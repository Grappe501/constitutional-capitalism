  "slice_id": "CC-BASELINE-AND-DATA-SOURCE-INVENTORY-1.0",
  "status": "canonical_planning_pre_code",
  "purpose": "Define the authoritative data-source hierarchy, baseline variable families, geographic coverage, refresh cadence, provenance requirements, and first digital-twin data demands for the Constitutional Capitalism Systems Intelligence Engine and National Debt & Prosperity model family.",
  "governing_rules": [
    "Use first-party public data as the default baseline source whenever available.",
    "Do not substitute project doctrine, press summaries, think-tank estimates, or general web claims for an authoritative baseline measure.",
    "A baseline value must carry source agency, dataset, vintage/date, geography, unit, definition, retrieval date, transformation notes, and revision status.",
    "If multiple authoritative sources disagree, preserve the disagreement and document definition differences rather than silently choosing one.",
    "Current values, historical observations, institutional projections, and model-generated scenarios must be stored and displayed as different epistemic classes.",
    "Small-area modeled estimates must be visibly labeled as modeled estimates rather than direct observations.",
    "No simulator slider may affect an output whose current baseline and causal parameter chain have not passed their respective gates.",
    "Latest-vintage data supersedes earlier preliminary estimates only when the owning agency specifies that convention; retain vintage metadata for reproducibility.",
    "Do not double count the same economic activity across federal, state, local, household, and private-sector ledgers.",
    "All transformations must be reproducible from raw or documented source fields."
  ],
  "epistemic_classes": [
    "observed_official_statistic",
    "modeled_official_estimate",
    "administrative_record",
    "institutional_projection",
    "derived_accounting_measure",
    "project_model_output",
    "illustrative_scenario"
  ],
