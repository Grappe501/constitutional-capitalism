        "federal_outlays_by_major_program",
        "mandatory_spending",
        "discretionary_spending",
        "federal_credit_and_guarantees"
      ],
      "geographies": ["nation"],
      "cadence": "daily for debt stock; monthly/annual for Treasury statements; annual and baseline-release cadence for CBO/OMB",
      "notes": "CBO baseline is the policy-comparison benchmark; Treasury owns actual debt and cash/financing records; OMB supplies executive budget/history series."
    },
