{
  "version": "1.0.0",
  "id": "CC-NARRATION-DIRECTOR-SCHEMA-1.0",
  "generated_at": "2026-08-16",
  "status": "ACTIVE",
  "purpose": "Paragraph-level Audio Book Director metadata. Public Book prose stays pristine; directions are narrator instructions only.",
  "unit_id_pattern": "{section_id}.P{paragraph_index:02d}",
  "example_unit_id": "S1.P01",
  "status_enum": ["draft", "proofed", "locked", "regenerate"],
  "priority_enum": ["standard", "signature"],
  "pace_enum": ["slow", "measured", "steady", "brisk"],
  "emotion_enum": [
    "neutral",
    "thoughtful",
    "measured",
    "firm",
    "hopeful",
    "restrained",
    "urgent",
    "warm"
  ],
  "paragraph_unit": {
    "unit_id": {"type": "string", "required": true},
    "source_path": {"type": "string", "required": true},
    "source_pass_id": {"type": "string", "required": true},
    "section_id": {"type": "string", "required": true},
    "section_heading": {"type": "string", "required": true},
    "paragraph_index": {"type": "integer", "required": true, "note": "1-based within section"},
    "spoken_text": {
      "type": "string",
      "required": true,
      "note": "Clean spoken prose; no audio tags; matches Public Book paragraph"
    },
    "direction": {
      "voice": {"type": "string|null", "note": "ElevenLabs voice id or alias; null until Style Guide freeze"},
      "energy": {"type": "integer", "min": 1, "max": 5},
      "pace": {"type": "string", "enum_ref": "pace_enum"},
      "emotion": {"type": "string", "enum_ref": "emotion_enum"},
      "emphasis": {"type": "array", "items": "string"},
      "opening_pause_ms": {"type": "integer"},
      "closing_pause_ms": {"type": "integer"},
      "performance_note": {"type": "string"}
    },
    "eleven_v3_tags": {
      "type": "string|null",
      "note": "Optional compiled tag-prefixed render string for expressive v3 passes; never published as book text"
    },
    "priority": {"type": "string", "enum_ref": "priority_enum"},
    "status": {"type": "string", "enum_ref": "status_enum"},
    "audio": {
      "model": {"type": "string|null"},
      "voice_id": {"type": "string|null"},
      "file_path": {"type": "string|null"},
      "content_hash": {"type": "string|null"},
      "generated_at": {"type": "string|null"},
      "characters": {"type": "integer|null"}
    }
  },
  "compile_rules": {
    "spoken_text_is_source_of_truth_for_words": true,
    "directions_never_enter_public_book": true,
    "regenerate_unit_not_chapter": true,
    "bound_figures_not_spoken_by_default": "describe briefly only if Style Guide requires; else skip"
  }
}
