{
  "version": "0.1.0",
  "last_updated": "2026-08-04",
  "status": "proposed",
  "decision_id": "CC-DEC-032",
  "title": "Chapter Evaluation Closing Block",
  "purpose": "Repeated structure for chapter endings so the book remains measurable, falsifiable, and honest about uncertainty.",
  "apply_when": ["researching", "drafting", "draft_complete", "editing", "fact_check", "legal_review", "final", "published"],
  "sections": [
    {
      "section_id": "CC-EVAL-SUCCESS",
      "heading": "Success Metrics",
      "prompt": "How would we know this chapter worked?",
      "links_to": ["national_baseline"]
    },
    {
      "section_id": "CC-EVAL-RISKS",
      "heading": "Risks",
      "prompt": "What could go wrong?",
      "links_to": ["risk_register"]
    },
    {
      "section_id": "CC-EVAL-COUNTER",
      "heading": "Counterarguments",
      "prompt": "What would critics say?",
      "links_to": ["objections", "counterargument_standard"]
    },
    {
      "section_id": "CC-EVAL-PILOT",
      "heading": "Pilot Test",
      "prompt": "How could this be tested in one state?",
      "links_to": ["implementation_manual", "transition_scenarios"]
    },
    {
      "section_id": "CC-EVAL-CONSTITUTIONAL",
      "heading": "Constitutional Questions",
      "prompt": "What constitutional issues arise?",
      "links_to": ["open_questions", "constitutional_articles"]
    },
    {
      "section_id": "CC-EVAL-RESEARCH",
      "heading": "Research Still Needed",
      "prompt": "What evidence remains incomplete?",
      "links_to": ["claim_ledger", "evidence_companion"]
    },
    {
      "section_id": "CC-EVAL-INTERNATIONAL",
      "heading": "International Examples",
      "prompt": "Has any nation attempted something similar?",
      "links_to": ["source_registry"],
      "discipline": "No invented examples."
    },
    {
      "section_id": "CC-EVAL-TIMELINE",
      "heading": "Impact Timeline",
      "prompt": "Expected effects at defined horizons (predictions/hypotheses, not proven outcomes).",
      "horizons": ["6_months", "2_years", "5_years", "10_years", "25_years"],
      "links_to": ["prediction_ledger"]
    }
  ]
}
