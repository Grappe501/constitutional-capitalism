{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "types": ["astro/client", "node"],

    "paths": {
      "@data/*": ["../../data/*"],
      "@content/*": ["../../content/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
