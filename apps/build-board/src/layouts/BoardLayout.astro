---
import "../styles/global.css";
import { identity } from "../lib/data";

interface Props {
  title: string;
  description?: string;
  path?: string;
}

const {
  title,
  description = "Constitutional Capitalism master Build Board — project command center.",
  path = "/",
} = Astro.props;

const pageTitle = `${title} | Build Board`;
const nav = [
  { href: "/", label: "Overview" },
  { href: "/master-plan/", label: "Master Plan" },
  { href: "/book/", label: "Book" },
  { href: "/research/", label: "Research" },
  { href: "/diagnosis/", label: "Diagnosis" },
  { href: "/equal-standing/", label: "Equal Standing" },
  { href: "/constitutional-citizenship/", label: "Citizenship" },
  { href: "/family/", label: "Family" },
  { href: "/assistance/", label: "Assistance" },
  { href: "/federalism/", label: "Federalism" },
  { href: "/peoples-branch/", label: "People’s Branch" },
  { href: "/phase-2-gate/", label: "Phase 2 Gate" },
  { href: "/proof-incubator/", label: "Proof Incubator" },
  { href: "/proof-packets/", label: "Proof Packets" },
  { href: "/research-institution/", label: "Research Institution" },
  { href: "/foundational-axioms/", label: "Axioms" },
  { href: "/collaborative-review/", label: "Collab Review" },
  { href: "/systems-intelligence/", label: "Systems AI" },
  { href: "/systems-map/", label: "Systems Map" },
  { href: "/justice/", label: "Justice" },
  { href: "/democracy/", label: "Democracy" },
  { href: "/public-service/", label: "Public Service" },
  { href: "/citizen-service/", label: "Citizen Service" },
  { href: "/constitutional-defense/", label: "Defense" },
  { href: "/civic-wealth/", label: "Civic Wealth" },
  { href: "/energy-sovereignty/", label: "Energy" },
  { href: "/health/", label: "Health" },
  { href: "/prosperous-aging/", label: "Aging" },
  { href: "/community-prosperity/", label: "Community Prosperity" },
  { href: "/local-ownership/", label: "Local Ownership" },
  { href: "/community-resilience/", label: "Resilience" },
  { href: "/transparency/", label: "Transparency" },
  { href: "/essential-systems/", label: "Essential Systems" },
  { href: "/human-capital/", label: "Human Capital" },
  { href: "/build-your-community/", label: "Build Community" },
  { href: "/resource-sovereignty/", label: "Resource Sovereignty" },
  { href: "/food-security/", label: "Food Security" },
  { href: "/family-farm-prosperity/", label: "Family Farms" },
  { href: "/baseline/", label: "Baseline" },
  { href: "/evidence/", label: "Evidence" },
  { href: "/policy/", label: "Policy" },
  { href: "/constitution/", label: "Constitution" },
  { href: "/decisions/", label: "Decisions" },
  { href: "/risks/", label: "Risks" },
  { href: "/deployments/", label: "Deployments" },
  { href: "/activity/", label: "Activity" },
  { href: "/handoff/", label: "Handoff" },
  { href: "/settings/", label: "Settings" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="frame" data-board-frame>
      <aside class="sidebar" data-board-sidebar>
        <div class="sidebar__top">
          <div class="sidebar__identity">
            <a class="sidebar__brand" href="/">Build Board</a>
            <p class="sidebar__tag">{identity.title}</p>
          </div>
          <button
            type="button"
            class="nav-toggle"
            data-nav-toggle
            aria-expanded="false"
            aria-controls="board-nav"
          >
            <span data-nav-toggle-label>Menu</span>
          </button>
        </div>
        <p class="sidebar__meta">
          Internal build board for contributors. Protect this URL before sharing broadly.
        </p>
        <nav class="side-nav" id="board-nav" data-board-nav aria-label="Board">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={path === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </aside>
      <div class="content">
        <main id="main">
          <slot />
        </main>
      </div>
    </div>
    <script>
      const frame = document.querySelector("[data-board-frame]");
      const toggle = document.querySelector("[data-nav-toggle]");
      const nav = document.querySelector("[data-board-nav]");
      const label = document.querySelector("[data-nav-toggle-label]");
      if (frame && toggle && nav && label) {
        const setOpen = (open: boolean) => {
          frame.classList.toggle("is-nav-open", open);
          document.body.classList.toggle("nav-lock", open);
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
          label.textContent = open ? "Close" : "Menu";
        };
        toggle.addEventListener("click", () => {
          setOpen(!frame.classList.contains("is-nav-open"));
        });
        nav.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setOpen(false));
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") setOpen(false);
        });
        const mq = window.matchMedia("(min-width: 901px)");
        const syncDesktop = () => {
          if (mq.matches) setOpen(false);
        };
        mq.addEventListener("change", syncDesktop);
      }
    </script>
  </body>
</html>
