---
import BoardLayout from "../layouts/BoardLayout.astro";
import { developingDoctrine } from "../lib/data";
import es from "../../../../data/project/energy_sovereignty_framework.json";

const doctrineIds = Array.from({ length: 20 }, (_, i) => `CC-DEV-${209 + i}`);
const items = (developingDoctrine.items || []).filter((d: any) =>
  doctrineIds.includes(d.doctrine_id)
);
const testQs = es.energy_sovereignty_test?.questions || [];
const prosperityQs = es.domestic_prosperity_test?.questions || [];
const baselines = es.sourced_context_baselines?.items || [];
const allocation =
  es.national_energy_prosperity_fund?.illustrative_distributable_allocation?.shares || [];
---

<BoardLayout title="Energy Sovereignty" path="/energy-sovereignty/">
  <h1 class="page-title">{es.domain_title}</h1>
  <p class="page-lede">
    Framework: <code>data/project/energy_sovereignty_framework.json</code> v{es.version}.
    Principle: <code>{es.principle_id}</code>. Decision: <code>CC-DEC-086</code>. Major national
    doctrine.; fund modeling 0%.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__value">{items.length}</div>
      <div class="stat__label">Developing doctrine items</div>
    </div>
    <div class="stat">
      <div class="stat__value">{baselines.length}</div>
      <div class="stat__label">Sourced EIA/DOE baselines</div>
    </div>
    <div class="stat">
      <div class="stat__value">{(es.website_branches || []).length}</div>
      <div class="stat__label">Website branches</div>
    </div>
  </div>

  <section class="panel">
    <h2>Memorable principle</h2>
    <blockquote>
      <p>{es.memorable_principle.text}</p>
    </blockquote>
    <p>{es.priority_sequence.principle}</p>
  </section>

  <section class="panel">
    <h2>Sourced context baselines</h2>
    
    <ul>
      {baselines.map((b: any) => (
        <li>
          <code>{b.id}</code> — {b.text}
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Illustrative fund allocation (not locked)</h2>
    
    <ul>
      {allocation.map((a: any) => (
        <li>
          {a.percent}% — {a.use}
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Domestic Prosperity Test</h2>
    <ol>
      {prosperityQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Energy sovereignty test</h2>
    <ol>
      {testQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Developing doctrine ({items.length})</h2>
    <ul>
      {items.map((d: any) => (
        <li>
          <code>{d.doctrine_id}</code> — {d.statement.slice(0, 160)}…
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Related</h2>
    <p>
      Related: <a href="/resource-sovereignty/">Resource Sovereignty</a>,{" "}
      <a href="/phase-2-gate/">Phase 2 Gate</a>.
    </p>
  </section>
</BoardLayout>
