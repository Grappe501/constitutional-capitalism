---
import BoardLayout from "../layouts/BoardLayout.astro";
import { deployments } from "../lib/data";
---

<BoardLayout title="Deployments" path="/deployments/">
  <h1 class="page-title">Deployments</h1>
  <p class="page-lede">
    Two independent Netlify sites from one GitHub repository. Production URLs recorded only when confirmed.
  </p>
  <div class="notice">
    Build Board access protection is not configured. Do not treat the board as private.
  </div>
  <div class="grid">
    {
      deployments.applications.map((app) => (
        <section class="panel">
          <h2>{app.name}</h2>
          <ul class="list-plain">
            <li>Status: <strong>{app.status}</strong></li>
            <li>Suggested Netlify name: <code>{app.suggested_netlify_name}</code></li>
            <li>Path: <code>{app.path}</code></li>
            <li>Base directory: <code>{app.base_directory}</code></li>
            <li>Build command: <code>{app.build_command}</code></li>
            <li>Publish directory: <code>{app.publish_directory}</code></li>
            <li>Config file: <code>{app.netlify_config}</code></li>
            <li>Last build status: {app.last_build_status || "—"}</li>
            <li>Last known commit: {app.last_known_commit || "—"}</li>
            <li>Production URL: {app.production_url || "not yet configured"}</li>
            <li>Access: {app.access}{app.access_note ? ` — ${app.access_note}` : ""}</li>
          </ul>
          <h3>Manual setup still required</h3>
          <ul class="list-plain">
            {(app.manual_setup_required || []).map((item) => <li>{item}</li>)}
          </ul>
        </section>
      ))
    }
  </div>
</BoardLayout>
