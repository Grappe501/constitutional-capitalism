---
import BoardLayout from "../layouts/BoardLayout.astro";
import { developingDoctrine } from "../lib/data";
import ff from "../../../../data/project/federalism_framework.json";

const doctrineIds = [
  "CC-DEV-104",
  "CC-DEV-105",
  "CC-DEV-106",
  "CC-DEV-107",
  "CC-DEV-108",
  "CC-DEV-109",
  "CC-DEV-110",
  "CC-DEV-111",
  "CC-DEV-112",
  "CC-DEV-113",
  "CC-DEV-114",
  "CC-DEV-115",
  "CC-DEV-116",
  "CC-DEV-117",
  "CC-DEV-118",
  "CC-DEV-119",
];
const fedDoctrine = (developingDoctrine.items || []).filter((d: any) =>
  doctrineIds.includes(d.doctrine_id)
);
const responsibilities = ff.core_responsibilities || [];
const testQs = ff.federalism_test?.questions || [];
const branches = ff.website_branches || [];
---

<BoardLayout title="Federalism" path="/federalism/">
  <h1 class="page-title">{ff.domain_title}</h1>
  <p class="page-lede">
    Framework: <code>data/project/federalism_framework.json</code> v{ff.version}. Principle:{" "}
    <code>{ff.principle_id}</code>. Decision: <code>CC-DEC-080</code>. Architecture — not statutes.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__value">{responsibilities.length}</div>
      <div class="stat__label">Core responsibilities</div>
    </div>
    <div class="stat">
      <div class="stat__value">{fedDoctrine.length}</div>
      <div class="stat__label">Developing doctrine items</div>
    </div>
    <div class="stat">
      <div class="stat__value">{branches.length}</div>
      <div class="stat__label">Website branches</div>
    </div>
  </div>

  <section class="panel">
    <h2>Character</h2>
    <p>
      Not <strong>{ff.character.not}</strong>. Is: {ff.character.is.join(", ")}.
    </p>
    <blockquote>
      <p>{ff.central_statement.text}</p>
    </blockquote>
    <blockquote>
      <p>{ff.governing_rule.text}</p>
    </blockquote>
  </section>

  <section class="panel">
    <h2>Core responsibilities</h2>
    <ol>
      {responsibilities.map((r: any) => (
        <li>
          <strong>
            {r.id} {r.title}
          </strong>
          — {r.summary}
        </li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Developing doctrine ({fedDoctrine.length})</h2>
    <ul>
      {fedDoctrine.map((d: any) => (
        <li>
          <code>{d.doctrine_id}</code> — {d.statement.slice(0, 180)}…
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Federalism test</h2>
    <ol>
      {testQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Related</h2>
    <p>
      Related: <a href="/phase-2-gate/">Phase 2 Gate</a>, <a href="/assistance/">Assistance</a>,{" "}
      <a href="/equal-standing/">Equal Standing</a>.
    </p>
  </section>
</BoardLayout>
