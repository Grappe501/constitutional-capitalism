---
import BoardLayout from "../layouts/BoardLayout.astro";
import { developingDoctrine, claims, baselineStatus } from "../lib/data";
import af from "../../../../data/project/assistance_framework.json";

const doctrineIds = [
  "CC-DEV-089",
  "CC-DEV-090",
  "CC-DEV-091",
  "CC-DEV-092",
  "CC-DEV-093",
  "CC-DEV-094",
  "CC-DEV-095",
  "CC-DEV-096",
  "CC-DEV-097",
  "CC-DEV-098",
  "CC-DEV-099",
  "CC-DEV-100",
  "CC-DEV-101",
  "CC-DEV-102",
  "CC-DEV-103",
];
const claimIds = [
  "CC-CLAIM-091",
  "CC-CLAIM-092",
  "CC-CLAIM-093",
  "CC-CLAIM-094",
  "CC-CLAIM-095",
  "CC-CLAIM-096",
  "CC-CLAIM-097",
  "CC-CLAIM-098",
  "CC-CLAIM-099",
  "CC-CLAIM-100",
];
const assistDoctrine = (developingDoctrine.items || []).filter((d: any) =>
  doctrineIds.includes(d.doctrine_id)
);
const assistClaims = (claims.claims || []).filter((c: any) => claimIds.includes(c.claim_id));
const testQs = af.assistance_test?.questions || [];
const pathways = af.pathways || [];
---

<BoardLayout title="Assistance" path="/assistance/">
  <h1 class="page-title">{af.domain_title}</h1>
  <p class="page-lede">
    Framework: <code>data/project/assistance_framework.json</code> v{af.version}. Principle:{" "}
    <code>{af.principle_id}</code>. Architecture — not modeled phaseouts.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__label">Doctrine items</div>
      <div class="stat__value">{assistDoctrine.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Pathways</div>
      <div class="stat__value">{pathways.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Assistance Test</div>
      <div class="stat__value">{testQs.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Baseline (all)</div>
      <div class="stat__value" style="font-size:1.1rem;">
        {baselineStatus.sourced_metrics}/{baselineStatus.total_metrics}
      </div>
    </div>
  </div>

  <section class="panel" style="margin-top:1rem;">
    <h2>Organizing principle</h2>
    <p>{af.organizing_principle.text}</p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Security vs dependency</h2>
    <p>
      <strong>Security:</strong> {af.security_vs_dependency.security}
    </p>
    <p>
      <strong>Dependency:</strong> {af.security_vs_dependency.dependency}
    </p>
    <p>
      <strong>Goal:</strong> {af.security_vs_dependency.goal}
    </p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Six pathways</h2>
    <ol>
      {
        pathways.map((p: any) => (
          <li>
            <code>{p.pathway_id}</code> <strong>{p.title}</strong> — {p.summary}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Developing doctrine</h2>
    <ul class="list-plain">
      {
        assistDoctrine.map((d: any) => (
          <li>
            <code>{d.doctrine_id}</code> — {d.statement}{" "}
            <span class="pill">{d.maturity}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Constitutional Assistance Test</h2>
    <ol>
      {testQs.map((q: any) => (
        <li>{q.text}</li>
      ))}
    </ol>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Claims</h2>
    <ul class="list-plain">
      {
        assistClaims.map((c: any) => (
          <li>
            <code>{c.claim_id}</code> — {c.public_wording || c.claim_text}{" "}
            <span class="pill">{c.support_level}</span>
          </li>
        ))
      }
    </ul>
  </section>
</BoardLayout>
