---
import BoardLayout from "../layouts/BoardLayout.astro";
import { developingDoctrine, claims, baselineStatus } from "../lib/data";
import trn from "../../../../data/project/transparency_framework.json";

const doctrineIds = ["CC-DEV-029", "CC-DEV-030", "CC-DEV-031", "CC-DEV-032"];
const claimIds = ["CC-CLAIM-034", "CC-CLAIM-035", "CC-CLAIM-036", "CC-CLAIM-037"];
const trnDoctrine = (developingDoctrine.items || []).filter((d: any) =>
  doctrineIds.includes(d.doctrine_id)
);
const trnClaims = (claims.claims || []).filter((c: any) => claimIds.includes(c.claim_id));
const testQs = trn.constitutional_transparency_test?.questions || [];
---

<BoardLayout title="Transparency" path="/transparency/">
  <h1 class="page-title">Constitutional Transparency and the People's Ledger</h1>
  <p class="page-lede">
    Research title: {trn.research_domain_title}. Framework:
    <code>data/project/transparency_framework.json</code> v{trn.version}.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__label">Doctrine items</div>
      <div class="stat__value">{trnDoctrine.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Transparency Test</div>
      <div class="stat__value">{testQs.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Website branches</div>
      <div class="stat__value">{trn.website_branches?.length ?? 0}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Claims</div>
      <div class="stat__value">{trnClaims.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Baseline (all)</div>
      <div class="stat__value" style="font-size:1.1rem;">
        {baselineStatus.sourced_metrics}/{baselineStatus.total_metrics}
      </div>
    </div>
  </div>

  <section class="panel" style="margin-top:1rem;">
    <h2>Guiding principle</h2>
    <p>{trn.guiding_principle.text}</p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Openness presumption</h2>
    <p>{trn.openness_presumption.text}</p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>The People's Ledger</h2>
    <p>
      <strong>{trn.peoples_ledger.name}</strong> — {trn.peoples_ledger.definition}
    </p>
    
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Developing doctrine</h2>
    <ul class="list-plain">
      {
        trnDoctrine.map((d: any) => (
          <li>
            <code>{d.doctrine_id}</code> — {d.statement}{" "}
            <span class="pill">{d.maturity}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Identity and access balance</h2>
    <p>{trn.identity_and_access_balance.caution}</p>
    <ul class="list-plain">
      <li>
        <strong>Routine:</strong> {trn.identity_and_access_balance.routine_public_records}
      </li>
      <li>
        <strong>Sensitive / high-volume:</strong>{" "}
        {trn.identity_and_access_balance.sensitive_or_high_volume}
      </li>
      <li>
        <strong>Changes:</strong> {trn.identity_and_access_balance.actions_that_change_records}
      </li>
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Constitutional Transparency Test</h2>
    <ol>
      {testQs.map((q: any) => (
        <li>{q.text}</li>
      ))}
    </ol>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Claims</h2>
    <ul class="list-plain">
      {
        trnClaims.map((c: any) => (
          <li>
            <code>{c.claim_id}</code> — {c.claim_text}{" "}
            <span class="pill">{c.support_level}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Research status</h2>
    <p>
      Phase: {trn.research_status?.phase}. Policy drafting: {trn.research_status?.policy_drafting}.
      Next: {trn.research_status?.next}
    </p>
    <p>Decisions: {(trn.decision_ids || []).join(", ")}</p>
  </section>
</BoardLayout>
