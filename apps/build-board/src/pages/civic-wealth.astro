---
import BoardLayout from "../layouts/BoardLayout.astro";
import { developingDoctrine } from "../lib/data";
import cw from "../../../../data/project/civic_wealth_framework.json";

const doctrineIds = Array.from({ length: 16 }, (_, i) => `CC-DEV-${193 + i}`);
const items = (developingDoctrine.items || []).filter((d: any) =>
  doctrineIds.includes(d.doctrine_id)
);
const testQs = cw.civic_wealth_test?.questions || [];
const pathway = cw.veteran_prosperity_pathway?.steps || [];
const never = cw.guardrails?.must_never_become || [];
---

<BoardLayout title="Civic Wealth" path="/civic-wealth/">
  <h1 class="page-title">{cw.domain_title}</h1>
  <p class="page-lede">
    Framework: <code>data/project/civic_wealth_framework.json</code> v{cw.version}. Principle:{" "}
    <code>{cw.principle_id}</code>. Decision: <code>CC-DEC-085</code>. Signature investment framing.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__value">{items.length}</div>
      <div class="stat__label">Developing doctrine items</div>
    </div>
    <div class="stat">
      <div class="stat__value">{pathway.length}</div>
      <div class="stat__label">Prosperity pathway steps</div>
    </div>
    <div class="stat">
      <div class="stat__value">{(cw.website_branches || []).length}</div>
      <div class="stat__label">Website branches</div>
    </div>
  </div>

  <section class="panel">
    <h2>Signature shift</h2>
    <p>
      From: <em>{cw.signature_shift.from}</em>
    </p>
    <blockquote>
      <p>{cw.signature_shift.to}</p>
    </blockquote>
  </section>

  <section class="panel">
    <h2>Governing principle</h2>
    <blockquote>
      <p>{cw.governing_principle.text}</p>
    </blockquote>
    <p>{cw.core_theme.text}</p>
  </section>

  <section class="panel">
    <h2>Veteran Prosperity Pathway</h2>
    <ol>
      {pathway.map((step: string) => (
        <li>{step}</li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Guardrails</h2>
    <ul>
      {never.map((n: string) => (
        <li>{n}</li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Civic wealth test</h2>
    <ol>
      {testQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Developing doctrine ({items.length})</h2>
    <ul>
      {items.map((d: any) => (
        <li>
          <code>{d.doctrine_id}</code> — {d.statement.slice(0, 160)}…
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Related</h2>
    <p>
      Related: <a href="/constitutional-defense/">Defense</a>,{" "}
      <a href="/citizen-service/">Citizen Service</a>, <a href="/phase-2-gate/">Phase 2 Gate</a>.
    </p>
  </section>
</BoardLayout>
