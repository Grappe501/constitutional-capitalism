---
import BoardLayout from "../layouts/BoardLayout.astro";
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../../../../");
const handoffPath = path.join(repoRoot, "docs/handoffs/CURRENT_THREAD_HANDOFF.md");
let handoff = "Handoff not generated yet. Run `pnpm handoff:generate`.";
try {
  handoff = fs.readFileSync(handoffPath, "utf8");
} catch {
  // keep default
}
---

<BoardLayout title="Handoff" path="/handoff/">
  <h1 class="page-title">Thread handoff</h1>
  <p class="page-lede">Generated current-thread handoff for Steve / ChatGPT / Cursor continuity.</p>
  <section class="panel">
    <pre style="white-space:pre-wrap; font-family: var(--sans); margin:0;">{handoff}</pre>
  </section>
</BoardLayout>
