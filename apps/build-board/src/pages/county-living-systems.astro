---
import BoardLayout from "../layouts/BoardLayout.astro";
import explorer from "../../../../data/project/arkansas_county_living_systems_explorer.json";

const counties = explorer.counties || [];
const compareMetrics = explorer.compare_metrics || [];
const questions = explorer.research_questions || [];
const edu = explorer.education_workforce_bridge || {};
const familyRows = Object.entries(
  (edu.completions_by_workforce_category || {}) as Record<string, Record<string, number>>
).map(([fam, years]) => ({
  fam,
  series: Object.entries(years)
    .map(([y, n]) => `${y}: ${Number(n).toLocaleString()}`)
    .join(" · "),
}));
const keystones = edu.keystone_capacity_signals || [];
const adwsRows = (edu.adws_state_bridge || []).map((r: any) => ({
  fam: r.workforce_category,
  completions: r.ipeds_completions_2023,
  openings: r.adws_total_annual_openings_sum,
  ratio: r.capacity_to_openings_ratio,
}));
const counterHyps = explorer.counterexample_register?.hypotheses || [];
---

<BoardLayout
  title="County Living Systems"
  path="/county-living-systems/"
  description="Internal integrated empirical laboratory. Not a public score. Counterexamples privileged."
>
  <h1 class="page-title">County Living Systems Explorer</h1>
  <p class="page-lede">
    Internal integrated empirical laboratory — <strong>not a public score</strong>.
    Observation first. Interpretation second. Causation only after modeling.
    Rose Bud / Lewisville remain candidates, not locks. Overall dial held at 43%.
    Analyst layer:
    <a href="/ai-research-intelligence/">CC Intelligence Engine</a>
    (server-side; propose only).
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__label">Counties</div>
      <div class="stat__value">{counties.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Status</div>
      <div class="stat__value" style="font-size:0.9rem;">{explorer.status}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Update</div>
      <div class="stat__value" style="font-size:0.95rem;">{explorer.update_id}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Counterexample hyps</div>
      <div class="stat__value">{counterHyps.length}</div>
    </div>
  </div>

  <section class="panel" style="margin-top:1rem;">
    <h2>Questions this laboratory is for</h2>
    <ul class="list-plain">
      {questions.map((q) => <li>{q}</li>)}
    </ul>
    <p style="margin-top:0.75rem;opacity:0.85;">
      Not yet “does X cause Y?” — which variables move together, which first, which don’t,
      where counterexamples live, which relationships survive cross-county comparison.
    </p>
  </section>

  <section class="panel" style="margin-top:1rem;" data-living-systems>
    <h2>County timeline</h2>
    <div style="display:flex;flex-wrap:wrap;gap:0.75rem;align-items:end;margin-bottom:1rem;">
      <label>
        County A
        <select data-county-a>
          {counties.map((c) => (
            <option value={c.fips} selected={c.fips === "05145"}>
              {c.county} ({c.fips})
            </option>
          ))}
        </select>
      </label>
      <label>
        County B (compare)
        <select data-county-b>
          <option value="">— none —</option>
          {counties.map((c) => (
            <option value={c.fips} selected={c.fips === "05073"}>
              {c.county} ({c.fips})
            </option>
          ))}
        </select>
      </label>
      <label>
        Focus metric
        <select data-metric>
          {compareMetrics.map((m) => (
            <option value={m} selected={m === "presidential_turnout_of_registered_percent"}>
              {m}
            </option>
          ))}
        </select>
      </label>
    </div>
    <div data-timeline-out style="overflow-x:auto;"></div>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>County Counterexample Register</h2>
    <p>
      Protects against confirmation machines. For each co-travel hypothesis: strongest support,
      strongest contradiction, ambiguous cases, missing data, definition breaks.
      Counterexamples are not nuisances — they show what the theory is missing.
    </p>
    {
      counterHyps.map((h: any) => (
        <div style="margin-top:1rem;padding-top:0.75rem;border-top:1px solid var(--border, #333);">
          <h3 style="font-size:1rem;">
            <code>{h.hypothesis_id}</code>
          </h3>
          <p style="opacity:0.9;">{h.claim}</p>
          {
            h.status === "MISSING_DATA" ? (
              <p>Missing data — {h.note}</p>
            ) : (
              <ul class="list-plain">
                <li>
                  Strongest support: <strong>{h.strongest_supporting_pattern?.county}</strong>{" "}
                  (score {h.strongest_supporting_pattern?.support_score})
                </li>
                <li>
                  Strongest contradiction (z-product):{" "}
                  <strong>{h.strongest_contradictory_pattern?.county}</strong>{" "}
                  (score {h.strongest_contradictory_pattern?.support_score})
                </li>
                <li>
                  Counterexample patterns:{" "}
                  {(h.counterexamples || [])
                    .map((c: any) => `${c.county} [${c.pattern}]`)
                    .join("; ") || "none flagged"}
                </li>
                <li>
                  Definition breaks: {(h.definition_breaks || []).join(" · ")}
                </li>
              </ul>
            )
          }
        </div>
      ))
    }
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Education capacity → ADWS demand bridge</h2>
    <p>
      Status: <code>{edu.adws_status || edu.status}</code>. Statewide/LWDA demand only —
      <strong>county geographic gap remains NEE</strong>. Low completions ≠ shortage.
    </p>
    <ul class="list-plain">
      {adwsRows.map((row) => (
        <li>
          <code>{row.fam}</code> — completions 2023: {Number(row.completions).toLocaleString()} ·
          ADWS linked annual openings: {Number(row.openings).toLocaleString()} · ratio:{" "}
          {row.ratio ?? "—"}
        </li>
      ))}
    </ul>
    <h3 style="margin-top:1rem;">IPEDS family completions</h3>
    <ul class="list-plain">
      {familyRows.map((row) => (
        <li>
          <code>{row.fam}</code> — {row.series}
        </li>
      ))}
    </ul>
    <h3 style="margin-top:1rem;">Keystone capacity signals</h3>
    <ul class="list-plain">
      {keystones.map((k: any) => (
        <li>
          <code>{k.label}</code> ({k.cip}) — {k.status} —{" "}
          {JSON.stringify(k.ipeds_completions_by_year)}
        </li>
      ))}
    </ul>
  </section>

  <script is:inline define:vars={{ counties, compareMetrics }}>
    const root = document.querySelector("[data-living-systems]");
    if (root) {
      const aSel = root.querySelector("[data-county-a]");
      const bSel = root.querySelector("[data-county-b]");
      const mSel = root.querySelector("[data-metric]");
      const out = root.querySelector("[data-timeline-out]");
      const byFips = Object.fromEntries(counties.map((c) => [c.fips, c]));

      function yearsFor(c) {
        return (c?.timeline || []).map((t) => t.year);
      }

      function val(c, year, metric) {
        const row = (c?.timeline || []).find((t) => t.year === year);
        return row?.metrics?.[metric]?.value;
      }

      function render() {
        const a = byFips[aSel.value];
        const b = bSel.value ? byFips[bSel.value] : null;
        const metric = mSel.value;
        const years = Array.from(
          new Set([...yearsFor(a), ...yearsFor(b)].filter(Boolean))
        ).sort();
        const rows = years
          .map((y) => {
            const av = val(a, y, metric);
            const bv = b ? val(b, y, metric) : null;
            if (av == null && bv == null) return "";
            return `<tr>
              <td><code>${y}</code></td>
              <td>${av == null ? "—" : typeof av === "number" ? av.toLocaleString() : av}</td>
              <td>${b ? (bv == null ? "—" : typeof bv === "number" ? bv.toLocaleString() : bv) : "—"}</td>
            </tr>`;
          })
          .join("");
        out.innerHTML = `
          <p style="opacity:0.85;margin-bottom:0.5rem;">
            Metric <code>${metric}</code> · ${a?.county || ""}${b ? " vs " + b.county : ""}
          </p>
          <table class="table">
            <thead><tr><th>Year</th><th>${a?.county || "A"}</th><th>${b?.county || "B"}</th></tr></thead>
            <tbody>${rows || '<tr><td colspan="3">No observations for this metric.</td></tr>'}</tbody>
          </table>
        `;
      }
      aSel.addEventListener("change", render);
      bSel.addEventListener("change", render);
      mSel.addEventListener("change", render);
      render();
    }
  </script>
</BoardLayout>
