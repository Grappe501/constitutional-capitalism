---
import BoardLayout from "../layouts/BoardLayout.astro";
import { developingDoctrine, claims, baselineStatus } from "../lib/data";
import civ from "../../../../data/project/constitutional_citizenship_framework.json";

const doctrineIds = [
  "CC-DEV-068",
  "CC-DEV-069",
  "CC-DEV-070",
  "CC-DEV-071",
  "CC-DEV-072",
  "CC-DEV-073",
];
const claimIds = [
  "CC-CLAIM-075",
  "CC-CLAIM-076",
  "CC-CLAIM-077",
  "CC-CLAIM-078",
  "CC-CLAIM-079",
  "CC-CLAIM-080",
];
const civDoctrine = (developingDoctrine.items || []).filter((d: any) =>
  doctrineIds.includes(d.doctrine_id)
);
const civClaims = (claims.claims || []).filter((c: any) => claimIds.includes(c.claim_id));
const testQs = civ.constitutional_citizenship_test?.questions || [];
const stages = civ.developmental_civic_pathway?.stages || [];
---

<BoardLayout title="Constitutional Citizenship" path="/constitutional-citizenship/">
  <h1 class="page-title">{civ.domain_title}</h1>
  <p class="page-lede">
    Research title: {civ.research_domain_title}. Framework:
    <code>data/project/constitutional_citizenship_framework.json</code> v{civ.version}. Principle:{" "}
    <code>{civ.principle_id}</code>.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__label">Doctrine items</div>
      <div class="stat__value">{civDoctrine.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Citizenship Test</div>
      <div class="stat__value">{testQs.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Pathway stages</div>
      <div class="stat__value">{stages.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Claims</div>
      <div class="stat__value">{civClaims.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Baseline (all)</div>
      <div class="stat__value" style="font-size:1.1rem;">
        {baselineStatus.sourced_metrics}/{baselineStatus.total_metrics}
      </div>
    </div>
  </div>

  <section class="panel" style="margin-top:1rem;">
    <h2>Central question</h2>
    <p>
      Primary: <strong>{civ.central_question_shift.primary}</strong>
    </p>
    <p class="muted">Not primarily: {civ.central_question_shift.not_primary}</p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Foundational doctrine</h2>
    <p>{civ.foundational_doctrine.text}</p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Voting-age discipline</h2>
    <p>
      <strong>{civ.prepared_civic_participation_exploration.hard_rule}</strong>
    </p>
    <p>{civ.prepared_civic_participation_exploration.governing_question}</p>
    <p class="muted">{civ.prepared_civic_participation_exploration.pilot_posture}</p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Developing doctrine</h2>
    <ul class="list-plain">
      {
        civDoctrine.map((d: any) => (
          <li>
            <code>{d.doctrine_id}</code> — {d.statement}{" "}
            <span class="pill">{d.maturity}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Constitutional Citizenship Test</h2>
    <ol>
      {testQs.map((q: any) => (
        <li>{q.text}</li>
      ))}
    </ol>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Claims</h2>
    <ul class="list-plain">
      {
        civClaims.map((c: any) => (
          <li>
            <code>{c.claim_id}</code> — {c.public_wording || c.claim_text}{" "}
            <span class="pill">{c.support_level}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Research status</h2>
    <p>
      Phase: {civ.research_status?.phase}. Policy drafting: {civ.research_status?.policy_drafting}.
      Next: {civ.research_status?.next}
    </p>
    <p class="muted">{civ.research_status?.baseline_note}</p>
  </section>
</BoardLayout>
