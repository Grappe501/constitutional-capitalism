---
import BoardLayout from "../layouts/BoardLayout.astro";
import EvidencePanel from "../components/EvidencePanel.astro";
import { developingDoctrine } from "../lib/data";
import f from "../../../../data/project/family_farm_prosperity_framework.json";
import panels from "../../../../data/project/publication_evidence_panels.json";

const doctrineIds = Array.from({ length: 20 }, (_, i) => `CC-DEV-${269 + i}`);
const items = (developingDoctrine.items || []).filter((d: any) =>
  doctrineIds.includes(d.doctrine_id)
);
const testQs = f.family_farm_prosperity_test?.questions || [];
const baselines = f.sourced_context_baselines?.items || [];
const pillars = f.thirteen_pillars?.pillars || [];
const processingPanel = (panels.panels || []).find(
  (p: { panel_id: string }) => p.panel_id === "CC-EP-AR-AG-PROCESSING-ACCESS-1"
);
const farmStructurePanel = (panels.panels || []).find(
  (p: { panel_id: string }) => p.panel_id === "CC-EP-RURAL-LOCAL-CAPITAL-SYSTEM-1"
);
---

<BoardLayout title="Family Farm Prosperity" path="/family-farm-prosperity/">
  <h1 class="page-title">{f.domain_title}</h1>
  <p class="page-lede">
    Framework: <code>data/project/family_farm_prosperity_framework.json</code> v{f.version}.
    Principle: <code>{f.principle_id}</code>. Decision: <code>CC-DEC-089</code>. Complements
    Community Food Security.; purchase floors and financing formulas require modeling; legal 0%.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__value">{items.length}</div>
      <div class="stat__label">Developing doctrine items</div>
    </div>
    <div class="stat">
      <div class="stat__value">{baselines.length}</div>
      <div class="stat__label">Sourced USDA baselines</div>
    </div>
    <div class="stat">
      <div class="stat__value">{pillars.length}</div>
      <div class="stat__label">Pillars</div>
    </div>
  </div>

  <section class="panel">
    <h2>Scorecard question</h2>
    <blockquote>
      <p>{f.scorecard_question.text}</p>
    </blockquote>
  </section>

  <section class="panel">
    <h2>Sourced context baselines</h2>
    <ul>
      {baselines.map((b: any) => (
        <li>
          <code>{b.id}</code> — {b.text}
        </li>
      ))}
    </ul>
  </section>
  {farmStructurePanel ? <EvidencePanel panel={farmStructurePanel} /> : null}
  {processingPanel ? <EvidencePanel panel={processingPanel} /> : null}

  <section class="panel">
    <h2>Thirteen pillars</h2>
    <ol>
      {pillars.map((p: any) => (
        <li>
          <strong>{p.title}</strong> — {p.summary}
        </li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Family farm prosperity test</h2>
    <ol>
      {testQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Developing doctrine ({items.length})</h2>
    <ul>
      {items.map((d: any) => (
        <li>
          <code>{d.doctrine_id}</code> — {d.statement.slice(0, 160)}…
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Related</h2>
    <p>
      Related: <a href="/food-security/">Food Security</a>,{" "}
      <a href="/resource-sovereignty/">Resource Sovereignty</a>,{" "}
      <a href="/phase-2-gate/">Phase 2 Gate</a>.
    </p>
  </section>
</BoardLayout>
