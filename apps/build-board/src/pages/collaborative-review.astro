---
import BoardLayout from "../layouts/BoardLayout.astro";
import f from "../../../../data/project/collaborative_constitutional_review_framework.json";

const types = f.review_types || f.comment_types || [];
const domains = f.expertise_domains?.domains || [];
const stages = f.five_stage_progression?.stages || [];
const impactFields = f.impact_requests?.ai_response_fields || [];
const ladder = f.contributor_reputation?.ladder || [];
const gates = f.activation_gates?.all_required || [];
const lifecycle = f.review_artifacts?.lifecycle || [];
const nodes = f.manuscript_tree?.nodes || [];
const views = f.scholarly_modes?.views || [];
---

<BoardLayout title="Collaborative Review" path="/collaborative-review/">
  <h1 class="page-title">{f.title}</h1>
  <p class="page-lede">
    Decisions: <code>{f.decision_id}</code>, <code>CC-DEC-098</code>. Status:{" "}
    <code>{f.status}</code>. <strong>Not built. Not active.</strong> Phase{" "}
    {f.phase_placement.chronological_phase_number} peer-review journal layer. Impact Requests
    bridge to Phase 9 Systems Intelligence.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__value">8</div>
      <div class="stat__label">Review phase</div>
    </div>
    <div class="stat">
      <div class="stat__value">{domains.length}</div>
      <div class="stat__label">Expertise domains</div>
    </div>
    <div class="stat">
      <div class="stat__value">{f.implementation_status.build_now ? "Yes" : "No"}</div>
      <div class="stat__label">Build now?</div>
    </div>
  </div>

  <section class="panel">
    <h2>Governance vs construction</h2>
    <p>{f.governance_vs_construction.rule}</p>
    <p class="muted">{f.governance_vs_construction.opens_when}</p>
  </section>

  <section class="panel">
    <h2>Operating model</h2>
    <blockquote>
      <p>{f.operating_model.title}</p>
    </blockquote>
    <p>{f.principle.text}</p>
  </section>

  <section class="panel">
    <h2>Five-stage progression</h2>
    <ol>
      {stages.map((s: any) => (
        <li>
          <strong>{s.title}</strong> — {s.summary}{" "}
          <span class="muted">({s.phases})</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Expertise domains</h2>
    <p>{f.expertise_domains.rule}</p>
    <ul>
      {domains.map((d: string) => (
        <li>{d}</li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Review types</h2>
    <ul>
      {types.map((t: any) => (
        <li>
          <strong>{t.title || t.id}</strong>
          {(t.labels || []).length ? `: ${(t.labels || []).join("; ")}` : ""}
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Impact Requests</h2>
    <p>{f.impact_requests.rule}</p>
    <p class="muted">Example: {f.impact_requests.example_submission}</p>
    <p>AI response fields:</p>
    <ol>
      {impactFields.map((x: string) => (
        <li>{x}</li>
      ))}
    </ol>
    <p class="muted">{f.impact_requests.authority}</p>
  </section>

  <section class="panel">
    <h2>Manuscript tree</h2>
    <p>{f.manuscript_tree.interaction}</p>
    <ol>
      {nodes.map((n: string) => (
        <li>{n}</li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Review artifacts</h2>
    <p>{f.review_artifacts.rule}</p>
    <p>Lifecycle: {lifecycle.join(" → ")}</p>
  </section>

  <section class="panel">
    <h2>Reputation ladder (internal)</h2>
    <ol>
      {ladder.map((x: string) => (
        <li>{x}</li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Scholarly modes</h2>
    <ul>
      {views.map((v: string) => (
        <li>{v}</li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Activation gates (all required)</h2>
    <ul>
      {gates.map((g: string) => (
        <li>{g}</li>
      ))}
    </ul>
    <p class="muted">{f.activation_gates.related_existing_slice.rule}</p>
  </section>

  <section class="panel">
    <h2>Related</h2>
    <p>
      <a href="/systems-intelligence/">Systems Intelligence</a>,{" "}
      <a href="/proof-incubator/">Proof Incubator</a>,{" "}
      <a href="/phase-2-gate/">Phase 2 Gate</a>,{" "}
      <a href="/foundational-axioms/">Foundational Axioms</a>.
    </p>
  </section>
</BoardLayout>
