---
import BoardLayout from "../layouts/BoardLayout.astro";
import { developingDoctrine, claims, baselineStatus } from "../lib/data";
import hc from "../../../../data/project/human_capital_framework.json";

const doctrineIds = ["CC-DEV-038", "CC-DEV-039", "CC-DEV-040", "CC-DEV-041"];
const claimIds = ["CC-CLAIM-042", "CC-CLAIM-043", "CC-CLAIM-044", "CC-CLAIM-045"];
const hcDoctrine = (developingDoctrine.items || []).filter((d: any) =>
  doctrineIds.includes(d.doctrine_id)
);
const hcClaims = (claims.claims || []).filter((c: any) => claimIds.includes(c.claim_id));
const testQs = hc.human_capital_test?.questions || [];
---

<BoardLayout title="Human Capital" path="/human-capital/">
  <h1 class="page-title">Human Capital Doctrine</h1>
  <p class="page-lede">
    Research title: {hc.research_domain_title}. Framework:
    <code>data/project/human_capital_framework.json</code> v{hc.version}.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__label">Doctrine items</div>
      <div class="stat__value">{hcDoctrine.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Human Capital Test</div>
      <div class="stat__value">{testQs.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Name candidates</div>
      <div class="stat__value">{hc.arkansas_academy_model?.name_candidates?.length ?? 0}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Claims</div>
      <div class="stat__value">{hcClaims.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Baseline (all)</div>
      <div class="stat__value" style="font-size:1.1rem;">
        {baselineStatus.sourced_metrics}/{baselineStatus.total_metrics}
      </div>
    </div>
  </div>

  <section class="panel" style="margin-top:1rem;">
    <h2>First principle</h2>
    <p>{hc.first_principle.text}</p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Pilot posture</h2>
    <p>{hc.pilot_posture.rule}</p>
    <p>
      Academy status: <span class="pill">{hc.arkansas_academy_model.status}</span>
    </p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Developing doctrine</h2>
    <ul class="list-plain">
      {
        hcDoctrine.map((d: any) => (
          <li>
            <code>{d.doctrine_id}</code> — {d.statement}{" "}
            <span class="pill">{d.maturity}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Mission (Arkansas design agenda)</h2>
    <p>{hc.arkansas_academy_model.mission}</p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Human Capital Test</h2>
    <ol>
      {testQs.map((q: any) => (
        <li>{q.text}</li>
      ))}
    </ol>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Claims</h2>
    <ul class="list-plain">
      {
        hcClaims.map((c: any) => (
          <li>
            <code>{c.claim_id}</code> — {c.claim_text}{" "}
            <span class="pill">{c.support_level}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Research status</h2>
    <p>
      Phase: {hc.research_status?.phase}. Policy drafting: {hc.research_status?.policy_drafting}.
      Next: {hc.research_status?.next}
    </p>
    <p>Decisions: {(hc.decision_ids || []).join(", ")}</p>
  </section>
</BoardLayout>
