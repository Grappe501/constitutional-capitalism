---
import BoardLayout from "../layouts/BoardLayout.astro";
import { developingDoctrine, claims, baselineStatus } from "../lib/data";
import justice from "../../../../data/project/justice_framework.json";

const justiceIds = [
  "CC-DEV-011",
  "CC-DEV-012",
  "CC-DEV-013",
  "CC-DEV-014",
  "CC-DEV-046",
  "CC-DEV-047",
  "CC-DEV-048",
  "CC-DEV-049",
  "CC-DEV-050",
  "CC-DEV-051",
  "CC-DEV-052",
];
const claimIds = [
  "CC-CLAIM-021",
  "CC-CLAIM-022",
  "CC-CLAIM-023",
  "CC-CLAIM-050",
  "CC-CLAIM-051",
  "CC-CLAIM-052",
  "CC-CLAIM-053",
  "CC-CLAIM-054",
  "CC-CLAIM-055",
  "CC-CLAIM-056",
  "CC-CLAIM-057",
];
const pps = justice.permanent_public_safety_system;
const justiceDoctrine = (developingDoctrine.items || []).filter((d: any) =>
  justiceIds.includes(d.doctrine_id)
);
const justiceClaims = (claims.claims || []).filter((c: any) =>
  claimIds.includes(c.claim_id)
);
const corpsCount = justice.community_safety_corps?.components?.length ?? 0;
const pathCount = justice.decision_pathways?.paths?.length ?? 0;
---

<BoardLayout title="Justice" path="/justice/">
  <h1 class="page-title">{justice.domain_title}</h1>
  <p class="page-lede">
    Complete Community Safety and Restoration System architecture — research before detailed policy.
    Framework: <code>data/project/justice_framework.json</code> v{justice.version}.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__label">Doctrine items</div>
      <div class="stat__value">{justiceDoctrine.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Corps components</div>
      <div class="stat__value">{corpsCount}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Decision paths</div>
      <div class="stat__value">{pathCount}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Justice Test</div>
      <div class="stat__value">{justice.justice_test?.questions?.length ?? 0}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Website branches</div>
      <div class="stat__value">{justice.website_branches?.length ?? 0}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Justice claims</div>
      <div class="stat__value">{justiceClaims.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Baseline (all)</div>
      <div class="stat__value" style="font-size:1.1rem;">
        {baselineStatus.sourced_metrics}/{baselineStatus.total_metrics}
      </div>
    </div>
  </div>

  <section class="panel" style="margin-top:1rem;">
    <h2>Community safety doctrine</h2>
    <p>{justice.community_safety_doctrine?.text}</p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>System objective</h2>
    <p>{justice.system_objective?.text}</p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>System map</h2>
    <ol>
      {(justice.system_map || []).map((s: string) => (
        <li>{s}</li>
      ))}
    </ol>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Public corrections rule</h2>
    <p>{justice.public_corrections_rule?.text}</p>
    <p class="muted">{justice.public_corrections_rule?.federal_policy_instability_note}</p>
  </section>

  {
    pps && (
      <section class="panel" style="margin-top:1rem;">
        <h2>Permanent Public Safety System</h2>
        <p class="muted">Status: {pps.status}</p>
        <p>
          Rejected: “{pps.rejected_language}.” Correct: {pps.correct_language}
        </p>
        <p>{pps.constitutional_capitalism_standard}</p>
        <p>{pps.answer}</p>
        <p class="muted">{pps.narrow_eligibility?.risk_score_rule}</p>
      </section>
    )
  }

  <section class="panel" style="margin-top:1rem;">
    <h2>Developing doctrine</h2>
    <ul class="list-plain">
      {
        justiceDoctrine.map((d: any) => (
          <li>
            <code>{d.doctrine_id}</code> — {d.statement}{" "}
            <span class="pill">{d.maturity}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Claims</h2>
    <ul class="list-plain">
      {
        justiceClaims.map((c: any) => (
          <li>
            <code>{c.claim_id}</code> — {c.public_wording || c.claim_text}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Justice Test</h2>
    <ol>
      {(justice.justice_test?.questions || []).map((q: any) => (
        <li>
          <code>{q.question_id}</code> — {q.text}
        </li>
      ))}
    </ol>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Research status</h2>
    <p>
      Phase: {justice.research_status?.phase}. Policy drafting:{" "}
      {justice.research_status?.policy_drafting}. Next: {justice.research_status?.next}
    </p>
    <p>Legal review and modeling remain 0% until real work occurs.</p>
  </section>
</BoardLayout>
