---
import BoardLayout from "../layouts/BoardLayout.astro";
import EvidencePanel from "../components/EvidencePanel.astro";
import { developingDoctrine } from "../lib/data";
import a from "../../../../data/project/prosperous_aging_framework.json";
import panels from "../../../../data/project/publication_evidence_panels.json";

const doctrineIds = Array.from({ length: 20 }, (_, i) => `CC-DEV-${249 + i}`);
const items = (developingDoctrine.items || []).filter((d: any) =>
  doctrineIds.includes(d.doctrine_id)
);
const testQs = a.prosperous_aging_test?.questions || [];
const baselines = a.sourced_context_baselines?.items || [];
const layers = a.four_retirement_layers?.layers || [];
const covenant = a.retirement_security_covenant?.rules || [];
const ownershipPanel = (panels.panels || []).find(
  (p: { panel_id: string }) => p.panel_id === "CC-EP-OWNERSHIP-RETIREMENT-SYSTEM-1"
);
---

<BoardLayout title="Prosperous Aging" path="/prosperous-aging/">
  <h1 class="page-title">{a.domain_title}</h1>
  <p class="page-lede">
    Framework: <code>data/project/prosperous_aging_framework.json</code> v{a.version}. Principle:{" "}
    <code>{a.principle_id}</code>. Decision: <code>CC-DEC-088</code>. Protect Social Security first;
    build ownership above it.; financing formulas and legal drafting 0%.
  </p>
  {ownershipPanel ? <EvidencePanel panel={ownershipPanel} /> : null}

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__value">{items.length}</div>
      <div class="stat__label">Developing doctrine items</div>
    </div>
    <div class="stat">
      <div class="stat__value">{baselines.length}</div>
      <div class="stat__label">Sourced SSA/GAO/IRS baselines</div>
    </div>
    <div class="stat">
      <div class="stat__value">{layers.length}</div>
      <div class="stat__label">Retirement layers</div>
    </div>
  </div>

  <section class="panel">
    <h2>Vision</h2>
    <blockquote>
      <p>{a.memorable_framing.vision}</p>
    </blockquote>
    <p>{a.memorable_framing.protect_not_replace}</p>
  </section>

  <section class="panel">
    <h2>Sourced context baselines</h2>
    <ul>
      {baselines.map((b: any) => (
        <li>
          <code>{b.id}</code> — {b.text}
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Four retirement layers</h2>
    <ol>
      {layers.map((l: any) => (
        <li>
          <strong>{l.title}</strong> — {l.summary}
        </li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Retirement Security Covenant</h2>
    <ol>
      {covenant.map((r: string) => (
        <li>{r}</li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Prosperous aging test</h2>
    <ol>
      {testQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Developing doctrine ({items.length})</h2>
    <ul>
      {items.map((d: any) => (
        <li>
          <code>{d.doctrine_id}</code> — {d.statement.slice(0, 160)}…
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Related</h2>
    <p>
      Related: <a href="/health/">Health</a>, <a href="/energy-sovereignty/">Energy</a>,{" "}
      <a href="/civic-wealth/">Civic Wealth</a>, <a href="/phase-2-gate/">Phase 2 Gate</a>.
    </p>
  </section>
</BoardLayout>
