---
import BoardLayout from "../layouts/BoardLayout.astro";
import { config, identity } from "../lib/data";
---

<BoardLayout title="Settings" path="/settings/">
  <h1 class="page-title">Settings</h1>
  <p class="page-lede">Read-only project configuration in Phase 0.</p>
  <section class="panel">
    <h2>Project configuration</h2>
    <ul class="list-plain">
      <li>Repository: {config.repository}</li>
      <li>Local root: {config.local_root}</li>
      <li>Package manager: {config.package_manager}</li>
      <li>Apps: {config.apps.join(", ")}</li>
      <li>H-drive only: {String(config.h_drive_only)}</li>
      <li>Database: {String(config.database)}</li>
      <li>Authentication: {String(config.authentication)}</li>
      <li>CMS: {String(config.cms)}</li>
      <li>Identity version: {identity.version}</li>
      <li>Public byline: {identity.public_byline ?? "unset (open decision)"}</li>
    </ul>
  </section>
</BoardLayout>
