---
import BoardLayout from "../layouts/BoardLayout.astro";
import EvidencePanel from "../components/EvidencePanel.astro";
import { developingDoctrine } from "../lib/data";
import f from "../../../../data/project/community_resilience_framework.json";
import panels from "../../../../data/project/publication_evidence_panels.json";

const doctrineIds = Array.from({ length: 20 }, (_, i) => `CC-DEV-${309 + i}`);
const items = (developingDoctrine.items || []).filter((d: any) =>
  doctrineIds.includes(d.doctrine_id)
);
const testQs = f.community_resilience_test?.questions || [];
const baselines = f.sourced_context_baselines?.items || [];
const pillars = f.design_pillars?.pillars || [];
const scorecard = f.community_resilience_scorecard?.indicators || [];
const ruralPanel = (panels.panels || []).find(
  (p: { panel_id: string }) => p.panel_id === "CC-EP-RURAL-LOCAL-CAPITAL-SYSTEM-1"
);
---

<BoardLayout title="Community Resilience" path="/community-resilience/">
  <h1 class="page-title">{f.domain_title}</h1>
  <p class="page-lede">
    Framework: <code>data/project/community_resilience_framework.json</code> v{f.version}.
    Principle: <code>{f.principle_id}</code>. Decision: <code>CC-DEC-091</code>. Safety
    Dividend and reserve formulas require modeling; legal 0%.
  </p>
  {ruralPanel ? <EvidencePanel panel={ruralPanel} /> : null}

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__value">{items.length}</div>
      <div class="stat__label">Developing doctrine items</div>
    </div>
    <div class="stat">
      <div class="stat__value">{baselines.length}</div>
      <div class="stat__label">Sourced baselines</div>
    </div>
    <div class="stat">
      <div class="stat__value">{scorecard.length}</div>
      <div class="stat__label">Scorecard indicators</div>
    </div>
  </div>

  <section class="panel">
    <h2>Compact</h2>
    <blockquote>
      <p>{f.compact_language.text}</p>
    </blockquote>
  </section>

  <section class="panel">
    <h2>Sourced context baselines</h2>
    <ul>
      {baselines.map((b: any) => (
        <li>
          <code>{b.id}</code> — {b.text}
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Ten design pillars</h2>
    <ol>
      {pillars.map((p: any) => (
        <li>
          <strong>{p.title}</strong> — {p.summary}
        </li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Community resilience test</h2>
    <ol>
      {testQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Developing doctrine ({items.length})</h2>
    <ul>
      {items.map((d: any) => (
        <li>
          <code>{d.doctrine_id}</code> — {d.statement.slice(0, 160)}…
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Related</h2>
    <p>
      Related: <a href="/health/">Health</a>,{" "}
      <a href="/community-prosperity/">Community Prosperity</a>,{" "}
      <a href="/constitutional-defense/">Constitutional Defense</a>,{" "}
      <a href="/phase-2-gate/">Phase 2 Gate</a>.
    </p>
  </section>
</BoardLayout>
