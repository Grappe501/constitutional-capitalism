---
import BoardLayout from "../layouts/BoardLayout.astro";
import checklist from "../../../../data/project/phase2_acceptance_checklist.json";
import governance from "../../../../data/project/forensic_audit_governance.json";
import bridge from "../../../../data/project/public_statistics_bridge.json";
import rcip from "../../../../data/project/rcip_civic_data_spine.json";
import { baselineStatus } from "../lib/data";
import snapshot from "../../../../data/metrics/progress_snapshot.json";

const gates = checklist.gate_items || [];
const open = gates.filter((g) => g.required && g.status !== "passed" && g.status !== "complete");
const steps = governance.burt_active_authority?.active_steps || [];
const deferred = governance.burt_active_authority?.deferred_steps;
const domains = checklist.priority_domains || [];
const layers = Object.fromEntries((snapshot.layers || []).map((l: any) => [l.id, l]));
---

<BoardLayout title="Phase 2 Gate" path="/phase-2-gate/">
  <h1 class="page-title">Phase 2 Acceptance Gate</h1>
  <p class="page-lede">
    Governing forensic audit: <em>{governance.central_diagnosis}</em> Objective:{" "}
    {governance.controlling_objective}
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__label">Phase 2</div>
      <div class="stat__value" style="font-size:1.25rem;">{checklist.phase_2_status}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Gate items open</div>
      <div class="stat__value">{open.length}/{gates.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Baseline</div>
      <div class="stat__value" style="font-size:1.1rem;">
        {baselineStatus.sourced_metrics}/{baselineStatus.total_metrics}
      </div>
    </div>
    <div class="stat">
      <div class="stat__label">Overall (regenerated)</div>
      <div class="stat__value">{snapshot.overall_percent ?? 0}%</div>
    </div>
  </div>

  <section class="panel" style="margin-top:1rem;">
    <h2>Canonical operating state</h2>
    <ul class="list-plain">
      <li>Phase 1: {checklist.canonical_operating_state.phase_1}</li>
      <li>Phase 2: {checklist.canonical_operating_state.phase_2}</li>
      <li>
        Forensic audit overall snapshot:{" "}
        {checklist.canonical_operating_state.forensic_audit_overall_snapshot}%
      </li>
      <li>
        Modeling: {layers.economic_modeling?.percent ?? 0}% · Legal:{" "}
        {layers.legal_review?.percent ?? 0}%
      </li>
      <li>Risk: {checklist.canonical_operating_state.current_risk}</li>
    </ul>
    <p class="muted">{checklist.canonical_operating_state.overall_percent_note}</p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Working rule</h2>
    <blockquote>
      <p>{governance.working_rule}</p>
    </blockquote>
    <p class="muted">{checklist.public_display_rule}</p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Completion gate</h2>
    <ul class="list-plain">
      {
        gates.map((g: any) => (
          <li>
            <span class="pill">{g.status}</span> <code>{g.id}</code> — {g.text}
            {g.burt_step ? ` (Burt step ${g.burt_step})` : ""}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Burt active authority — steps 1–13</h2>
    <ol>
      {
        steps.map((s: any) => (
          <li>
            <strong>
              {s.step}. {s.title}
            </strong>{" "}
            — {s.summary}
          </li>
        ))
      }
    </ol>
    <p class="muted">
      Deferred {deferred?.range}: {deferred?.rule} No {deferred?.includes_no?.join("; ")}.
    </p>
    {
      Array.isArray((deferred as any)?.steps) && (deferred as any).steps.length > 0 ? (
        <ol>
          {(deferred as any).steps.map((s: any) => (
            <li>
              <strong>
                {s.step}. {s.title}
              </strong>{" "}
              — {s.summary}
            </li>
          ))}
        </ol>
      ) : null
    }
    <p class="muted">
      Full forensic status:{" "}
      <code>reports/CC_FORENSIC_AUDIT_STATUS_AND_FORWARD_PLAN_2026-08-05.md</code>
    </p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Eight priority domains</h2>
    <ul class="list-plain">
      {
        domains.map((d: any) => (
          <li>
            <strong>{d.title}</strong> — {(d.brief_files || []).join(", ")}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>RCIP — shared civic-data spine</h2>
    <p>
      <strong>{rcip.title}</strong> · <span class="pill">{rcip.status}</span>
    </p>
    <p>{rcip.spine_purpose}</p>
    <p>
      Strongest feature: <strong>{rcip.strongest_feature?.name}</strong> —{" "}
      {rcip.strongest_feature?.rule}
    </p>
    <ol>
      {
        (rcip.four_layers || []).map((l: any) => (
          <li>
            <strong>{l.title}</strong>
          </li>
        ))
      }
    </ol>
    <p class="muted">
      Isolated schemas: {(rcip.isolated_schemas?.schemas || []).join(", ")}. First proof consumer:{" "}
      {rcip.first_external_proof_consumer}.
    </p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Supporting slice — Public Statistics Bridge</h2>
    <p>
      <code>{bridge.slice_id}</code> · status <span class="pill">{bridge.status}</span>
    </p>
    <p>{bridge.governing_rule}</p>
    <p class="muted">
      Public Data Engine:{" "}
      <code>{bridge.public_data_engine?.canonical_workspace || "H:\\SOSWebsite\\RedDirt"}</code>.
      Phase 2 preference: {bridge.phase_2_preference}. Import path: <code>{bridge.import_path}</code>.
      CC asks for named measures — not APIs. Baseline rises only when validated observations are
      mapped — stub exports do not invent beyond live baseline 42/64.
    </p>
    <p class="muted">
      Spine: <code>data/project/rcip_civic_data_spine.json</code> · RCIP:{" "}
      <code>docs/architecture/REDDIRT_CIVIC_INTELLIGENCE_PLATFORM.md</code> · Handoff:{" "}
      <code>docs/handoffs/BURT_PUBLIC_STATISTICS_BRIDGE.md</code>
    </p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Honest outcomes</h2>
    <p>
      <strong>A:</strong> Phase 2 COMPLETE — all acceptance criteria materially satisfied.
    </p>
    <p>
      <strong>B:</strong> Phase 2 PARTIAL — next slice{" "}
      <code>{checklist.if_incomplete.next_slice}</code>
    </p>
  </section>
</BoardLayout>
