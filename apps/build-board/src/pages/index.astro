---
import BoardLayout from "../layouts/BoardLayout.astro";
import ProgressBar from "../components/ProgressBar.astro";
import {
  identity,
  snapshot,
  layers,
  buildState,
  slices,
  deployments,
  decisions,
  risks,
  principles,
  objections,
  terms,
  daysSince,
  sources,
  claims,
  baselineStatus,
} from "../lib/data";

const statusCounts = snapshot.manuscript?.status_counts || {};
const openDecisions = decisions.decisions.filter((d: any) => d.status === "open").slice(0, 5);
const topRisks = risks.risks
  .filter((r: any) => r.severity === "critical" || r.severity === "high")
  .slice(0, 5);
const days = daysSince(snapshot.generated_at || buildState.last_updated);
const activeSlice = slices.slices.find((s: any) => s.slice_id === slices.active_slice);
const phase0 = slices.slices.find((s: any) => s.slice_id === "CC-PHASE-0-MASTER-PROJECT-FOUNDATION-1.0");
const phase1 = slices.slices.find((s: any) => s.slice_id === "CC-PHASE-1-FOUNDATIONAL-DECLARATION-1.0");
const phase2 = slices.slices.find((s: any) => s.slice_id === "CC-PHASE-2-DIAGNOSIS-RESEARCH-FOUNDATION-1.0");
const bookDeploy = deployments.applications.find((a: any) => a.id === "book-site");
const claimsSupported = (claims.claims || []).filter((c: any) =>
  ["supported", "partially_supported"].includes(c.support_level)
).length;
---

<BoardLayout title="Executive Overview" path="/">
  <h1 class="page-title">{identity.title}</h1>
  <p class="page-lede">
    Master Build Board. Source of truth remains structured records in <code>data/</code>.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__label">Overall completion</div>
      <div class="stat__value">{snapshot.overall_percent ?? 0}%</div>
    </div>
    <div class="stat">
      <div class="stat__label">Phase 0</div>
      <div class="stat__value" style="font-size:1.1rem;">{phase0?.status || "—"}</div>
      <div class="stat__note">Accepted at 71cce43</div>
    </div>
    <div class="stat">
      <div class="stat__label">Phase 1</div>
      <div class="stat__value" style="font-size:1.05rem;">{phase1?.status || "accepted"}</div>
      <div class="stat__note">Closed — philosophy ~70%</div>
    </div>
    <div class="stat">
      <div class="stat__label">Phase 2 / active</div>
      <div class="stat__value" style="font-size:1.05rem;">{phase2?.status || activeSlice?.status}</div>
      <div class="stat__note">{activeSlice?.slice_id}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Sources / priority claims done</div>
      <div class="stat__value" style="font-size:1.2rem;">
        {sources.sources?.length ?? 0}/{claimsSupported}
      </div>
      <div class="stat__note">Baseline sourced {baselineStatus.sourced_metrics}/{baselineStatus.total_metrics}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Declaration</div>
      <div class="stat__value" style="font-size:1.1rem;">{snapshot.declaration?.status || "—"}</div>
      <div class="stat__note">{snapshot.declaration?.words ?? 0} words</div>
    </div>
    <div class="stat">
      <div class="stat__label">Principles / objections / terms</div>
      <div class="stat__value" style="font-size:1.2rem;">
        {principles.principles.length}/{objections.objections.length}/{terms.terms.length}
      </div>
    </div>
    <div class="stat">
      <div class="stat__label">Manuscript outlined</div>
      <div class="stat__value">{snapshot.manuscript?.outlined_units ?? statusCounts.outline ?? 0}</div>
      <div class="stat__note">of {snapshot.manuscript?.units ?? 0} units</div>
    </div>
  </div>

  <div class="grid" style="margin-top:1rem; grid-template-columns: 1.2fr 1fr;">
    <section class="panel">
      <h2>Progress layers</h2>
      <div class="progress-list">
        {layers.layers.map((l: any) => <ProgressBar label={l.label} percent={l.percent} />)}
      </div>
    </section>
    <div class="grid">
      <section class="panel">
        <h2>Next recommended action</h2>
        <p>{buildState.next_action}</p>
      </section>
      <section class="panel">
        <h2>Validation / deployment</h2>
        <ul class="list-plain">
          <li>Latest snapshot: {snapshot.generated_at || "not generated"}</li>
          <li>Book site: {bookDeploy?.status || "unknown"}</li>
          <li>Board access: public URL unprotected</li>
          <li>Days since update: {days ?? "—"}</li>
          <li>Research questions: {snapshot.research?.open_questions ?? 0}</li>
          <li>Claims tracked: {snapshot.research?.claims ?? 0}</li>
        </ul>
      </section>
      <section class="panel">
        <h2>Chapters by status</h2>
        <ul class="list-plain">
          {Object.entries(statusCounts).map(([k, v]) => <li>{k}: {v}</li>)}
        </ul>
      </section>
    </div>
  </div>

  <div class="grid grid--stats" style="margin-top:1rem;">
    <section class="panel">
      <h2>Latest open decisions</h2>
      <ul class="list-plain">
        {openDecisions.map((d: any) => <li><span class="pill pill--open">{d.status}</span> {d.title}</li>)}
      </ul>
    </section>
    <section class="panel">
      <h2>Top risks</h2>
      <ul class="list-plain">
        {
          topRisks.map((r: any) => (
            <li>
              <span class="pill pill--risk">{r.severity}</span> {r.title}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BoardLayout>
