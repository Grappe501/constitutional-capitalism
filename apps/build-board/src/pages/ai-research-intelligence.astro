---
import BoardLayout from "../layouts/BoardLayout.astro";
import layer from "../../../../data/project/ai_research_intelligence_layer.json";
import map from "../../../../data/project/ai_research_completion_advancement_map.json";
import registry from "../../../../data/project/ai_research_object_registry.json";

const modes = layer.analyst_modes || [];
const components = layer.components || [];
const counties = registry.designated_counties || [];
const why = map.why_still_at_current_percent || [];
const ladder = map.advancement_ladder || [];
---

<BoardLayout
  title="AI Research Intelligence"
  path="/ai-research-intelligence/"
  description="Constitutional Capitalism Intelligence Engine — research layer. AI proposes; project decides. No client API keys."
>
  <h1 class="page-title">CC Intelligence Engine</h1>
  <p class="page-lede">
    Research layer above the evidence warehouse — <strong>not a chatbot</strong>, and
    <strong>not Phase 9 SIE activation</strong>.
    Pipeline: official data → observations → provenance → AI analysis → human decision.
    Credentials stay server-side only. Overall dial held at {map.current_overall_percent}%.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__label">Slice</div>
      <div class="stat__value" style="font-size:0.85rem;">{layer.slice_id}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Status</div>
      <div class="stat__value" style="font-size:0.85rem;">{layer.status}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Decision</div>
      <div class="stat__value" style="font-size:0.95rem;">{layer.decision_id}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Dial hold</div>
      <div class="stat__value">{map.current_overall_percent}%</div>
    </div>
  </div>

  <section class="panel">
    <h2>Architectural rule</h2>
    <p>
      <code>OPENAI_API_KEY</code> lives only in the server/build environment (local CLI or
      Netlify board Functions). Never in browser JS, git, or public assets.
    </p>
    <p>
      AI may: {(layer.ai_may || []).join(" → ")}. AI must not invent evidence, alter the
      baseline, publish, or raise the dial.
    </p>
    <p>
      Related deferred capstone:
      <a href="/systems-intelligence/">Systems Intelligence (Phase 9)</a>.
      County instrument:
      <a href="/county-living-systems/">County Living Systems</a>.
    </p>
  </section>

  <section class="panel">
    <h2>Completion Advancement Map</h2>
    <p class="muted">{map.dial_rule}</p>
    <h3>Why still at {map.current_overall_percent}%?</h3>
    <ul>
      {why.map((w: any) => (
        <li>
          <strong>{w.id}</strong> — {w.statement}
        </li>
      ))}
    </ul>
    {ladder.map((rung: any) => (
      <div style="margin-top:1.25rem;">
        <h3>
          {rung.label}: {rung.theme}
        </h3>
        <ul>
          {(rung.required_workstreams || []).map((w: any) => (
            <li>
              <strong>{w.title}</strong> — {w.earns_credit_when}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section class="panel">
    <h2>Analyst (propose only)</h2>
    <p class="muted">
      Deterministic modes work without a key. County / comparative / hypothesis stress use
      the Netlify function when <code>OPENAI_API_KEY</code> is configured on the board site.
    </p>
    <form id="ai-form" class="ai-form">
      <label>
        Mode
        <select name="mode" id="ai-mode">
          {modes.map((m: string) => (
            <option value={m} selected={m === "completion_advancement_map"}>
              {m}
            </option>
          ))}
        </select>
      </label>
      <label>
        County FIPS (A)
        <select name="fips_a" id="ai-fips-a">
          {counties.map((c: any) => (
            <option value={c.fips} selected={c.fips === "05145"}>
              {c.name} ({c.fips})
            </option>
          ))}
        </select>
      </label>
      <label>
        County FIPS (B)
        <select name="fips_b" id="ai-fips-b">
          {counties.map((c: any) => (
            <option value={c.fips} selected={c.fips === "05073"}>
              {c.name} ({c.fips})
            </option>
          ))}
        </select>
      </label>
      <label class="ai-form__wide">
        Question (optional)
        <textarea name="question" id="ai-question" rows="3" placeholder="Leave blank for the mode default." />
      </label>
      <div class="ai-form__actions">
        <button type="submit">Run analyst</button>
        <button type="button" id="ai-download" disabled>Download proposal JSON</button>
      </div>
    </form>
    <p id="ai-status" class="muted" aria-live="polite"></p>
    <pre id="ai-out" class="ai-out" hidden></pre>
  </section>

  <section class="panel">
    <h2>Components (1.0)</h2>
    <ol>
      {components.map((c: any) => (
        <li>
          {c.name} — <code>{c.status}</code>
        </li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Local CLI</h2>
    <pre class="ai-out" style="display:block;">{`pnpm ai:research --pack
pnpm ai:research --mode county_living_systems --fips 05145
pnpm ai:research --mode comparative_systems --fips 05145 --fips 05073
pnpm ai:research --mode hypothesis_stress --hyp HYP-128
pnpm ai:research --mode completion_advancement_map`}</pre>
  </section>
</BoardLayout>

<style>
  .muted {
    color: var(--muted, #5c6570);
  }
  .ai-form {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .ai-form label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
  }
  .ai-form__wide {
    grid-column: 1 / -1;
  }
  .ai-form select,
  .ai-form textarea {
    font: inherit;
    padding: 0.45rem 0.55rem;
  }
  .ai-form__actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .ai-form button {
    font: inherit;
    padding: 0.55rem 0.9rem;
    cursor: pointer;
  }
  .ai-out {
    margin-top: 1rem;
    padding: 1rem;
    overflow: auto;
    white-space: pre-wrap;
    font-size: 0.88rem;
    line-height: 1.45;
    background: color-mix(in srgb, Canvas 92%, CanvasText 8%);
    border: 1px solid color-mix(in srgb, CanvasText 18%, transparent);
  }
</style>

<script>
  const form = document.getElementById("ai-form") as HTMLFormElement | null;
  const out = document.getElementById("ai-out");
  const status = document.getElementById("ai-status");
  const downloadBtn = document.getElementById("ai-download") as HTMLButtonElement | null;
  let lastProposal: unknown = null;

  downloadBtn?.addEventListener("click", () => {
    if (!lastProposal) return;
    const blob = new Blob([JSON.stringify(lastProposal, null, 2)], {
      type: "application/json",
    });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = `ai-proposal-${Date.now()}.json`;
    a.click();
    URL.revokeObjectURL(a.href);
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!out || !status) return;
    const mode = (document.getElementById("ai-mode") as HTMLSelectElement).value;
    const fips_a = (document.getElementById("ai-fips-a") as HTMLSelectElement).value;
    const fips_b = (document.getElementById("ai-fips-b") as HTMLSelectElement).value;
    const question = (document.getElementById("ai-question") as HTMLTextAreaElement).value;

    status.textContent = "Running…";
    out.hidden = true;
    if (downloadBtn) downloadBtn.disabled = true;

    // Deterministic map is already on-page; still call function for unified audit shape.
    try {
      const res = await fetch("/.netlify/functions/cc-ai-research", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          mode,
          fips: fips_a,
          fips_a,
          fips_b,
          fips_list: [fips_a, fips_b],
          question: question || undefined,
          hypothesis_id: "HYP-128",
          claim_id: "CC-CLAIM-003",
        }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        throw new Error(data.error || `HTTP ${res.status}`);
      }
      out.textContent = data.markdown || JSON.stringify(data, null, 2);
      out.hidden = false;
      lastProposal = {
        ...data.proposal,
        at: new Date().toISOString(),
        mode: data.mode,
        markdown: data.markdown,
        model: data.model,
        api_key_present: data.api_key_present,
        governance: data.governance,
        human_note:
          "Download and commit only after human review. Does not alter canonical files.",
      };
      if (downloadBtn) downloadBtn.disabled = false;
      status.textContent = data.api_key_present
        ? `OK — ${data.kind} (${data.model || "n/a"}). Proposal only; not published.`
        : `OK — ${data.kind}. Server key not configured; deterministic/stub path used.`;
    } catch (err) {
      // Local `astro preview` has no functions — fall back to static completion map file.
      if (mode === "completion_advancement_map") {
        out.textContent =
          "Function unavailable in plain Astro preview. Completion Advancement Map is shown above on this page. For live analysts: `netlify dev` (board) or `pnpm ai:research`.";
        out.hidden = false;
        status.textContent = "Static fallback — map already rendered above.";
        return;
      }
      status.textContent = `Error: ${(err as Error).message}. Use pnpm ai:research locally, or deploy board with Functions + OPENAI_API_KEY.`;
    }
  });
</script>
