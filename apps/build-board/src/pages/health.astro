---
import BoardLayout from "../layouts/BoardLayout.astro";
import { developingDoctrine } from "../lib/data";
import h from "../../../../data/project/health_human_capacity_framework.json";

const doctrineIds = Array.from({ length: 20 }, (_, i) => `CC-DEV-${229 + i}`);
const items = (developingDoctrine.items || []).filter((d: any) =>
  doctrineIds.includes(d.doctrine_id)
);
const testQs = h.health_system_test?.questions || [];
const baselines = h.problem_diagnosis?.sourced_baselines || [];
const layers = h.five_financial_layers?.layers || [];
---

<BoardLayout title="Health, Human Capacity, and Community Care" path="/health/">
  <h1 class="page-title">{h.domain_title}</h1>
  <p class="page-lede">
    Framework: <code>data/project/health_human_capacity_framework.json</code> v{h.version}.
    Principle: <code>{h.principle_id}</code>. Decision: <code>CC-DEC-087</code>. Major dedicated
    healthcare doctrine.; financing formulas and legal drafting 0%.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__value">{items.length}</div>
      <div class="stat__label">Developing doctrine items</div>
    </div>
    <div class="stat">
      <div class="stat__value">{baselines.length}</div>
      <div class="stat__label">Sourced CMS/HRSA/CDC/ACHI baselines</div>
    </div>
    <div class="stat">
      <div class="stat__value">{layers.length}</div>
      <div class="stat__label">Financial layers</div>
    </div>
  </div>

  <section class="panel">
    <h2>Public promise</h2>
    <blockquote>
      <p>{h.public_promise.text}</p>
    </blockquote>
    <p>{h.guiding_rule.text}</p>
  </section>

  <section class="panel">
    <h2>Sourced context baselines</h2>
    <ul>
      {baselines.map((b: any) => (
        <li>
          <code>{b.id}</code> — {b.text}
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Five financial layers</h2>
    <ol>
      {layers.map((l: any) => (
        <li>
          <strong>{l.title}</strong> — {l.summary}
        </li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Health system test</h2>
    <ol>
      {testQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Developing doctrine ({items.length})</h2>
    <ul>
      {items.map((d: any) => (
        <li>
          <code>{d.doctrine_id}</code> — {d.statement.slice(0, 160)}…
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Related</h2>
    <p>
      Related: <a href="/essential-systems/">Essential Systems</a>,{" "}
      <a href="/human-capital/">Human Capital</a>,{" "}
      <a href="/phase-2-gate/">Phase 2 Gate</a>.
    </p>
  </section>
</BoardLayout>
