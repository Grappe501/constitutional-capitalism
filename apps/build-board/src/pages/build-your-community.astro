---
import BoardLayout from "../layouts/BoardLayout.astro";
import { developingDoctrine, claims, baselineStatus } from "../lib/data";
import cos from "../../../../data/project/community_operating_system_framework.json";

const doctrineIds = ["CC-DEV-042", "CC-DEV-043", "CC-DEV-044", "CC-DEV-045"];
const claimIds = ["CC-CLAIM-046", "CC-CLAIM-047", "CC-CLAIM-048", "CC-CLAIM-049"];
const cosDoctrine = (developingDoctrine.items || []).filter((d: any) =>
  doctrineIds.includes(d.doctrine_id)
);
const cosClaims = (claims.claims || []).filter((c: any) => claimIds.includes(c.claim_id));
const testQs = cos.implementation_completeness_test?.questions || [];
---

<BoardLayout title="Build Your Community" path="/build-your-community/">
  <h1 class="page-title">Build Your Community</h1>
  <p class="page-lede">
    Research title: {cos.research_domain_title}. Framework:
    <code>data/project/community_operating_system_framework.json</code> v{cos.version}.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__label">Doctrine items</div>
      <div class="stat__value">{cosDoctrine.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Architecture layers</div>
      <div class="stat__value">{cos.seven_layer_architecture?.layers?.length ?? 0}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Completeness Test</div>
      <div class="stat__value">{testQs.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Claims</div>
      <div class="stat__value">{cosClaims.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Baseline (all)</div>
      <div class="stat__value" style="font-size:1.1rem;">
        {baselineStatus.sourced_metrics}/{baselineStatus.total_metrics}
      </div>
    </div>
  </div>

  <section class="panel" style="margin-top:1rem;">
    <h2>Signature</h2>
    <p>{cos.signature_of_movement.text}</p>
    <p>
      <strong>Practical question:</strong> {cos.signature_of_movement.practical_question}
    </p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Implementation Completeness Rule</h2>
    <p>{cos.implementation_completeness_rule.text}</p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Developing doctrine</h2>
    <ul class="list-plain">
      {
        cosDoctrine.map((d: any) => (
          <li>
            <code>{d.doctrine_id}</code> — {d.statement}{" "}
            <span class="pill">{d.maturity}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Seven layers</h2>
    <ol>
      {(cos.seven_layer_architecture?.layers || []).map((l: any) => (
        <li>
          {l.name} — {l.purpose}
        </li>
      ))}
    </ol>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Implementation Completeness Test</h2>
    <ol>
      {testQs.map((q: any) => (
        <li>{q.text}</li>
      ))}
    </ol>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Claims</h2>
    <ul class="list-plain">
      {
        cosClaims.map((c: any) => (
          <li>
            <code>{c.claim_id}</code> — {c.claim_text}{" "}
            <span class="pill">{c.support_level}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Research status</h2>
    <p>
      Phase: {cos.research_status?.phase}. Next: {cos.research_status?.next}
    </p>
    <p>Decisions: {(cos.decision_ids || []).join(", ")}</p>
  </section>
</BoardLayout>
