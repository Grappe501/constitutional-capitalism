---
import BoardLayout from "../layouts/BoardLayout.astro";
import ProgressBar from "../components/ProgressBar.astro";
import { articles } from "../lib/data";
---

<BoardLayout title="Constitution" path="/constitution/">
  <h1 class="page-title">Economic Constitution</h1>
  <p class="page-lede">
    Emerging Articles of Constitutional Capitalism. Preamble status: {articles.preamble_status}.
    Not ratified doctrine.
  </p>
  <div class="grid">
    {
      articles.articles.map((a) => (
        <section class="panel">
          <h2>
            Article {a.roman}: {a.title}
          </h2>
          <p><span class="pill">{a.status}</span> <code>{a.article_id}</code></p>
          <ProgressBar label={`Article ${a.roman}`} percent={a.maturity_percent} />
          <p style="color:var(--muted);">
            Related chapters: {(a.related_chapter_ids || []).join(", ") || "—"}
          </p>
        </section>
      ))
    }
  </div>
</BoardLayout>
