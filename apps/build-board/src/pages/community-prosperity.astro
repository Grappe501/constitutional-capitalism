---
import BoardLayout from "../layouts/BoardLayout.astro";
import EvidencePanel from "../components/EvidencePanel.astro";
import { developingDoctrine } from "../lib/data";
import f from "../../../../data/project/community_prosperity_framework.json";
import panels from "../../../../data/project/publication_evidence_panels.json";

const doctrineIds = Array.from({ length: 20 }, (_, i) => `CC-DEV-${289 + i}`);
const items = (developingDoctrine.items || []).filter((d: any) =>
  doctrineIds.includes(d.doctrine_id)
);
const testQs = f.community_prosperity_test?.questions || [];
const baselines = f.sourced_context_baselines?.items || [];
const pillars = f.design_pillars?.pillars || [];
const safeguards = f.safeguards?.rules || [];
const ruralPanel = (panels.panels || []).find(
  (p: { panel_id: string }) => p.panel_id === "CC-EP-RURAL-LOCAL-CAPITAL-SYSTEM-1"
);
---

<BoardLayout title="Community Prosperity" path="/community-prosperity/">
  <h1 class="page-title">{f.domain_title}</h1>
  <p class="page-lede">
    Framework: <code>data/project/community_prosperity_framework.json</code> v{f.version}.
    Principle: <code>{f.principle_id}</code>. Decision: <code>CC-DEC-090</code>. Elaborates
    Prosperous Aging Layer 3; links Civic Wealth. Local allocation bands require modeling; legal 0%.
  </p>
  {ruralPanel ? <EvidencePanel panel={ruralPanel} /> : null}

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__value">{items.length}</div>
      <div class="stat__label">Developing doctrine items</div>
    </div>
    <div class="stat">
      <div class="stat__value">{baselines.length}</div>
      <div class="stat__label">Sourced baselines</div>
    </div>
    <div class="stat">
      <div class="stat__value">{safeguards.length}</div>
      <div class="stat__label">Fiduciary safeguards</div>
    </div>
  </div>

  <section class="panel">
    <h2>Core question</h2>
    <blockquote>
      <p>{f.core_question.text}</p>
    </blockquote>
  </section>

  <section class="panel">
    <h2>Sourced context baselines</h2>
    <ul>
      {baselines.map((b: any) => (
        <li>
          <code>{b.id}</code> — {b.text}
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Ten design pillars</h2>
    <ol>
      {pillars.map((p: any) => (
        <li>
          <strong>{p.title}</strong> — {p.summary}
        </li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Safeguards</h2>
    <ul>
      {safeguards.map((r: any) => (
        <li>
          <code>{r.id}</code> — {r.text}
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Community prosperity test</h2>
    <ol>
      {testQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Developing doctrine ({items.length})</h2>
    <ul>
      {items.map((d: any) => (
        <li>
          <code>{d.doctrine_id}</code> — {d.statement.slice(0, 160)}…
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Related</h2>
    <p>
      Related: <a href="/prosperous-aging/">Prosperous Aging</a>,{" "}
      <a href="/civic-wealth/">Civic Wealth</a>, <a href="/phase-2-gate/">Phase 2 Gate</a>.
    </p>
  </section>
</BoardLayout>
