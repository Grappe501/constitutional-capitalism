---
import BoardLayout from "../layouts/BoardLayout.astro";
import EvidencePanel from "../components/EvidencePanel.astro";
import { developingDoctrine, claims, sources, baselineStatus } from "../lib/data";
import democracy from "../../../../data/project/democracy_framework.json";
import panels from "../../../../data/project/publication_evidence_panels.json";

const demDoctrine = (developingDoctrine.items || []).filter((d: any) =>
  ["CC-DEV-015", "CC-DEV-016", "CC-DEV-017", "CC-DEV-018", "CC-DEV-019"].includes(d.doctrine_id)
);
const demClaims = (claims.claims || []).filter((c: any) =>
  ["CC-CLAIM-024", "CC-CLAIM-025", "CC-CLAIM-026", "CC-CLAIM-134", "CC-CLAIM-003"].includes(c.claim_id)
);
const demSources = (sources.sources || []).filter((s: any) =>
  ["CC-SRC-014", "CC-SRC-015", "CC-SRC-016", "CC-SRC-257", "CC-SRC-265", "CC-SRC-266", "CC-SRC-267"].includes(
    s.source_id
  )
);
const politicalMoneyPanel = (panels.panels || []).find(
  (p: { panel_id: string }) => p.panel_id === "CC-EP-DEMOCRACY-POLITICAL-MONEY-1"
);
const trustPanel = (panels.panels || []).find(
  (p: { panel_id: string }) => p.panel_id === "CC-EP-TRUST-AND-BASELINE-DIAL-1"
);
---

<BoardLayout title="Democracy" path="/democracy/">
  <h1 class="page-title">Democracy, Representation, and Distributed Government</h1>
  <p class="page-lede">
    Second constitutional spine. Framework:
    <code>data/project/democracy_framework.json</code>.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__label">Doctrine items</div>
      <div class="stat__value">{demDoctrine.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Design pillars</div>
      <div class="stat__value">{democracy.pillars?.length ?? 0}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Democracy Test</div>
      <div class="stat__value">{democracy.democracy_test?.questions?.length ?? 0}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Bill Test</div>
      <div class="stat__value">{democracy.bill_transparency_test?.questions?.length ?? 0}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Seeded sources</div>
      <div class="stat__value">{demSources.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Baseline (all)</div>
      <div class="stat__value" style="font-size:1.1rem;">
        {baselineStatus.sourced_metrics}/{baselineStatus.total_metrics}
      </div>
    </div>
  </div>

  <section class="panel" style="margin-top:1rem;">
    <h2>Foundational principle</h2>
    <p>{democracy.foundational_principle.text}</p>
  </section>
  {trustPanel ? <EvidencePanel panel={trustPanel} /> : null}

  {
    politicalMoneyPanel ? (
      <section class="panel" style="margin-top:1rem;">
        <h2>Evidence Panel · {politicalMoneyPanel.panel_id}</h2>
        <p>
          <strong>Reader question:</strong> {politicalMoneyPanel.reader_question}
        </p>
        <p>{politicalMoneyPanel.what_the_data_show.key_finding}</p>
        <ul>
          {politicalMoneyPanel.what_the_data_show.critical_numbers.map((n: any) => (
            <li>
              <strong>{n.value}</strong> — {n.label}
              {n.metric_id || n.source_id ? (
                <>
                  {" "}
                  (<code>{n.metric_id || n.source_id}</code>)
                </>
              ) : null}
            </li>
          ))}
        </ul>
        <p>{politicalMoneyPanel.what_the_data_show.plain_english}</p>
        <p>
          Evidence strength: <strong>{politicalMoneyPanel.evidence_strength}</strong> —{" "}
          {politicalMoneyPanel.strength_note}
        </p>
        <details>
          <summary>Explore the data</summary>
          <p>
            <strong>Supports:</strong> {politicalMoneyPanel.what_supports_this.join(" · ")}
          </p>
          <p>
            <strong>Challenges:</strong> {politicalMoneyPanel.what_challenges_it.join(" · ")}
          </p>
          <p>
            <strong>Don’t know:</strong> {politicalMoneyPanel.what_we_dont_know.join(" · ")}
          </p>
          <p class="muted">
            Last updated: {politicalMoneyPanel.last_updated.date} ·{" "}
            {politicalMoneyPanel.last_updated.dataset_or_release}
          </p>
        </details>
      </section>
    ) : null
  }

  <section class="panel" style="margin-top:1rem;">
    <h2>Developing doctrine</h2>
    <ul class="list-plain">
      {
        demDoctrine.map((d: any) => (
          <li>
            <code>{d.doctrine_id}</code> — {d.statement}{" "}
            <span class="pill">{d.maturity}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Claims</h2>
    <ul class="list-plain">
      {
        demClaims.map((c: any) => (
          <li>
            <code>{c.claim_id}</code> — {c.claim_text}{" "}
            <span class="pill">{c.support_level}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Seeded sources</h2>
    <ul class="list-plain">
      {
        demSources.map((s: any) => (
          <li>
            <code>{s.source_id}</code> — {s.title}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Research status</h2>
    <p>
      Phase: {democracy.research_status?.phase}. Policy drafting:{" "}
      {democracy.research_status?.policy_drafting}. Next: {democracy.research_status?.next}
    </p>
  </section>
</BoardLayout>
