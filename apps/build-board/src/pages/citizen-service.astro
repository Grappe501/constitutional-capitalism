---
import BoardLayout from "../layouts/BoardLayout.astro";
import { developingDoctrine } from "../lib/data";
import cps from "../../../../data/project/citizen_public_service_framework.json";

const doctrineIds = Array.from({ length: 34 }, (_, i) => `CC-DEV-${142 + i}`);
const items = (developingDoctrine.items || []).filter((d: any) =>
  doctrineIds.includes(d.doctrine_id)
);
const testQs = cps.citizen_public_service_test?.questions || [];
const rejects = cps.earned_vs_privilege_distinction?.rejects || [];
const reforms = cps.citizen_service_reforms || [];
const principles = (cps.principle_ids || []).join(", ");
const decisions = (cps.decision_ids || []).join(", ");
---

<BoardLayout title="Citizen Service" path="/citizen-service/">
  <h1 class="page-title">{cps.domain_title}</h1>
  <p class="page-lede">
    Framework: <code>data/project/citizen_public_service_framework.json</code> v{cps.version}.
    Principles: <code>{principles}</code>. Decisions: <code>{decisions}</code>. Complements
    modernization public-service spine.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__value">{items.length}</div>
      <div class="stat__label">Developing doctrine items</div>
    </div>
    <div class="stat">
      <div class="stat__value">{reforms.length}</div>
      <div class="stat__label">Citizen-service reforms</div>
    </div>
    <div class="stat">
      <div class="stat__value">{(cps.website_branches || []).length}</div>
      <div class="stat__label">Website branches</div>
    </div>
  </div>

  <section class="panel">
    <h2>Operational principle</h2>
    <blockquote>
      <p>{cps.operational_principle.text}</p>
    </blockquote>
    <p>{cps.accessibility_doctrine.text}</p>
  </section>

  <section class="panel">
    <h2>Central theme</h2>
    <p>{cps.central_theme}</p>
    <blockquote>
      <p>{cps.governing_principle.text}</p>
    </blockquote>
    <blockquote>
      <p>{cps.constitutional_principle.text}</p>
    </blockquote>
  </section>

  <section class="panel">
    <h2>Leadership vs administration</h2>
    <ul>
      <li>
        <strong>Temporary democratic leadership:</strong>{" "}
        {cps.leadership_vs_administration.separate.temporary_democratic_leadership}
      </li>
      <li>
        <strong>Professional public administration:</strong>{" "}
        {cps.leadership_vs_administration.separate.professional_public_administration}
      </li>
    </ul>
  </section>

  <section class="panel">
    <h2>Eighteen reforms</h2>
    <ol>
      {reforms.map((r: any) => (
        <li>
          <code>{r.id}</code> — {r.title}
        </li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Critical distinction</h2>
    <p>{cps.earned_vs_privilege_distinction.framing}</p>
    <p>
      <strong>Same rules:</strong> {cps.earned_vs_privilege_distinction.same_rules}
    </p>
    <ul>
      {rejects.map((r: string) => (
        <li>{r}</li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Citizen Public Service Commission</h2>
    <p>{cps.citizen_public_service_commission.summary}</p>
  </section>

  <section class="panel">
    <h2>Citizen public service test</h2>
    <ol>
      {testQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>
  </section>

  <section class="panel">
    <h2>Developing doctrine ({items.length})</h2>
    <ul>
      {items.map((d: any) => (
        <li>
          <code>{d.doctrine_id}</code> — {d.statement.slice(0, 160)}…
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <h2>Related</h2>
    <p>
      <a href="/public-service/">Public Service</a>,{" "}
      <a href="/peoples-branch/">People’s Branch</a>, <a href="/phase-2-gate/">Phase 2 Gate</a>.
    </p>
  </section>
</BoardLayout>
