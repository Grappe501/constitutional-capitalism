---
import BoardLayout from "../layouts/BoardLayout.astro";
import { developingDoctrine, claims, baselineStatus } from "../lib/data";
import ess from "../../../../data/project/essential_systems_framework.json";

const doctrineIds = [
  "CC-DEV-033",
  "CC-DEV-034",
  "CC-DEV-035",
  "CC-DEV-036",
  "CC-DEV-037"
];
const claimIds = ["CC-CLAIM-038", "CC-CLAIM-039", "CC-CLAIM-040", "CC-CLAIM-041"];
const essDoctrine = (developingDoctrine.items || []).filter((d: any) =>
  doctrineIds.includes(d.doctrine_id)
);
const essClaims = (claims.claims || []).filter((c: any) => claimIds.includes(c.claim_id));
const testQs = ess.essential_systems_test?.questions || [];
---

<BoardLayout title="Essential Systems" path="/essential-systems/">
  <h1 class="page-title">Essential Systems</h1>
  <p class="page-lede">
    Research title: {ess.research_domain_title}. Framework:
    <code>data/project/essential_systems_framework.json</code> v{ess.version}.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__label">Doctrine items</div>
      <div class="stat__value">{essDoctrine.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Systems</div>
      <div class="stat__value">{ess.systems?.length ?? 0}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Essential Test</div>
      <div class="stat__value">{testQs.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Claims</div>
      <div class="stat__value">{essClaims.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Baseline (all)</div>
      <div class="stat__value" style="font-size:1.1rem;">
        {baselineStatus.sourced_metrics}/{baselineStatus.total_metrics}
      </div>
    </div>
  </div>

  <section class="panel" style="margin-top:1rem;">
    <h2>Constitutional question</h2>
    <p>{ess.constitutional_question.text}</p>
    
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Systems</h2>
    <ul class="list-plain">
      {
        (ess.systems || []).map((s: any) => (
          <li>
            <strong>{s.title}</strong> — {s.purpose}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Developing doctrine</h2>
    <ul class="list-plain">
      {
        essDoctrine.map((d: any) => (
          <li>
            <code>{d.doctrine_id}</code> — {d.statement}{" "}
            <span class="pill">{d.maturity}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Community Health Index</h2>
    <p>
      <strong>{ess.community_health_index.name}</strong> — {ess.community_health_index.summary}
    </p>
    
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Essential Systems Test</h2>
    <ol>
      {testQs.map((q: any) => (
        <li>{q.text}</li>
      ))}
    </ol>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Claims</h2>
    <ul class="list-plain">
      {
        essClaims.map((c: any) => (
          <li>
            <code>{c.claim_id}</code> — {c.claim_text}{" "}
            <span class="pill">{c.support_level}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Research status</h2>
    <p>
      Phase: {ess.research_status?.phase}. Policy drafting: {ess.research_status?.policy_drafting}.
      Next: {ess.research_status?.next}
    </p>
    <p>Decisions: {(ess.decision_ids || []).join(", ")}</p>
  </section>
</BoardLayout>
