---
import BoardLayout from "../layouts/BoardLayout.astro";
import ProgressBar from "../components/ProgressBar.astro";
import { pillars, proposals } from "../lib/data";
---

<BoardLayout title="Policy" path="/policy/">
  <h1 class="page-title">Policy development</h1>
  <p class="page-lede">Pillars and seed proposals. Maturity remains low until modeling and review.</p>

  <section class="panel">
    <h2>Policy pillars</h2>
    <div class="progress-list">
      {
        pillars.pillars.map((p) => (
          <ProgressBar label={`${p.id} — ${p.title}`} percent={p.maturity_percent} />
        ))
      }
    </div>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Proposals</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Research</th>
            <th>Recommendation</th>
            <th>Maturity</th>
          </tr>
        </thead>
        <tbody>
          {
            proposals.proposals.map((p) => (
              <tr>
                <td>{p.proposal_id}</td>
                <td>
                  <strong>{p.title}</strong>
                  <div style="color:var(--muted);">{p.description}</div>
                </td>
                <td>{p.research_status}</td>
                <td>{p.current_recommendation}</td>
                <td>
                  <ProgressBar label={p.title} percent={p.maturity_percentage} />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</BoardLayout>
