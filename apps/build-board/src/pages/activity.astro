---
import BoardLayout from "../layouts/BoardLayout.astro";
import { buildHistory, cursorReturn, buildState } from "../lib/data";
---

<BoardLayout title="Activity" path="/activity/">
  <h1 class="page-title">Activity</h1>
  <p class="page-lede">Build history and latest Cursor return metadata.</p>

  <section class="panel">
    <h2>Latest Cursor return</h2>
    <ul class="list-plain">
      <li>Mission: <code>{cursorReturn.mission_id}</code></li>
      <li>Status: {cursorReturn.status}</li>
      <li>Updated: {cursorReturn.updated_at}</li>
      <li>Summary: {cursorReturn.summary}</li>
      <li>Current build state: {buildState.status} / {buildState.phase}</li>
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Build history</h2>
    {
      buildHistory.builds.length === 0 ? (
        <p style="color:var(--muted);">No completed build-history entries yet.</p>
      ) : (
        <ul class="list-plain">
          {buildHistory.builds.map((b: any) => (
            <li>
              {b.at || b.date}: {b.summary || JSON.stringify(b)}
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BoardLayout>
