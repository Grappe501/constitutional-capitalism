---
import BoardLayout from "../layouts/BoardLayout.astro";
import { claims, sources } from "../lib/data";

const list = claims.claims || [];
const withSources = list.filter((c: any) => (c.source_ids || []).length > 0);
const supportedish = list.filter((c: any) =>
  ["supported", "partially_supported"].includes(c.support_level)
);
---

<BoardLayout title="Evidence" path="/evidence/">
  <h1 class="page-title">Evidence Companion monitor</h1>
  <p class="page-lede">
    Claim ledger + source registry. Legal review and modeling remain 0% unless real work occurs.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__label">Verified sources</div>
      <div class="stat__value">{sources.sources?.length ?? 0}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Claims</div>
      <div class="stat__value">{list.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Claims with sources</div>
      <div class="stat__value">{withSources.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Supported / partial</div>
      <div class="stat__value">{supportedish.length}</div>
    </div>
  </div>

  <section class="panel" style="margin-top:1rem;">
    <h2>Claims</h2>
    <ul class="list-plain">
      {
        list.map((c: any) => (
          <li>
            <code>{c.claim_id}</code> — {c.claim_text}{" "}
            <span class="pill">{c.support_level}</span>
            {(c.source_ids || []).length ? ` · ${c.source_ids.join(", ")}` : " · no sources"}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Sources</h2>
    <ul class="list-plain">
      {
        (sources.sources || []).map((s: any) => (
          <li>
            <code>{s.source_id}</code> — {s.title} ({s.year}) · {s.verification_status}
          </li>
        ))
      }
    </ul>
  </section>
</BoardLayout>
