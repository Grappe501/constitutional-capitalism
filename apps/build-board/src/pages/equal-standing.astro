---
import BoardLayout from "../layouts/BoardLayout.astro";
import { developingDoctrine, claims, baselineStatus } from "../lib/data";
import eq from "../../../../data/project/equal_standing_framework.json";

const doctrineIds = [
  "CC-DEV-062",
  "CC-DEV-063",
  "CC-DEV-064",
  "CC-DEV-065",
  "CC-DEV-066",
  "CC-DEV-067",
];
const claimIds = [
  "CC-CLAIM-069",
  "CC-CLAIM-070",
  "CC-CLAIM-071",
  "CC-CLAIM-072",
  "CC-CLAIM-073",
  "CC-CLAIM-074",
];
const eqDoctrine = (developingDoctrine.items || []).filter((d: any) =>
  doctrineIds.includes(d.doctrine_id)
);
const eqClaims = (claims.claims || []).filter((c: any) => claimIds.includes(c.claim_id));
const testQs = eq.equal_standing_test?.questions || [];
---

<BoardLayout title="Equal Standing" path="/equal-standing/">
  <h1 class="page-title">{eq.domain_title}</h1>
  <p class="page-lede">
    Research title: {eq.research_domain_title}. Framework:
    <code>data/project/equal_standing_framework.json</code> v{eq.version}. Principle:{" "}
    <code>{eq.principle_id}</code>.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__label">Doctrine items</div>
      <div class="stat__value">{eqDoctrine.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Equal Standing Test</div>
      <div class="stat__value">{testQs.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Website branches</div>
      <div class="stat__value">{eq.website_branches?.length ?? 0}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Claims</div>
      <div class="stat__value">{eqClaims.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Baseline (all)</div>
      <div class="stat__value" style="font-size:1.1rem;">
        {baselineStatus.sourced_metrics}/{baselineStatus.total_metrics}
      </div>
    </div>
  </div>

  <section class="panel" style="margin-top:1rem;">
    <h2>Foundational principle</h2>
    <p>{eq.foundational_principle.text}</p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Blind Stage Principle</h2>
    <p>{eq.blind_stage_principle.text}</p>
    <p>
      <strong>{eq.blind_stage_principle.iconic_phrase}</strong>
    </p>
    <p class="muted">{eq.blind_stage_principle.iconic_phrase_caveat}</p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Relevant distinctions</h2>
    <p>{eq.relevant_distinctions_rule.text}</p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Developing doctrine</h2>
    <ul class="list-plain">
      {
        eqDoctrine.map((d: any) => (
          <li>
            <code>{d.doctrine_id}</code> — {d.statement}{" "}
            <span class="pill">{d.maturity}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Equal Standing Test</h2>
    <ol>
      {testQs.map((q: any) => (
        <li>{q.text}</li>
      ))}
    </ol>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Claims</h2>
    <ul class="list-plain">
      {
        eqClaims.map((c: any) => (
          <li>
            <code>{c.claim_id}</code> — {c.public_wording || c.claim_text}{" "}
            <span class="pill">{c.support_level}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Research status</h2>
    <p>
      Phase: {eq.research_status?.phase}. Policy drafting: {eq.research_status?.policy_drafting}.
      Next: {eq.research_status?.next}
    </p>
    <p class="muted">{eq.research_status?.baseline_note}</p>
  </section>
</BoardLayout>
