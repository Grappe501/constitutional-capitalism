---
import BoardLayout from "../layouts/BoardLayout.astro";
import { developingDoctrine, claims, baselineStatus } from "../lib/data";
import fam from "../../../../data/project/family_framework.json";

const doctrineIds = [
  "CC-DEV-078",
  "CC-DEV-079",
  "CC-DEV-080",
  "CC-DEV-081",
  "CC-DEV-082",
  "CC-DEV-083",
  "CC-DEV-084",
];
const claimIds = [
  "CC-CLAIM-085",
  "CC-CLAIM-086",
  "CC-CLAIM-087",
  "CC-CLAIM-088",
  "CC-CLAIM-089",
  "CC-CLAIM-090",
];
const famDoctrine = (developingDoctrine.items || []).filter((d: any) =>
  doctrineIds.includes(d.doctrine_id)
);
const famClaims = (claims.claims || []).filter((c: any) => claimIds.includes(c.claim_id));
const testQs = fam.family_test?.questions || [];
---

<BoardLayout title="Family" path="/family/">
  <h1 class="page-title">{fam.domain_title}</h1>
  <p class="page-lede">
    Framework: <code>data/project/family_framework.json</code> v{fam.version}. Principle:{" "}
    <code>{fam.principle_id}</code>.
  </p>

  <div class="grid grid--stats">
    <div class="stat">
      <div class="stat__label">Doctrine items</div>
      <div class="stat__value">{famDoctrine.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Family Test</div>
      <div class="stat__value">{testQs.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Claims</div>
      <div class="stat__value">{famClaims.length}</div>
    </div>
    <div class="stat">
      <div class="stat__label">Baseline (all)</div>
      <div class="stat__value" style="font-size:1.1rem;">
        {baselineStatus.sourced_metrics}/{baselineStatus.total_metrics}
      </div>
    </div>
  </div>

  <section class="panel" style="margin-top:1rem;">
    <h2>Organizing principle</h2>
    <p>{fam.organizing_principle.text}</p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Dignity-safe shared responsibility</h2>
    <p>{fam.shared_responsibility_rule.text}</p>
    <p class="muted">Rejected: {fam.shared_responsibility_rule.rejected_phrasing}</p>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Developing doctrine</h2>
    <ul class="list-plain">
      {
        famDoctrine.map((d: any) => (
          <li>
            <code>{d.doctrine_id}</code> — {d.statement}{" "}
            <span class="pill">{d.maturity}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Constitutional Family Test</h2>
    <ol>
      {testQs.map((q: any) => (
        <li>{q.text}</li>
      ))}
    </ol>
  </section>

  <section class="panel" style="margin-top:1rem;">
    <h2>Claims</h2>
    <ul class="list-plain">
      {
        famClaims.map((c: any) => (
          <li>
            <code>{c.claim_id}</code> — {c.public_wording || c.claim_text}{" "}
            <span class="pill">{c.support_level}</span>
          </li>
        ))
      }
    </ul>
  </section>
</BoardLayout>
