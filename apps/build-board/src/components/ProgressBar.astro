---
interface Props {
  label: string;
  percent: number;
}
const { label, percent } = Astro.props;
const safe = Math.max(0, Math.min(100, percent));
---

<div class="progress-row">
  <div class="progress-row__meta">
    <span>{label}</span>
    <span aria-hidden="true">{safe}%</span>
  </div>
  <div
    class="bar"
    role="progressbar"
    aria-label={`${label} progress`}
    aria-valuemin={0}
    aria-valuemax={100}
    aria-valuenow={safe}
  >
    <span style={`width:${safe}%`}></span>
  </div>
</div>
