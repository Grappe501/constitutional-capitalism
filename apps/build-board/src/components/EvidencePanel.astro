---
/**
 * CC-DEC-104 Evidence Panel — progressive disclosure interim component.
 * Prefer evidence_system (definition + comparison + series + history + geography + missing layers)
 * over isolated headlines.
 */
type CriticalNumber = {
  label: string;
  value: string;
  period?: string;
  geography?: string;
  metric_id?: string;
  source_id?: string;
  note?: string;
};

type ComparisonRow = {
  label: string;
  value: string;
  note?: string;
};

type HistoryPoint = {
  period: string;
  value: string;
  label?: string;
  geography?: string;
  note?: string;
  source_id?: string;
};

type SeriesPointBlock = {
  series_id?: string;
  label: string;
  source?: string;
  point_count?: number;
  coverage?: string;
  definition_note?: string;
  points: HistoryPoint[];
};

type EvidenceSystem = {
  definition?: string;
  comparison?: ComparisonRow[];
  observation_history?: HistoryPoint[];
  geography_contrast?: ComparisonRow[];
  series_points?: SeriesPointBlock[];
  missing_layers?: string[];
  series_note?: string;
  series_status?: string;
  qualification?: string;
  reader_stack?: string;
};

type Panel = {
  panel_id: string;
  title: string;
  reader_question: string;
  evidence_strength: string;
  strength_note?: string;
  evidence_system?: EvidenceSystem;
  what_the_data_show: {
    key_finding: string;
    critical_numbers: CriticalNumber[];
    plain_english: string;
  };
  what_supports_this: string[];
  what_challenges_it: string[];
  what_we_dont_know: string[];
  last_updated: { date: string; dataset_or_release: string };
  explore?: {
    methodology?: string;
    import_package?: string;
    mapping?: string;
    related_claims?: string[];
    related_public_reasoning?: string[];
  };
  source_ids?: string[];
  metric_ids?: string[];
};

interface Props {
  panel: Panel;
}

const { panel } = Astro.props;
const nums = panel.what_the_data_show.critical_numbers || [];
const sys = panel.evidence_system;
---

<section class="evidence-panel" aria-labelledby={`${panel.panel_id}-title`}>
  <header class="evidence-panel__header">
    <p class="evidence-panel__eyebrow">Evidence Panel · {panel.panel_id}</p>
    <h2 id={`${panel.panel_id}-title`}>{panel.title}</h2>
    <p class="evidence-panel__question">
      <span class="evidence-panel__q-label">Reader question</span>
      {panel.reader_question}
    </p>
  </header>

  {
    sys ? (
      <div class="evidence-panel__system">
        <h3>Evidence system</h3>
        {sys.reader_stack ? (
          <p>
            <span class="evidence-panel__sys-label">Reader stack</span>
            {sys.reader_stack}
          </p>
        ) : null}
        {sys.definition ? (
          <p>
            <span class="evidence-panel__sys-label">Definition</span>
            {sys.definition}
          </p>
        ) : null}
        {sys.comparison?.length ? (
          <>
            <p class="evidence-panel__sys-label">Comparison</p>
            <ul class="evidence-panel__comparison">
              {sys.comparison.map((row) => (
                <li>
                  <strong>{row.value}</strong> — {row.label}
                  {row.note ? <span class="evidence-panel__note"> {row.note}</span> : null}
                </li>
              ))}
            </ul>
          </>
        ) : null}
        {sys.observation_history?.length ? (
          <>
            <p class="evidence-panel__sys-label">Historical observations</p>
            <ul class="evidence-panel__history">
              {sys.observation_history.map((pt) => (
                <li>
                  <strong>{pt.value}</strong>
                  <span class="evidence-panel__meta">
                    {" "}
                    · {[pt.period, pt.geography, pt.label, pt.source_id].filter(Boolean).join(" · ")}
                  </span>
                  {pt.note ? <span class="evidence-panel__note"> {pt.note}</span> : null}
                </li>
              ))}
            </ul>
          </>
        ) : null}
        {sys.series_points?.length ? (
          <>
            <p class="evidence-panel__sys-label">Attached series points</p>
            {sys.series_points.map((block) => (
              <div class="evidence-panel__series-block">
                <p>
                  <strong>{block.label}</strong>
                  <span class="evidence-panel__meta">
                    {" "}
                    · {[block.coverage, block.point_count != null ? `${block.point_count} points` : null, block.source]
                      .filter(Boolean)
                      .join(" · ")}
                  </span>
                </p>
                {block.definition_note ? (
                  <p class="evidence-panel__note">{block.definition_note}</p>
                ) : null}
                <ul class="evidence-panel__history">
                  {block.points.map((pt) => (
                    <li>
                      <strong>{pt.value}</strong>
                      <span class="evidence-panel__meta">
                        {" "}
                        · {[pt.period, pt.geography, pt.note].filter(Boolean).join(" · ")}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </>
        ) : null}
        {sys.geography_contrast?.length ? (
          <>
            <p class="evidence-panel__sys-label">Geography / definition contrast</p>
            <ul class="evidence-panel__comparison">
              {sys.geography_contrast.map((row) => (
                <li>
                  <strong>{row.value}</strong> — {row.label}
                  {row.note ? <span class="evidence-panel__note"> {row.note}</span> : null}
                </li>
              ))}
            </ul>
          </>
        ) : null}
        {sys.series_note ? (
          <p>
            <span class="evidence-panel__sys-label">Series</span>
            {sys.series_note}
            {sys.series_status ? (
              <span class="evidence-panel__note"> [{sys.series_status}]</span>
            ) : null}
          </p>
        ) : null}
        {sys.missing_layers?.length ? (
          <>
            <p class="evidence-panel__sys-label">Layers not yet attached</p>
            <ul class="evidence-panel__missing">
              {sys.missing_layers.map((layer) => (
                <li>{layer}</li>
              ))}
            </ul>
          </>
        ) : null}
        {sys.qualification ? (
          <p>
            <span class="evidence-panel__sys-label">Qualification</span>
            {sys.qualification}
          </p>
        ) : null}
      </div>
    ) : null
  }

  <div class="evidence-panel__finding">
    <h3>What the data show</h3>
    <p class="evidence-panel__key">{panel.what_the_data_show.key_finding}</p>
    <ul class="evidence-panel__numbers">
      {
        nums.map((n) => (
          <li>
            <div class="evidence-panel__value">{n.value}</div>
            <div class="evidence-panel__label">{n.label}</div>
            <div class="evidence-panel__meta">
              {[n.period, n.geography, n.metric_id, n.source_id].filter(Boolean).join(" · ")}
            </div>
            {n.note ? <p class="evidence-panel__note">{n.note}</p> : null}
          </li>
        ))
      }
    </ul>
    <p>{panel.what_the_data_show.plain_english}</p>
    <p class="evidence-panel__strength">
      Evidence strength: <strong>{panel.evidence_strength}</strong>
      {panel.strength_note ? ` — ${panel.strength_note}` : ""}
    </p>
  </div>

  <details class="evidence-panel__explore">
    <summary>Explore the data</summary>
    <div class="evidence-panel__explore-body">
      <h3>What supports this</h3>
      <ul>
        {panel.what_supports_this.map((x) => <li>{x}</li>)}
      </ul>
      <h3>What challenges it</h3>
      <ul>
        {panel.what_challenges_it.map((x) => <li>{x}</li>)}
      </ul>
      <h3>What we don’t know</h3>
      <ul>
        {panel.what_we_dont_know.map((x) => <li>{x}</li>)}
      </ul>
      <p class="muted">
        Last updated: {panel.last_updated.date} · {panel.last_updated.dataset_or_release}
      </p>
      {
        panel.explore?.related_claims?.length ? (
          <p>
            Related claims:{" "}
            {panel.explore.related_claims.map((id, i) => (
              <>
                {i > 0 ? ", " : null}
                <code>{id}</code>
              </>
            ))}
          </p>
        ) : null
      }
      <p>
        Standard: <a href="https://constitutional-capitalism.netlify.app/evidence/methodology/">Evidence methodology</a> · CC-DEC-104
      </p>
    </div>
  </details>
</section>
