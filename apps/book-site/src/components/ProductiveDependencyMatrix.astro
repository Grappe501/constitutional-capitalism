---
import chapter from "../../../../data/project/stage3_pass36_arkansas_productive_systems.json";

const systems = chapter.dependency_matrix?.systems || [];
const deps = chapter.dependency_matrix?.dependencies || {};
---

<figure class="viz" data-viz="dependency-matrix" id="dependency-matrix">
  <figcaption class="viz__cap">
    <span class="viz__family">Productive Systems Dependency Matrix</span>
    <span class="viz__q">Where does one system fail if another fails?</span>
  </figcaption>
  <div style="overflow-x:auto;">
    <table class="matrix-table">
      <thead>
        <tr>
          <th scope="col">System ↓ depends on →</th>
          {systems.map((s: string) => <th scope="col">{s.slice(0, 4)}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          systems.map((row: string) => (
            <tr>
              <th scope="row">{row}</th>
              {systems.map((col: string) => {
                const hit = row !== col && (deps[row] || []).includes(col);
                return <td class={hit ? "matrix-hit" : "matrix-miss"}>{hit ? "●" : "·"}</td>;
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="viz__note">{chapter.dependency_matrix?.purpose}</p>
</figure>

<style>
  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
  }
  .matrix-table th,
  .matrix-table td {
    border: 1px solid var(--line);
    padding: 0.35rem 0.4rem;
    text-align: center;
  }
  .matrix-table th[scope="row"] {
    text-align: left;
    font-weight: 650;
  }
  .matrix-hit {
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    font-weight: 700;
  }
  .matrix-miss {
    color: var(--ink-soft);
  }
</style>
