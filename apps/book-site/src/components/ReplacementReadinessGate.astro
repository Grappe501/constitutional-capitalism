---
import chapter from "../../../../data/project/stage3_pass37_transition_intergenerational.json";

const tests = chapter.replacement_readiness_test?.tests || [];
---

<figure class="viz viz--ladder" data-viz="replacement-readiness" id="readiness">
  <figcaption class="viz__cap">
    <span class="viz__family">Replacement Readiness Gate</span>
    <span class="viz__q">Nine tests before legacy removal</span>
  </figcaption>
  <ol class="cap-ladder waterfall-steps">
    {
      tests.map((t: any) => (
        <li>
          <strong>{t.id}</strong>
          <div class="muted" style="font-weight:500;font-size:0.82rem;margin-top:0.25rem;">
            {t.question}
          </div>
        </li>
      ))
    }
  </ol>
  <p class="lede" style="margin-top:0.85rem;">
    Only then: <strong>{chapter.replacement_readiness_test?.only_then}</strong>
  </p>
  <p class="viz__note">{chapter.replacement_readiness_test?.purpose}</p>
</figure>
