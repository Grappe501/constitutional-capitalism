---
interface Props {
  level: "proven" | "strong" | "working" | "illustrative" | "untested";
  note?: string;
}
const labels: Record<Props["level"], string> = {
  proven: "PROVEN",
  strong: "STRONG",
  working: "WORKING",
  illustrative: "ILLUSTRATIVE",
  untested: "UNTESTED",
};
const { level, note } = Astro.props;
---

<span class={`ev-badge ev-badge--${level}`} title={note || labels[level]}>
  {labels[level]}
  {note && <span class="ev-badge__note">{note}</span>}
</span>
