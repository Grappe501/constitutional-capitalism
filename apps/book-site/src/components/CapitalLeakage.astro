---
import chapter from "../../../../data/project/stage3_pass34_money_markets_ownership.json";

const productive = chapter.arkansas_dollar_lifecycle?.productive_chain || [];
const extract = chapter.arkansas_dollar_lifecycle?.extraction_chain || [];
---

<figure class="viz viz--leak" data-viz="productive-retention" id="retention">
  <figcaption class="viz__cap">
    <span class="viz__family">Productive Retention (not autarky)</span>
    <span class="viz__q">Healthy trade ≠ structural extraction</span>
  </figcaption>
  <div class="leak-grid">
    <div class="leak-col leak-col--keep">
      <h3>Productive chain</h3>
      <ul>
        {productive.map((s: string) => <li>{s}</li>)}
      </ul>
    </div>
    <div class="leak-col leak-col--leak">
      <h3>Extraction chain</h3>
      <ul>
        {extract.map((s: string) => <li>{s}</li>)}
      </ul>
      <p style="margin-top:0.75rem;font-size:0.88rem;">
        Imports are not automatically leakage. Outside investment is not automatically extraction. External firms are
        not automatically harmful.
      </p>
    </div>
  </div>
  <p class="viz__note">
    {chapter.productive_retention?.definition}. {chapter.productive_retention?.safeguard}{" "}
    {chapter.productive_retention?.rule}
  </p>
</figure>
