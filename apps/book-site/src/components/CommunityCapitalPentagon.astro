---
import chapter from "../../../../data/project/stage3_pass33_human_community_capital.json";

const forms = chapter.community_capital?.forms || [];
---

<figure class="viz viz--pentagon" data-viz="community-capital-pentagon" id="community-capital">
  <figcaption class="viz__cap">
    <span class="viz__family">Community Capital Pentagon — Evidence Version</span>
    <span class="viz__q">Who benefits · what is retained · what can we measure?</span>
  </figcaption>
  <ul class="pentagon">
    {
      forms.map((f: any) => (
        <li>
          <strong>{f.label}</strong>
          <span>{f.definition}</span>
          <span class="pentagon__ev">
            {(f.measurable_signals_bound || []).slice(0, 2).join(" · ")}
          </span>
        </li>
      ))
    }
  </ul>
  <p class="lede" style="margin-top:0.85rem;">
    {chapter.community_capital?.central_argument}
  </p>
  <p class="viz__note">{chapter.community_capital?.factory_note}</p>
</figure>

<style>
  .pentagon__ev {
    display: block;
    font-size: 0.75rem;
    opacity: 0.7;
    margin-top: 0.35rem;
  }
</style>
