---
interface Props {
  activeId?: string;
}
const { activeId = "ARKANSAS_NOW" } = Astro.props;
const stations = [
  { id: "ARKANSAS_NOW", label: "NOW", purpose: "Baseline & inherited obligations" },
  { id: "YEARS_1_2", label: "Years 1–2", purpose: "Measurement, law, pilots, capacity" },
  { id: "YEARS_3_5", label: "Years 3–5", purpose: "Scale proven mechanisms" },
  { id: "YEARS_6_10", label: "Years 6–10", purpose: "Integrated operating system" },
  { id: "GENERATION_1", label: "Gen 1", purpose: "Prove household & public wealth" },
  { id: "GENERATION_2", label: "Gen 2", purpose: "Stronger inheritance test" },
];
---

<figure class="viz viz--pathway" data-viz="arkansas-pathway">
  <figcaption class="viz__cap">
    <span class="viz__family">The Arkansas Pathway</span>
    <span class="viz__q">What happens over time?</span>
  </figcaption>
  <ol class="pathway">
    {
      stations.map((s) => (
        <li class:list={["pathway__stop", { "pathway__stop--active": s.id === activeId }]}>
          <strong>{s.label}</strong>
          <span>{s.purpose}</span>
        </li>
      ))
    }
  </ol>
  <p class="viz__note">
    Temporal spine of the book — structural purposes only. Dependencies (A before B) populate under
    each station in Stage 2.
  </p>
</figure>
