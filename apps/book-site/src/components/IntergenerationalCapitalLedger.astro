---
import chapter from "../../../../data/project/stage3_pass37_transition_intergenerational.json";

const capitals =
  chapter.generation_2?.intergenerational_balance_sheet?.capitals || [];
const rule = chapter.intergenerational_capital_rule || {};
---

<figure class="viz viz--igen" data-viz="intergenerational-balance-sheet" id="igen-ledger">
  <figcaption class="viz__cap">
    <span class="viz__family">Arkansas Intergenerational Balance Sheet</span>
    <span class="viz__q">What Generation 1 inherited versus what Generation 1 leaves</span>
  </figcaption>
  <ul class="igen-ledger">
    {
      capitals.map((c: any) => (
        <li>
          <strong>{c.label}</strong>
          <span>{c.contents}</span>
        </li>
      ))
    }
  </ul>
  <p class="lede" style="margin-top:0.85rem;">
    <strong>{rule.rule}</strong>
  </p>
  <p class="viz__note">
    Dimensions locked — no invented values yet. Unknown beats fabricated statewide surplus. More
    powerful than balancing one annual budget.
  </p>
</figure>
