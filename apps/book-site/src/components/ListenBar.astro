---
---

<aside class="listen-dock" data-listen-bar data-listen-state="dormant" aria-label="Listen to this page">
  <button type="button" class="listen-pill" data-listen-expand aria-expanded="false">
    <span class="listen-pill__icon" aria-hidden="true" data-listen-pill-icon>▶</span>
    <span data-listen-pill-label>Listen</span>
  </button>

  <div class="listen-panel" data-listen-panel hidden>
    <div class="listen-panel__head">
      <p class="listen-panel__title">
        <span class="listen-panel__heading" data-listen-page-title>Listen</span>
        <span class="listen-panel__status" data-listen-status>Ready</span>
      </p>
      <button type="button" class="listen-btn listen-btn--ghost" data-listen-minimize aria-label="Minimize player">
        Minimize
      </button>
    </div>
    <div class="listen-panel__controls">
      <button type="button" class="listen-btn listen-btn--primary" data-listen-play>Play</button>
      <button type="button" class="listen-btn" data-listen-pause disabled>Pause</button>
      <button type="button" class="listen-btn" data-listen-stop disabled>Stop</button>
      <label class="listen-panel__rate">
        <span>Speed</span>
        <select data-listen-rate aria-label="Speech speed">
          <option value="0.85">0.85×</option>
          <option value="1" selected>1×</option>
          <option value="1.15">1.15×</option>
          <option value="1.35">1.35×</option>
        </select>
      </label>
    </div>
    <p class="listen-panel__note">
      Browser voice. Collapses when idle — stays available as a small pill while you read.
    </p>
  </div>
</aside>

<script>
  const bar = document.querySelector("[data-listen-bar]") as HTMLElement | null;
  const playBtn = document.querySelector("[data-listen-play]") as HTMLButtonElement | null;
  const pauseBtn = document.querySelector("[data-listen-pause]") as HTMLButtonElement | null;
  const stopBtn = document.querySelector("[data-listen-stop]") as HTMLButtonElement | null;
  const statusEl = document.querySelector("[data-listen-status]") as HTMLElement | null;
  const rateEl = document.querySelector("[data-listen-rate]") as HTMLSelectElement | null;
  const expandBtn = document.querySelector("[data-listen-expand]") as HTMLButtonElement | null;
  const minimizeBtn = document.querySelector("[data-listen-minimize]") as HTMLButtonElement | null;
  const panel = document.querySelector("[data-listen-panel]") as HTMLElement | null;
  const pillLabel = document.querySelector("[data-listen-pill-label]") as HTMLElement | null;
  const pillIcon = document.querySelector("[data-listen-pill-icon]") as HTMLElement | null;
  const pageTitleEl = document.querySelector("[data-listen-page-title]") as HTMLElement | null;
  const main = document.querySelector("#main");

  const supported =
    !!bar &&
    !!playBtn &&
    !!pauseBtn &&
    !!stopBtn &&
    !!statusEl &&
    !!rateEl &&
    !!expandBtn &&
    !!minimizeBtn &&
    !!panel &&
    !!pillLabel &&
    !!main &&
    "speechSynthesis" in window &&
    "SpeechSynthesisUtterance" in window;

  const STATE_KEY = "cc-listen-pref";
  let idleTimer: number | undefined;
  let playbackState: "idle" | "playing" | "paused" = "idle";
  let elapsedSec = 0;
  let tickTimer: number | undefined;

  type UiState = "dormant" | "mini" | "expanded";

  const pageTitle =
    document.querySelector("h1")?.textContent?.replace(/\s+/g, " ").trim() || "This page";

  if (pageTitleEl) pageTitleEl.textContent = pageTitle;

  const formatTime = (sec: number) => {
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60);
    return `${m}:${String(s).padStart(2, "0")}`;
  };

  const rateLabel = () => `${Number(rateEl?.value || 1)}×`;

  const refreshPill = () => {
    if (!pillLabel || !pillIcon) return;
    if (playbackState === "playing") {
      pillIcon.textContent = "❚❚";
      pillLabel.textContent = `${formatTime(elapsedSec)} · ${rateLabel()}`;
    } else if (playbackState === "paused") {
      pillIcon.textContent = "▶";
      pillLabel.textContent = `${formatTime(elapsedSec)} · Resume`;
    } else {
      pillIcon.textContent = "▶";
      pillLabel.textContent = "Listen";
    }
  };

  const setUi = (state: UiState, persist = true) => {
    if (!bar || !panel || !expandBtn) return;
    bar.setAttribute("data-listen-state", state);
    const open = state === "expanded";
    panel.hidden = !open;
    expandBtn.hidden = open;
    expandBtn.setAttribute("aria-expanded", open ? "true" : "false");
    refreshPill();
    if (persist) {
      try {
        sessionStorage.setItem(STATE_KEY, state);
      } catch {
        /* ignore */
      }
    }
  };

  const scheduleCollapse = () => {
    window.clearTimeout(idleTimer);
    if (playbackState === "playing") return;
    idleTimer = window.setTimeout(() => {
      if (playbackState === "paused") setUi("mini");
      else setUi("dormant");
    }, 6000);
  };

  expandBtn?.addEventListener("click", () => {
    if (playbackState === "playing" || playbackState === "paused") {
      const preferMini = (() => {
        try {
          return sessionStorage.getItem(STATE_KEY) === "mini";
        } catch {
          return false;
        }
      })();
      if (preferMini && playbackState === "playing") {
        // toggle expand from mini
        setUi("expanded");
        return;
      }
    }
    setUi("expanded");
    if (playbackState === "paused" && playBtn) playBtn.click();
  });
  minimizeBtn?.addEventListener("click", () => {
    setUi(playbackState === "idle" ? "dormant" : "mini");
  });

  try {
    const pref = sessionStorage.getItem(STATE_KEY) as UiState | null;
    if (pref === "expanded" || pref === "mini" || pref === "dormant") setUi(pref, false);
    else setUi("dormant", false);
  } catch {
    setUi("dormant", false);
  }

  if (!supported) {
    if (statusEl) statusEl.textContent = "Voice not supported";
    if (playBtn) playBtn.disabled = true;
    if (pillLabel) pillLabel.textContent = "Listen unavailable";
  } else {
    const synth = window.speechSynthesis;
    let chunks: string[] = [];
    let index = 0;
    let paused = false;
    let wakeLock: any = null;

    const setStatus = (text: string) => {
      statusEl!.textContent = text;
    };

    const stopTick = () => {
      window.clearInterval(tickTimer);
      tickTimer = undefined;
    };

    const startTick = () => {
      stopTick();
      tickTimer = window.setInterval(() => {
        if (playbackState === "playing") {
          elapsedSec += 1;
          refreshPill();
        }
      }, 1000);
    };

    const setControls = (state: "idle" | "playing" | "paused") => {
      playbackState = state;
      if (state === "idle") {
        playBtn!.textContent = "Play";
        playBtn!.disabled = false;
        pauseBtn!.disabled = true;
        stopBtn!.disabled = true;
        stopTick();
      } else if (state === "playing") {
        playBtn!.disabled = true;
        pauseBtn!.disabled = false;
        pauseBtn!.textContent = "Pause";
        stopBtn!.disabled = false;
        const preferMini = (() => {
          try {
            return sessionStorage.getItem(STATE_KEY) === "mini";
          } catch {
            return false;
          }
        })();
        setUi(preferMini ? "mini" : "expanded");
        window.clearTimeout(idleTimer);
        startTick();
      } else {
        playBtn!.disabled = false;
        playBtn!.textContent = "Resume";
        pauseBtn!.disabled = true;
        stopBtn!.disabled = false;
        stopTick();
        scheduleCollapse();
      }
      refreshPill();
    };

    const collectChunks = (): string[] => {
      const nodes = main!.querySelectorAll(
        "h1, h2, h3, h4, p, li, blockquote, figcaption, td, th, .page-lede, .lede"
      );
      const out: string[] = [];
      nodes.forEach((node) => {
        if (node.closest("[data-listen-bar]")) return;
        const text = (node.textContent || "").replace(/\s+/g, " ").trim();
        if (!text || text.length < 2) return;
        if (text.length > 450) {
          const parts = text.match(/[^.!?]+[.!?]+|[^.!?]+$/g) || [text];
          parts.forEach((part) => {
            const clean = part.replace(/\s+/g, " ").trim();
            if (clean) out.push(clean);
          });
        } else out.push(text);
      });
      return out;
    };

    const releaseWakeLock = async () => {
      try {
        await wakeLock?.release();
      } catch {
        /* ignore */
      }
      wakeLock = null;
    };

    const requestWakeLock = async () => {
      try {
        if ("wakeLock" in navigator) {
          wakeLock = await (navigator as any).wakeLock.request("screen");
          wakeLock.addEventListener("release", () => {
            wakeLock = null;
          });
        }
      } catch {
        /* ignore */
      }
    };

    const stopAll = async () => {
      synth.cancel();
      chunks = [];
      index = 0;
      paused = false;
      elapsedSec = 0;
      await releaseWakeLock();
      setControls("idle");
      setStatus("Ready");
      scheduleCollapse();
    };

    const speakNext = () => {
      if (index >= chunks.length) {
        void stopAll().then(() => setStatus("Finished"));
        return;
      }
      const utter = new SpeechSynthesisUtterance(chunks[index]);
      utter.rate = Number(rateEl!.value) || 1;
      utter.onstart = () => {
        setControls("playing");
        setStatus(`${index + 1}/${chunks.length}`);
      };
      utter.onend = () => {
        if (paused) return;
        index += 1;
        speakNext();
      };
      utter.onerror = () => {
        if (paused) return;
        index += 1;
        speakNext();
      };
      synth.speak(utter);
    };

    playBtn!.addEventListener("click", async () => {
      if (paused && synth.paused) {
        paused = false;
        synth.resume();
        setControls("playing");
        setStatus(`${index + 1}/${chunks.length}`);
        return;
      }
      await stopAll();
      chunks = collectChunks();
      if (!chunks.length) {
        setStatus("No readable text on this page");
        setUi("expanded");
        return;
      }
      index = 0;
      paused = false;
      elapsedSec = 0;
      await requestWakeLock();
      setUi("expanded");
      window.setTimeout(() => speakNext(), 60);
    });

    pauseBtn!.addEventListener("click", () => {
      if (!synth.speaking) return;
      paused = true;
      synth.pause();
      setControls("paused");
      setStatus("Paused");
    });

    stopBtn!.addEventListener("click", () => {
      void stopAll();
    });

    rateEl!.addEventListener("change", () => {
      refreshPill();
      if (synth.speaking && !paused) {
        const current = index;
        synth.cancel();
        index = current;
        paused = false;
        window.setTimeout(() => speakNext(), 60);
      }
    });

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible" && synth.speaking && !paused) {
        void requestWakeLock();
      }
    });

    window.addEventListener("beforeunload", () => {
      synth.cancel();
    });
  }
</script>
