---
---

<aside class="listen-bar" data-listen-bar aria-label="Listen to this page">
  <div class="listen-bar__inner">
    <p class="listen-bar__title">
      <span class="listen-bar__heading">Listen</span>
      <span class="listen-bar__status" data-listen-status>Ready</span>
    </p>
    <div class="listen-bar__controls">
      <button type="button" class="listen-btn listen-btn--primary" data-listen-play>
        Play
      </button>
      <button type="button" class="listen-btn" data-listen-pause disabled>
        Pause
      </button>
      <button type="button" class="listen-btn" data-listen-stop disabled>
        Stop
      </button>
    </div>
    <label class="listen-bar__rate">
      <span>Speed</span>
      <select data-listen-rate aria-label="Speech speed">
        <option value="0.85">Slow</option>
        <option value="1" selected>Normal</option>
        <option value="1.15">Fast</option>
      </select>
    </label>
  </div>
  <p class="listen-bar__note">
    Uses your browser’s built-in voice (Chrome works best). For driving, start playback before you
    move and keep the phone secured.
  </p>
</aside>

<script>
  const bar = document.querySelector("[data-listen-bar]");
  const playBtn = document.querySelector("[data-listen-play]");
  const pauseBtn = document.querySelector("[data-listen-pause]");
  const stopBtn = document.querySelector("[data-listen-stop]");
  const statusEl = document.querySelector("[data-listen-status]");
  const rateEl = document.querySelector("[data-listen-rate]") as HTMLSelectElement | null;
  const main = document.querySelector("#main");

  const supported =
    !!bar &&
    !!playBtn &&
    !!pauseBtn &&
    !!stopBtn &&
    !!statusEl &&
    !!rateEl &&
    !!main &&
    "speechSynthesis" in window &&
    "SpeechSynthesisUtterance" in window;

  if (!supported) {
    if (statusEl) statusEl.textContent = "Voice not supported in this browser";
    if (playBtn) playBtn.setAttribute("disabled", "true");
  } else {
    const synth = window.speechSynthesis;
    let chunks: string[] = [];
    let index = 0;
    let paused = false;
    let wakeLock: any = null;

    const setStatus = (text: string) => {
      statusEl.textContent = text;
    };

    const setControls = (state: "idle" | "playing" | "paused") => {
      if (state === "idle") {
        playBtn.textContent = "Play";
        playBtn.removeAttribute("disabled");
        pauseBtn.setAttribute("disabled", "true");
        stopBtn.setAttribute("disabled", "true");
      } else if (state === "playing") {
        playBtn.setAttribute("disabled", "true");
        pauseBtn.removeAttribute("disabled");
        pauseBtn.textContent = "Pause";
        stopBtn.removeAttribute("disabled");
      } else {
        playBtn.removeAttribute("disabled");
        playBtn.textContent = "Resume";
        pauseBtn.setAttribute("disabled", "true");
        stopBtn.removeAttribute("disabled");
      }
    };

    const collectChunks = (): string[] => {
      const nodes = main.querySelectorAll(
        "h1, h2, h3, h4, p, li, blockquote, figcaption, td, th, .page-lede, .lede"
      );
      const out: string[] = [];
      nodes.forEach((node) => {
        if (node.closest("[data-listen-bar]")) return;
        const text = (node.textContent || "").replace(/\s+/g, " ").trim();
        if (!text) return;
        if (text.length < 2) return;
        // Chrome truncates very long utterances — split conservatively.
        if (text.length > 450) {
          const parts = text.match(/[^.!?]+[.!?]+|[^.!?]+$/g) || [text];
          parts.forEach((part) => {
            const clean = part.replace(/\s+/g, " ").trim();
            if (clean) out.push(clean);
          });
        } else {
          out.push(text);
        }
      });
      return out;
    };

    const releaseWakeLock = async () => {
      try {
        await wakeLock?.release();
      } catch {
        /* ignore */
      }
      wakeLock = null;
    };

    const requestWakeLock = async () => {
      try {
        if ("wakeLock" in navigator) {
          wakeLock = await navigator.wakeLock.request("screen");
          wakeLock.addEventListener("release", () => {
            wakeLock = null;
          });
        }
      } catch {
        /* ignore — not critical */
      }
    };

    const stopAll = async () => {
      synth.cancel();
      chunks = [];
      index = 0;
      paused = false;
      await releaseWakeLock();
      setControls("idle");
      setStatus("Ready");
    };

    const speakNext = () => {
      if (index >= chunks.length) {
        void stopAll().then(() => setStatus("Finished"));
        return;
      }
      const utter = new SpeechSynthesisUtterance(chunks[index]);
      utter.rate = Number(rateEl.value) || 1;
      utter.onstart = () => {
        setControls("playing");
        setStatus(`Reading ${index + 1} of ${chunks.length}`);
      };
      utter.onend = () => {
        if (paused) return;
        index += 1;
        speakNext();
      };
      utter.onerror = () => {
        if (paused) return;
        index += 1;
        speakNext();
      };
      synth.speak(utter);
    };

    playBtn.addEventListener("click", async () => {
      if (paused && synth.paused) {
        paused = false;
        synth.resume();
        setControls("playing");
        setStatus(`Reading ${index + 1} of ${chunks.length}`);
        return;
      }
      await stopAll();
      chunks = collectChunks();
      if (!chunks.length) {
        setStatus("No readable text on this page");
        return;
      }
      index = 0;
      paused = false;
      await requestWakeLock();
      // Some Chrome builds need a beat after cancel before speak.
      window.setTimeout(() => speakNext(), 60);
    });

    pauseBtn.addEventListener("click", () => {
      if (!synth.speaking) return;
      paused = true;
      synth.pause();
      setControls("paused");
      setStatus("Paused");
    });

    stopBtn.addEventListener("click", () => {
      void stopAll();
    });

    rateEl.addEventListener("change", () => {
      if (synth.speaking && !paused) {
        // Restart current chunk at new rate.
        const current = index;
        synth.cancel();
        index = current;
        paused = false;
        window.setTimeout(() => speakNext(), 60);
      }
    });

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible" && synth.speaking && !paused) {
        void requestWakeLock();
      }
    });

    window.addEventListener("beforeunload", () => {
      synth.cancel();
    });
  }
</script>
