---
import chapter from "../../../../data/project/stage3_pass36_arkansas_productive_systems.json";

const columns = chapter.production_balance_sheet?.columns || [];
const rows = chapter.production_balance_sheet?.rows || [];
const notes = chapter.production_balance_sheet?.prototype_notes || {};
---

<figure class="viz" data-viz="production-balance-sheet" id="balance-sheet">
  <figcaption class="viz__cap">
    <span class="viz__family">Arkansas Production Balance Sheet</span>
    <span class="viz__q">Demand · capacity · dependency · sales · ownership · condition · burden · resilience</span>
  </figcaption>
  <ul class="link-board" style="margin-bottom:0.75rem;">
    {columns.map((c: string) => <li>{c}</li>)}
  </ul>
  <ul class="stack">
    {
      rows.map((r: string) => (
        <li>
          <strong>{r}</strong>
          <div class="muted">
            {notes[r]
              ? Object.entries(notes[r])
                  .map(([k, v]) => `${k}: ${v}`)
                  .join(" · ")
              : "Cells largely UNKNOWN — populate in Stage 4 / manuals"}
          </div>
        </li>
      ))
    }
  </ul>
  <p class="viz__note">{chapter.production_balance_sheet?.rule}</p>
</figure>
