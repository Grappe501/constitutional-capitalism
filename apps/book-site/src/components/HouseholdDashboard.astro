---
import chapter from "../../../../data/project/stage3_pass32_household_prosperity.json";

const baselines = (chapter.household_prosperity_ledger?.shared_arkansas_baselines || []).slice(0, 6);
const dims = chapter.five_dimension_framework?.dimensions || [];

function fmt(v: unknown, unit?: string) {
  if (v == null) return "—";
  if (typeof v === "number") {
    if (unit === "USD" || unit === "USD_2022") {
      return new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0,
      }).format(v);
    }
    if (unit === "percent" || unit === "percent_of_DPI") return `${v}%`;
    if (unit === "cents_per_kWh") return `${v}¢/kWh`;
    return new Intl.NumberFormat("en-US").format(v);
  }
  return String(v);
}
---

<figure class="viz viz--hh-dash" data-viz="household-dashboard" id="dashboard">
  <figcaption class="viz__cap">
    <span class="viz__family">Household Prosperity Dashboard</span>
    <span class="viz__q">Is an ordinary household actually more prosperous?</span>
  </figcaption>
  <div class="hh-dash">
    {
      dims.map((d: any) => (
        <div class={`hh-dash__gauge${d.id === "TIME" ? " hh-dash__gauge--time" : ""}`}>
          <strong>{d.label}</strong>
          <span>{d.definition}</span>
        </div>
      ))
    }
  </div>
  <div class="hh-dash__chips">
    {
      baselines.map((b: any) => (
        <div class="hh-dash__chip">
          <strong>{fmt(b.value, b.unit)}</strong>
          <span>
            {b.label} · {b.period} · {b.claim_class}
          </span>
        </div>
      ))
    }
  </div>
  <p class="viz__note">
    Pass 3.2 populates gauges with Arkansas FACT baselines where bound. Prosperity Surplus statewide
    total remains un-fabricated until Stage 4 microsim.
  </p>
</figure>

<style>
  .hh-dash__chips {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.65rem;
    margin-top: 1rem;
  }
  .hh-dash__chip {
    border: 1px solid color-mix(in srgb, var(--ink, #1a1a1a) 12%, transparent);
    padding: 0.55rem 0.7rem;
  }
  .hh-dash__chip strong {
    display: block;
    font-size: 1.05rem;
  }
  .hh-dash__chip span {
    display: block;
    font-size: 0.78rem;
    opacity: 0.75;
    margin-top: 0.2rem;
  }
</style>
