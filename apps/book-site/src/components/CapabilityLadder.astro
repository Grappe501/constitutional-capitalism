---
import chapter from "../../../../data/project/stage3_pass33_human_community_capital.json";

const chain = chapter.capability_continuum?.chain || [];
---

<figure class="viz viz--ladder" data-viz="capability-continuum" id="continuum">
  <figcaption class="viz__cap">
    <span class="viz__family">Arkansas Capability Continuum</span>
    <span class="viz__q">Birth → learning → work/service → ownership → leadership → next generation</span>
  </figcaption>
  <ol class="cap-ladder">
    {chain.map((step: string) => <li>{step}</li>)}
  </ol>
  <p class="lede" style="margin-top:0.85rem;">
    {chapter.capability_continuum?.rule}
  </p>
  <p class="viz__note">
    Increase capability to create value, exercise agency, acquire ownership, and contribute to Arkansas —
    not merely to fill employer vacancies.
  </p>
</figure>
