---
interface Props {
  current?: string;
}
const { current = "" } = Astro.props;

const links = [
  { href: "/unabridged/", id: "home", label: "Reader home" },
  { href: "/unabridged/#toc", id: "toc", label: "TOC" },
  { href: "/unabridged/glossary/", id: "glossary", label: "Glossary" },
  { href: "/unabridged/audits/", id: "audits", label: "Audits" },
  { href: "/unabridged/validation/", id: "validation", label: "Stage 4 queue" },
  { href: "/unabridged/atlas/", id: "atlas", label: "Asset Atlas" },
  { href: "/unabridged/is-is-not/", id: "is-is-not", label: "Is / Is Not" },
  { href: "/unabridged/certification/", id: "certification", label: "Certification" },
  { href: "/system/master-map/", id: "map", label: "Master Map" },
];
---

<nav class="unabridged-nav" aria-label="Unabridged reader">
  <ul>
    {
      links.map((l) => (
        <li>
          <a href={l.href} aria-current={current === l.id ? "page" : undefined}>
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
