---
import chapter from "../../../../data/project/stage3_pass35_government_democratic_power.json";

const loop = chapter.capture_architecture?.loop || [];
const mechanisms = chapter.capture_architecture?.capture_mechanisms || [];
const breakers = chapter.capture_architecture?.circuit_breaker_families || [];
---

<figure class="viz viz--capture-breakers" data-viz="capture-circuit-breakers" id="capture">
  <figcaption class="viz__cap">
    <span class="viz__family">Capture Loop + Circuit Breakers</span>
    <span class="viz__q">Where reconcentration is interrupted — institutional architecture</span>
  </figcaption>
  <p class="fly-card fly-card--down" style="margin:0;">
    {loop.join(" → ")}
  </p>
  <h3 style="margin:0.85rem 0 0.4rem;font-size:0.95rem;">Capture mechanisms</h3>
  <ul class="link-board">
    {mechanisms.map((m: string) => <li>{m}</li>)}
  </ul>
  <h3 style="margin:0.85rem 0 0.4rem;font-size:0.95rem;">Eight circuit-breaker families</h3>
  <ul class="breakers">
    {
      breakers.map((b: any) => (
        <li>
          {typeof b === "string" ? b : b.label}
          {b?.interrupts ? <span class="muted"> — {b.interrupts}</span> : null}
        </li>
      ))
    }
  </ul>
  <p class="viz__note">
    Architecture of where capture occurs and what control belongs at each point — not a hundred ethics
    statutes.
  </p>
</figure>
