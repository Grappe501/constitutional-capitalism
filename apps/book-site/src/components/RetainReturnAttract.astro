---
import chapter from "../../../../data/project/stage3_pass33_human_community_capital.json";

const stages = chapter.retain_return_attract_belong?.stages || [];
---

<figure class="viz viz--rra" data-viz="retain-return-attract-belong" id="population">
  <figcaption class="viz__cap">
    <span class="viz__family">Retain → Return → Attract → Belong</span>
    <span class="viz__q">Population strategy connected to place and demand</span>
  </figcaption>
  <ol class="rra">
    {
      stages.map((s: any) => (
        <li>
          <strong>{s.label}</strong>
          <span>{s.definition}</span>
        </li>
      ))
    }
  </ol>
  <p class="lede" style="margin-top:0.85rem;">
    {chapter.retain_return_attract_belong?.insight}
  </p>
  <p class="viz__note">
    HYP-132 remains sensitivity — not COUNTABLE revenue. Designated-county PEP change from Arkansas
    NOW is FACT context for divergence, not a statewide migration model.
  </p>
</figure>
