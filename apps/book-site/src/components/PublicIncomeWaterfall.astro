---
import chapter from "../../../../data/project/stage3_pass34_money_markets_ownership.json";

const waterfall = chapter.public_income_firewall?.waterfall || [];
const firewall = chapter.public_income_firewall?.firewall || [];
---

<figure class="viz viz--waterfall" data-viz="public-income-waterfall" id="waterfall">
  <figcaption class="viz__cap">
    <span class="viz__family">Public-Income Waterfall</span>
    <span class="viz__q">Revenue ≠ profit ≠ public income ≠ reserved public cash</span>
  </figcaption>
  <ol class="cap-ladder waterfall-steps">
    {waterfall.map((step: string) => <li>{step}</li>)}
  </ol>
  <ul class="link-board" style="margin-top:0.85rem;">
    {firewall.map((f: string) => <li>{f}</li>)}
  </ul>
  <p class="viz__note">
    COUNTABLE remains $0 until the evidence chain proves reserved public cash. Food-hub work is discipline, not
    failure: no free cash → no COUNTABLE claim.
  </p>
</figure>
