---
import chapter from "../../../../data/project/stage3_pass33_human_community_capital.json";

const pathways = chapter.capability_continuum?.parallel_postsecondary_pathways || [];
---

<figure class="viz viz--pathways" data-viz="multiple-pathways" id="pathways">
  <figcaption class="viz__cap">
    <span class="viz__family">Multiple Pathways Map</span>
    <span class="viz__q">University is not the only road to prosperity</span>
  </figcaption>
  <ul class="path-grid">
    {
      pathways.map((p: string) => (
        <li>
          <strong>{p}</strong>
        </li>
      ))
    }
  </ul>
  <p class="lede" style="margin-top:0.85rem;">
    {chapter.capability_continuum?.movement_rule}
  </p>
  <p class="viz__note">
    Parallel pathways after secondary education — and movement between them throughout life.
  </p>
</figure>

<style>
  .path-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 0.45rem;
  }
  .path-grid li {
    padding: 0.55rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--ink, #1a1a1a) 12%, transparent);
    text-align: center;
  }
</style>
