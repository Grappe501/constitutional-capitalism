---
import chapter from "../../../../data/project/stage3_pass33_human_community_capital.json";

const chain = chapter.demand_map_architecture?.chain || [];
const rows = (chapter.demand_map_architecture?.family_bridge_rows || []).slice(0, 8);
---

<figure class="viz viz--demand" data-viz="demand-capability-loop" id="demand-loop">
  <figcaption class="viz__cap">
    <span class="viz__family">Demand ↔ Capability Loop</span>
    <span class="viz__q">Needs inform capacity — they do not dictate a life</span>
  </figcaption>
  <ol class="demand-loop">
    {chain.map((s: string) => <li><strong>{s}</strong></li>)}
  </ol>
  <p class="lede" style="margin-top:0.85rem;">
    {chapter.demand_map_architecture?.freedom_rule}
  </p>
  {
    rows.length > 0 && (
      <div class="table-wrap" style="margin-top:0.75rem;">
        <table class="data-table">
          <thead>
            <tr>
              <th>Category</th>
              <th>IPEDS 2023</th>
              <th>ADWS openings</th>
              <th>Ratio</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r: any) => (
              <tr>
                <td>{String(r.category || "").replaceAll("_", " ")}</td>
                <td>{r.ipeds_completions_2023}</td>
                <td>{r.adws_annual_openings_sum}</td>
                <td>{r.capacity_to_openings_ratio}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
  <p class="viz__note">
    DERIVED bridges — not shortage claims. County geographic gap remains NEE. Flywheel of human
    capital reinvestment remains joined beneath this loop.
  </p>
</figure>

<style>
  .demand-loop {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  .demand-loop li {
    padding: 0.45rem 0.7rem;
    border-left: 3px solid color-mix(in srgb, var(--copper, #b08d57) 80%, transparent);
    background: color-mix(in srgb, var(--ink, #1a1a1a) 4%, transparent);
  }
  .table-wrap {
    overflow-x: auto;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .data-table th,
  .data-table td {
    text-align: left;
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--ink, #1a1a1a) 12%, transparent);
  }
</style>
