---
import chapter from "../../../../data/project/stage3_pass35_government_democratic_power.json";

const ladder = chapter.subsidiarity?.ladder || [];
const test = chapter.subsidiarity?.decision_test || [];
---

<figure class="viz viz--ladder" data-viz="subsidiarity-ladder" id="subsidiarity">
  <figcaption class="viz__cap">
    <span class="viz__family">Subsidiarity Ladder</span>
    <span class="viz__q">Lowest capable level · rights protected · statewide interests preserved</span>
  </figcaption>
  <ol class="cap-ladder">
    {ladder.map((step: string) => <li>{step}</li>)}
  </ol>
  <p class="lede" style="margin-top:0.85rem;">{chapter.subsidiarity?.principle}</p>
  <ul class="link-board">
    {test.map((q: string) => <li>{q}</li>)}
  </ul>
  <p class="viz__note">Not simply “local control.” Decision criteria place the function.</p>
</figure>
