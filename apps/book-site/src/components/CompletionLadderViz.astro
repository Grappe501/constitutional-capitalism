---
interface Props {
  overall: number;
  skeleton: number;
  firstPass: number;
  publication: number;
  validation: number;
  caption?: string;
}
const {
  overall,
  skeleton,
  firstPass,
  publication,
  validation,
  caption = "Skeleton and First-Pass held at 100%. Unabridged Completion is the active Stage 3 dial.",
} = Astro.props;

const rows = [
  { label: "Skeleton", value: skeleton, tone: "accent" },
  { label: "First pass", value: firstPass, tone: "ink" },
  { label: "Unabridged", value: publication, tone: "ink" },
  { label: "Validation", value: validation, tone: "ink" },
  { label: "Overall", value: overall, tone: "copper" },
];
---

<figure class="viz viz--completion" data-viz="completion-ladder">
  <figcaption class="viz__cap">
    <span class="viz__family">Build Progress</span>
    <span class="viz__q">How did build completion change?</span>
  </figcaption>
  <div class="completion-viz">
    {
      rows.map((r) => (
        <div class={`completion-viz__row completion-viz__row--${r.tone}`}>
          <div class="completion-viz__meta">
            <span>{r.label}</span>
            <strong>{r.value}%</strong>
          </div>
          <div class="completion-viz__track" aria-hidden="true">
            <div class="completion-viz__fill" style={`width:${Math.min(100, Math.max(0, r.value))}%`} />
          </div>
        </div>
      ))
    }
  </div>
  <p class="viz__note">{caption}</p>
</figure>
