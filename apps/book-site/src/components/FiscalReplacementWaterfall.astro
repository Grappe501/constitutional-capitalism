---
import chapter from "../../../../data/project/stage3_pass37_transition_intergenerational.json";

const chain = chapter.fiscal_transition_ledger?.chain || [];
---

<figure class="viz viz--ladder" data-viz="fiscal-replacement-waterfall" id="fiscal-waterfall">
  <figcaption class="viz__cap">
    <span class="viz__family">Fiscal Replacement Waterfall</span>
    <span class="viz__q">Legacy requirement → verified replacements → costs/reserves → actual capacity</span>
  </figcaption>
  <ol class="cap-ladder waterfall-steps">
    {chain.map((s: string) => <li>{s}</li>)}
  </ol>
  <p class="lede" style="margin-top:0.85rem;">{chapter.fiscal_transition_ledger?.rule}</p>
  <p class="viz__note">{chapter.fiscal_transition_ledger?.countable}</p>
</figure>
