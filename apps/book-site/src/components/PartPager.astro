---
interface Props {
  prev?: { href: string; label: string } | null;
  next?: { href: string; label: string } | null;
}
const { prev = null, next = null } = Astro.props;
---

<nav class="part-pager" aria-label="Part navigation">
  {
    prev ? (
      <a class="part-pager__prev" href={prev.href}>
        ← {prev.label}
      </a>
    ) : (
      <span class="part-pager__prev muted">Beginning</span>
    )
  }
  <a class="part-pager__toc" href="/unabridged/#toc">
    Table of Contents
  </a>
  {
    next ? (
      <a class="part-pager__next" href={next.href}>
        {next.label} →
      </a>
    ) : (
      <a class="part-pager__next" href="/unabridged/certification/">
        Certification →
      </a>
    )
  }
</nav>
