---
import chapter from "../../../../data/project/stage3_pass35_government_democratic_power.json";

const roles = chapter.four_roles?.roles || [];
const test = chapter.four_roles?.role_conflict_test || {};
---

<figure class="viz viz--roles" data-viz="government-roles-quadrant" id="roles">
  <figcaption class="viz__cap">
    <span class="viz__family">Government Four Roles + Conflict Test</span>
    <span class="viz__q">What role · and can roles collide in the same market?</span>
  </figcaption>
  <ul class="roles-quad">
    {
      roles.map((r: any) => (
        <li>
          <strong>{r.label}</strong>
          <span>{r.meaning}</span>
        </li>
      ))
    }
  </ul>
  <div class="fly-card" style="margin-top:0.85rem;">
    <h3 style="margin:0 0 0.45rem;font-size:1rem;">{test.title}</h3>
    <ul class="stack" style="margin:0;">
      {(test.questions || []).map((q: string) => <li>{q}</li>)}
    </ul>
  </div>
  <p class="viz__note">
    Especially important for public-income architecture (Pass 3.4). Do not casually blend roles.
  </p>
</figure>
