---
import chapter from "../../../../data/project/stage3_pass34_money_markets_ownership.json";

interface Props {
  domain?: string;
}
const { domain = "Arkansas Money Engine" } = Astro.props;
const forms = chapter.ownership_architecture?.forms || [];
---

<figure class="viz viz--own" data-viz="ownership-spectrum" id="ownership">
  <figcaption class="viz__cap">
    <span class="viz__family">Ownership Spectrum</span>
    <span class="viz__q">Who controls · who bears risk · who receives surplus · where return accumulates</span>
  </figcaption>
  <div class="own-grid own-spectrum">
    {
      forms.map((f: any) => (
        <div class="own-col">
          <h3>{f.label}</h3>
          <p>
            Control: {f.control}
            <br />
            Risk: {f.risk}
            <br />
            Surplus: {f.surplus}
          </p>
        </div>
      ))
    }
  </div>
  <p class="lede" style="margin-top:0.85rem;">{chapter.ownership_architecture?.principle}</p>
  <p class="viz__note">
    Not private versus public as the only axis. Function, incentives, competition, risk, and public purpose choose the
    form — including for {domain}.
  </p>
</figure>
