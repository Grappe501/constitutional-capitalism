---
import chapter from "../../../../data/project/stage3_pass35_government_democratic_power.json";

const spheres = chapter.purpose_of_government?.spheres || [];
const sov = chapter.popular_sovereignty || {};
---

<figure class="viz viz--sovereignty" data-viz="sovereignty-delegation" id="sovereignty">
  <figcaption class="viz__cap">
    <span class="viz__family">Sovereignty &amp; Delegation Map</span>
    <span class="viz__q">People hold sovereignty · government holds delegated power</span>
  </figcaption>
  <div class="fly-card fly-card--up" style="margin:0 0 0.85rem;">
    <strong>People (sovereignty)</strong>
    <div class="muted" style="margin-top:0.35rem;">{sov.principle}</div>
  </div>
  <div class="own-grid three-econ-grid">
    {
      spheres.map((s: any) => (
        <div class="own-col">
          <h3>{s.label}</h3>
          <p>{s.rule}</p>
        </div>
      ))
    }
  </div>
  <p class="lede" style="margin-top:0.85rem;">
    Delegation of authority ≠ transfer of sovereignty. Elections authorize agents; they do not surrender
    political ownership.
  </p>
  <p class="viz__note">{chapter.purpose_of_government?.test}</p>
</figure>
