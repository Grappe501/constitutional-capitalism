---
import chapter from "../../../../data/project/stage3_pass36_arkansas_productive_systems.json";

const food = chapter.systems?.FOOD || {};
const chain = food.architecture_chain || [];
---

<figure class="viz viz--ladder" data-viz="food-value-chain" id="food-chain">
  <figcaption class="viz__cap">
    <span class="viz__family">Food Value Chain</span>
    <span class="viz__q">Farm → consumer/export · where do ownership and margin accumulate?</span>
  </figcaption>
  <ol class="cap-ladder">
    {chain.map((s: string) => <li>{s}</li>)}
  </ol>
  <ul class="stack" style="margin-top:0.85rem;">
    {(food.principles || []).map((p: string) => <li>{p}</li>)}
  </ul>
  <p class="viz__note">
    {food.not} COUNTABLE public free cash remains $0 until waterfall evidence clears.
  </p>
</figure>
