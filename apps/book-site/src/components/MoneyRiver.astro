---
import chapter from "../../../../data/project/stage3_pass34_money_markets_ownership.json";
import bridge from "../../../../data/project/arkansas_money_engine_budget_bridge.json";

interface Props {
  title?: string;
  note?: string;
  stages?: { label: string; kind?: "entry" | "flow" | "asset" | "leak" }[];
}

function money(n?: number | null) {
  if (n == null) return "—";
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(n);
}

const gr = chapter.revenue_taxonomy?.fy2026_gr_facts;
const gdp = chapter.arkansas_evidence_bound?.production_labor?.[0]?.value_usd;
const wages = chapter.arkansas_evidence_bound?.production_labor?.[1]?.value_usd;

const {
  title = "Arkansas Money River — Evidence Version",
  note = `Inflows include FY2026 GR gross ${money(gr?.gross_general_revenue_usd)} (FACT) and QCEW private wages ${money(wages)} (FACT). Asset formation sits against GDP ${money(gdp)} (FACT). Outflows require Extraction Test — not a buy-local slogan. COUNTABLE engines remain $0. Distributed GR ${money(bridge.headline_now?.general_revenue_distributed_to_agencies_and_institutions_usd)}.`,
  stages = [
    { label: "Inflows (GR · wages · external demand)", kind: "entry" },
    { label: "Internal circulation (three economies)", kind: "flow" },
    { label: "Asset formation & ownership", kind: "asset" },
    { label: "Outflows (trade vs extraction)", kind: "leak" },
  ],
} = Astro.props;
---

<figure class="viz viz--river" data-viz="money-river" id="money-river">
  <figcaption class="viz__cap">
    <span class="viz__family">{title}</span>
    <span class="viz__q">Where did it come from · where did it go · what compounds · what extracts?</span>
  </figcaption>
  <svg class="viz-svg" viewBox="0 0 720 220" role="img" aria-label="Arkansas Money River evidence schematic">
    <defs>
      <linearGradient id="riverFill" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#1d4ed8" stop-opacity="0.85"></stop>
        <stop offset="70%" stop-color="#3b82f6" stop-opacity="0.55"></stop>
        <stop offset="100%" stop-color="#94a3b8" stop-opacity="0.35"></stop>
      </linearGradient>
    </defs>
    <path
      d="M20 110 C 120 40, 220 40, 300 110 S 480 180, 560 110 S 680 40, 700 90"
      fill="none"
      stroke="url(#riverFill)"
      stroke-width="34"
      stroke-linecap="round"></path>
    <path
      d="M420 118 C 480 150, 540 175, 620 190"
      fill="none"
      stroke="#b87333"
      stroke-width="10"
      stroke-linecap="round"
      opacity="0.9"></path>
    <path
      d="M360 95 C 400 55, 450 35, 520 28"
      fill="none"
      stroke="#1e3a8a"
      stroke-width="8"
      stroke-linecap="round"
      opacity="0.75"></path>
    <text x="28" y="28" class="viz-svg__label">{stages[0]?.label || "Inflows"}</text>
    <text x="220" y="200" class="viz-svg__label">{stages[1]?.label || "Circulation"}</text>
    <text x="480" y="22" class="viz-svg__label">{stages[2]?.label || "Assets"}</text>
    <text x="540" y="210" class="viz-svg__label viz-svg__label--leak">{stages[3]?.label || "Outflows"}</text>
  </svg>
  <ol class="river-steps">
    {stages.map((s) => (
      <li data-kind={s.kind || "flow"}>{s.label}</li>
    ))}
  </ol>
  <p class="viz__note">{note}</p>
</figure>
