---
import chapter from "../../../../data/project/stage3_pass36_arkansas_productive_systems.json";

const evidence = chapter.arkansas_evidence_bound?.production_scales || [];

function money(n?: number | null) {
  if (n == null) return "—";
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(n);
}
---

<figure class="viz" data-viz="productive-geography" id="geography">
  <figcaption class="viz__cap">
    <span class="viz__family">Arkansas Productive Geography — Scale Foundation</span>
    <span class="viz__q">Where capacity is evidenced · not a forced county map</span>
  </figcaption>
  <div class="dash-row">
    {
      evidence.slice(0, 6).map((e: any) => (
        <div class="dash-cell">
          <strong>{e.value_usd != null ? money(e.value_usd) : e.value}</strong>
          <span>
            {e.label} · {e.claim_class}
          </span>
        </div>
      ))
    }
  </div>
  <p class="lede" style="margin-top:0.85rem;">
    Geographic detail only where data support it. Energy, broadband, water, hospitals, roads remain OPEN
    binds — not invented maps.
  </p>
  <p class="viz__note">
    Foundation for later county/region overlays. Gaps: {(chapter.arkansas_evidence_bound?.gaps || []).slice(0, 4).join(" · ")}
  </p>
</figure>
