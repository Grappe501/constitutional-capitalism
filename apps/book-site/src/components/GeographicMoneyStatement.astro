---
import chapter from "../../../../data/project/stage3_pass34_money_markets_ownership.json";
import bridge from "../../../../data/project/arkansas_money_engine_budget_bridge.json";

const fields = chapter.geographic_money_statements?.fields || [];
const evidence = chapter.arkansas_evidence_bound || {};

function money(n?: number | null) {
  if (n == null) return "—";
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(n);
}

const prototypeRows = [
  {
    field: "INFLOWS",
    bound: `GR gross ${money(evidence.revenue?.[0]?.value_usd)} · QCEW wages ${money(evidence.production_labor?.[1]?.value_usd)} · tourism scale ${money(chapter.external_income?.bound_scales?.[0]?.value_usd)}`,
  },
  {
    field: "INTERNAL_CIRCULATION",
    bound: "Household ↔ productive ↔ public exchanges (Three Economies) — county detail deferred",
  },
  {
    field: "OUTFLOWS",
    bound: "Extraction Test + productive retention — ownership geography not fabricated from SOD",
  },
  {
    field: "ASSET_FORMATION",
    bound: `GDP scale ${money(evidence.production_labor?.[0]?.value_usd)} · taxable AV ${money(evidence.property?.[0]?.value_usd)}`,
  },
  {
    field: "OWNERSHIP",
    bound: "Spectrum: household → private → employee → coop → community → institutional → public → mixed → external",
  },
  {
    field: "PUBLIC_POSITION",
    bound: `FY2026 GR distributed ${money(bridge.headline_now?.general_revenue_distributed_to_agencies_and_institutions_usd)} · COUNTABLE engines $0`,
  },
  {
    field: "HOUSEHOLD_POSITION",
    bound: "Join Household Prosperity Ledger — statewide surplus not fabricated",
  },
];
---

<figure class="viz viz--gms" data-viz="geographic-money-statement" id="gms">
  <figcaption class="viz__cap">
    <span class="viz__family">Geographic Money Statement — State Prototype</span>
    <span class="viz__q">Inflows · circulation · outflows · assets · ownership · public · household</span>
  </figcaption>
  <div class="dash-row" style="margin-bottom:0.85rem;">
    {
      fields.map((f: any) => (
        <div class="dash-cell">
          <strong>{f.label}</strong>
          <span>{f.question}</span>
        </div>
      ))
    }
  </div>
  <ul class="stack">
    {
      prototypeRows.map((r) => (
        <li>
          <strong>{r.field}</strong>
          <div class="muted">{r.bound}</div>
        </li>
      ))
    }
  </ul>
  <p class="viz__note">
    Architecture complete for State → region → county → municipality. Not attempting all 75 counties here. Unknown
    beats fabricated ownership geography.
  </p>
</figure>
