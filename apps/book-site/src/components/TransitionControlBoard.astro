---
import chapter from "../../../../data/project/stage3_pass37_transition_intergenerational.json";

const fields = chapter.transition_control_board?.fields || [];
const pos = chapter.transition_control_board?.decisions_positive || [];
const corr = chapter.transition_control_board?.decisions_corrective || [];
---

<figure class="viz viz--tcb" data-viz="transition-control-board" id="control-board">
  <figcaption class="viz__cap">
    <span class="viz__family">Transition Control Board</span>
    <span class="viz__q">Operational instrument — not a decorative chart</span>
  </figcaption>
  <ul class="link-board" style="margin-bottom:0.75rem;">
    {fields.map((f: string) => <li>{f}</li>)}
  </ul>
  <div class="tcb-scroll">
    <table class="tcb">
      <thead>
        <tr>
          <th>Current</th>
          <th>Future</th>
          <th>State</th>
          <th>Evidence</th>
          <th>Fiscal</th>
          <th>Legal</th>
          <th>Resilience</th>
          <th>Decision</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td colspan="8" class="tcb-arch">
            Architecture only — rows filled when reforms are scored. No fake public examples.
            Positive: {pos.join(" · ")}. Corrective: {corr.join(" · ")}.
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="viz__note">{chapter.transition_control_board?.purpose}</p>
</figure>
