---
import "../styles/global.css";
import ListenBar from "../components/ListenBar.astro";
import { identity } from "../lib/data";

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title,
  description = "Constitutional Capitalism — Restoring Prosperity Through Constitutional Principles. A free public book project in development.",
  path = "/",
} = Astro.props;

const pageTitle = title
  ? `${title} | ${identity.title}`
  : `${identity.title} | ${identity.subtitle}`;
const canonical = new URL(path, Astro.site).toString();
const nav = [
  { href: "/", label: "Home" },
  { href: "/definition/", label: "Definition" },
  { href: "/declaration/", label: "Declaration" },
  { href: "/foundational-axioms/", label: "Axioms" },
  { href: "/principles/", label: "Principles" },
  { href: "/equal-standing/", label: "Equal Standing" },
  { href: "/constitutional-citizenship/", label: "Citizenship" },
  { href: "/family/", label: "Family" },
  { href: "/assistance/", label: "Assistance" },
  { href: "/federalism/", label: "Federalism" },
  { href: "/peoples-branch/", label: "People’s Branch" },
  { href: "/flourishing/", label: "Flourishing" },
  { href: "/where-we-are/", label: "Where We Are" },
  { href: "/justice/", label: "Justice" },
  { href: "/democracy/", label: "Democracy" },
  { href: "/public-service/", label: "Public Service" },
  { href: "/citizen-service/", label: "Citizen Service" },
  { href: "/constitutional-defense/", label: "Defense" },
  { href: "/civic-wealth/", label: "Civic Wealth" },
  { href: "/energy-sovereignty/", label: "Energy" },
  { href: "/health/", label: "Health" },
  { href: "/prosperous-aging/", label: "Aging" },
  { href: "/community-prosperity/", label: "Community Prosperity" },
  { href: "/local-ownership/", label: "Local Ownership" },
  { href: "/community-resilience/", label: "Resilience" },
  { href: "/transparency/", label: "Transparency" },
  { href: "/essential-systems/", label: "Essential Systems" },
  { href: "/human-capital/", label: "Human Capital" },
  { href: "/build-your-community/", label: "Build Community" },
  { href: "/resource-sovereignty/", label: "Resource Sovereignty" },
  { href: "/food-security/", label: "Food Security" },
  { href: "/family-farm-prosperity/", label: "Family Farms" },
  { href: "/evidence/", label: "Evidence" },
  { href: "/metrics/", label: "Metrics" },
  { href: "/compare/", label: "Compare" },
  { href: "/book/", label: "Book" },
  { href: "/status/", label: "Status" },
  { href: "/about/", label: "About" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={identity.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" data-site-header>
      <div class="site-header__bar">
        <a class="brand" href="/">
          <span class="brand__full">{identity.title}</span>
          <span class="brand__short" aria-hidden="true">CC</span>
        </a>
        <button
          type="button"
          class="nav-toggle"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="primary-nav"
        >
          <span class="nav-toggle__label" data-nav-toggle-label>Menu</span>
        </button>
      </div>
      <nav class="nav" id="primary-nav" data-primary-nav aria-label="Primary">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={path === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="main" class="shell" data-listen-root>
      <slot />
    </main>
    <ListenBar />
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>
          <strong>{identity.title}</strong> — {identity.subtitle}
        </p>
        <p>
          Free public edition intended. Manuscript in development. Licensing decision open.
          Project status: {identity.project_status}.
        </p>
        <p>
          <a href="/resources/">Resources</a> ·
          <a href="/updates/">Updates</a> ·
          <a href="/status/">Status</a>
        </p>
      </div>
    </footer>
    <script>
      const header = document.querySelector("[data-site-header]");
      const toggle = document.querySelector("[data-nav-toggle]");
      const nav = document.querySelector("[data-primary-nav]");
      const label = document.querySelector("[data-nav-toggle-label]");
      if (header && toggle && nav && label) {
        const setOpen = (open: boolean) => {
          header.classList.toggle("is-nav-open", open);
          document.body.classList.toggle("nav-lock", open);
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
          label.textContent = open ? "Close" : "Menu";
        };
        toggle.addEventListener("click", () => {
          setOpen(!header.classList.contains("is-nav-open"));
        });
        nav.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setOpen(false));
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") setOpen(false);
        });
        const mq = window.matchMedia("(min-width: 901px)");
        const syncDesktop = () => {
          if (mq.matches) setOpen(false);
        };
        mq.addEventListener("change", syncDesktop);
      }
    </script>
  </body>
</html>
