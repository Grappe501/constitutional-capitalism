---
import BaseLayout from "../../layouts/BaseLayout.astro";
import UnabridgedNav from "../../components/UnabridgedNav.astro";
import PartPager from "../../components/PartPager.astro";
import chapter from "../../../../../data/project/stage3_pass38_unabridged_integration.json";

const parts = chapter.master_toc?.parts || [];

export function getStaticPaths() {
  const roman = ["i", "ii", "iii", "iv", "v", "vi", "vii"];
  return roman.map((slug) => ({ params: { part: `part-${slug}` } }));
}

const slug = Astro.params.part || "";
const roman = slug.replace("part-", "").toUpperCase();
const idx = parts.findIndex((p: any) => p.roman === roman);
const part = parts[idx];
if (!part) {
  throw new Error(`Unknown part: ${slug}`);
}

const prev =
  idx > 0
    ? {
        href: `/unabridged/part-${parts[idx - 1].roman.toLowerCase()}/`,
        label: `Part ${parts[idx - 1].roman}`,
      }
    : null;
const next =
  idx < parts.length - 1
    ? {
        href: `/unabridged/part-${parts[idx + 1].roman.toLowerCase()}/`,
        label: `Part ${parts[idx + 1].roman}`,
      }
    : null;
---

<BaseLayout
  title={`Part ${part.roman} — ${part.title}`}
  path={`/unabridged/${slug}/`}
  description={`${part.subtitle}. Unabridged Constitutional Capitalism.`}
>
  <article class="unabridged">
    <header class="hub-banner">
      <span class="chip chip--done">Part {part.roman} · Pass {part.pass_number}</span>
      <h1>{part.title}</h1>
      <p class="lede">{part.subtitle}</p>
      <p class="muted">{part.governing_question}</p>
      <p class="lede" style="margin-top:0.75rem;">
        <strong>{part.organizing_sentence}</strong>
      </p>
      <ul class="link-board">
        <li><a href={part.href}>Open full engine →</a></li>
        <li><a href="/unabridged/#toc">Back to TOC →</a></li>
        <li><a href="/system/master-map/">Master Map →</a></li>
      </ul>
    </header>

    <UnabridgedNav current="toc" />
    <PartPager prev={prev} next={next} />

    <section class="hub-section" aria-labelledby="sections">
      <h2 id="sections">Sections in this part</h2>
      <ol class="stack">
        {
          (part.sections || []).map((s: any) => (
            <li>
              <strong>{s.id}</strong> — {s.title}
              {s.ref ? <span class="muted"> · {s.ref}</span> : null}
            </li>
          ))
        }
      </ol>
      <p class="muted">
        Full narrative, evidence panels, and visuals live on the engine surface. This reader page is
        the book spine into that surface.
      </p>
      <p>
        <a class="chip chip--live" href={part.href}>Continue in {part.title} engine →</a>
      </p>
    </section>

    <section class="hub-section" aria-labelledby="meta">
      <h2 id="meta">Part metadata</h2>
      <ul class="link-board">
        <li>Visuals shipped: {part.visual_count}</li>
        <li>Open validation questions: {part.ov_count}</li>
        <li>Category completion: {part.category_completion_percent}%</li>
        <li>
          Artifact: <code>{part.artifact}</code>
        </li>
      </ul>
    </section>

    <PartPager prev={prev} next={next} />
  </article>
</BaseLayout>
