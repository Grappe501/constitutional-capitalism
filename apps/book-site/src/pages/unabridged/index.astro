---
import BaseLayout from "../../layouts/BaseLayout.astro";
import UnabridgedNav from "../../components/UnabridgedNav.astro";
import chapter from "../../../../../data/project/stage3_pass38_unabridged_integration.json";

const parts = chapter.master_toc?.parts || [];
const jump = chapter.master_toc?.jump_index || [];
const cert = chapter.stage_3_certification || {};
const gates = chapter.certification?.gates || {};
---

<BaseLayout
  title="Unabridged Reader — Constitutional Capitalism"
  path="/unabridged/"
  description="Living technical book: Parts I–VII of Constitutional Capitalism for Arkansas, integrated and Stage 3 certified."
>
  <article class="unabridged">
    <header class="hub-banner">
      <span class="chip chip--done">Stage 3 certified · 8/8</span>
      <h1>Unabridged Reader</h1>
      <p class="lede">{chapter.organizing_sentence}</p>
      <p class="muted">{chapter.governing_question}</p>
      <p class="muted">
        {cert.decision_id} · {cert.update_id} · Architectural defects = {cert.architectural_defects} ·
        COUNTABLE = $0
      </p>
      <ul class="link-board">
        <li><a href="/unabridged/part-i/">Start Reading → Part I</a></li>
        <li><a href="/unabridged/certification/">Stage 3 Certification →</a></li>
        <li><a href="/system/master-map/">Master System Map →</a></li>
        <li><a href="/build-progress/passes/pass-3-8/">Pass 3.8 What Changed →</a></li>
      </ul>
    </header>

    <UnabridgedNav current="home" />

    <section class="hub-section" id="toc" aria-labelledby="toc-title">
      <h2 id="toc-title">Master Table of Contents</h2>
      <p class="lede">
        Part → Chapter/Section → Module → Evidence/Visual. Read linearly, or jump by concept.
      </p>
      <ol class="toc-parts">
        {
          parts.map((p: any) => (
            <li class="toc-part">
              <a href={`/unabridged/part-${p.roman.toLowerCase()}/`}>
                <span class="toc-part__roman">Part {p.roman}</span>
                <strong>{p.title}</strong>
                <span class="muted">{p.subtitle}</span>
              </a>
              <div class="toc-part__meta muted">
                Pass {p.pass_number} · {p.sections?.length || 0} sections ·{" "}
                <a href={p.href}>Open engine →</a>
              </div>
              <ul class="toc-sections">
                {(p.sections || []).map((s: any) => (
                  <li>
                    <span class="muted">{s.id}</span> {s.title}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="hub-section" id="jump" aria-labelledby="jump-title">
      <h2 id="jump-title">Jump index</h2>
      <ul class="link-board">
        {
          jump.map((j: any) => (
            <li>
              <a href={j.href}>
                {j.term} <span class="muted">· Part {j.part}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="closure">
      <h2 id="closure">Stage 3 closure</h2>
      <p class="lede">{cert.statement}</p>
      <ul class="link-board">
        {
          Object.entries(gates).map(([k, v]) => (
            <li>
              <span class={v ? "chip chip--done" : "chip chip--live"}>{v ? "PASS" : "FAIL"}</span>{" "}
              {k.replaceAll("_", " ")}
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
