---
import BaseLayout from "../../layouts/BaseLayout.astro";
import UnabridgedNav from "../../components/UnabridgedNav.astro";
import chapter from "../../../../../data/project/stage3_pass38_unabridged_integration.json";

const glossary = chapter.glossary || {};
const terms = glossary.terms || [];
---

<BaseLayout
  title="Canonical Glossary — Constitutional Capitalism"
  path="/unabridged/glossary/"
  description="One authoritative definition for each specialized term across Passes 3.1–3.7."
>
  <article class="unabridged">
    <header class="hub-banner">
      <span class="chip chip--done">Pass 3.8</span>
      <h1>{glossary.title || "Canonical Glossary"}</h1>
      <p class="lede">{glossary.rule}</p>
    </header>
    <UnabridgedNav current="glossary" />
    <section class="hub-section">
      <dl class="glossary-list">
        {
          terms.map((t: any) => (
            <>
              <dt id={t.term.replaceAll(/\s+/g, "-").toLowerCase()}>{t.term}</dt>
              <dd>{t.definition}</dd>
            </>
          ))
        }
      </dl>
    </section>
  </article>
</BaseLayout>
