---
import BaseLayout from "../layouts/BaseLayout.astro";
import cdf from "../../../../data/project/constitutional_defense_framework.json";

const loyalty = cdf.chain_of_loyalty?.order || [];
const fedFunctions = cdf.federal_defense_responsibilities?.functions || [];
const vetOpps = cdf.veterans_as_civic_leaders?.structured_opportunities || [];
const mentoring = cdf.veterans_as_civic_leaders?.community_mentoring || [];
const servicePaths = cdf.national_service?.pathways || [];
const familySupports = cdf.military_families?.supports || [];
const industry = cdf.defense_industries?.encourage || [];
const community = cdf.community_resilience?.contributions || [];
const tech = cdf.technology_and_force?.emphasis_areas || [];
const civicTopics = cdf.civic_education_and_defense?.topics || [];
const afterCare = cdf.care_after_service?.owes || [];
const limits = cdf.constitutional_limits?.military_must_never || [];
const resilience = cdf.national_resilience?.dimensions || [];
const testQs = cdf.constitutional_defense_test?.questions || [];
const branches = cdf.website_branches || [];
---

<BaseLayout
  title="Constitutional Defense"
  path="/constitutional-defense/"
  description="Constitutionally defensive national power — peace through strength under the Constitution. Neither hawkish nor pacifist. Victory measured by wars prevented."
>
  <article class="prose">
    <h1>{cdf.domain_title}</h1>
    <p class="status-note">
      Major pillar — architecture before statutes. Neither hawkish nor pacifist:{" "}
      <strong>constitutionally defensive</strong>. No invented force-structure, procurement, or VA
      cost statistics. Legal drafting remains 0%.
    </p>
    <p class="lede">{cdf.stance.purpose_of_national_power}</p>

    <h2>Governing principle</h2>
    <blockquote>
      <p>{cdf.governing_principle.text}</p>
    </blockquote>

    <h2>Larger philosophy</h2>
    <blockquote>
      <p>{cdf.larger_philosophy.text}</p>
    </blockquote>

    <h2>Chain of loyalty</h2>
    <p>{cdf.chain_of_loyalty.rule}</p>
    <ol>
      {loyalty.map((step: string) => (
        <li>{step}</li>
      ))}
    </ol>

    <h2>Federal defense responsibility</h2>
    <p>{cdf.federal_defense_responsibilities.summary}</p>
    <ul>
      {fedFunctions.map((f: string) => (
        <li>{f}</li>
      ))}
    </ul>
    <p class="status-note">{cdf.federal_defense_responsibilities.links_to_federalism}</p>

    <h2>Strength through deterrence</h2>
    <blockquote>
      <p>{cdf.deterrence.principle}</p>
    </blockquote>
    <p>
      Victory is measured by <strong>{cdf.deterrence.victory_measured_by}</strong> — not by{" "}
      {cdf.deterrence.victory_not_measured_by}.
    </p>

    <h2>Veterans as civic leaders</h2>
    <p>{cdf.veterans_as_civic_leaders.framing}</p>
    <ul>
      {vetOpps.map((o: string) => (
        <li>{o}</li>
      ))}
    </ul>
    <p>Local mentoring:</p>
    <ul>
      {mentoring.map((m: string) => (
        <li>{m}</li>
      ))}
    </ul>
    <p class="status-note">{cdf.veterans_as_civic_leaders.links_to_citizen_service}</p>

    <h2>National service</h2>
    <p>{cdf.national_service.summary}</p>
    <ul>
      {servicePaths.map((p: string) => (
        <li>{p}</li>
      ))}
    </ul>

    <h2>Military families</h2>
    <p>{cdf.military_families.summary}</p>
    <ul>
      {familySupports.map((s: string) => (
        <li>{s}</li>
      ))}
    </ul>

    <h2>Veterans’ healthcare</h2>
    <p>{cdf.veterans_healthcare.summary}</p>
    <p>{cdf.veterans_healthcare.distinction}</p>

    <h2>Defense industries</h2>
    <p>{cdf.defense_industries.summary}</p>
    <ul>
      {industry.map((i: string) => (
        <li>{i}</li>
      ))}
    </ul>

    <h2>Community resilience</h2>
    <p>{cdf.community_resilience.summary}</p>
    <ul>
      {community.map((c: string) => (
        <li>{c}</li>
      ))}
    </ul>
    <p>{cdf.community_resilience.result}</p>

    <h2>Technology and the military</h2>
    <p>{cdf.technology_and_force.summary}</p>
    <ul>
      {tech.map((t: string) => (
        <li>{t}</li>
      ))}
    </ul>
    <p>
      <strong>{cdf.technology_and_force.hard_rule}</strong>
    </p>

    <h2>Civic education and defense</h2>
    <p>{cdf.civic_education_and_defense.summary}</p>
    <ul>
      {civicTopics.map((t: string) => (
        <li>{t}</li>
      ))}
    </ul>

    <h2>Care after service</h2>
    <p>{cdf.care_after_service.summary}</p>
    <ul>
      {afterCare.map((a: string) => (
        <li>{a}</li>
      ))}
    </ul>

    <h2>Constitutional limits</h2>
    <p>{cdf.constitutional_limits.summary}</p>
    <p>The military should never:</p>
    <ul>
      {limits.map((l: string) => (
        <li>{l}</li>
      ))}
    </ul>

    <h2>National Resilience</h2>
    <p>{cdf.national_resilience.summary}</p>
    <ul>
      {resilience.map((d: string) => (
        <li>{d}</li>
      ))}
    </ul>
    <p>{cdf.national_resilience.local_foundation}</p>

    <h2>Constitutional defense test</h2>
    <p>{cdf.constitutional_defense_test.purpose}</p>
    <ol>
      {testQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>

    <h2>Website branches</h2>
    <ul>
      {branches.map((b: any) => (
        <li>
          <strong>{b.title}</strong> — {b.summary}
        </li>
      ))}
    </ul>

    <p class="status-note">
      See also <a href="/civic-wealth/">Civic Wealth</a>,{" "}
      <a href="/federalism/">Federalism</a>,{" "}
      <a href="/citizen-service/">Citizen-Service Government</a>,{" "}
      <a href="/peoples-branch/">People’s Branch</a>, and{" "}
      <a href="/food-security/">Food Security</a>.
    </p>
  </article>
</BaseLayout>
