---
import BaseLayout from "../layouts/BaseLayout.astro";
import ess from "../../../../data/project/essential_systems_framework.json";

const systems = ess.systems || [];
const methodQs = ess.chapter_method?.questions || [];
const testQs = ess.essential_systems_test?.questions || [];
const branches = ess.website_branches || [];
const chiMeasures = ess.community_health_index?.measures_beyond_hospital_capacity || [];
const preventionDomains = ess.preventive_society?.applies_beyond_healthcare || [];
---

<BaseLayout
  title="Essential Systems"
  path="/essential-systems/"
  description="Design banking, insurance, and healthcare so innovation is rewarded while the public interest remains protected."
>
  <article class="prose">
    <h1>{ess.domain_title}</h1>

    <p class="lede">{ess.role_in_philosophy}</p>

    <h2>Framing rule</h2>
    <p>{ess.framing_rule}</p>

    <h2>Constitutional question</h2>
    <blockquote>
      <p>{ess.constitutional_question.text}</p>
    </blockquote>

    <h2>How each chapter proceeds</h2>
    <p>{ess.chapter_method.summary}</p>
    <ol>
      {methodQs.map((q: any) => (
        <li>{q.text}</li>
      ))}
    </ol>

    <h2>Essential systems</h2>
    {
      systems.map((s: any) => (
        <section style="margin-bottom:1.75rem;">
          <h3>{s.title}</h3>
          <p>{s.purpose}</p>
          {s.foundational_idea && (
            <blockquote>
              <p>{s.foundational_idea}</p>
            </blockquote>
          )}
          {s.principle?.text && (
            <p>
              <strong>Principle:</strong> {s.principle.text}
            </p>
          )}
          {s.framing_caution && <p class="muted">{s.framing_caution}</p>}
          {s.design_questions?.length > 0 && (
            <>
              <p>Questions for study:</p>
              <ul>
                {s.design_questions.map((q: string) => (
                  <li>{q}</li>
                ))}
              </ul>
            </>
          )}
          {s.health_maintenance_investments?.length > 0 && (
            <>
              <p>Health-maintenance investments may include:</p>
              <ul>
                {s.health_maintenance_investments.map((i: string) => (
                  <li>{i}</li>
                ))}
              </ul>
            </>
          )}
          {s.note && <p class="muted">{s.note}</p>}
        </section>
      ))
    }

    <h2>Community Health Index</h2>
    <p>
      <strong>{ess.community_health_index.name}</strong> — {ess.community_health_index.summary}
    </p>
    
    <ul>
      {chiMeasures.map((m: string) => (
        <li>{m}</li>
      ))}
    </ul>

    <h2>A preventive society</h2>
    <blockquote>
      <p>{ess.preventive_society.goal}</p>
    </blockquote>
    <p>Applies beyond healthcare:</p>
    <ul>
      {preventionDomains.map((d: string) => (
        <li>{d}</li>
      ))}
    </ul>
    <p>{ess.preventive_society.measurement_note}</p>

    <h2>Essential Systems Test</h2>
    <p>{ess.essential_systems_test.purpose}</p>
    <ol>
      {testQs.map((q: any) => (
        <li>{q.text}</li>
      ))}
    </ol>

    <h2>Domain branches</h2>
    <ul>
      {branches.map((b: any) => (
        <li>{b.title}</li>
      ))}
    </ul>

    <p class="muted">
      See also <a href="/health/">Health, Human Capacity, and Community Care</a>,{" "}
      <a href="/transparency/">Transparency</a>,{" "}
      <a href="/public-service/">Public Service</a>, <a href="/justice/">Justice</a>, and{" "}
      <a href="/where-we-are/">Where we are</a>.
    </p>
  </article>
</BaseLayout>
