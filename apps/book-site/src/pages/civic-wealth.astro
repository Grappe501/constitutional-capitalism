---
import BaseLayout from "../layouts/BaseLayout.astro";
import cw from "../../../../data/project/civic_wealth_framework.json";

const pathway = cw.veteran_prosperity_pathway?.steps || [];
const wealthExamples = cw.wealth_through_contribution?.examples || [];
const multipliers = cw.service_multipliers?.multiplier_examples || [];
const accountUses = cw.civic_investment_account?.opportunity_uses || [];
const accountRules = cw.civic_investment_account?.rules || [];
const rural = cw.rural_revitalization?.community_offers_examples || [];
const never = cw.guardrails?.must_never_become || [];
const serviceForms = cw.constitutional_service_forms?.pathways || [];
const testQs = cw.civic_wealth_test?.questions || [];
const branches = cw.website_branches || [];
---

<BaseLayout
  title="Civic Wealth"
  path="/civic-wealth/"
  description="Thank you for strengthening the republic. Now the republic will invest in your next chapter of building it. Investment through contribution — not benefit stacks."
>
  <article class="prose">
    <h1>{cw.domain_title}</h1>

    <h2>The signature shift</h2>
    <p>
      Instead of: <em>{cw.signature_shift.from}</em>
    </p>
    <blockquote>
      <p>{cw.signature_shift.to}</p>
    </blockquote>
    <p>{cw.signature_shift.relationship}</p>

    <h2>Civic Wealth Ladder</h2>
    <blockquote>
      <p>{cw.governing_principle.text}</p>
    </blockquote>
    <p>
      <strong>Not the goal:</strong> {cw.governing_principle.goal_not}
    </p>
    <p>
      <strong>Goal:</strong> {cw.governing_principle.goal}
    </p>

    <h2>Core theme</h2>
    <blockquote>
      <p>{cw.core_theme.text}</p>
    </blockquote>
    <p>{cw.core_theme.not_equal_outcomes}</p>
    <p>{cw.core_theme.human_capital_link}</p>

    <h2>Veteran Prosperity Pathway</h2>
    <p>{cw.veteran_prosperity_pathway.summary}</p>
    <ol>
      {pathway.map((step: string) => (
        <li>{step}</li>
      ))}
    </ol>
    

    <h2>Wealth through contribution</h2>
    <p>{cw.wealth_through_contribution.summary}</p>
    <ul>
      {wealthExamples.map((e: string) => (
        <li>{e}</li>
      ))}
    </ul>

    <h2>Service multipliers</h2>
    <p>{cw.service_multipliers.summary}</p>
    <p>{cw.service_multipliers.base}</p>
    <ul>
      {multipliers.map((m: string) => (
        <li>{m}</li>
      ))}
    </ul>

    <h2>Civic Investment Account</h2>
    <p>{cw.civic_investment_account.summary}</p>
    <p>Opportunity uses:</p>
    <ul>
      {accountUses.map((u: string) => (
        <li>{u}</li>
      ))}
    </ul>
    <p>Rules:</p>
    <ul>
      {accountRules.map((r: string) => (
        <li>{r}</li>
      ))}
    </ul>
    

    <h2>Rural revitalization</h2>
    <p>{cw.rural_revitalization.summary}</p>
    <ul>
      {rural.map((r: string) => (
        <li>{r}</li>
      ))}
    </ul>

    <h2>Legacy Multiplier</h2>
    <p>{cw.legacy_multiplier.summary}</p>
    <p>{cw.legacy_multiplier.example}</p>
    <p>
      <strong>{cw.legacy_multiplier.rule}</strong>
    </p>

    <h2>Guardrails</h2>
    <p>{cw.guardrails.summary}</p>
    <p>Must never become:</p>
    <ul>
      {never.map((n: string) => (
        <li>{n}</li>
      ))}
    </ul>
    <p>{cw.guardrails.distinction_from_office_privilege}</p>
    <p>{cw.guardrails.distinction_from_dependency}</p>

    <h2>Constitutional Service</h2>
    <p>{cw.constitutional_service_forms.summary}</p>
    <ul>
      {serviceForms.map((s: string) => (
        <li>{s}</li>
      ))}
    </ul>

    <h2>Civic wealth test</h2>
    <p>{cw.civic_wealth_test.purpose}</p>
    <ol>
      {testQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>

    <h2>Website branches</h2>
    <ul>
      {branches.map((b: any) => (
        <li>
          <strong>{b.title}</strong> — {b.summary}
        </li>
      ))}
    </ul>

    <p class="muted">
      See also <a href="/constitutional-defense/">Constitutional Defense</a>,{" "}
      <a href="/citizen-service/">Citizen-Service Government</a>,{" "}
      <a href="/assistance/">Assistance</a>, and <a href="/human-capital/">Human Capital</a>.
    </p>
  </article>
</BaseLayout>
