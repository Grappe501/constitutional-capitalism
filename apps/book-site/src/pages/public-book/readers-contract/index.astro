---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import assembly from "../../../../../../data/project/stage5_pass511_whole_book_assembly.json";

const c = assembly.readers_contract;
---

<BaseLayout
  title="Reader's Contract — Public Book"
  path="/public-book/readers-contract/"
  description="What this book promises — and what it does not."
>
  <article class="public-book">
    <header class="hub-banner">
      <span class="chip chip--done">Public Book · Reader's Contract</span>
      <h1>Reader's Contract</h1>
      <p class="lede">One page. No fine print that cancels the honesty.</p>
    </header>

    <section class="hub-section">
      <h2>What this book promises</h2>
      <ul class="stack">
        {c.promises.map((p: string) => <li>{p}</li>)}
      </ul>
    </section>

    <section class="hub-section">
      <h2>What this book does not promise</h2>
      <ul class="stack">
        {c.does_not_promise.map((p: string) => <li>{p}</li>)}
      </ul>
    </section>

    <section class="hub-section">
      <blockquote>
        <p>{c.closing}</p>
      </blockquote>
      <ul class="link-board">
        <li><a href="/public-book/introduction/">Introduction →</a></li>
        <li><a href="/public-book/table-of-contents/">Table of Contents →</a></li>
        <li><a href="/public-book/the-arkansas-we-inherited/">Chapter 1 →</a></li>
      </ul>
    </section>
  </article>
</BaseLayout>
