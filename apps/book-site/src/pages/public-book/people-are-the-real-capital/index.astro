---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReadingModes from "../../../components/ReadingModes.astro";
import chapter from "../../../../../../data/project/stage5_pass54_people_are_the_real_capital.json";
import plan from "../../../../../../data/project/stage5_eleven_pass_plan.json";

const sections = chapter.sections || [];
const visuals = chapter.signature_visuals || [];
const rrab = chapter.rrab || [];
const sidebar = chapter.sidebar_dignity || {};
const trace = chapter.traceability || [];
const cert = chapter.certification || {};
const ladder = chapter.learn_earn_own || [];
---

<BaseLayout
  title="People Are the Real Capital — Public Book"
  path="/public-book/people-are-the-real-capital/"
  description="Public Book Chapter 4: human capability, pathways, Demand Map boundaries, Retain–Return–Attract–Belong, and AI without magic retraining."
>
  <article class="public-book">
    <header class="hub-banner">
      <span class="chip chip--done">Public Book · Chapter 4 · Pass 5.4</span>
      <p class="muted">Volume II · ~{chapter.approx_pages} pages</p>
      <h1>{chapter.pass_name}</h1>
      <p class="lede">{chapter.governing_proposition}</p>
      <p class="lede" style="margin-top:0.75rem;">
        <strong>{chapter.demand_principle}</strong>
      </p>
      <ul class="link-board">
        <li><a href="/public-book/">Public Book hub →</a></li>
        <li><a href="/public-book/follow-the-money/">Chapter 3 →</a></li>
        <li><a href="/system/human-community-engine/">Unabridged Human &amp; Community Capital →</a></li>
        <li><a href="/build-progress/passes/pass-5-4/">What Changed →</a></li>
      </ul>
      <p class="muted">
        Technical System 100% · Public Book {cert.public_book_completion_percent_after}% · COUNTABLE $0
        · {chapter.decision_id} · {chapter.update_id}
      </p>
    </header>

    <ReadingModes />

    <section class="hub-section" id="visuals" data-depth="understand" data-depth-keep>
      <h2>Five signature visuals</h2>
      <ul class="stack">
        {
          visuals.map((v: any) => (
            <li>
              <strong>
                {v.id} · {v.title}
              </strong>
              <div class="muted">
                {v.shows}
                {v.claim_class ? ` · ${v.claim_class}` : ""}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="rrab">
      <h2>Retain → Return → Attract → Belong</h2>
      <ul class="stack">
        {
          rrab.map((r: any) => (
            <li>
              <strong>{r.id}</strong> — {r.plain}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="learn-earn">
      <h2>LEARN → OWN</h2>
      <p class="lede">{ladder.join(" → ")}</p>
      <p class="muted">Diversify. Do not put a household's entire future into one employer.</p>
    </section>

    <section class="hub-section" id="dignity">
      <h2>{sidebar.title}</h2>
      <blockquote class="lede" style="font-size:1.1rem;">{sidebar.text}</blockquote>
    </section>

    {
      sections.map((s: any) => (
        <section class="hub-section" id={s.id.toLowerCase()}>
          <h2>{s.heading}</h2>
          {s.prose.map((p: string) => (
            <p class="lede" style="font-size:1.05rem; font-weight:400;">{p}</p>
          ))}
        </section>
      ))
    }

    <section class="hub-section" id="purpose">
      <h2>Purpose lock</h2>
      <blockquote class="lede" style="font-size:1.15rem;">{chapter.purpose_lock}</blockquote>
    </section>

    <section class="hub-section" id="trace">
      <h2>Trace this chapter</h2>
      <ul class="stack">
        {
          trace.map((t: any) => (
            <li>
              <span class="chip chip--done">{t.class}</span> {t.claim}
              <div class="muted">
                {t.source_note} · <a href={t.unabridged}>Open →</a>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Next</h2>
      <p class="lede">Pass 5.5 — The Productive Arkansas</p>
      <ul class="link-board">
        {
          (plan.passes || []).slice(0, 6).map((p: any) => (
            <li>
              <span class={p.status === "COMPLETE" ? "chip chip--done" : "chip chip--queued"}>
                {p.status}
              </span>{" "}
              {p.number} {p.name}
              {p.surface_href ? (
                <>
                  {" "}
                  · <a href={p.surface_href}>Read →</a>
                </>
              ) : null}
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
