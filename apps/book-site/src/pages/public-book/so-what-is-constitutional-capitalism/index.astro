---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReadingModes from "../../../components/ReadingModes.astro";
import PublicBookChapterNav from "../../../components/PublicBookChapterNav.astro";
import chapter from "../../../../../../data/project/stage5_pass57_so_what_is_constitutional_capitalism.json";
import plan from "../../../../../../data/project/stage5_eleven_pass_plan.json";

const sections = chapter.sections || [];
const commitments = chapter.seven_commitments || [];
const isNot = chapter.what_it_is_not || [];
const eightQ = chapter.eight_questions || [];
const matrix = chapter.comparison_matrix || {};
const visuals = chapter.signature_visuals || [];
const trace = chapter.traceability || [];
const cert = chapter.certification || {};
const explorerLinks = matrix.explorer_links || [];
---

<BaseLayout
  title="So What Is Constitutional Capitalism? — Public Book"
  path="/public-book/so-what-is-constitutional-capitalism/"
  description="Public Book Chapter 7: the synthesis — what Constitutional Capitalism is, what it is not, and the eight questions it asks everywhere."
>
  <article class="public-book">
    <header class="hub-banner">
      <span class="chip chip--done">Public Book · Chapter 7 · Pass 5.7</span>
      <p class="muted">Volume II · ~{chapter.approx_pages} pages</p>
      <h1>{chapter.pass_name}</h1>
      <p class="lede">{chapter.governing_question}</p>
      <p class="lede" style="margin-top:0.75rem;">
        <strong>{chapter.central_line}</strong>
      </p>
      <ul class="link-board">
        <li><a href="/public-book/">Public Book hub →</a></li>
        <li><a href="/public-book/government-that-belongs-to-the-people/">Chapter 6 →</a></li>
        <li><a href="/compare/explorer/constitutional-capitalism/">Comparison Explorer →</a></li>
        <li><a href="/build-progress/passes/pass-5-7/">What Changed →</a></li>
      </ul>
      <p class="muted">
        Technical System 100% · Public Book {cert.public_book_completion_percent_after}% · COUNTABLE $0
        · {chapter.decision_id} · {chapter.update_id}
      </p>
    </header>

    <ReadingModes />

    <section class="hub-section" id="definitions" data-depth="understand" data-depth-keep>
      <h2>Canonical definitions</h2>
      <blockquote class="lede" style="font-size:1.1rem;">
        {chapter.canonical_definition_long}
      </blockquote>
      <p class="lede" style="margin-top:1rem;">
        <strong>{chapter.canonical_definition_short}</strong>
      </p>
    </section>

    <section class="hub-section" id="layers">
      <h2>Three layers</h2>
      <ul class="link-board">
        <li>
          <strong>Public Book → UNDERSTAND</strong>
          <div class="muted">This chapter</div>
        </li>
        <li>
          <strong>Explorer → LEARN</strong>
          <div class="muted"><a href="/compare/explorer/">Comparison Explorer →</a></div>
        </li>
        <li>
          <strong>Unabridged → PROVE</strong>
          <div class="muted"><a href="/unabridged/">Technical system →</a></div>
        </li>
      </ul>
    </section>

    <section class="hub-section" id="commitments">
      <h2>Seven core commitments</h2>
      <ol class="stack">
        {
          commitments.map((c: any) => (
            <li>
              <strong>{c.title}</strong>
              <div class="muted">{c.body}</div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="hub-section" id="is-not">
      <h2>What it is not</h2>
      <ul class="stack">
        {
          isNot.map((x: any) => (
            <li>
              <strong>{x.title}</strong>
              <div class="muted">{x.body}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="eight-questions">
      <h2>Eight questions CC asks everywhere</h2>
      <ol class="stack">
        {eightQ.map((q: any) => <li>{q.q}</li>)}
      </ol>
    </section>

    <section class="hub-section" id="comparison">
      <h2>Five-system comparison</h2>
      <div style="overflow-x:auto;">
        <table>
          <thead>
            <tr>
              <th>Question</th>
              {(matrix.columns || []).map((col: string) => <th>{col}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              (matrix.rows || []).map((row: any) => (
                <tr>
                  <th scope="row">{row.question}</th>
                  {(row.cells || []).map((cell: string) => <td>{cell}</td>)}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <h3 style="margin-top:1.25rem;">Go deeper</h3>
      <ul class="link-board">
        {
          explorerLinks.map((l: any) => (
            <li>
              <a href={l.href}>{l.label} →</a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="countable">
      <h2>COUNTABLE = $0</h2>
      <p class="lede">{chapter.countable_meaning}</p>
    </section>

    <section class="hub-section" id="visuals">
      <h2>Six signature visuals</h2>
      <ul class="stack">
        {
          visuals.map((v: any) => (
            <li>
              <strong>
                {v.id} · {v.title}
              </strong>
              <div class="muted">{v.shows}</div>
            </li>
          ))
        }
      </ul>
    </section>

    {
      sections.map((s: any) => (
        <section class="hub-section" id={s.id.toLowerCase()}>
          <h2>{s.heading}</h2>
          {s.prose.map((p: string) => (
            <p class="lede" style="font-size:1.05rem; font-weight:400;">{p}</p>
          ))}
        </section>
      ))
    }

    <section class="hub-section" id="trace">
      <h2>Trace this chapter</h2>
      <ul class="stack">
        {
          trace.map((t: any) => (
            <li>
              <span class="chip chip--done">{t.class}</span> {t.claim}
              <div class="muted">
                {t.source_note} · <a href={t.unabridged}>Open →</a>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Next</h2>
      <p class="lede">
        Pass 5.8 — Building the Bridge ·{" "}
        <a href="/public-book/building-the-bridge/">Read →</a>
      </p>
      <ul class="link-board">
        {
          (plan.passes || []).slice(0, 10).map((p: any) => (
            <li>
              <span class={p.status === "COMPLETE" ? "chip chip--done" : "chip chip--queued"}>
                {p.status}
              </span>{" "}
              {p.number} {p.name}
              {p.surface_href ? (
                <>
                  {" "}
                  · <a href={p.surface_href}>Read →</a>
                </>
              ) : null}
            </li>
          ))
        }
      </ul>
    </section>
  
    <PublicBookChapterNav chapter={7} />
  </article>
</BaseLayout>
