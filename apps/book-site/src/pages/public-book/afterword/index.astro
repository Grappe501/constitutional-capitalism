---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import assembly from "../../../../../../data/project/stage5_pass511_whole_book_assembly.json";

const a = assembly.afterword;
---

<BaseLayout
  title="Afterword — Public Book"
  path="/public-book/afterword/"
  description="An invitation to test Constitutional Capitalism — not a demand to agree."
>
  <article class="public-book">
    <header class="hub-banner">
      <span class="chip chip--done">Public Book · Afterword</span>
      <h1>{a.title}</h1>
    </header>

    <section class="hub-section" style="max-width:38rem;">
      {a.body.map((p: string) => <p class="lede">{p}</p>)}
    </section>

    <section class="hub-section">
      <ul class="link-board">
        {a.links.map((l: any) => (
          <li>
            <a href={l.href}>{l.label} →</a>
          </li>
        ))}
        <li><a href="/public-book/the-arkansas-we-could-leave-behind/">Return to Chapter 10 →</a></li>
        <li><a href="/public-book/certification/">Certification record →</a></li>
      </ul>
    </section>
  </article>
</BaseLayout>
