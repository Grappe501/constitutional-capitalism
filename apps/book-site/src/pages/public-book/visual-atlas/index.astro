---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import assembly from "../../../../../../data/project/stage5_pass511_whole_book_assembly.json";

const visuals = assembly.visual_atlas || [];
const chapters = assembly.chapters || [];
const byN = Object.fromEntries(chapters.map((c: any) => [c.n, c]));
---

<BaseLayout
  title="Visual Atlas — Public Book"
  path="/public-book/visual-atlas/"
  description="Major conceptual visuals of the Public Book, linked back to the chapters that teach them."
>
  <article class="public-book">
    <header class="hub-banner">
      <span class="chip chip--done">Public Book · Visual Atlas</span>
      <h1>Visual Atlas</h1>
      <p class="lede">
        A visual way through the philosophy. Each card links to the chapter that teaches it.
      </p>
    </header>

    <section class="hub-section">
      <ul class="stack">
        {
          visuals.map((v: any) => (
            <li>
              <strong>{v.title}</strong>
              <div class="muted">
                Chapter {v.chapter}
                {byN[v.chapter] ? ` — ${byN[v.chapter].title}` : ""}
              </div>
              <a href={v.href}>Open in chapter →</a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <ul class="link-board">
        <li><a href="/public-book/system-map/">One-page system map →</a></li>
        <li><a href="/public-book/table-of-contents/">Table of Contents →</a></li>
        <li><a href="/system/visual-language/">Technical visual language →</a></li>
      </ul>
    </section>
  </article>
</BaseLayout>
