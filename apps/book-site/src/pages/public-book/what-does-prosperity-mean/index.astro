---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReadingModes from "../../../components/ReadingModes.astro";
import PublicBookChapterNav from "../../../components/PublicBookChapterNav.astro";
import chapter from "../../../../../../data/project/stage5_pass52_what_does_prosperity_mean.json";
import plan from "../../../../../../data/project/stage5_eleven_pass_plan.json";

const sections = chapter.sections || [];
const dims = chapter.five_dimensions || [];
const surplus = chapter.prosperity_surplus || {};
const agency = chapter.agency || {};
const visuals = chapter.signature_visuals || [];
const rivers = chapter.three_rivers || {};
const notSaying = chapter.not_saying || {};
const def = chapter.locked_definition || {};
const trace = chapter.traceability || [];
const stage4 = chapter.stage4_preservations || [];
const cert = chapter.certification || {};
const guides = chapter.recurring_guides || {};
---

<BaseLayout
  title="What Does Prosperity Mean? — Public Book"
  path="/public-book/what-does-prosperity-mean/"
  description="Public Book Chapter 2: Income, cost, security, ownership, and time — and why GDP and jobs alone are not prosperity."
>
  <article class="public-book">
    <header class="hub-banner">
      <span class="chip chip--done">Public Book · Chapter 2 · Pass 5.2</span>
      <p class="muted">Volume II · ~{chapter.approx_pages} pages · Clarity controls length</p>
      <h1>{chapter.pass_name}</h1>
      <p class="lede">{chapter.governing_job}</p>
      <ul class="link-board">
        <li><a href="/public-book/">Public Book hub →</a></li>
        <li><a href="/public-book/the-arkansas-we-inherited/">Chapter 1 →</a></li>
        <li><a href="/system/household-engine/">Unabridged Household Prosperity →</a></li>
        <li><a href="/build-progress/passes/pass-5-2/">What Changed →</a></li>
      </ul>
      <p class="muted">
        Technical System 100% · Public Book {cert.public_book_completion_percent_after}% · COUNTABLE $0
        · {chapter.decision_id} · {chapter.update_id}
      </p>
      <p class="muted">
        Guides: {guides.household?.name} ({guides.household?.claim_class}) ·{" "}
        {guides.community?.name} ({guides.community?.claim_class})
      </p>
    </header>

    <ReadingModes />

    <section class="hub-section" id="dashboard" data-depth="understand" data-depth-keep>
      <h2>The Household Prosperity Dashboard</h2>
      <ul class="stack">
        {
          dims.map((d: any) => (
            <li>
              <strong>{d.label}</strong> — {d.question}
              <div class="muted">{d.plain}</div>
            </li>
          ))
        }
      </ul>
      <p class="lede">
        Around the center: <strong>Agency</strong> — {agency.definition}
      </p>
    </section>

    <section class="hub-section" id="funnel">
      <h2>The Prosperity Funnel</h2>
      <p class="lede"><strong>{surplus.formula}</strong></p>
      <p class="muted">{surplus.not_meaning}</p>
      <p>{surplus.is_meaning}</p>
      <p class="lede">{surplus.honesty}</p>
      <span class="chip chip--live">{surplus.claim_class}</span>
    </section>

    <section class="hub-section" id="visuals">
      <h2>Five signature visuals</h2>
      <ul class="stack">
        {
          visuals.map((v: any) => (
            <li>
              <strong>
                {v.id} · {v.title}
              </strong>
              <div class="muted">
                {v.shows}
                {v.claim_class ? ` · ${v.claim_class}` : ""}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    {
      sections.map((s: any) => (
        <section class="hub-section" id={s.id.toLowerCase()}>
          <h2>{s.heading}</h2>
          {s.prose.map((p: string) => (
            <p class="lede" style="font-size:1.05rem; font-weight:400;">{p}</p>
          ))}
        </section>
      ))
    }

    <section class="hub-section" id="three-rivers">
      <h2>Same Income, Different Life</h2>
      <span class="chip chip--live">{rivers.claim_class}</span>
      <p class="muted">{rivers.note}</p>
      <ul class="stack">
        {
          (rivers.rows || [])
            .filter((r: any) => r.id)
            .map((r: any) => (
              <li>
                <strong>
                  {r.id} — {r.title}
                </strong>
                <div class="muted">{r.pattern}</div>
              </li>
            ))
        }
      </ul>
      {
        rivers.rows?.find((r: any) => r.question) && (
          <p class="lede">
            {rivers.rows.find((r: any) => r.question).question}{" "}
            {rivers.rows.find((r: any) => r.answer_method).answer_method}
          </p>
        )
      }
    </section>

    <section class="hub-section" id="definition">
      <h2>The locked definition</h2>
      <blockquote class="lede" style="font-size:1.15rem;">
        {def.text}
      </blockquote>
      <p class="muted">
        {def.origin} · <span class="chip chip--done">{def.status}</span>
      </p>
    </section>

    <section class="hub-section" id="not-saying">
      <h2>{notSaying.title}</h2>
      <p class="muted">We are not saying:</p>
      <ul class="link-board">
        {(notSaying.items || []).map((i: string) => <li>{i}</li>)}
      </ul>
      <p class="muted">We are saying:</p>
      <ul class="stack">
        {(notSaying.instead || []).map((i: string) => (
          <li class="lede" style="font-weight:400;">{i}</li>
        ))}
      </ul>
    </section>

    <section class="hub-section" id="stage4">
      <h2>Stage 4 corrections preserved</h2>
      <ul class="stack">
        {stage4.map((s: string) => <li>{s}</li>)}
      </ul>
    </section>

    <section class="hub-section" id="trace">
      <h2>Trace this chapter</h2>
      <ul class="stack">
        {
          trace.map((t: any) => (
            <li>
              <span class="chip chip--done">{t.class}</span> {t.claim}
              <div class="muted">
                {t.source_note} · <a href={t.unabridged}>Open source surface →</a>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <PublicBookChapterNav chapter={2} />
  </article>
</BaseLayout>
