---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import assembly from "../../../../../../data/project/stage5_pass511_whole_book_assembly.json";
import ch7 from "../../../../../../data/project/stage5_pass57_so_what_is_constitutional_capitalism.json";

const faq = assembly.is_is_not_faq || [];
const isNot = ch7.what_it_is_not || [];
---

<BaseLayout
  title="What CC Is / Is Not — Public Book"
  path="/public-book/is-is-not/"
  description="Compact reference: socialism? laissez-faire? tax abolition? Who governs?"
>
  <article class="public-book">
    <header class="hub-banner">
      <span class="chip chip--done">Public Book · Boundaries</span>
      <h1>What Constitutional Capitalism Is — and Is Not</h1>
      <p class="lede">
        {ch7.canonical_definition_short}
      </p>
      <p class="muted">{ch7.canonical_definition_long}</p>
    </header>

    <section class="hub-section">
      <h2>Five-minute answers</h2>
      <ul class="stack">
        {
          faq.map((item: any) => (
            <li>
              <strong>{item.q}</strong>
              <div>{item.a}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Fair boundaries (from Chapter 7)</h2>
      <ul class="stack">
        {
          isNot.map((item: any) => (
            <li>
              <strong>{item.title}</strong>
              <div>{item.body}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <ul class="link-board">
        <li><a href="/public-book/so-what-is-constitutional-capitalism/">Full Chapter 7 →</a></li>
        <li><a href="/compare/explorer/constitutional-capitalism/">Explorer flagship →</a></li>
        <li><a href="/unabridged/is-is-not/">Unabridged Is / Is Not →</a></li>
      </ul>
    </section>
  </article>
</BaseLayout>
