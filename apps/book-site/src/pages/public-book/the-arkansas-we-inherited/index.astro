---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PublicBookChapterNav from "../../../components/PublicBookChapterNav.astro";
import chapter from "../../../../../../data/project/public_book_ch01_narrative.json";

const sections = chapter.sections || [];
const turn = chapter.turn_the_page || {};
const authorsNote = chapter.authors_note || "";

function renderProse(p: string) {
  return p.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
}
---

<BaseLayout
  title="The Arkansas We Inherited — Public Book"
  path="/public-book/the-arkansas-we-inherited/"
  description="Chapter 1 of Constitutional Capitalism — why ordinary prosperity feels harder, told through Arkansas life."
  readingRoom={true}
>
  <article class="reading-room">
    <header class="reading-room__open">
      <p class="reading-room__book">{chapter.book_title || "Constitutional Capitalism"}</p>
      <p class="reading-room__kicker">Chapter 1</p>
      <h1>{chapter.title}</h1>
    </header>

    {
      sections.map((s: any) => (
        <section class="reading-room__section" id={s.id}>
          {s.heading ? <h2>{s.heading}</h2> : null}
          {s.prose.map((p: string) => (
            <p class="reading-room__p" set:html={renderProse(p)} />
          ))}
        </section>
      ))
    }

    <p class="reading-room__turn">
      <a href={turn.href || "/public-book/what-does-prosperity-mean/"}>
        {turn.label || "Chapter 2 →"}
      </a>
    </p>

    <PublicBookChapterNav chapter={1} readingRoom={true} />

    <details class="reading-room__note">
      <summary>Author's note</summary>
      <p>{authorsNote}</p>
      <p class="reading-room__note-links">
        <a href="/evidence/">Sources / Evidence</a>
        {" · "}
        <a href="/book/">All chapters</a>
      </p>
    </details>
  </article>
</BaseLayout>

<style>
  .reading-room {
    max-width: 36rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 5rem;
  }
  .reading-room__open {
    margin-bottom: 2.75rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--ink, #1a2b24) 12%, transparent);
  }
  .reading-room__book {
    font-family: var(--font-sans, Manrope, system-ui, sans-serif);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink, #1a2b24) 55%, transparent);
    margin: 0 0 1.25rem;
  }
  .reading-room__kicker {
    font-family: var(--font-sans, Manrope, system-ui, sans-serif);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent, #0f6e56);
    margin: 0 0 0.65rem;
  }
  .reading-room__open h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.55rem);
    line-height: 1.12;
    margin: 0;
  }
  .reading-room__section {
    margin: 0 0 0.25rem;
  }
  .reading-room__p {
    font-size: 1.145rem;
    line-height: 1.72;
    margin: 0 0 1.2rem;
  }
  .reading-room__turn {
    margin: 2.75rem 0 1.5rem;
    font-size: 1.08rem;
  }
  .reading-room__turn a {
    font-weight: 600;
  }
  .reading-room__note {
    margin: 2.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--ink, #1a2b24) 10%, transparent);
    font-size: 0.92rem;
    color: color-mix(in srgb, var(--ink, #1a2b24) 68%, transparent);
  }
  .reading-room__note summary {
    cursor: pointer;
    font-family: var(--font-sans, Manrope, system-ui, sans-serif);
    color: color-mix(in srgb, var(--ink, #1a2b24) 58%, transparent);
  }
  .reading-room__note p {
    margin: 0.85rem 0 0;
    line-height: 1.55;
  }
  .reading-room__note-links {
    font-size: 0.88rem;
  }
</style>
