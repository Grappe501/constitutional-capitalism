---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import assembly from "../../../../../../data/project/stage5_pass511_whole_book_assembly.json";

const intro = assembly.introduction;
---

<BaseLayout
  title="Introduction — Public Book"
  path="/public-book/introduction/"
  description="Why this book, why Arkansas, why now, and how to read it."
>
  <article class="public-book">
    <header class="hub-banner">
      <span class="chip chip--done">Public Book · Introduction</span>
      <h1>{intro.title}</h1>
      <p class="lede">{intro.opening}</p>
    </header>

    <section class="hub-section">
      <h2>Why this book?</h2>
      <p>{intro.why_this_book}</p>
    </section>

    <section class="hub-section">
      <h2>Why Arkansas?</h2>
      <p>{intro.why_arkansas}</p>
    </section>

    <section class="hub-section">
      <h2>Why now?</h2>
      <p>{intro.why_now}</p>
    </section>

    <section class="hub-section">
      <h2>How should I read it?</h2>
      <p>{intro.how_to_read}</p>
      <blockquote>
        <p><strong>{intro.unusual}</strong></p>
      </blockquote>
    </section>

    <section class="hub-section">
      <ul class="link-board">
        <li><a href="/public-book/readers-contract/">Reader's Contract →</a></li>
        <li><a href="/public-book/table-of-contents/">Table of Contents →</a></li>
        <li><a href="/public-book/the-arkansas-we-inherited/">Begin Chapter 1 →</a></li>
      </ul>
    </section>
  </article>
</BaseLayout>
