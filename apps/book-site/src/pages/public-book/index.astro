---
import BaseLayout from "../../layouts/BaseLayout.astro";
import completion from "../../../../../data/project/completion_ladder_and_dashboard.json";
import plan from "../../../../../data/project/stage5_eleven_pass_plan.json";
import assembly from "../../../../../data/project/stage5_pass511_whole_book_assembly.json";

const tech = completion.technical_system || {};
const book = completion.public_book || {};
const explorer = completion.comparison_explorer_lane || {};
const bars = completion.stage5_category_bars || plan.passes || [];
const status = assembly.project_status_after || {};
const chapters = (assembly.chapters || []).filter((c: any) => c.n <= 10);

function chipClass(status?: string) {
  if (status === "COMPLETE" || status === "CERTIFIED") return "chip chip--done";
  if (status === "ACTIVE" || status === "NEXT") return "chip chip--live";
  return "chip chip--queued";
}
---

<BaseLayout
  title="Public Book — Volume II"
  path="/public-book/"
  description="The certified Public Book of Constitutional Capitalism — ten chapters, one argument."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">{status.banner || "FOUNDATIONAL BUILD — COMPLETE"}</span>
      <h1>The Public Book</h1>
      <p class="lede">
        Ten chapters. One continuous argument — from the Arkansas we inherited to the Arkansas we
        could leave behind.
      </p>
      <p class="muted">
        House style: <strong>Arkansas'</strong> — never “Arkansas's.” COUNTABLE <strong>$0</strong>.
      </p>
    </header>

    <section class="hub-section">
      <h2>Start here</h2>
      <ul class="link-board">
        <li><a href="/public-book/introduction/">Introduction →</a></li>
        <li><a href="/public-book/readers-contract/">Reader's Contract →</a></li>
        <li><a href="/public-book/table-of-contents/">Table of Contents →</a></li>
        <li><a href="/public-book/the-arkansas-we-inherited/">Chapter 1 →</a></li>
        <li><a href="/public-book/follow-one-idea/">Follow One Idea →</a></li>
        <li><a href="/public-book/certification/">Certification →</a></li>
      </ul>
    </section>

    <section class="hub-section">
      <h2>Scoreboard</h2>
      <ul class="link-board">
        <li>
          <span class="chip chip--done">{tech.status || "CERTIFIED"}</span>{" "}
          <strong>{tech.label || "TECHNICAL SYSTEM"}</strong> — {tech.percent ?? 100}%
        </li>
        <li>
          <span class={chipClass(book.status)}>{book.status || "CERTIFIED"}</span>{" "}
          <strong>{book.label || "PUBLIC BOOK"}</strong> — {book.percent ?? 100}% ({book.chapters_complete ?? 11}/
          {book.chapters_total ?? 11})
          <div class="muted">{book.note}</div>
        </li>
        <li>
          <span class="chip chip--queued">{explorer.status || "PARALLEL"}</span>{" "}
          <strong>{explorer.label || "COMPARISON EXPLORER"}</strong>
          <div class="muted">
            Living educational resource · <a href={explorer.href || "/compare/explorer/"}>Open Explorer →</a>
          </div>
        </li>
      </ul>
    </section>

    <section class="hub-section">
      <h2>The ten chapters</h2>
      <ol class="stack">
        {
          chapters.map((ch: any) => (
            <li>
              <strong>
                {ch.n}. {ch.title}
              </strong>
              <span class="muted"> — {ch.role}</span>
              <div>
                <em>{ch.question}</em>
              </div>
              <a href={ch.href}>Read →</a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="hub-section">
      <h2>Tools</h2>
      <ul class="link-board">
        <li><a href="/public-book/visual-atlas/">Visual Atlas →</a></li>
        <li><a href="/public-book/glossary/">Glossary →</a></li>
        <li><a href="/public-book/is-is-not/">What CC Is / Is Not →</a></li>
        <li><a href="/public-book/system-map/">One-Page System Map →</a></li>
        <li><a href="/public-book/afterword/">Afterword →</a></li>
      </ul>
    </section>

    <section class="hub-section">
      <h2>How deep?</h2>
      <ul class="stack">
        <li><strong>UNDERSTAND</strong> — Public Book (this volume)</li>
        <li>
          <strong>LEARN</strong> — <a href="/compare/explorer/">Comparison Explorer</a>
        </li>
        <li>
          <strong>PROVE</strong> — <a href="/unabridged/">Unabridged</a> / <a href="/evidence/">Evidence</a>
        </li>
        <li>
          <strong>BUILD</strong> — Implementation manuals <span class="chip chip--queued">FUTURE</span>
        </li>
      </ul>
    </section>

    <section class="hub-section">
      <h2>Assembly passes</h2>
      <ul class="stack">
        {
          bars.map((p: any) => (
            <li>
              <span class={chipClass(p.status)}>{(p.status || "").replaceAll("_", " ")}</span>{" "}
              <strong>{p.label || `${p.number} ${p.name}`}</strong>
              {p.surface || p.surface_href ? (
                <>
                  {" "}
                  · <a href={p.surface || p.surface_href}>Open →</a>
                </>
              ) : null}
              {p.href ? (
                <>
                  {" "}
                  · <a href={p.href}>What Changed →</a>
                </>
              ) : null}
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
