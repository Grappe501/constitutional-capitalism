---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import assembly from "../../../../../../data/project/stage5_pass511_whole_book_assembly.json";

const chapters = assembly.chapters || [];
---

<BaseLayout
  title="Table of Contents — Public Book"
  path="/public-book/table-of-contents/"
  description="Ten chapters. Ten questions. One argument."
>
  <article class="public-book">
    <header class="hub-banner">
      <span class="chip chip--done">Public Book · Contents</span>
      <h1>Table of Contents</h1>
      <p class="lede">Each chapter asks one question. Together they form one argument.</p>
    </header>

    <section class="hub-section">
      <ol class="stack">
        {
          chapters.map((ch: any) => (
            <li>
              <strong>
                {ch.n}. {ch.title}
              </strong>
              <span class="muted"> — {ch.role}</span>
              <div class="lede" style="margin:0.35rem 0 0.15rem;">
                <em>{ch.question}</em>
              </div>
              <a href={ch.href}>Read →</a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="hub-section">
      <h2>Front matter &amp; tools</h2>
      <ul class="link-board">
        <li><a href="/public-book/introduction/">Introduction →</a></li>
        <li><a href="/public-book/readers-contract/">Reader's Contract →</a></li>
        <li><a href="/public-book/follow-one-idea/">Follow One Idea →</a></li>
        <li><a href="/public-book/visual-atlas/">Visual Atlas →</a></li>
        <li><a href="/public-book/glossary/">Glossary →</a></li>
        <li><a href="/public-book/is-is-not/">What CC Is / Is Not →</a></li>
        <li><a href="/public-book/system-map/">One-Page System Map →</a></li>
        <li><a href="/public-book/afterword/">Afterword →</a></li>
        <li><a href="/public-book/certification/">Certification →</a></li>
      </ul>
    </section>
  </article>
</BaseLayout>
