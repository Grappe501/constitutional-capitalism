---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReadingModes from "../../../components/ReadingModes.astro";
import chapter from "../../../../../../data/project/stage5_pass56_government_that_belongs_to_the_people.json";
import plan from "../../../../../../data/project/stage5_eleven_pass_plan.json";

const sections = chapter.sections || [];
const roles = chapter.government_roles || [];
const breakers = chapter.capture_breaker_families || [];
const aiLevels = chapter.ai_power_levels || [];
const visuals = chapter.signature_visuals || [];
const boxes = chapter.misconception_boxes || [];
const trace = chapter.traceability || [];
const cert = chapter.certification || {};
---

<BaseLayout
  title="Government That Belongs to the People — Public Book"
  path="/public-book/government-that-belongs-to-the-people/"
  description="Public Book Chapter 6: capable but constrained government — Opposition Test, sovereignty, capture breakers, and citizens govern."
>
  <article class="public-book">
    <header class="hub-banner">
      <span class="chip chip--done">Public Book · Chapter 6 · Pass 5.6</span>
      <p class="muted">Volume II · ~{chapter.approx_pages} pages</p>
      <h1>{chapter.pass_name}</h1>
      <p class="lede">{chapter.governing_proposition}</p>
      <p class="lede" style="margin-top:0.75rem;">
        <strong>{chapter.opposition_test}</strong>
      </p>
      <ul class="link-board">
        <li><a href="/public-book/">Public Book hub →</a></li>
        <li><a href="/public-book/the-productive-arkansas/">Chapter 5 →</a></li>
        <li><a href="/system/government-engine/">Unabridged Government OS →</a></li>
        <li><a href="/build-progress/passes/pass-5-6/">What Changed →</a></li>
      </ul>
      <p class="muted">
        Technical System 100% · Public Book {cert.public_book_completion_percent_after}% · COUNTABLE $0
        · {chapter.decision_id} · {chapter.update_id}
      </p>
    </header>

    <ReadingModes />

    <section class="hub-section" id="citizens-govern" data-depth="understand" data-depth-keep>
      <h2>The governing line</h2>
      <blockquote class="lede" style="font-size:1.15rem;">
        {chapter.citizens_govern_line}
      </blockquote>
    </section>

    <section class="hub-section" id="roles">
      <h2>Four government roles</h2>
      <ul class="stack">
        {
          roles.map((r: any) => (
            <li>
              <strong>{r.id.replaceAll("_", " / ")}</strong> — {r.q}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="breakers">
      <h2>Eight capture-breaker families</h2>
      <ul class="stack">
        {
          breakers.map((b: any) => (
            <li>
              <strong>{b.id.replaceAll("_", " ")}</strong> — {b.q}
            </li>
          ))
        }
      </ul>
      <p class="muted">Circuit breakers — not promises of virtuous leadership.</p>
    </section>

    <section class="hub-section" id="ai-levels">
      <h2>AI and public power</h2>
      <ul class="stack">
        {
          aiLevels.map((a: any) => (
            <li>
              <strong>{a.id.replaceAll("_", " ")}</strong> — {a.q}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="misconceptions">
      <h2>Misconceptions</h2>
      {
        boxes.map((box: any) => (
          <div style="margin-bottom:1.5rem;">
            <h3>{box.title}</h3>
            <p class="lede">
              <strong>{box.answer}</strong>
            </p>
            <p>{box.explain}</p>
          </div>
        ))
      }
    </section>

    <section class="hub-section" id="visuals">
      <h2>Six signature visuals</h2>
      <ul class="stack">
        {
          visuals.map((v: any) => (
            <li>
              <strong>
                {v.id} · {v.title}
              </strong>
              <div class="muted">{v.shows}</div>
            </li>
          ))
        }
      </ul>
    </section>

    {
      sections.map((s: any) => (
        <section class="hub-section" id={s.id.toLowerCase()}>
          <h2>{s.heading}</h2>
          {s.prose.map((p: string) => (
            <p class="lede" style="font-size:1.05rem; font-weight:400;">{p}</p>
          ))}
        </section>
      ))
    }

    <section class="hub-section" id="landing">
      <h2>Definition</h2>
      <blockquote class="lede" style="font-size:1.15rem;">
        {chapter.landing_definition}
      </blockquote>
    </section>

    <section class="hub-section" id="trace">
      <h2>Trace this chapter</h2>
      <ul class="stack">
        {
          trace.map((t: any) => (
            <li>
              <span class="chip chip--done">{t.class}</span> {t.claim}
              <div class="muted">
                {t.source_note} · <a href={t.unabridged}>Open →</a>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Next</h2>
      <p class="lede">
        Pass 5.7 — So What Is Constitutional Capitalism? ·{" "}
        <a href="/public-book/so-what-is-constitutional-capitalism/">Read →</a>
      </p>
      <ul class="link-board">
        {
          (plan.passes || []).slice(0, 9).map((p: any) => (
            <li>
              <span class={p.status === "COMPLETE" ? "chip chip--done" : "chip chip--queued"}>
                {p.status}
              </span>{" "}
              {p.number} {p.name}
              {p.surface_href ? (
                <>
                  {" "}
                  · <a href={p.surface_href}>Read →</a>
                </>
              ) : null}
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
