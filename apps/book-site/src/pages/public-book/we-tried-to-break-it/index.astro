---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReadingModes from "../../../components/ReadingModes.astro";
import chapter from "../../../../../../data/project/stage5_pass59_we_tried_to_break_it.json";
import plan from "../../../../../../data/project/stage5_eleven_pass_plan.json";

const sections = chapter.sections || [];
const families = chapter.attack_families || [];
const lessons = chapter.lessons || [];
const died = chapter.ideas_that_died || [];
const replaced = chapter.what_replaced_them || [];
const unproven = chapter.still_unproven || [];
const grades = chapter.evidence_grades || [];
const visuals = chapter.signature_visuals || [];
const tax = chapter.tax_lesson || {};
const trace = chapter.traceability || [];
const cert = chapter.certification || {};
---

<BaseLayout
  title="We Tried to Break It — Public Book"
  path="/public-book/we-tried-to-break-it/"
  description="Public Book Chapter 9: what Stage 4 attacked, what failed, what survived, and what remains unproven — including COUNTABLE $0."
>
  <article class="public-book">
    <header class="hub-banner">
      <span class="chip chip--done">Public Book · Chapter 9 · Pass 5.9</span>
      <p class="muted">Volume II · ~{chapter.approx_pages} pages</p>
      <h1>{chapter.pass_name}</h1>
      <p class="lede">{chapter.governing_proposition}</p>
      <p class="lede" style="margin-top:0.75rem;">
        <strong>{chapter.numbers_line}</strong>
      </p>
      <ul class="link-board">
        <li><a href="/public-book/">Public Book hub →</a></li>
        <li><a href="/public-book/building-the-bridge/">Chapter 8 →</a></li>
        <li><a href="/system/changed-our-mind/">What We Changed Our Mind About →</a></li>
        <li><a href="/build-progress/passes/pass-5-9/">What Changed →</a></li>
      </ul>
      <p class="muted">
        Technical System 100% · Public Book {cert.public_book_completion_percent_after}% · COUNTABLE $0
        · {chapter.decision_id} · {chapter.update_id}
      </p>
    </header>

    <ReadingModes />

    <section class="hub-section" id="attacks" data-depth="understand" data-depth-keep>
      <h2>Five attack families</h2>
      <ul class="stack">
        {
          families.map((f: any) => (
            <li>
              <strong>{f.id.replaceAll("_", " & ")}</strong> — {f.q}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="tax">
      <h2>Tax abolition lesson</h2>
      <ul class="link-board">
        <li>Individual income tax — {tax.iit_approx}</li>
        <li>Property layers — {tax.property_approx}</li>
        <li>
          <strong>Combined map — {tax.combined_approx}</strong>
        </li>
        <li>
          <strong>COUNTABLE — ${tax.countable_usd}</strong>
        </li>
      </ul>
    </section>

    <section class="hub-section" id="graveyard">
      <h2>Ideas that did not survive / What replaced them</h2>
      <div style="display:grid; gap:1rem; grid-template-columns:repeat(auto-fit,minmax(16rem,1fr));">
        <div>
          <h3>Died</h3>
          <ul class="stack">
            {died.map((d: string) => <li>{d}</li>)}
          </ul>
        </div>
        <div>
          <h3>Replaced by</h3>
          <ul class="stack">
            {replaced.map((r: string) => <li>{r}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="hub-section" id="lessons">
      <h2>What we thought → what survived</h2>
      <ul class="stack">
        {
          lessons.map((L: any) => (
            <li>
              <strong>{L.title}</strong>
              <div class="muted">
                <div>
                  <em>Thought:</em> {L.thought}
                </div>
                <div>
                  <em>Attacked:</em> {L.attacked}
                </div>
                <div>
                  <em>Broke:</em> {L.broke}
                </div>
                <div>
                  <em>Survived:</em> {L.survived}
                </div>
                <div>
                  <em>Changed:</em> {L.changed}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="unproven">
      <h2>Known / Unknown / COUNTABLE</h2>
      <ul class="stack">
        {
          unproven.map((u: any) => (
            <li>
              <strong>{u.label}</strong> — {u.status}
            </li>
          ))
        }
      </ul>
      <p class="lede">{chapter.certainty_line}</p>
    </section>

    <section class="hub-section" id="grades">
      <h2>Evidence grades</h2>
      <ul class="link-board">
        {grades.map((g: string) => <li>{g}</li>)}
      </ul>
    </section>

    <section class="hub-section" id="visuals">
      <h2>Five signature visuals</h2>
      <ul class="stack">
        {
          visuals.map((v: any) => (
            <li>
              <strong>
                {v.id} · {v.title}
              </strong>
              <div class="muted">{v.shows}</div>
            </li>
          ))
        }
      </ul>
    </section>

    {
      sections.map((s: any) => (
        <section class="hub-section" id={s.id.toLowerCase()}>
          <h2>{s.heading}</h2>
          {s.prose.map((p: string) => (
            <p class="lede" style="font-size:1.05rem; font-weight:400;">{p}</p>
          ))}
        </section>
      ))
    }

    <section class="hub-section" id="landing">
      <h2>Land the chapter</h2>
      <blockquote class="lede" style="font-size:1.1rem;">
        {chapter.closing_argument}
      </blockquote>
      <p class="lede" style="margin-top:1rem;">
        <strong>{chapter.test_never_ends}</strong>
      </p>
      <p class="muted" style="margin-top:0.75rem;">
        {chapter.loyalty_line}
      </p>
    </section>

    <section class="hub-section" id="trace">
      <h2>Trace this chapter</h2>
      <ul class="stack">
        {
          trace.map((t: any) => (
            <li>
              <span class="chip chip--done">{t.class}</span> {t.claim}
              <div class="muted">
                {t.source_note} · <a href={t.unabridged}>Open →</a>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Next</h2>
      <p class="lede">
        Pass 5.10 — The Arkansas We Could Leave Behind ·{" "}
        <a href="/public-book/the-arkansas-we-could-leave-behind/">Read →</a>
      </p>
      <ul class="link-board">
        {
          (plan.passes || []).map((p: any) => (
            <li>
              <span class={p.status === "COMPLETE" ? "chip chip--done" : "chip chip--queued"}>
                {p.status}
              </span>{" "}
              {p.number} {p.name}
              {p.surface_href ? (
                <>
                  {" "}
                  · <a href={p.surface_href}>Read →</a>
                </>
              ) : null}
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
