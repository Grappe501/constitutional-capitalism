---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReadingModes from "../../../components/ReadingModes.astro";
import chapter from "../../../../../../data/project/stage5_pass510_the_arkansas_we_could_leave_behind.json";
import plan from "../../../../../../data/project/stage5_eleven_pass_plan.json";

const sections = chapter.sections || [];
const dashboard = chapter.household_dashboard_forward || [];
const doNotLeave = chapter.do_not_leave || [];
const horizon = chapter.generational_horizon || [];
const visuals = chapter.signature_visuals || [];
const keys = chapter.key_lines || {};
const trace = chapter.traceability || [];
const cert = chapter.certification || {};
---

<BaseLayout
  title="The Arkansas We Could Leave Behind — Public Book"
  path="/public-book/the-arkansas-we-could-leave-behind/"
  description="Public Book Chapter 10: the aspirational destination — greater freedom, capability, and power for the people who come after us."
>
  <article class="public-book leave-behind">
    <header class="hub-banner">
      <span class="chip chip--done">Public Book · Chapter 10 · Pass 5.10</span>
      <p class="muted">Volume II · ~{chapter.approx_pages} pages · aspirational, not predictive</p>
      <h1>{chapter.pass_name}</h1>
      <p class="lede">{chapter.governing_proposition}</p>
      <p class="lede" style="margin-top:0.75rem;">
        <strong>{chapter.opening_line}</strong>
      </p>
      <ul class="link-board">
        <li><a href="/public-book/">Public Book hub →</a></li>
        <li><a href="/public-book/we-tried-to-break-it/">Chapter 9 →</a></li>
        <li><a href="/system/transition-engine/">Unabridged Transition →</a></li>
        <li><a href="/build-progress/passes/pass-5-10/">What Changed →</a></li>
      </ul>
      <p class="muted">
        Technical System 100% · Public Book {cert.public_book_completion_percent_after}% · COUNTABLE $0
        · {chapter.decision_id} · {chapter.update_id}
      </p>
    </header>

    <ReadingModes />

    <section class="hub-section" id="horizon" data-depth="understand" data-depth-keep>
      <h2>The Generational Horizon</h2>
      <p class="lede">{horizon.join(" → ")}</p>
      <p class="muted">{chapter.design_note}</p>
    </section>

    <section class="hub-section" id="dashboard">
      <h2>Generation 2 Household Dashboard</h2>
      <ul class="stack">
        {
          dashboard.map((d: any) => (
            <li>
              <strong>{d.id}</strong>
              <div class="muted">Not: {d.not}</div>
              <div>{d.but}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="do-not-leave">
      <h2>What we must not leave them</h2>
      <ul class="stack">
        {doNotLeave.map((x: string) => <li>{x}</li>)}
      </ul>
      <p class="lede" style="margin-top:1rem;">
        <strong>{keys.loyalty}</strong>
      </p>
    </section>

    <section class="hub-section" id="key-lines">
      <h2>Lines that hold the chapter</h2>
      <ul class="stack">
        <li>{keys.income_ownership}</li>
        <li>{keys.pathways}</li>
        <li>{keys.capture_fear}</li>
        <li>{keys.growth_definition}</li>
        <li>{keys.adapt}</li>
        <li>{keys.public_wealth}</li>
        <li>{keys.promise}</li>
      </ul>
    </section>

    <section class="hub-section" id="visuals">
      <h2>Six signature visuals</h2>
      <ul class="stack">
        {
          visuals.map((v: any) => (
            <li>
              <strong>
                {v.id} · {v.title}
              </strong>
              <div class="muted">{v.shows}</div>
            </li>
          ))
        }
      </ul>
    </section>

    {
      sections.map((s: any, i: number) => (
        <section
          class="hub-section"
          id={s.id.toLowerCase()}
          style={i > 18 ? "margin-top:2.5rem;" : undefined}
        >
          <h2>{s.heading}</h2>
          {s.prose.map((p: string) => (
            <p
              class="lede"
              style={`font-size:${i > 20 ? "1.12rem" : "1.05rem"}; font-weight:400; ${i > 22 ? "line-height:1.7;" : ""}`}
            >
              {p}
            </p>
          ))}
        </section>
      ))
    }

    <section class="hub-section" id="final" style="margin-top:3rem;">
      <blockquote class="lede" style="font-size:1.2rem; line-height:1.75; white-space:pre-line;">
        {chapter.final_lines}
      </blockquote>
    </section>

    <section class="hub-section" id="trace">
      <h2>Trace this chapter</h2>
      <ul class="stack">
        {
          trace.map((t: any) => (
            <li>
              <span class="chip chip--done">{t.class}</span> {t.claim}
              <div class="muted">
                {t.source_note} · <a href={t.unabridged}>Open →</a>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Next</h2>
      <p class="lede">Pass 5.11 — Whole-Book Assembly &amp; Editorial Certification</p>
      <p class="muted">One book. One voice. No new substantive subject.</p>
      <ul class="link-board">
        {
          (plan.passes || []).map((p: any) => (
            <li>
              <span class={p.status === "COMPLETE" ? "chip chip--done" : "chip chip--queued"}>
                {p.status}
              </span>{" "}
              {p.number} {p.name}
              {p.surface_href ? (
                <>
                  {" "}
                  · <a href={p.surface_href}>Read →</a>
                </>
              ) : null}
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
