---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReadingModes from "../../../components/ReadingModes.astro";
import chapter from "../../../../../../data/project/stage5_pass58_building_the_bridge.json";
import plan from "../../../../../../data/project/stage5_eleven_pass_plan.json";

const sections = chapter.sections || [];
const gates = chapter.nine_gates || [];
const roadmap = chapter.roadmap || [];
const waterfall = chapter.fiscal_replacement_waterfall || [];
const states = chapter.transition_states || [];
const decisions = chapter.decision_states || [];
const visuals = chapter.signature_visuals || [];
const tax = chapter.tax_replacement_lesson || {};
const trace = chapter.traceability || [];
const cert = chapter.certification || {};
---

<BaseLayout
  title="Building the Bridge — Public Book"
  path="/public-book/building-the-bridge/"
  description="Public Book Chapter 8: build the bridge before removing the old road — Dependency Rule, Replacement Readiness, and Arkansas' transition sequence."
>
  <article class="public-book">
    <header class="hub-banner">
      <span class="chip chip--done">Public Book · Chapter 8 · Pass 5.8</span>
      <p class="muted">Volume II · ~{chapter.approx_pages} pages</p>
      <h1>{chapter.pass_name}</h1>
      <p class="lede">
        <strong>{chapter.governing_rule}</strong>
      </p>
      <p class="muted">{chapter.dependency_rule}</p>
      <ul class="link-board">
        <li><a href="/public-book/">Public Book hub →</a></li>
        <li><a href="/public-book/so-what-is-constitutional-capitalism/">Chapter 7 →</a></li>
        <li><a href="/system/transition-engine/">Unabridged Transition Engine →</a></li>
        <li><a href="/build-progress/passes/pass-5-8/">What Changed →</a></li>
      </ul>
      <p class="muted">
        Technical System 100% · Public Book {cert.public_book_completion_percent_after}% · COUNTABLE $0
        · {chapter.decision_id} · {chapter.update_id}
      </p>
    </header>

    <ReadingModes />

    <section class="hub-section" id="roadmap" data-depth="understand" data-depth-keep>
      <h2>Arkansas' Transition Roadmap</h2>
      <ol class="stack">
        {
          roadmap.map((r: any) => (
            <li>
              <strong>{r.label}</strong>
              <div class="muted">{r.purpose}</div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="hub-section" id="tax-lesson">
      <h2>Tax replacement lesson</h2>
      <p class="lede">{tax.lesson}</p>
      <ul class="link-board">
        <li>
          <strong>Replacement burden map</strong> — {tax.display}
        </li>
        <li>
          <strong>COUNTABLE</strong> — ${tax.countable_usd}
        </li>
      </ul>
    </section>

    <section class="hub-section" id="nine-gates">
      <h2>Replacement Readiness — nine gates</h2>
      <ol class="stack">
        {
          gates.map((g: any) => (
            <li>
              <strong>{g.id}</strong> — {g.q}
            </li>
          ))
        }
      </ol>
      <p class="muted">Only then: REPLACEMENT-READY.</p>
    </section>

    <section class="hub-section" id="states">
      <h2>Transition language</h2>
      <p>
        <strong>States:</strong> {states.join(" · ")}
      </p>
      <p>
        <strong>At any point:</strong> {decisions.join(" · ")}
      </p>
    </section>

    <section class="hub-section" id="waterfall">
      <h2>Fiscal Replacement Waterfall</h2>
      <ol class="stack">
        {waterfall.map((step: string) => <li>{step}</li>)}
      </ol>
      <p class="muted">Only ACTUAL REPLACEMENT CAPACITY can justify tax replacement.</p>
    </section>

    <section class="hub-section" id="visuals">
      <h2>Six signature visuals</h2>
      <ul class="stack">
        {
          visuals.map((v: any) => (
            <li>
              <strong>
                {v.id} · {v.title}
              </strong>
              <div class="muted">{v.shows}</div>
            </li>
          ))
        }
      </ul>
    </section>

    {
      sections.map((s: any) => (
        <section class="hub-section" id={s.id.toLowerCase()}>
          <h2>{s.heading}</h2>
          {s.prose.map((p: string) => (
            <p class="lede" style="font-size:1.05rem; font-weight:400;">{p}</p>
          ))}
        </section>
      ))
    }

    <section class="hub-section" id="landing">
      <h2>Land the chapter</h2>
      <blockquote class="lede" style="font-size:1.1rem;">
        {chapter.closing_argument}
      </blockquote>
      <p class="lede" style="margin-top:1rem;">
        <strong>{chapter.landing_line}</strong>
      </p>
    </section>

    <section class="hub-section" id="trace">
      <h2>Trace this chapter</h2>
      <ul class="stack">
        {
          trace.map((t: any) => (
            <li>
              <span class="chip chip--done">{t.class}</span> {t.claim}
              <div class="muted">
                {t.source_note} · <a href={t.unabridged}>Open →</a>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Next</h2>
      <p class="lede">Pass 5.9 — We Tried to Break It</p>
      <ul class="link-board">
        {
          (plan.passes || []).slice(0, 10).map((p: any) => (
            <li>
              <span class={p.status === "COMPLETE" ? "chip chip--done" : "chip chip--queued"}>
                {p.status}
              </span>{" "}
              {p.number} {p.name}
              {p.surface_href ? (
                <>
                  {" "}
                  · <a href={p.surface_href}>Read →</a>
                </>
              ) : null}
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
