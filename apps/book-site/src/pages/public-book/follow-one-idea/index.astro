---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import assembly from "../../../../../../data/project/stage5_pass511_whole_book_assembly.json";

const paths = assembly.follow_one_idea || [];
const chapters = assembly.chapters || [];
const byN = Object.fromEntries(chapters.map((c: any) => [c.n, c]));
---

<BaseLayout
  title="Follow One Idea — Public Book"
  path="/public-book/follow-one-idea/"
  description="Trace money, household, ownership, power, or generations across the Public Book."
>
  <article class="public-book">
    <header class="hub-banner">
      <span class="chip chip--done">Public Book · Reading paths</span>
      <h1>Follow One Idea</h1>
      <p class="lede">
        Not new doctrine — connections already present. Pick a thread and walk the chapters that carry it.
      </p>
    </header>

    {
      paths.map((path: any) => (
        <section class="hub-section" id={path.id}>
          <h2>{path.label}</h2>
          <p>{path.blurb}</p>
          <ol class="stack">
            {path.chapters.map((n: number) => {
              const ch = byN[n];
              return ch ? (
                <li>
                  <a href={ch.href}>
                    Ch. {ch.n}: {ch.title}
                  </a>
                  <span class="muted"> — {ch.question}</span>
                </li>
              ) : null;
            })}
          </ol>
        </section>
      ))
    }

    <section class="hub-section">
      <ul class="link-board">
        <li><a href="/public-book/table-of-contents/">Full Table of Contents →</a></li>
        <li><a href="/public-book/introduction/">Introduction →</a></li>
      </ul>
    </section>
  </article>
</BaseLayout>
