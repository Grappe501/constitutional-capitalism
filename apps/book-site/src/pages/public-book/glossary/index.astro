---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import assembly from "../../../../../../data/project/stage5_pass511_whole_book_assembly.json";

const glossary = assembly.glossary || [];
const defs = assembly.definitions || [];
const hierarchy = assembly.terminology_hierarchy || {};
---

<BaseLayout
  title="Glossary — Public Book"
  path="/public-book/glossary/"
  description="A Constitutional Capitalism glossary — short explanations first, then deeper links."
>
  <article class="public-book">
    <header class="hub-banner">
      <span class="chip chip--done">Public Book · Glossary</span>
      <h1>Glossary</h1>
      <p class="lede">Project-specific terms in plain language. Not a graduate economics dictionary.</p>
    </header>

    <section class="hub-section">
      <h2>Terminology hierarchy</h2>
      <ul class="stack">
        <li><strong>Core principles</strong> — {hierarchy.core_principles}</li>
        <li><strong>Analytical tools</strong> — {hierarchy.analytical_tools}</li>
        <li><strong>Implementation instruments</strong> — {hierarchy.implementation_instruments}</li>
      </ul>
      <p class="muted">
        Not every capitalized phrase is a new philosophical principle. Some names test; some would operate.
      </p>
    </section>

    <section class="hub-section">
      <h2>Canonical definition stack</h2>
      <ul class="stack">
        {
          defs.map((d: any) => (
            <li>
              <strong>{d.term}</strong>
              <span class="chip chip--queued">{(d.tier || "").replaceAll("_", " ")}</span>
              <div>{d.short}</div>
              <p class="muted">{d.canonical}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Quick glossary</h2>
      <ul class="stack">
        {
          glossary.map((g: any) => (
            <li>
              <strong>{g.term}</strong> — {g.blurb}{" "}
              <a href={g.more}>Learn more →</a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
