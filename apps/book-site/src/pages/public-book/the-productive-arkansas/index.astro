---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReadingModes from "../../../components/ReadingModes.astro";
import PublicBookChapterNav from "../../../components/PublicBookChapterNav.astro";
import chapter from "../../../../../../data/project/stage5_pass55_the_productive_arkansas.json";
import plan from "../../../../../../data/project/stage5_eleven_pass_plan.json";

const sections = chapter.sections || [];
const systems = chapter.eight_systems || [];
const test = chapter.productive_systems_test || [];
const visuals = chapter.signature_visuals || [];
const box = chapter.misconception_box || {};
const trace = chapter.traceability || [];
const cert = chapter.certification || {};
---

<BaseLayout
  title="The Productive Arkansas — Public Book"
  path="/public-book/the-productive-arkansas/"
  description="Public Book Chapter 5: food, energy, housing, healthcare, transportation, water, digital, and care as one interdependent productive system."
>
  <article class="public-book">
    <header class="hub-banner">
      <span class="chip chip--done">Public Book · Chapter 5 · Pass 5.5</span>
      <p class="muted">Volume II · ~{chapter.approx_pages} pages</p>
      <h1>{chapter.pass_name}</h1>
      <p class="lede">{chapter.governing_question}</p>
      <p class="muted">{chapter.shared_role}</p>
      <ul class="link-board">
        <li><a href="/public-book/">Public Book hub →</a></li>
        <li><a href="/public-book/people-are-the-real-capital/">Chapter 4 →</a></li>
        <li><a href="/system/productive-systems/">Unabridged Productive Systems →</a></li>
        <li><a href="/build-progress/passes/pass-5-5/">What Changed →</a></li>
      </ul>
      <p class="muted">
        Technical System 100% · Public Book {cert.public_book_completion_percent_after}% · COUNTABLE $0
        · {chapter.decision_id} · {chapter.update_id}
      </p>
    </header>

    <ReadingModes />

    <section class="hub-section" id="systems" data-depth="understand" data-depth-keep>
      <h2>Arkansas' Productive Systems</h2>
      <ul class="link-board">
        {systems.map((s: string) => <li><strong>{s}</strong></li>)}
      </ul>
      <p class="muted">Systems — not eight government departments.</p>
    </section>

    <section class="hub-section" id="test">
      <h2>Productive Systems Test</h2>
      <ul class="stack">
        {
          test.map((t: any) => (
            <li>
              <strong>{t.id.replaceAll("_", " ")}</strong> — {t.q}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="misconception">
      <h2>{box.title}</h2>
      <p class="lede">
        <strong>{box.answer}</strong>
      </p>
      <p>{box.explain}</p>
    </section>

    <section class="hub-section" id="visuals">
      <h2>Six signature visuals</h2>
      <ul class="stack">
        {
          visuals.map((v: any) => (
            <li>
              <strong>
                {v.id} · {v.title}
              </strong>
              <div class="muted">
                {v.shows}
                {v.claim_class ? ` · ${v.claim_class}` : ""}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="efficiency">
      <h2>Efficiency versus resilience</h2>
      <blockquote class="lede" style="font-size:1.1rem;">
        {chapter.efficiency_resilience}
      </blockquote>
    </section>

    {
      sections.map((s: any) => (
        <section class="hub-section" id={s.id.toLowerCase()}>
          <h2>{s.heading}</h2>
          {s.prose.map((p: string) => (
            <p class="lede" style="font-size:1.05rem; font-weight:400;">{p}</p>
          ))}
        </section>
      ))
    }

    <section class="hub-section" id="landing">
      <h2>Definition</h2>
      <blockquote class="lede" style="font-size:1.15rem;">
        {chapter.landing_definition}
      </blockquote>
    </section>

    <section class="hub-section" id="trace">
      <h2>Trace this chapter</h2>
      <ul class="stack">
        {
          trace.map((t: any) => (
            <li>
              <span class="chip chip--done">{t.class}</span> {t.claim}
              <div class="muted">
                {t.source_note} · <a href={t.unabridged}>Open →</a>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Next</h2>
      <p class="lede">
        Pass 5.6 — Government That Belongs to the People ·{" "}
        <a href="/public-book/government-that-belongs-to-the-people/">Read →</a>
      </p>
      <ul class="link-board">
        {
          (plan.passes || []).slice(0, 8).map((p: any) => (
            <li>
              <span class={p.status === "COMPLETE" ? "chip chip--done" : "chip chip--queued"}>
                {p.status}
              </span>{" "}
              {p.number} {p.name}
              {p.surface_href ? (
                <>
                  {" "}
                  · <a href={p.surface_href}>Read →</a>
                </>
              ) : null}
            </li>
          ))
        }
      </ul>
    </section>
  
    <PublicBookChapterNav chapter={5} />
  </article>
</BaseLayout>
