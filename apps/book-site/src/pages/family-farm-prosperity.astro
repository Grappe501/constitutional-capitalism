---
import BaseLayout from "../layouts/BaseLayout.astro";
import EvidencePanel from "../components/EvidencePanel.astro";
import f from "../../../../data/project/family_farm_prosperity_framework.json";
import panels from "../../../../data/project/publication_evidence_panels.json";

const pillars = f.thirteen_pillars?.pillars || [];
const baselines = f.sourced_context_baselines?.items || [];
const cycle = f.economic_cycle?.flow || [];
const testQs = f.family_farm_prosperity_test?.questions || [];
const branches = f.website_branches || [];
const institutions =
  pillars.find((p: any) => p.id === "P2")?.institutions || [];
const processingPanel = (panels.panels || []).find(
  (p: { panel_id: string }) => p.panel_id === "CC-EP-AR-AG-PROCESSING-ACCESS-1"
);
const farmStructurePanel = (panels.panels || []).find(
  (p: { panel_id: string }) => p.panel_id === "CC-EP-RURAL-LOCAL-CAPITAL-SYSTEM-1"
);
---

<BaseLayout
  title="Family Farm Prosperity"
  path="/family-farm-prosperity/"
  description="Make local family farms engines of community wealth, public health, land stewardship, and national resilience."
>
  <article class="prose">
    <h1>{f.domain_title}</h1>
    <p class="muted">
      Architecture Candidate under doctrine freeze (CC-DEC-093) — Hypothesis Card HYP-116.
      Architecture integrated; evidentiary validation not complete (Proof Burden CC-DEC-094).
      Not manuscript-publishable doctrine.
    </p>

    <h2>Central promise</h2>
    <blockquote>
      <p>{f.central_promise.text}</p>
    </blockquote>
    <p>{f.goal.text}</p>

    <h2>Compact</h2>
    <blockquote>
      <p>{f.compact_language.text}</p>
    </blockquote>

    <h2>Message to farmers</h2>
    <p class="muted">Not: {f.farmer_message.not}</p>
    <blockquote>
      <p>{f.farmer_message.is}</p>
    </blockquote>
    <p>{f.farmer_message.independence_rule}</p>

    <h2>Sourced context baselines</h2>
    <ul>
      {baselines.map((b: any) => (
        <li>
          <code>{b.id}</code> — {b.text}
        </li>
      ))}
    </ul>

    {farmStructurePanel ? <EvidencePanel panel={farmStructurePanel} /> : null}
    {processingPanel ? <EvidencePanel panel={processingPanel} /> : null}

    <h2>Thirteen pillars</h2>
    {
      pillars.map((p: any) => (
        <section style="margin-bottom:1.25rem;">
          <h3>
            {p.id}. {p.title}
          </h3>
          <p>{p.summary}</p>
          {p.id === "P2" && institutions.length > 0 && (
            <>
              <p>Institutional purchasers may include:</p>
              <ul>
                {institutions.map((i: string) => (
                  <li>{i}</li>
                ))}
              </ul>
            </>
          )}
        </section>
      ))
    }

    <h2>Economic cycle</h2>
    <p>{f.economic_cycle.summary}</p>
    <ol>
      {cycle.map((c: string) => (
        <li>{c}</li>
      ))}
    </ol>

    <h2>Scorecard question</h2>
    <blockquote>
      <p>{f.scorecard_question.text}</p>
    </blockquote>

    <h2>Family farm prosperity test</h2>
    <p>{f.family_farm_prosperity_test.purpose}</p>
    <ol>
      {testQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>

    <h2>Website branches</h2>
    <ul>
      {branches.map((b: any) => (
        <li>
          <strong>{b.title}</strong> — {b.summary}
        </li>
      ))}
    </ul>

    <p class="muted">
      See also <a href="/local-ownership/">Local Ownership</a>,{" "}
      <a href="/food-security/">Community Food Security</a>,{" "}
      <a href="/resource-sovereignty/">Resource Sovereignty</a>,{" "}
      <a href="/health/">Health</a>, <a href="/prosperous-aging/">Prosperous Aging</a>,{" "}
      <a href="/energy-sovereignty/">Energy Sovereignty</a>, and{" "}
      <a href="/civic-wealth/">Civic Wealth</a>.
    </p>
  </article>
</BaseLayout>
