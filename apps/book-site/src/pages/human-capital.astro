---
import BaseLayout from "../layouts/BaseLayout.astro";
import hc from "../../../../data/project/human_capital_framework.json";

const testQs = hc.human_capital_test?.questions || [];
const branches = hc.website_branches || [];
const names = hc.arkansas_academy_model?.name_candidates || [];
const regions = hc.arkansas_academy_model?.regional_specialization?.examples || [];
const metrics = hc.arkansas_academy_model?.success_metrics?.beyond_graduation_rates || [];
const civic = hc.arkansas_academy_model?.civic_leadership?.curriculum_topics || [];
const entre = hc.arkansas_academy_model?.entrepreneurship?.graduate_capabilities || [];
const partners = hc.arkansas_academy_model?.community_partnerships?.advisory_board_includes || [];
---

<BaseLayout
  title="Human Capital Doctrine"
  path="/human-capital/"
  description="Build human capital infrastructure — multiple pathways of equal dignity; pilot academies that make home stronger."
>
  <article class="prose">
    <h1>{hc.domain_title}</h1>

    <p class="lede">{hc.role_in_philosophy}</p>

    <h2>First principle</h2>
    <blockquote>
      <p>{hc.first_principle.text}</p>
    </blockquote>

    <h2>Human capital infrastructure</h2>
    <p>{hc.human_capital_infrastructure.summary}</p>

    <h2>Equal dignity</h2>
    <p>{hc.equal_dignity_rule.text}</p>

    <h2>Pilot posture</h2>
    <p>{hc.pilot_posture.rule}</p>
    <p>{hc.pilot_posture.portable_doctrine}</p>

    <h2>Arkansas academy design agenda</h2>
    
    <p>{hc.arkansas_academy_model.naming_rule}</p>
    <p>Name candidates (undecided):</p>
    <ul>
      {names.map((n: string) => (
        <li>{n}</li>
      ))}
    </ul>
    <blockquote>
      <p>{hc.arkansas_academy_model.mission}</p>
    </blockquote>
    <p>{hc.arkansas_academy_model.mission_note}</p>

    <h3>Regional strengths</h3>
    <p>{hc.arkansas_academy_model.regional_specialization.rule}</p>
    
    {
      regions.map((r: any) => (
        <section style="margin-bottom:1rem;">
          <h4 style="margin-bottom:0.35rem;">{r.region}</h4>
          <ul>
            {r.focus_areas.map((f: string) => (
              <li>{f}</li>
            ))}
          </ul>
        </section>
      ))
    }

    <h3>Living-learning campuses</h3>
    <p>{hc.arkansas_academy_model.living_learning_campus.summary}</p>
    

    <h3>Paid apprenticeships</h3>
    <p>{hc.arkansas_academy_model.paid_apprenticeships.rule}</p>

    <h3>Entrepreneurship</h3>
    <p>{hc.arkansas_academy_model.entrepreneurship.rule}</p>
    <ul>
      {entre.map((e: string) => (
        <li>{e}</li>
      ))}
    </ul>

    <h3>Civic leadership</h3>
    <p>{hc.arkansas_academy_model.civic_leadership.rule}</p>
    <ul>
      {civic.map((c: string) => (
        <li>{c}</li>
      ))}
    </ul>

    <h3>Community partnerships</h3>
    <p>{hc.arkansas_academy_model.community_partnerships.purpose}</p>
    <ul>
      {partners.map((p: string) => (
        <li>{p}</li>
      ))}
    </ul>

    <h3>Success metrics</h3>
    <p>{hc.arkansas_academy_model.success_metrics.alignment}</p>
    <ul>
      {metrics.map((m: string) => (
        <li>{m}</li>
      ))}
    </ul>
    

    <h2>Human Capital Test</h2>
    <p>{hc.human_capital_test.purpose}</p>
    <ol>
      {testQs.map((q: any) => (
        <li>{q.text}</li>
      ))}
    </ol>

    <h2>Domain branches</h2>
    <ul>
      {branches.map((b: any) => (
        <li>{b.title}</li>
      ))}
    </ul>

    <p>
      See also <a href="/essential-systems/">Essential Systems</a>,
      <a href="/public-service/">Public Service</a>, and
      <a href="/where-we-are/">Where we are</a>.
    </p>
  </article>
</BaseLayout>
