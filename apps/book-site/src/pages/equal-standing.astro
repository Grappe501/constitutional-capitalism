---
import BaseLayout from "../layouts/BaseLayout.astro";
import eq from "../../../../data/project/equal_standing_framework.json";

const testQs = eq.equal_standing_test?.questions || [];
const branches = eq.website_branches || [];
const receives = eq.equality_of_opportunity_and_accountability?.receives || [];
const accepts = eq.equality_of_opportunity_and_accountability?.accepts || [];
const rejectList = eq.reject_privilege_in_every_direction?.reject || [];
const accessTo = eq.equal_access_requirements?.access_to || [];
const askFirst = eq.blind_stage_principle?.ask_first || [];
const doNotAsk = eq.blind_stage_principle?.do_not_ask_first || [];
const legit = eq.relevant_distinctions_rule?.examples_of_legitimate_distinctions || [];
const illegit = eq.relevant_distinctions_rule?.examples_of_illegitimate_influence || [];
---

<BaseLayout
  title="Equal Standing Before the Constitution"
  path="/equal-standing/"
  description="Every person stands equal before the Constitution — equal protection, equal accountability, conduct before status."
>
  <article class="prose">
    <h1>{eq.domain_title}</h1>

    <p class="lede">{eq.role_in_philosophy}</p>

    <h2>Foundational principle</h2>
    <blockquote>
      <p>{eq.foundational_principle.text}</p>
    </blockquote>

    <h2>Relevant distinctions</h2>
    <p>{eq.relevant_distinctions_rule.text}</p>
    <p>Legitimate distinctions may include:</p>
    <ul>
      {legit.map((e: string) => (
        <li>{e}</li>
      ))}
    </ul>
    <p>Illegitimate influence includes:</p>
    <ul>
      {illegit.map((e: string) => (
        <li>{e}</li>
      ))}
    </ul>

    <h2>The Blind Stage Principle</h2>
    
    <blockquote>
      <p>{eq.blind_stage_principle.text}</p>
    </blockquote>
    <blockquote>
      <p>
        <strong>{eq.blind_stage_principle.iconic_phrase}</strong>
      </p>
    </blockquote>
    <p>{eq.blind_stage_principle.iconic_phrase_caveat}</p>
    <p>Ask first:</p>
    <ul>
      {askFirst.map((q: string) => (
        <li>{q}</li>
      ))}
    </ul>
    <p>Not first:</p>
    <ul>
      {doNotAsk.map((q: string) => (
        <li>{q}</li>
      ))}
    </ul>

    <h2>Equality of opportunity, equality of accountability</h2>
    <p>Every citizen receives:</p>
    <ul>
      {receives.map((r: string) => (
        <li>{r}</li>
      ))}
    </ul>
    <p>Every citizen also accepts:</p>
    <ul>
      {accepts.map((a: string) => (
        <li>{a}</li>
      ))}
    </ul>
    <p>
      <strong>{eq.equality_of_opportunity_and_accountability.closing_rule}</strong>
    </p>

    <h2>Reject privilege in every direction</h2>
    <p>{eq.reject_privilege_in_every_direction.summary}</p>
    <ul>
      {rejectList.map((r: string) => (
        <li>{r}</li>
      ))}
    </ul>

    <h2>Equal access</h2>
    <p>{eq.equal_access_requirements.summary}</p>
    <ul>
      {accessTo.map((a: string) => (
        <li>{a}</li>
      ))}
    </ul>
    

    <h2>Civic culture</h2>
    <blockquote>
      <p>{eq.civic_culture.text}</p>
    </blockquote>
    <p>{eq.civic_culture.aim}</p>

    <h2>Equal Standing Test</h2>
    <p>{eq.equal_standing_test.purpose}</p>
    <ol>
      {testQs.map((q: any) => (
        <li>{q.text}</li>
      ))}
    </ol>

    <h2>Domain branches</h2>
    <ul>
      {branches.map((b: any) => (
        <li>
          <strong>{b.title}</strong> — {b.summary}
        </li>
      ))}
    </ul>

    <p>
      Complements Declaration <em>On equality</em> (rejects equality of outcome). See also{" "}
      <a href="/principles/">Principles</a>, <a href="/justice/">Justice</a>,{" "}
      <a href="/democracy/">Democracy</a>, <a href="/transparency/">Transparency</a>, and{" "}
      <a href="/where-we-are/">Where we are</a>.
    </p>
  </article>
</BaseLayout>
