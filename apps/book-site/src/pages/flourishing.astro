---
import BaseLayout from "../layouts/BaseLayout.astro";
import hfi from "../../../../data/project/human_flourishing_index.json";
import identity from "../../../../data/project/living_project_identity.json";

const domains = hfi.domains || [];
const sourced = hfi.research_status?.sourced_domains ?? 0;
const total = hfi.research_status?.total_domains ?? domains.length;
---

<BaseLayout
  title="Human Flourishing Index"
  path="/flourishing/"
  description="Did human life improve? The defining benchmark for Constitutional Capitalism proposals."
>
  <article class="prose">
    <h1>{hfi.title}</h1>
    <p class="status-note">
      Design agenda — {sourced}/{total} domains sourced. Architecture is not measurement.
      No invented composite scores.
    </p>
    <p class="lede">{hfi.role_in_philosophy}</p>

    <h2>Ultimate question</h2>
    <blockquote>
      <p>{hfi.ultimate_question}</p>
    </blockquote>

    <h2>Policy test</h2>
    <blockquote>
      <p>{hfi.policy_test_question}</p>
    </blockquote>

    <h2>Not sole metrics</h2>
    <ul>
      {hfi.not_sole_metrics.map((m: string) => (
        <li>{m}</li>
      ))}
    </ul>

    <h2>Index domains</h2>
    <ul>
      {domains.map((d: any) => (
        <li>
          <code>{d.domain_id}</code> — {d.title}{" "}
          <span class="status-note">({d.status})</span>
        </li>
      ))}
    </ul>

    <h2>Construction rules</h2>
    <ul>
      {hfi.construction_rules.map((r: string) => (
        <li>{r}</li>
      ))}
    </ul>

    <h2>Living project context</h2>
    <p>{identity.scope_shift.current_framing}</p>
    <p class="status-note">
      Phase 1: {identity.canonical_honesty_state.phase_1}. Phase 2:{" "}
      {identity.canonical_honesty_state.phase_2}. Modeling:{" "}
      {identity.canonical_honesty_state.modeling}.
    </p>

    <p>
      See also <a href="/family/">Family</a>, <a href="/metrics/">Metrics</a>,{" "}
      <a href="/human-capital/">Human Capital</a>, and{" "}
      <a href="/where-we-are/">Where we are</a>.
    </p>
  </article>
</BaseLayout>
