---
import BaseLayout from "../layouts/BaseLayout.astro";
import h from "../../../../data/project/health_human_capacity_framework.json";

const layers = h.five_financial_layers?.layers || [];
const equityFactors = h.rural_health_equity_formula?.weighted_factors || [];
const network = h.community_health_network?.stack || [];
const station = h.community_health_network?.local_health_station_services || [];
const pathways = h.rural_workforce_pipeline?.pathways || [];
const pharma = h.pharmaceutical_reform?.reforms || [];
const insure = h.insurance_reform?.require || [];
const fundRev = h.state_health_prosperity_fund?.revenue_examples || [];
const fundUse = h.state_health_prosperity_fund?.finances || [];
const dividendFlow = h.prevention_dividend?.flow || [];
const dividendMay = h.prevention_dividend?.may_fund || [];
const dash = h.public_accountability?.dashboard_metrics || [];
const local = h.constitutional_division?.local_and_regional || [];
const state = h.constitutional_division?.state || [];
const federal = h.constitutional_division?.federal || [];
const baselines = h.problem_diagnosis?.sourced_baselines || [];
const testQs = h.health_system_test?.questions || [];
const branches = h.website_branches || [];
---

<BaseLayout
  title="Health, Human Capacity, and Community Care"
  path="/health/"
  description="Healthcare as human-capital infrastructure: essential care follows the person; rural readiness is financed like a fire department; prevention is rewarded."
>
  <article class="prose">
    <h1>{h.domain_title}</h1>

    <h2>Governing principle</h2>
    <blockquote>
      <p>{h.governing_principle.text}</p>
    </blockquote>

    <h2>Guiding rule</h2>
    <blockquote>
      <p>{h.guiding_rule.text}</p>
    </blockquote>

    <h2>Doctrine</h2>
    <blockquote>
      <p>{h.doctrine_statement.text}</p>
    </blockquote>

    <h2>Public promise</h2>
    <blockquote>
      <p>{h.public_promise.text}</p>
    </blockquote>

    <h2>The problem</h2>
    <p>{h.problem_diagnosis.summary}</p>
    <blockquote>
      <p>{h.problem_diagnosis.financing_contrast}</p>
    </blockquote>

    <h2>Sourced context baselines</h2>
    <ul>
      {baselines.map((b: any) => (
        <li>
          <code>{b.id}</code> — {b.text}
        </li>
      ))}
    </ul>

    <h2>Five financial layers</h2>
    {
      layers.map((layer: any) => (
        <section style="margin-bottom:1.5rem;">
          <h3>
            {layer.id}. {layer.title}
          </h3>
          <p>{layer.summary}</p>
          {layer.essential_package && (
            <>
              <p>Essential package includes:</p>
              <ul>
                {layer.essential_package.map((x: string) => (
                  <li>{x}</li>
                ))}
              </ul>
            </>
          )}
          {layer.finances && (
            <>
              <p>Finances:</p>
              <ul>
                {layer.finances.map((x: string) => (
                  <li>{x}</li>
                ))}
              </ul>
            </>
          )}
          {layer.front_door && (
            <>
              <p>Front door:</p>
              <ul>
                {layer.front_door.map((x: string) => (
                  <li>{x}</li>
                ))}
              </ul>
            </>
          )}
          {layer.reward_improvements && (
            <>
              <p>Reward improvements such as:</p>
              <ul>
                {layer.reward_improvements.map((x: string) => (
                  <li>{x}</li>
                ))}
              </ul>
            </>
          )}
        </section>
      ))
    }

    <h2>Rural Health Equity Formula</h2>
    <p>{h.rural_health_equity_formula.summary}</p>
    <ul>
      {equityFactors.map((f: string) => (
        <li>{f}</li>
      ))}
    </ul>
    <blockquote>
      <p>{h.rural_health_equity_formula.funding_principle}</p>
    </blockquote>

    <h2>Community Health Network</h2>
    <ol>
      {network.map((n: string) => (
        <li>{n}</li>
      ))}
    </ol>
    <p>Local health stations may provide:</p>
    <ul>
      {station.map((s: string) => (
        <li>{s}</li>
      ))}
    </ul>
    <p>{h.community_health_network.transportation_rule}</p>

    <h2>Rural workforce pipeline</h2>
    <p>{h.rural_workforce_pipeline.summary}</p>
    <ul>
      {pathways.map((p: string) => (
        <li>{p}</li>
      ))}
    </ul>

    <h2>Healthcare as a local economic engine</h2>
    <p>{h.local_economic_engine.summary}</p>

    <h2>Pharmaceutical reform</h2>
    <p>{h.pharmaceutical_reform.summary}</p>
    <ul>
      {pharma.map((p: string) => (
        <li>{p}</li>
      ))}
    </ul>

    <h2>Insurance reform</h2>
    <p>{h.insurance_reform.summary}</p>
    <ul>
      {insure.map((i: string) => (
        <li>{i}</li>
      ))}
    </ul>

    <h2>State Health Prosperity Fund</h2>
    <p>{h.state_health_prosperity_fund.summary}</p>
    <p>Revenue examples:</p>
    <ul>
      {fundRev.map((r: string) => (
        <li>{r}</li>
      ))}
    </ul>
    <p>Finances:</p>
    <ul>
      {fundUse.map((u: string) => (
        <li>{u}</li>
      ))}
    </ul>

    <h2>Prevention Dividend</h2>
    <p>{h.prevention_dividend.summary}</p>
    <ol>
      {dividendFlow.map((d: string) => (
        <li>{d}</li>
      ))}
    </ol>
    <p>May fund:</p>
    <ul>
      {dividendMay.map((d: string) => (
        <li>{d}</li>
      ))}
    </ul>

    <h2>Public accountability</h2>
    <p>{h.public_accountability.summary}</p>
    <ul>
      {dash.map((d: string) => (
        <li>{d}</li>
      ))}
    </ul>

    <h2>Constitutional division of responsibility</h2>
    <p>Local and regional:</p>
    <ul>
      {local.map((x: string) => (
        <li>{x}</li>
      ))}
    </ul>
    <p>State:</p>
    <ul>
      {state.map((x: string) => (
        <li>{x}</li>
      ))}
    </ul>
    <p>Federal:</p>
    <ul>
      {federal.map((x: string) => (
        <li>{x}</li>
      ))}
    </ul>

    <h2>Implementation</h2>
    <p>{h.implementation_rule.text}</p>

    <h2>Health system test</h2>
    <p>{h.health_system_test.purpose}</p>
    <ol>
      {testQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>

    <h2>Website branches</h2>
    <ul>
      {branches.map((b: any) => (
        <li>
          <strong>{b.title}</strong> — {b.summary}
        </li>
      ))}
    </ul>

    <p class="muted">
      See also <a href="/essential-systems/">Essential Systems</a>,{" "}
      <a href="/human-capital/">Human Capital</a>,{" "}
      <a href="/assistance/">Assistance</a>,{" "}
      <a href="/family/">Family</a>,{" "}
      <a href="/food-security/">Food Security</a>, and{" "}
      <a href="/energy-sovereignty/">Energy Sovereignty</a>.
    </p>
  </article>
</BaseLayout>
