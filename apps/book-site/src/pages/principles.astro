---
import BaseLayout from "../layouts/BaseLayout.astro";
import { principles } from "../lib/data";
---

<BaseLayout
  title="Principles"
  path="/principles/"
  description="Foundational principles of Constitutional Capitalism."
>
  <article>
    <h1 style="font-family:var(--serif);margin-top:0;">First principles</h1>
    <p class="status-note">Draft register — not final ratified doctrine</p>
    <p class="lede">
      These principles are derived from the Declaration and govern later policy evaluation. Explore
      each principle below.
    </p>

    <div class="principle-grid">
      {
        principles.principles.map((p) => (
          <details class="principle-card">
            <summary>
              <span class="principle__id">{p.id}</span>
              <strong>{p.title || p.id}</strong>
            </summary>
            <p class="principle-statement">{p.statement || p.text}</p>
            {p.explanation && <p>{p.explanation}</p>}
            {typeof p.maturity_percent === "number" && (
              <p style="color:var(--ink-soft);font-size:0.9rem;">
                Maturity: {p.maturity_percent}% · Status: {p.status || "draft"}
              </p>
            )}
          </details>
        ))
      }
    </div>
  </article>
</BaseLayout>

<style>
  .principle-grid {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .principle-card {
    border-bottom: 1px solid var(--line);
    padding: 0.75rem 0 1rem;
  }
  .principle-card summary {
    cursor: pointer;
    list-style: none;
    display: grid;
    gap: 0.25rem;
  }
  .principle-card summary::-webkit-details-marker {
    display: none;
  }
  .principle-statement {
    font-family: var(--serif);
    font-size: 1.05rem;
    margin: 0.75rem 0;
  }
</style>
