---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  comparison,
  comparisonBySlug,
  simpleMarkdownToHtml,
  type EconomicSystem,
} from "../../lib/data";

export function getStaticPaths() {
  return comparison.systems.map((s: EconomicSystem) => ({
    params: { system: s.slug },
  }));
}

const slug = Astro.params.system as string;
const system = comparisonBySlug(slug)!;

const dossierModules = import.meta.glob("../../../../../content/public-resources/systems/*.md", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;

const dossierKey = Object.keys(dossierModules).find((k) => k.endsWith(`/${system.slug}.md`));
const raw = dossierKey ? dossierModules[dossierKey] : "";
const html = raw
  ? simpleMarkdownToHtml(raw)
  : `<p class="muted">Dossier file missing for ${system.name}.</p>`;

const neighbors = (system.neighbor_systems || [])
  .map((id) => comparison.systems.find((s) => s.id === id))
  .filter(Boolean) as EconomicSystem[];
---

<BaseLayout
  title={system.name}
  path={`/compare/${system.slug}/`}
  description={`Fair diagnostic comparison dossier for ${system.name} within the Constitutional Capitalism economic system matrix.`}
>
  <article class="prose system-dossier">
    <p class="muted">
      <a href="/compare/">← All systems</a> · {system.family} · Developing analytical tool
    </p>

    <div class="dossier-body" set:html={html} />

    {
      neighbors.length > 0 && (
        <section aria-label="Neighbor systems">
          <h2 id="matrix-neighbors">Matrix neighbor links</h2>
          <ul>
            {neighbors.map((n) => (
              <li>
                <a href={`/compare/${n.slug}/`}>{n.name}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p style="margin-top:2rem;">
      <a class="button button--solid" href="/compare/">Back to comparison matrix</a>
    </p>
  </article>
</BaseLayout>

<style>
  .system-dossier :global(.compare-dossier-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    margin: 1rem 0 1.5rem;
  }
  .system-dossier :global(.compare-dossier-table th),
  .system-dossier :global(.compare-dossier-table td) {
    border-bottom: 1px solid var(--line);
    text-align: left;
    padding: 0.5rem 0.4rem;
    vertical-align: top;
  }
  .system-dossier :global(blockquote) {
    margin: 1rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--line);
    color: var(--ink-soft);
  }
</style>
