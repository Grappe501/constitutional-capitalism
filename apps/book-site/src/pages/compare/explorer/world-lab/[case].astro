---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ExplorerNav from "../../../../components/ExplorerNav.astro";
import explorer from "../../../../../../../data/project/comparison_explorer_v1.json";

export function getStaticPaths() {
  return explorer.world_laboratory.cases.map((c) => ({ params: { case: c.slug } }));
}

const slug = Astro.params.case as string;
const c = explorer.world_laboratory.cases.find((x) => x.slug === slug)!;
---

<BaseLayout
  title={`${c.title} — World Laboratory`}
  path={`/compare/explorer/world-lab/${c.slug}/`}
  description={c.tagline}
>
  <article class="explorer prose">
    <header class="hub-banner">
      <span class="chip chip--queued">{c.status}</span>
      <h1>{c.title}</h1>
      <p class="lede">{c.tagline}</p>
      <p><strong>Governing question:</strong> {c.question}</p>
    </header>
    <ExplorerNav current="world-lab" />

    <section class="hub-section">
      <h2>What did this look like in the real world?</h2>
      <dl class="glossary-list">
        <dt>What existed before?</dt>
        <dd>{c.before}</dd>
        <dt>What problem were they confronting?</dt>
        <dd>{c.problem}</dd>
        <dt>What did they change?</dt>
        <dd>{c.changed}</dd>
        <dt>Who owned what?</dt>
        <dd>{c.owned}</dd>
        <dt>What role did markets play?</dt>
        <dd>{c.markets}</dd>
        <dt>What role did government play?</dt>
        <dd>{c.government}</dd>
        <dt>How was it financed?</dt>
        <dd>{c.financed}</dd>
        <dt>What happened to ordinary households?</dt>
        <dd>{c.households}</dd>
        <dt>What worked?</dt>
        <dd>{c.worked}</dd>
        <dt>What failed?</dt>
        <dd>{c.failed}</dd>
        <dt>What happened later?</dt>
        <dd>{c.later}</dd>
        <dt>What lesson applies to Arkansas?</dt>
        <dd>{c.arkansas_lesson}</dd>
        <dt>What does NOT apply (no transplant)?</dt>
        <dd>{c.not_a_transplant}</dd>
      </dl>
    </section>

    <p><a href="/compare/explorer/world-lab/">← All World Lab cases</a></p>
  </article>
</BaseLayout>
