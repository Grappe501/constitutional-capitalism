---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ExplorerNav from "../../../../components/ExplorerNav.astro";
import SixQuestions from "../../../../components/SixQuestions.astro";
import explorer from "../../../../../../../data/project/comparison_explorer_v1.json";
import deep from "../../../../../../../data/project/comparison_explorer_deepening_v1.json";

export function getStaticPaths() {
  return explorer.world_laboratory.cases.map((c) => ({ params: { case: c.slug } }));
}

const slug = Astro.params.case as string;
const c = explorer.world_laboratory.cases.find((x) => x.slug === slug)!;
const d = (deep.cases_deep as any)?.[slug] || null;
---

<BaseLayout
  title={`${d?.title || c.title} — World Laboratory`}
  path={`/compare/explorer/world-lab/${c.slug}/`}
  description={d?.tagline || c.tagline}
>
  <article class="explorer prose">
    <header class="hub-banner">
      <span class={d ? "chip chip--done" : "chip chip--queued"}>
        {d ? "Explorer 3.0 exemplar" : c.status}
      </span>
      <h1>{d?.title || c.title}</h1>
      <p class="lede">{d?.tagline || c.tagline}</p>
      {!d ? <p><strong>Governing question:</strong> {c.question}</p> : null}
    </header>
    <ExplorerNav current="world-lab" />

    {
      d ? (
        <>
          <section class="hub-section">
            <h2>BEFORE → DECISION → AFTER</h2>
            <dl class="glossary-list">
              <dt>BEFORE</dt>
              <dd>{d.BEFORE}</dd>
              <dt>PROBLEM</dt>
              <dd>{d.PROBLEM}</dd>
              <dt>THEORY</dt>
              <dd>{d.THEORY}</dd>
              <dt>INTERVENTION</dt>
              <dd>{d.INTERVENTION}</dd>
              <dt>SHORT TERM</dt>
              <dd>{d.SHORT_TERM}</dd>
              <dt>SECOND-ORDER EFFECTS</dt>
              <dd>{d.SECOND_ORDER_EFFECTS}</dd>
              <dt>LONG TERM</dt>
              <dd>{d.LONG_TERM}</dd>
              <dt>DISTRIBUTION</dt>
              <dd>{d.DISTRIBUTION}</dd>
              <dt>INSTITUTIONS</dt>
              <dd>{d.INSTITUTIONS}</dd>
              <dt>COUNTERFACTUAL</dt>
              <dd>{d.COUNTERFACTUAL}</dd>
              <dt>SCHOLARLY DISPUTE</dt>
              <dd>{d.SCHOLARLY_DISPUTE}</dd>
              <dt>ARKANSAS LESSON</dt>
              <dd>{d.ARKANSAS_LESSON}</dd>
              <dt>NON-LESSON</dt>
              <dd>{d.NON_LESSON}</dd>
            </dl>
          </section>
          <section class="hub-section">
            <h2>CC: Borrow / Modify / Reject / Question</h2>
            <ul class="stack">
              <li>
                <strong>BORROW:</strong> {d.CC.BORROW}
              </li>
              <li>
                <strong>MODIFY:</strong> {d.CC.MODIFY}
              </li>
              <li>
                <strong>REJECT:</strong> {d.CC.REJECT}
              </li>
              <li>
                <strong>QUESTION:</strong> {d.CC.QUESTION}
              </li>
            </ul>
          </section>
          <SixQuestions six={d.six_questions} />
        </>
      ) : (
        <section class="hub-section">
          <h2>What did this look like in the real world?</h2>
          <dl class="glossary-list">
            <dt>What existed before?</dt>
            <dd>{c.before}</dd>
            <dt>What problem were they confronting?</dt>
            <dd>{c.problem}</dd>
            <dt>What did they change?</dt>
            <dd>{c.changed}</dd>
            <dt>Arkansas lesson</dt>
            <dd>{c.arkansas_lesson}</dd>
            <dt>What does NOT apply?</dt>
            <dd>{c.not_a_transplant}</dd>
          </dl>
          <p class="muted">Shell case. Norway and Gilded Age→Progressive are Explorer 3.0 exemplars.</p>
        </section>
      )
    }

    <p>
      <a href="/compare/explorer/world-lab/">← All World Lab cases</a>
    </p>
  </article>
</BaseLayout>
