---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ExplorerNav from "../../../components/ExplorerNav.astro";
import deep from "../../../../../../data/project/comparison_explorer_deepening_v1.json";

const terms = deep.jargon_library || [];
---

<BaseLayout
  title="Economics Without Jargon"
  path="/compare/explorer/jargon/"
  description="Technical terms in normal-person language—with Arkansas-relevant reasons to care."
>
  <article class="explorer">
    <header class="hub-banner">
      <span class="chip chip--done">Explorer 3.0</span>
      <h1>Economics Without Jargon</h1>
      <p class="lede">
        Never ask the reader to understand the vocabulary before they understand the idea.
      </p>
    </header>
    <ExplorerNav current="home" />

    <section class="hub-section">
      {
        terms.map((t: any) => (
          <section class="module-card" id={t.term.replaceAll(/\s+/g, "-").toLowerCase()}>
            <h2>{t.term}</h2>
            <p>
              <strong>Normal-person version:</strong> {t.plain}
            </p>
            <p>
              <strong>Example:</strong> {t.example}
            </p>
            <p class="muted">
              <strong>Why you should care:</strong> {t.why_care}
            </p>
          </section>
        ))
      }
    </section>

    <section class="hub-section">
      <h2>Exemplar: six layers behind one matrix cell</h2>
      <p class="lede">
        The matrix can still say short labels. Clicking opens depth.{" "}
        <a href="/compare/explorer/ownership-layers/">Open ownership cell layers →</a>
      </p>
    </section>
  </article>
</BaseLayout>
