---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ExplorerNav from "../../../components/ExplorerNav.astro";
import flag from "../../../../../../data/project/comparison_explorer_flagship_v1.json";

const open = flag.opening;
const choose = flag.choose_society;
const act1 = flag.act1_tensions;
const act2 = flag.act2_worlds_teaser;
const isNot = flag.is_not;
const principles = flag.seven_principles;
const twenty = flag.twenty_questions;
const town = flag.liberty_town;
const middle = flag.household_map;
const stage4 = flag.stage4_attack;
const myths = flag.misconceptions;
const challenges = flag.challenges;
const nav = flag.journey_nav;
const sources = flag.sources;
const cap = act2.capitalism_world;
const featured = stage4.featured_claim;
const systemsJson = JSON.stringify(middle.systems);
---

<BaseLayout
  title="What is Constitutional Capitalism? — Flagship"
  path="/compare/explorer/constitutional-capitalism/"
  description={open.lede}
>
  <article class="explorer flagship">
    <header class="hub-banner flagship__hero">
      <span class="chip chip--done">CC-PUBLIC-UNDERSTANDING-FLAGSHIP · +0 dials</span>
      <p class="muted">{open.eyebrow}</p>
      <h1>{open.title}</h1>
      <p class="lede">{open.lede}</p>
      <p>
        <span class="chip chip--live">{open.arkansas_open.label}</span>
        {open.arkansas_open.text}
      </p>
      <p class="muted" style="margin-top:0.75rem;">
        {flag.decision_id} · {flag.update_id} · Validation 33% · Overall 83% unchanged · Stage 4 remains
        primary
      </p>
      <p class="lede" style="margin-top:0.75rem;">
        <em>{flag.success_test}</em>
      </p>
    </header>

    <ExplorerNav current="flagship" />

    <nav class="flagship__toc" aria-label="Journey sections">
      <ul class="link-board">
        {
          nav.map((n) => (
            <li>
              <a href={`#${n.id}`}>{n.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- CHOOSE SOCIETY -->
    <section class="hub-section" id="choose">
      <h2>{choose.title}</h2>
      <p class="lede">{choose.intro}</p>
      {
        choose.questions.map((q) => (
          <details class="flagship__block">
            <summary>{q.prompt}</summary>
            <div class="flagship__body" data-choose={q.id}>
              <ul class="stack flagship__choices">
                {q.choices.map((c) => (
                  <li>
                    <button type="button" class="flagship__choice" data-choice={c.id}>
                      {c.label}
                    </button>
                  </li>
                ))}
              </ul>
              <div class="flagship__traditions" hidden>
                <p class="lede">
                  Here is how different political-economic traditions tend to reason about your choice.
                </p>
                <dl class="glossary-list">
                  {Object.entries(q.traditions).map(([name, take]) => (
                    <>
                      <dt>{name}</dt>
                      <dd>{take}</dd>
                    </>
                  ))}
                </dl>
              </div>
            </div>
          </details>
        ))
      }
    </section>

    <!-- ACT I -->
    <section class="hub-section" id="act1">
      <h2>{act1.title}</h2>
      <p class="lede">{act1.intro}</p>
      <ul class="stack">
        {
          act1.tensions.map((t) => (
            <li>
              <strong>{t.title}</strong>
              <div class="muted">{t.q}</div>
            </li>
          ))
        }
      </ul>
      <p class="lede">
        Every political-economic philosophy is, in part, a different answer to these tensions.
      </p>
    </section>

    <!-- ACT II -->
    <section class="hub-section" id="act2">
      <h2>{act2.title}</h2>
      <p class="lede">{act2.intro}</p>
      <div class="flagship__world">
        <h3>Capitalism</h3>
        <p>{cap.imagine}</p>
        <h4>Why is that powerful?</h4>
        <ul class="stack">
          {cap.why_powerful.map((w: string) => <li>{w}</li>)}
        </ul>
        <h4>Where does the tension begin?</h4>
        <p>{cap.tension}</p>
        <p class="lede">{cap.punch}</p>
        <p>
          <a href={cap.href}>Open the Capitalism world page →</a>
        </p>
      </div>
      <ul class="link-board">
        {
          act2.other_worlds.map((w) => (
            <li>
              <a href={w.href}>{w.name}</a>
              <div class="muted">{w.hook}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- IS NOT -->
    <section class="hub-section" id="is-not">
      <h2>{isNot.title}</h2>
      <p class="lede">{isNot.subtitle}</p>
      {
        isNot.items.map((item) => (
          <details class:list={["flagship__block", item.highlight && "flagship__block--hot"]} open={item.highlight}>
            <summary>{item.title}</summary>
            <p>{item.body}</p>
            {item.highlight ? (
              <p class="lede">
                <strong>Build the bridge before removing the old road.</strong>
              </p>
            ) : null}
          </details>
        ))
      }
    </section>

    <!-- PRINCIPLES -->
    <section class="hub-section" id="principles">
      <h2>What Constitutional Capitalism is</h2>
      <p class="lede">Seven principles—revealed one at a time.</p>
      {
        principles.map((p) => (
          <details class="flagship__block">
            <summary>
              {p.n}. {p.title}
            </summary>
            <p>{p.body}</p>
          </details>
        ))
      }
    </section>

    <!-- 20 QUESTIONS -->
    <section class="hub-section" id="twenty">
      <h2>Constitutional Capitalism in 20 Questions</h2>
      <p class="lede">30-second answer → 5-minute answer → Unabridged source.</p>
      {
        twenty.map((item, i) => (
          <details class="flagship__block">
            <summary>
              {i + 1}. {item.q}
            </summary>
            <p>
              <strong>30 seconds:</strong> {item.sec30}
            </p>
            <p>
              <strong>5 minutes:</strong> {item.sec5}
            </p>
            <p>
              <a href={item.unabridged}>Go deeper →</a>
            </p>
          </details>
        ))
      }
    </section>

    <!-- LIBERTY TOWN -->
    <section class="hub-section" id="town">
      <h2>{town.title}</h2>
      <p>
        <span class="chip chip--live">{town.label}</span> <strong>{town.name}</strong> — population{" "}
        {town.pop.toLocaleString()}
      </p>
      <p class="lede">{town.intro}</p>
      <p class="muted">The town has: {town.assets.join(", ")}.</p>
      <div class="flagship__tabs" data-town-tabs>
        {
          town.systems.map((sys, i) => (
            <button type="button" class:list={["flagship__tab", i === 0 && "is-active"]} data-town={sys.id}>
              {sys.name}
            </button>
          ))
        }
      </div>
      {
        town.systems.map((sys, i) => (
          <div class="flagship__town-panel" data-town-panel={sys.id} hidden={i !== 0}>
            <dl class="glossary-list">
              {town.questions.map((qq) => (
                <>
                  <dt>{qq}</dt>
                  <dd>{sys.answers[qq]}</dd>
                </>
              ))}
            </dl>
          </div>
        ))
      }
    </section>

    <!-- HOUSEHOLD MAP -->
    <section class="hub-section" id="middle">
      <h2>{middle.title}</h2>
      <p class="lede">
        Center: <strong>{middle.center}</strong>. Switch systems. Watch who owns, funds, decides, bears
        risk, receives surplus, and what government controls—without fake numbers.
      </p>
      <div class="flagship__orbit" aria-hidden="true">
        <div class="flagship__orbit-center">{middle.center}</div>
        <ul class="flagship__orbit-nodes">
          {middle.nodes.map((n) => <li>{n}</li>)}
        </ul>
      </div>
      <label class="flagship__select-label">
        System
        <select id="flagship-system" class="flagship__select">
          {
            Object.entries(middle.systems).map(([id, s]) => (
              <option value={id} selected={id === "cc"}>
                {s.name}
              </option>
            ))
          }
        </select>
      </label>
      <div id="flagship-system-out" class="flagship__system-out"></div>
      <p class="muted">Lenses: {middle.lenses.join(" · ")}</p>
      <p>
        <a href="/compare/explorer/follow-100/">Follow the $100 →</a>
      </p>
    </section>

    <!-- STAGE 4 -->
    <section class="hub-section" id="stage4">
      <h2>{stage4.title}</h2>
      <p class="lede">{stage4.intro}</p>
      <div class="flagship__claim">
        <h3>Featured kill</h3>
        <dl class="glossary-list">
          <dt>Claim</dt>
          <dd>{featured.claim}</dd>
          <dt>What we hoped</dt>
          <dd>{featured.hoped}</dd>
          <dt>What hostile testing found</dt>
          <dd>{featured.found}</dd>
          <dt>Result</dt>
          <dd>
            <strong>{featured.result}</strong>
          </dd>
          <dt>What changed</dt>
          <dd>{featured.changed}</dd>
          <dt>Current public cash</dt>
          <dd>
            <strong>{featured.countable}</strong>
          </dd>
        </dl>
      </div>
      <div class="flagship__tabs" data-s4-tabs>
        <button type="button" class="flagship__tab is-active" data-s4="survived">What survived</button>
        <button type="button" class="flagship__tab" data-s4="failed">What failed</button>
        <button type="button" class="flagship__tab" data-s4="changed">What changed</button>
        <button type="button" class="flagship__tab" data-s4="unknown">What we don't know</button>
      </div>
      {
        Object.entries(stage4.tabs).map(([key, items], i) => (
          <ul class="stack flagship__s4-panel" data-s4-panel={key} hidden={i !== 0}>
            {(items as string[]).map((x) => (
              <li>{x}</li>
            ))}
          </ul>
        ))
      }
      <ul class="link-board">
        <li><a href={stage4.hrefs.fiscal}>Fiscal Attack →</a></li>
        <li><a href={stage4.hrefs.legal}>Legal Attack →</a></li>
        <li><a href={stage4.hrefs.validation}>Validation queue →</a></li>
      </ul>
    </section>

    <!-- MYTHS -->
    <section class="hub-section" id="myths">
      <h2>Misconceptions wall</h2>
      {
        myths.map((m) => (
          <details class="flagship__block">
            <summary>{m.q}</summary>
            <p>{m.a}</p>
          </details>
        ))
      }
    </section>

    <!-- CHALLENGE -->
    <section class="hub-section" id="challenge">
      <h2>Challenge Constitutional Capitalism</h2>
      <p class="lede">Choose an objection. We treat it as serious—not a strawman.</p>
      {
        challenges.map((c) => (
          <details class="flagship__block">
            <summary>{c.objection}</summary>
            <p>
              <strong>That's a serious objection.</strong> {c.serious}
            </p>
            <p>
              <strong>CC's answer:</strong> {c.cc_answer}
            </p>
            <p class="muted">
              <strong>Are we satisfied?</strong> {c.satisfaction}
            </p>
          </details>
        ))
      }
    </section>

    <!-- SOURCE -->
    <section class="hub-section" id="source">
      <h2>Go to the Unabridged source</h2>
      <p class="lede">
        This page is a translation layer. The Unabridged remains the source of truth. Explorer earns zero
        Validation points.
      </p>
      <ul class="link-board">
        {
          sources.map((s) => (
            <li>
              <a href={s.href}>{s.label}</a>
            </li>
          ))
        }
        <li>
          <a href="/compare/explorer/philosophy/constitutional-capitalism/">Explorer 3.0 depth exemplar →</a>
        </li>
      </ul>
    </section>
  </article>

  <script define:vars={{ systemsJson }}>
    const systems = JSON.parse(systemsJson);

    document.querySelectorAll("[data-choose]").forEach((block) => {
      const out = block.querySelector(".flagship__traditions");
      block.querySelectorAll(".flagship__choice").forEach((btn) => {
        btn.addEventListener("click", () => {
          block.querySelectorAll(".flagship__choice").forEach((b) => b.classList.remove("is-picked"));
          btn.classList.add("is-picked");
          if (out) out.hidden = false;
        });
      });
    });

    document.querySelectorAll("[data-town-tabs]").forEach((tabs) => {
      tabs.querySelectorAll("[data-town]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-town");
          tabs.querySelectorAll(".flagship__tab").forEach((t) => t.classList.remove("is-active"));
          btn.classList.add("is-active");
          document.querySelectorAll("[data-town-panel]").forEach((p) => {
            p.hidden = p.getAttribute("data-town-panel") !== id;
          });
        });
      });
    });

    document.querySelectorAll("[data-s4-tabs]").forEach((tabs) => {
      tabs.querySelectorAll("[data-s4]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-s4");
          tabs.querySelectorAll(".flagship__tab").forEach((t) => t.classList.remove("is-active"));
          btn.classList.add("is-active");
          document.querySelectorAll("[data-s4-panel]").forEach((p) => {
            p.hidden = p.getAttribute("data-s4-panel") !== id;
          });
        });
      });
    });

    const select = document.getElementById("flagship-system");
    const outEl = document.getElementById("flagship-system-out");
    function renderSystem() {
      if (!select || !outEl) return;
      const s = systems[select.value];
      if (!s) return;
      outEl.innerHTML =
        "<p><strong>" +
        s.name +
        "</strong></p><p>" +
        s.summary +
        "</p><p><strong>Where surplus tends to go:</strong> " +
        s.surplus +
        "</p><p><strong>What government tends to control:</strong> " +
        s.government +
        "</p>";
    }
    select?.addEventListener("change", renderSystem);
    renderSystem();
  </script>

  <style>
    .flagship__hero {
      background: linear-gradient(165deg, var(--void) 0%, var(--void-mid) 55%, #1a2744 100%);
      color: var(--hero-ink);
      border-radius: 0;
      padding: 2rem 1.25rem 2.25rem;
      margin: 0 calc(50% - 50vw) 1.5rem;
      width: 100vw;
      max-width: 100vw;
    }
    .flagship__hero h1,
    .flagship__hero .lede,
    .flagship__hero .muted,
    .flagship__hero p {
      color: inherit;
    }
    .flagship__hero .lede {
      color: var(--hero-ink-soft);
      max-width: var(--measure);
    }
    .flagship__toc {
      position: sticky;
      top: 0;
      z-index: 5;
      background: color-mix(in srgb, var(--paper) 92%, transparent);
      backdrop-filter: blur(8px);
      padding: 0.5rem 0;
      margin-bottom: 1rem;
      border-bottom: 1px solid var(--line);
    }
    .flagship__block {
      border: 1px solid var(--line);
      border-radius: 0.35rem;
      padding: 0.65rem 0.85rem;
      margin: 0.55rem 0;
      background: var(--panel);
    }
    .flagship__block--hot {
      border-color: color-mix(in srgb, var(--copper) 55%, var(--line));
      box-shadow: inset 3px 0 0 var(--copper);
    }
    .flagship__block summary {
      cursor: pointer;
      font-weight: 600;
      color: var(--ink);
      font-family: var(--sans);
    }
    .flagship__world {
      padding: 1rem 0 0.5rem;
      border-top: 1px solid var(--line);
    }
    .flagship__choice {
      display: block;
      width: 100%;
      text-align: left;
      padding: 0.65rem 0.85rem;
      border: 1px solid var(--line);
      background: var(--paper);
      color: var(--ink);
      border-radius: 0.3rem;
      cursor: pointer;
      font: inherit;
    }
    .flagship__choice:hover,
    .flagship__choice.is-picked {
      border-color: var(--accent);
      background: color-mix(in srgb, var(--accent-bright) 12%, var(--panel));
    }
    .flagship__traditions {
      margin-top: 1rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--line);
    }
    .flagship__tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin: 0.75rem 0 1rem;
    }
    .flagship__tab {
      border: 1px solid var(--line);
      background: var(--panel);
      color: var(--ink-soft);
      padding: 0.4rem 0.7rem;
      border-radius: 0.25rem;
      cursor: pointer;
      font: inherit;
      font-size: 0.92rem;
    }
    .flagship__tab.is-active {
      color: var(--accent-deep);
      border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
      font-weight: 600;
    }
    .flagship__orbit {
      display: grid;
      gap: 0.75rem;
      margin: 1rem 0;
      padding: 1rem;
      background: linear-gradient(180deg, var(--paper-deep), var(--panel));
      border: 1px solid var(--line);
      border-radius: 0.4rem;
    }
    .flagship__orbit-center {
      font-family: var(--serif);
      font-size: 1.25rem;
      font-weight: 700;
      text-align: center;
      color: var(--accent-deep);
      padding: 0.75rem;
    }
    .flagship__orbit-nodes {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      justify-content: center;
    }
    .flagship__orbit-nodes li {
      border: 1px solid var(--line);
      padding: 0.35rem 0.55rem;
      border-radius: 0.25rem;
      background: var(--panel);
      font-size: 0.88rem;
      color: var(--ink-soft);
    }
    .flagship__select-label {
      display: grid;
      gap: 0.35rem;
      max-width: 22rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
    }
    .flagship__select {
      font: inherit;
      padding: 0.45rem 0.55rem;
      border: 1px solid var(--line);
      border-radius: 0.3rem;
      background: var(--panel);
      color: var(--ink);
    }
    .flagship__system-out {
      padding: 0.85rem 0;
      max-width: var(--measure);
    }
    .flagship__claim {
      border-left: 3px solid var(--warn);
      padding: 0.25rem 0 0.25rem 0.85rem;
      margin: 1rem 0;
      background: color-mix(in srgb, var(--warn-bg) 55%, var(--panel));
    }
    @media (prefers-reduced-motion: reduce) {
      .flagship__toc {
        position: static;
      }
    }
  </style>
</BaseLayout>
