---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ExplorerNav from "../../../../components/ExplorerNav.astro";
import experience from "../../../../../../../data/project/comparison_explorer_experience_v1.json";

const thinkers = experience.thinkers || [];
---

<BaseLayout
  title="Thinkers & Worlds — Comparison Explorer"
  path="/compare/explorer/thinkers/"
  description="Ideas with people, conflicts, and consequences — the worlds thinkers were responding to."
>
  <article class="explorer">
    <header class="hub-banner">
      <span class="chip chip--done">Historically alive</span>
      <h1>Thinkers &amp; Worlds</h1>
      <p class="lede">
        Adam Smith is not a sticker on capitalism. Karl Marx is not a slogan. Keynes and Hayek were
        answering real crises — and disagreeing about what those crises meant.
      </p>
      <p class="muted">Explorer Experience {experience.version} · expanding roster</p>
    </header>
    <ExplorerNav current="thinkers" />

    <section class="hub-section">
      <ul class="stack">
        {
          thinkers.map((t: any) => (
            <li id={t.id}>
              <strong>{t.name}</strong>
              <p>
                <em>Not just:</em> {t.not_just}
              </p>
              <p>
                <strong>Responding to:</strong> {t.responding_to}
              </p>
              <ul class="link-board">
                <li>
                  <a href={t.href}>Enter related philosophy →</a>
                </li>
                {t.also ? (
                  <li>
                    <a href={t.also}>Also explore →</a>
                  </li>
                ) : null}
              </ul>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <p class="muted">
        Later slices deepen each thinker into a full world — institutions, conflicts, consequences —
        without reopening Foundational System v1.0.
      </p>
      <ul class="link-board">
        <li><a href="/compare/explorer/world-lab/">World Laboratory →</a></li>
        <li><a href="/compare/explorer/#philosophies">All philosophies →</a></li>
      </ul>
    </section>
  </article>
</BaseLayout>
