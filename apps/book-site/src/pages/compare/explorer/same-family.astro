---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ExplorerNav from "../../../components/ExplorerNav.astro";
import explorer from "../../../../../../data/project/comparison_explorer_v1.json";

const fam = explorer.same_family;
---

<BaseLayout
  title="Same Arkansas Family, Different Systems"
  path="/compare/explorer/same-family/"
  description="ILLUSTRATION — which institutions would generally make which decisions for one household."
>
  <article class="explorer">
    <header class="hub-banner">
      <span class="chip chip--live">{fam.claim_class}</span>
      <h1>{fam.title}</h1>
      <p class="lede">
        {fam.family.name} · {fam.family.place} · {fam.family.members}
      </p>
      <p>{fam.family.situation}</p>
      <p class="muted">{fam.disclaimer}</p>
    </header>
    <ExplorerNav current="same-family" />

    <section class="hub-section">
      <h2>Decision axes</h2>
      <ul class="link-board">
        {fam.decision_axes.map((a: string) => <li>{a}</li>)}
      </ul>
    </section>

    {
      fam.by_philosophy.map((block) => (
        <section class="hub-section" aria-labelledby={`fam-${block.id}`}>
          <h2 id={`fam-${block.id}`}>{block.label}</h2>
          <dl class="glossary-list">
            {Object.entries(block.notes).map(([k, v]) => (
              <>
                <dt>{k.replaceAll("_", " ")}</dt>
                <dd>{v as string}</dd>
              </>
            ))}
          </dl>
        </section>
      ))
    }

    <section class="hub-section">
      <p>
        This makes abstract philosophy human without fake predictions. Source of truth:{" "}
        <a href="/system/household-engine/">Household Engine</a>.
      </p>
    </section>
  </article>
</BaseLayout>
