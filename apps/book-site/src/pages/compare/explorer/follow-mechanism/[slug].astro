---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ExplorerNav from "../../../../components/ExplorerNav.astro";
import deep from "../../../../../../../data/project/comparison_explorer_deepening_v1.json";

export function getStaticPaths() {
  return Object.keys(deep.mechanisms || {}).map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as string;
const m = (deep.mechanisms as any)[slug];
---

<BaseLayout
  title={`${m.title} — Follow the Mechanism`}
  path={`/compare/explorer/follow-mechanism/${slug}/`}
  description={m.opening}
>
  <article class="explorer prose">
    <header class="hub-banner">
      <span class="chip chip--done">Explorer 3.0 · Follow the Mechanism</span>
      <h1>{m.title}</h1>
      <p class="lede">{m.opening}</p>
    </header>
    <ExplorerNav current="home" />

    <section class="hub-section">
      <h2>Walk through it</h2>
      <ol class="stack">
        {m.steps.map((s: string) => <li>{s}</li>)}
      </ol>
      <p class="lede">
        <strong>{m.question}</strong> {m.answer}
      </p>
    </section>

    <section class="hub-section">
      <h2>Terms introduced along the way</h2>
      <dl class="glossary-list">
        {
          m.terms_introduced.map((t: any) => (
            <>
              <dt>{t.term}</dt>
              <dd>{t.plain}</dd>
            </>
          ))
        }
      </dl>
    </section>

    <section class="hub-section">
      <h2>How traditions respond</h2>
      <ul class="stack">
        {
          m.traditions.map((t: any) => (
            <li>
              <strong>{t.name}:</strong> {t.take}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Same facts, different conclusions</h2>
      <p class="lede">{m.same_facts.fact}</p>
      <ul class="stack">
        {m.same_facts.readings.map((r: string) => <li>{r}</li>)}
      </ul>
      <p class="muted">We're teaching how to think—not which slogan to memorize.</p>
    </section>
  </article>
</BaseLayout>
