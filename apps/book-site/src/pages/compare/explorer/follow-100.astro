---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ExplorerNav from "../../../components/ExplorerNav.astro";
import explorer from "../../../../../../data/project/comparison_explorer_v1.json";

const f = explorer.follow_100;
---

<BaseLayout
  title="Follow the $100"
  path="/compare/explorer/follow-100/"
  description="ILLUSTRATION — watch $100 move through different ownership models."
>
  <article class="explorer">
    <header class="hub-banner">
      <span class="chip chip--live">{f.claim_class}</span>
      <h1>{f.title}</h1>
      <p class="lede">{f.scene}</p>
      <p class="muted">{f.disclaimer}</p>
    </header>
    <ExplorerNav current="follow-100" />

    <section class="hub-section">
      <p class="lede">{f.punchline}</p>
      <div class="follow-grid">
        {
          f.models.map((m) => (
            <section class="follow-card" aria-labelledby={`m-${m.id}`}>
              <h2 id={`m-${m.id}`}>{m.label}</h2>
              <ul class="follow-flows">
                {m.flows.map((flow) => (
                  <li>
                    <span>{flow.to}</span>
                    <strong>${flow.amount}</strong>
                    <span
                      class="follow-bar"
                      style={`width:${Math.max(8, flow.amount * 2)}%`}
                      aria-hidden="true"
                    />
                  </li>
                ))}
              </ul>
              <p class="muted"><strong>Ten years later:</strong> {m.ten_year_note}</p>
            </section>
          ))
        }
      </div>
      <p>
        Related concept: <a href="/compare/explorer/concept/profit/">Profit</a> ·{" "}
        <a href="/compare/explorer/concept/ownership/">Ownership</a> ·{" "}
        <a href="/system/money-engine/">Money Engine (unabridged)</a>
      </p>
    </section>
  </article>
</BaseLayout>
