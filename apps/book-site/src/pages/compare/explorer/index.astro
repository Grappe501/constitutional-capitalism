---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ExplorerNav from "../../../components/ExplorerNav.astro";
import explorer from "../../../../../../data/project/comparison_explorer_v1.json";
import deep from "../../../../../../data/project/comparison_explorer_deepening_v1.json";
import lane from "../../../../../../data/project/public_understanding_lane.json";
import flag from "../../../../../../data/project/comparison_explorer_flagship_v1.json";
import experience from "../../../../../../data/project/comparison_explorer_experience_v1.json";
import completion from "../../../../../../data/project/completion_ladder_and_dashboard.json";

const paths = deep.contract?.learning_paths || [];
const exemplars = deep.contract?.exemplars_this_pass || {};
const deepPhil = new Set(exemplars.philosophies || []);
const deepConcept = new Set(exemplars.concepts || []);
const fb = completion.foundational_build || {};
const experiences = experience.experiences || [];
---

<BaseLayout
  title="Comparison Explorer — Public Intellectual Experience"
  path="/compare/explorer/"
  description="College-senior depth in high-school-readable language. Explore philosophies, world history, mechanisms, and Put Me in the System — without reopening Foundational System v1.0."
>
  <article class="explorer">
    <header class="hub-banner">
      <span class="chip chip--done">Public Understanding · Explorer Experience {experience.version}</span>
      <h1>Comparison Explorer</h1>
      <p class="lede">{experience.target}</p>
      <p class="muted">
        {fb.banner || "FOUNDATIONAL BUILD — COMPLETE"} · {fb.name || "Foundational System"}{" "}
        {fb.version || "v1.0"} frozen · <strong>+0 foundational dials</strong>
      </p>
      <p class="lede" style="margin-top:0.75rem;">
        Not an encyclopedia. Not a table with longer cells. A place to keep exploring —
        UNDERSTAND → EXPLORE → DEEP DIVE → COMPARE → TEST IT → CC → PROVE.
      </p>
    </header>

    <ExplorerNav current="home" />

    <section class="hub-section" id="experiences">
      <h2>Experiences</h2>
      <ul class="stack">
        {
          experiences.map((e: any) => (
            <li>
              <strong>
                <a href={e.href}>{e.label}</a>
              </strong>
              <div class="muted">{e.promise}</div>
            </li>
          ))
        }
      </ul>
      <ul class="link-board">
        <li>
          <a href="/compare/explorer/constitutional-capitalism/">
            <strong>Flagship journey: What is Constitutional Capitalism?</strong> →
          </a>
        </li>
        <li>
          <a href="/compare/explorer/put-me/">
            <strong>Start Put Me in the System</strong> →
          </a>
        </li>
      </ul>
    </section>

    <section class="hub-section" id="learning-paths" aria-labelledby="paths-title">
      <h2 id="paths-title">Time budgets</h2>
      <p class="lede">Same pages — different depth. No separate content universe.</p>
      <ul class="stack">
        {
          paths.map((p: any) => (
            <li>
              <strong>{p.label}</strong> — {p.promise}
              <ul class="link-board">
                {(p.hrefs || []).map((h: string) => (
                  <li>
                    <a href={h}>{h}</a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="problem">
      <h2 id="problem">Problems first</h2>
      <p class="lede">
        People often learn ideology as vocabulary. This lane teaches <strong>problems first</strong>, then
        mechanisms, then disagreements — at their strongest.
      </p>
      <ul class="stack">
        <li>
          <strong>Capitalism</strong> — How do millions coordinate production without one central authority?
        </li>
        <li>
          <strong>Socialism</strong> — What happens when ownership of productive capital concentrates wealth
          and power?
        </li>
        <li>
          <strong>Social democracy</strong> — Can markets stay productive while protecting people from
          insecurity?
        </li>
        <li>
          <strong>Constitutional Capitalism</strong> — How do we preserve markets and liberty while
          preventing concentrated economic or government power from dominating citizens?
        </li>
      </ul>
    </section>

    <section class="hub-section" id="philosophies" aria-labelledby="phil-title">
      <h2 id="phil-title">Philosophies</h2>
      <ul class="stack">
        {
          (explorer.philosophies || []).map((p: any) => (
            <li>
              <a href={`/compare/explorer/philosophy/${p.slug}/`}>
                <strong>{p.name}</strong>
              </a>
              {deepPhil.has(p.slug) ? <span class="chip chip--done"> seven-layer</span> : null}
              <div class="muted">{p.problem_it_tries_to_solve}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="concepts" aria-labelledby="concept-title">
      <h2 id="concept-title">Concepts</h2>
      <ul class="link-board">
        {
          (explorer.concepts || []).map((c: any) => (
            <li>
              <a href={`/compare/explorer/concept/${c.slug}/`}>
                {c.name || c.title || c.slug}
                {deepConcept.has(c.slug) ? " · deep" : ""}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Lane rules</h2>
      <ul class="stack">
        <li>Unabridged remains source of truth.</li>
        <li>Present the strongest serious version before criticizing.</li>
        <li>Illustrations labeled. No fake statistics.</li>
        <li>
          Status: {lane.status} · Flagship {flag.decision_id || "CC-DEC-176"} · Experience{" "}
          {experience.decision_id}
        </li>
      </ul>
      <ul class="link-board">
        <li><a href="/public-book/">UNDERSTAND · Public Book →</a></li>
        <li><a href="/unabridged/">PROVE · Unabridged →</a></li>
        <li><a href="/status/">Project status →</a></li>
      </ul>
    </section>
  </article>
</BaseLayout>
