---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ExplorerNav from "../../../components/ExplorerNav.astro";
import explorer from "../../../../../../data/project/comparison_explorer_v1.json";
import lane from "../../../../../../data/project/public_understanding_lane.json";
---

<BaseLayout
  title="Comparison Explorer 2.0"
  path="/compare/explorer/"
  description="Political-economic philosophy explorer — plain English to technical depth. Translation layer into the Unabridged source of truth."
>
  <article class="explorer">
    <header class="hub-banner">
      <span class="chip chip--queued">CC-PUBLIC-UNDERSTANDING-LANE</span>
      <h1>{explorer.title}</h1>
      <p class="lede">{explorer.subtitle}</p>
      <p class="muted">
        {lane.status} · {explorer.decision_id} · {explorer.update_id} · Completion dials unchanged
        (Unabridged 100% · Overall 75%)
      </p>
      <p class="lede" style="margin-top:0.75rem;">
        <strong>Unabridged = source of truth.</strong> This Explorer is a translation layer for public
        understanding—not a competing doctrine and not a ninth Stage 3 category.
      </p>
      <ul class="link-board">
        <li><a href="/compare/explorer/matrix/">Open simple clickable matrix →</a></li>
        <li><a href="/compare/explorer/follow-100/">Follow the $100 →</a></li>
        <li><a href="/compare/explorer/same-family/">Same Arkansas Family →</a></li>
        <li><a href="/compare/explorer/world-lab/">World Laboratory →</a></li>
        <li><a href="/unabridged/">Unabridged source of truth →</a></li>
        <li><a href="/compare/">Legacy full system matrix →</a></li>
      </ul>
    </header>

    <ExplorerNav current="home" />

    <section class="hub-section" aria-labelledby="problem">
      <h2 id="problem">What problem are we solving?</h2>
      <p class="lede">
        People often learn ideology as vocabulary. This lane teaches <strong>problems first</strong>.
      </p>
      <ul class="stack">
        <li>
          <strong>Capitalism</strong> — How do millions coordinate production without one central
          authority deciding everything?
        </li>
        <li>
          <strong>Socialism</strong> — What happens when ownership of productive capital concentrates
          wealth and power?
        </li>
        <li>
          <strong>Social democracy</strong> — Can we retain market productivity while protecting people
          from insecurity and extreme inequality?
        </li>
        <li>
          <strong>Constitutional Capitalism</strong> — How do we preserve markets, initiative, ownership,
          and liberty while preventing concentrated economic or government power from dominating
          citizens—and make prosperity compound across households, communities, and generations?
        </li>
      </ul>
    </section>

    <section class="hub-section" id="philosophies" aria-labelledby="phil-title">
      <h2 id="phil-title">Philosophy pages</h2>
      <p class="lede">
        Same structure for each tradition. Strongest case first. Then criticism. Then CC relationship.
      </p>
      <p class="muted">{explorer.neutrality_rule}</p>
      <ul class="link-board">
        {
          explorer.philosophies.map((p) => (
            <li>
              <a href={`/compare/explorer/philosophy/${p.slug}/`}>{p.name}</a>
              <span class="muted"> · {p.status}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="concepts" aria-labelledby="concept-title">
      <h2 id="concept-title">Concept mini-books</h2>
      <p class="lede">
        Ask a question—ownership, markets, profit, monopoly—and enter a layered answer: Quick →
        Understand → Deeper → Technical → Sources.
      </p>
      <ul class="link-board">
        {
          explorer.concepts.map((c) => (
            <li>
              <a href={`/compare/explorer/concept/${c.slug}/`}>{c.title}</a>
              <span class="muted"> — {c.question}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="experiences">
      <h2 id="experiences">Teaching experiences</h2>
      <ul class="link-board">
        <li><a href="/compare/explorer/follow-100/">Follow the $100 (ILLUSTRATION)</a></li>
        <li><a href="/compare/explorer/same-family/">Same Arkansas Family (ILLUSTRATION)</a></li>
        <li><a href="/compare/explorer/world-lab/">World Laboratory — historical cases</a></li>
        <li><a href="/compare/explorer/same-problem/">Same Problem, Different Answers</a></li>
        <li><a href="/compare/explorer/table-talk/">Around the table</a></li>
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="rules">
      <h2 id="rules">Lane rules</h2>
      <ul class="stack">
        <li>Zero effect on Stage 3 / overall completion metrics</li>
        <li>Does not delay Stage 4 — Break It</li>
        <li>Links into Unabridged rather than inventing parallel doctrine</li>
        <li>No fake statistics; illustrations labeled ILLUSTRATION</li>
        <li>Never ask readers for vocabulary before the idea</li>
      </ul>
    </section>
  </article>
</BaseLayout>
