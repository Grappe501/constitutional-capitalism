---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ExplorerNav from "../../../components/ExplorerNav.astro";
import explorer from "../../../../../../data/project/comparison_explorer_v1.json";

const sp = explorer.same_problem;
---

<BaseLayout
  title="Same Problem, Different Answers"
  path="/compare/explorer/same-problem/"
  description="One problem; how different traditions reason—then real-world cases underneath."
>
  <article class="explorer">
    <header class="hub-banner">
      <span class="chip chip--done">Decision frameworks</span>
      <h1>{sp.title}</h1>
      <p class="lede">Philosophy becomes usable when it answers the same concrete problem.</p>
    </header>
    <ExplorerNav current="same-problem" />

    {
      sp.items.map((item) => (
        <section class="hub-section" aria-labelledby={item.id}>
          <h2 id={item.id}>{item.title}</h2>
          <ul class="stack">
            {item.answers.map((a) => (
              <li>
                <strong>{a.philosophy}:</strong> {a.answer}
              </li>
            ))}
          </ul>
          <p class="muted">
            World examples: see <a href="/compare/explorer/world-lab/">World Laboratory</a>.
          </p>
        </section>
      ))
    }
  </article>
</BaseLayout>
