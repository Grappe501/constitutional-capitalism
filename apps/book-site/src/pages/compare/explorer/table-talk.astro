---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ExplorerNav from "../../../components/ExplorerNav.astro";
import explorer from "../../../../../../data/project/comparison_explorer_v1.json";

const tt = explorer.table_talk;
---

<BaseLayout
  title="Around the Table"
  path="/compare/explorer/table-talk/"
  description="How different traditions might reason about the same public question—without cartoon stereotypes."
>
  <article class="explorer">
    <header class="hub-banner">
      <span class="chip chip--done">Intellectual reasoning</span>
      <h1>{tt.title}</h1>
      <p class="lede">Not partisan stereotypes. Actual decision frameworks.</p>
    </header>
    <ExplorerNav current="home" />

    {
      tt.items.map((item) => (
        <section class="hub-section" aria-labelledby={item.id}>
          <h2 id={item.id}>{item.question}</h2>
          <ul class="stack">
            {item.voices.map((v) => (
              <li>
                <strong>{v.tradition}:</strong> {v.reasoning}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </article>
</BaseLayout>
