---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ExplorerNav from "../../../../components/ExplorerNav.astro";
import ExplorerSubjectChrome from "../../../../components/ExplorerSubjectChrome.astro";
import DepthMode from "../../../../components/DepthMode.astro";
import SixQuestions from "../../../../components/SixQuestions.astro";
import DefendOtherSide from "../../../../components/DefendOtherSide.astro";
import explorer from "../../../../../../../data/project/comparison_explorer_v1.json";
import deep from "../../../../../../../data/project/comparison_explorer_deepening_v1.json";

export function getStaticPaths() {
  return explorer.philosophies.map((p) => ({ params: { slug: p.slug } }));
}

const slug = Astro.params.slug as string;
const p = explorer.philosophies.find((x) => x.slug === slug)!;
const d = (deep.philosophies_deep as any)?.[slug] || null;
const rel = p.cc_relationship || {};
const title = d?.display_name || p.name;
---

<BaseLayout
  title={`${title} — Comparison Explorer`}
  path={`/compare/explorer/philosophy/${p.slug}/`}
  description={d?.plain_english_opening || `What ${p.name} believes and how Constitutional Capitalism relates.`}
>
  <article class="explorer prose">
    <header class="hub-banner">
      <span class={d ? "chip chip--done" : "chip chip--queued"}>
        {d ? "Seven-layer experience" : p.status}
      </span>
      <h1>{title}</h1>
      <p class="lede">
        <strong>Problem it tries to solve:</strong> {p.problem_it_tries_to_solve}
      </p>
      <p class="muted">{p.variants_note}</p>
      <ul class="link-board">
        <li><a href="/compare/explorer/">← Explorer home</a></li>
        <li><a href="/compare/explorer/put-me/">Put Me in the System →</a></li>
        {
          p.slug === "constitutional-capitalism" ? (
            <li>
              <a href="/compare/explorer/constitutional-capitalism/">
                <strong>Open the flagship journey →</strong>
              </a>
            </li>
          ) : null
        }
        {
          p.compare_dossier_slug ? (
            <li>
              <a href={`/compare/${p.compare_dossier_slug}/`}>Analytical dossier →</a>
            </li>
          ) : null
        }
      </ul>
    </header>
    <ExplorerNav current="philosophies" />
    <ExplorerSubjectChrome />

    {
      d ? (
        <>
          <section class="hub-section" id="layer-understand">
            <h2>UNDERSTAND</h2>
            <DepthMode
              plain={d.plain_english_opening}
              deep={d.mechanism}
              technical={d.technical_definition}
            />
          </section>

          <section class="hub-section" id="layer-explore">
            <h2>EXPLORE</h2>
            <p>
              <span class="chip chip--live">{d.arkansas_scenario.label}</span> {d.arkansas_scenario.text}
            </p>
            <h3>Branches inside this tradition</h3>
            <p class="muted">{d.branches_note}</p>
            <ul class="stack">
              {d.branches.map((b: any) => (
                <li>
                  <strong>{b.name}:</strong> {b.idea}
                </li>
              ))}
            </ul>
            <p>
              <a href="/compare/explorer/put-me/">See this through an Arkansas role →</a>
            </p>
          </section>

          <section class="hub-section" id="layer-deep-dive">
            <h2>DEEP DIVE</h2>
            <h3>{d.thinkers_disagreement.title}</h3>
            {d.thinkers_disagreement.smith ? (
              <>
                <p>
                  <strong>Smith:</strong> {d.thinkers_disagreement.smith}
                </p>
                <p>
                  <strong>Marx:</strong> {d.thinkers_disagreement.marx}
                </p>
              </>
            ) : null}
            {d.thinkers_disagreement.side_a ? (
              <>
                <p>
                  <strong>One side:</strong> {d.thinkers_disagreement.side_a}
                </p>
                <p>
                  <strong>Other side:</strong> {d.thinkers_disagreement.side_b}
                </p>
              </>
            ) : null}
            {d.thinkers_disagreement.keynes ? (
              <>
                <p>
                  <strong>Keynes:</strong> {d.thinkers_disagreement.keynes}
                </p>
                <p>
                  <strong>Hayek:</strong> {d.thinkers_disagreement.hayek}
                </p>
              </>
            ) : null}
            <p class="lede">{d.thinkers_disagreement.question}</p>
            <p class="muted">{d.thinkers_disagreement.no_winner}</p>
            <SixQuestions six={d.six_questions} />
            <h3>First-order vs second-order</h3>
            <p>
              <strong>First-order:</strong> {d.first_order}
            </p>
            <ul class="stack">
              {d.second_order.map((s: string) => (
                <li>{s}</li>
              ))}
            </ul>
            <p>
              <strong>Opportunity cost:</strong> {d.opportunity_cost}
            </p>
          </section>

          <section class="hub-section" id="layer-compare">
            <h2>COMPARE</h2>
            <p>
              <strong>Strongest argument for:</strong> {d.strongest_for}
            </p>
            <p>
              <strong>Strongest argument against this page:</strong> {d.argument_against_page}
            </p>
            <DefendOtherSide questions={d.defend_other_side} />
            <p>
              <a href="/compare/explorer/matrix/">Open the simple matrix →</a> ·{" "}
              <a href="/compare/explorer/same-problem/">Same problem, different answers →</a>
            </p>
          </section>

          <section class="hub-section" id="layer-test-it">
            <h2>TEST IT</h2>
            <p>{d.empirical_note}</p>
            <p class="muted">{d.scholarly_disagreement}</p>
            <p>
              <strong>What evidence would settle it?</strong> {d.what_evidence_would_settle}
            </p>
            <p>
              <a href="/compare/explorer/world-lab/">World Laboratory →</a>
            </p>
          </section>

          <section class="hub-section" id="layer-cc">
            <h2>CC — Agree · Borrow · Modify · Reject · Unresolved</h2>
            <p>
              <strong>Position:</strong> {d.cc_position}
            </p>
            <ul class="stack">
              <li>
                <strong>AGREE:</strong> {(rel.WE_AGREE_HERE || []).join(" · ") || "—"}
              </li>
              <li>
                <strong>BORROW:</strong> {(rel.WE_BORROW_THIS || []).join(" · ") || "—"}
              </li>
              <li>
                <strong>MODIFY:</strong> {(rel.WE_MODIFY_THIS || []).join(" · ") || "—"}
              </li>
              <li>
                <strong>REJECT:</strong> {(rel.WE_REJECT_THIS || []).join(" · ") || "—"}
              </li>
              <li>
                <strong>UNRESOLVED:</strong> {d.cc_uncertainty || "Open questions remain — honesty over forced closure."}
              </li>
            </ul>
            <p class="muted">
              <strong>Stage 4 posture:</strong> {d.stage4_testing}
            </p>
          </section>

          <section class="hub-section" id="layer-prove">
            <h2>PROVE</h2>
            <p class="muted">
              Unabridged is the source of truth. The Explorer translates — it does not compete.
            </p>
            <ul class="link-board">
              {(d?.unabridged_links || p.unabridged_links || []).map((href: string) => (
                <li>
                  <a href={href}>{href} →</a>
                </li>
              ))}
              <li>
                <a href="/unabridged/">Unabridged hub →</a>
              </li>
              <li>
                <a href="/evidence/">Evidence desk →</a>
              </li>
            </ul>
          </section>
        </>
      ) : (
        <>
          <section class="hub-section" id="layer-understand">
            <h2>UNDERSTAND</h2>
            <DepthMode plain={p.depths.plain} deep={p.depths.deep} technical={p.depths.technical} />
          </section>
          <section class="hub-section" id="layer-explore">
            <h2>EXPLORE</h2>
            <dl class="glossary-list">
              <dt>Where did it come from?</dt>
              <dd>{p.where_it_came_from}</dd>
              <dt>Who should own productive property?</dt>
              <dd>{p.who_owns_productive_property}</dd>
              <dt>What should government do?</dt>
              <dd>{p.what_government_does}</dd>
              <dt>What does success look like?</dt>
              <dd>{p.success_looks_like}</dd>
            </dl>
          </section>
          <section class="hub-section" id="layer-deep-dive">
            <h2>DEEP DIVE</h2>
            <p>{p.why_supporters_believe}</p>
            <p>{p.where_reality_gets_complicated}</p>
            <p class="muted">
              Full seven-layer depth is expanding across philosophies. Exemplars already rebuilt:
              modern market capitalism, socialism, social democracy, constitutional capitalism.
            </p>
          </section>
          <section class="hub-section" id="layer-compare">
            <h2>COMPARE</h2>
            <p>{p.what_critics_say}</p>
            <p>
              <a href="/compare/explorer/matrix/">Simple matrix →</a>
            </p>
          </section>
          <section class="hub-section" id="layer-test-it">
            <h2>TEST IT</h2>
            <p>
              <a href="/compare/explorer/world-lab/">World Laboratory →</a>
            </p>
          </section>
          <section class="hub-section" id="layer-cc">
            <h2>CC — Agree · Borrow · Modify · Reject · Unresolved</h2>
            <ul class="stack">
              <li>
                <strong>AGREE:</strong> {(rel.WE_AGREE_HERE || []).join(" · ")}
              </li>
              <li>
                <strong>DISAGREE:</strong> {(rel.WE_DISAGREE_HERE || []).join(" · ")}
              </li>
              <li>
                <strong>BORROW:</strong> {(rel.WE_BORROW_THIS || []).join(" · ")}
              </li>
              <li>
                <strong>MODIFY:</strong> {(rel.WE_MODIFY_THIS || []).join(" · ")}
              </li>
              <li>
                <strong>REJECT:</strong> {(rel.WE_REJECT_THIS || []).join(" · ")}
              </li>
              <li>
                <strong>UNRESOLVED:</strong> Shell page — deepen without forcing premature closure.
              </li>
            </ul>
          </section>
          <section class="hub-section" id="layer-prove">
            <h2>PROVE</h2>
            <ul class="link-board">
              {(p.unabridged_links || []).map((href: string) => (
                <li>
                  <a href={href}>{href} →</a>
                </li>
              ))}
            </ul>
          </section>
        </>
      )
    }
  </article>
</BaseLayout>
