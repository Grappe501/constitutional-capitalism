---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ExplorerNav from "../../../../components/ExplorerNav.astro";
import experience from "../../../../../../../data/project/comparison_explorer_experience_v1.json";

const mechs = experience.mechanisms_backlog || [];
---

<BaseLayout
  title="Interactive Mechanisms — Comparison Explorer"
  path="/compare/explorer/mechanisms/"
  description="Watch what happens when ownership concentrates, money leaves, monopolies form, or public investment succeeds or fails."
>
  <article class="explorer">
    <header class="hub-banner">
      <span class="chip chip--live">Mechanisms · experience</span>
      <h1>Interactive Mechanisms</h1>
      <p class="lede">
        Not slogans — cause and effect. Start with what is shipped; the backlog expands without
        touching foundational dials.
      </p>
    </header>
    <ExplorerNav current="mechanisms" />

    <section class="hub-section">
      <ul class="stack">
        {
          mechs.map((m: any) => (
            <li>
              <span class={m.status === "SHIPPED" ? "chip chip--done" : "chip chip--queued"}>
                {m.status}
              </span>{" "}
              <strong>{m.label}</strong>
              {m.href ? (
                <>
                  {" "}
                  · <a href={m.href}>Open →</a>
                </>
              ) : (
                <div class="muted">Planned interactive walkthrough — not yet built.</div>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Also useful now</h2>
      <ul class="link-board">
        <li><a href="/compare/explorer/follow-100/">Follow the $100 →</a></li>
        <li><a href="/compare/explorer/ownership-layers/">Ownership layers →</a></li>
        <li><a href="/compare/explorer/matrix/">Simple matrix →</a></li>
      </ul>
    </section>
  </article>
</BaseLayout>
