---
import BaseLayout from "../layouts/BaseLayout.astro";
import justice from "../../../../data/project/justice_framework.json";

const stages = justice.stages || [];
const testQs = justice.justice_test?.questions || [];
const branches = justice.website_branches || [];
const commitments = justice.core_commitments || [];
const corps = justice.community_safety_corps?.components || [];
const paths = justice.decision_pathways?.paths || [];
const systemMap = justice.system_map || [];
const leaveWith = justice.reentry_from_day_one?.leave_with || [];
---

<BaseLayout
  title="Community Safety, Justice, and Restoration"
  path="/justice/"
  description="Complete Community Safety and Restoration System — prevent, protect, treat, secure, restore, return."
>
  <article class="prose">
    <h1>{justice.domain_title}</h1>
    <p class="status-note">
      Developing doctrine and research architecture — not finished justice policy. Legal review 0%.
      Community Safety Corps and Restoration Councils are design agendas. No invented crime or recidivism statistics.
    </p>
    <p class="lede">{justice.role_in_philosophy}</p>

    <h2>System objective</h2>
    <blockquote>
      <p>{justice.system_objective.text}</p>
    </blockquote>
    <p>{justice.system_objective.not_merely}</p>
    <p>{justice.system_objective.presence_rule}</p>

    <h2>Community safety doctrine</h2>
    <blockquote>
      <p>{justice.community_safety_doctrine.text}</p>
    </blockquote>

    <h2>Public-safety promise</h2>
    <blockquote>
      <p>{justice.public_safety_promise.text}</p>
    </blockquote>

    <h2>System map</h2>
    <ol>
      {systemMap.map((step: string) => (
        <li>{step}</li>
      ))}
    </ol>
    <p>
      That is the better way: <strong>not more incarceration, not less accountability — more safety, more restoration, and far less human potential permanently discarded.</strong>
    </p>

    <h2>Community Safety Corps</h2>
    <p class="status-note">Status: {justice.community_safety_corps.status}</p>
    <p>{justice.community_safety_corps.summary}</p>
    {
      corps.map((c: any) => (
        <section style="margin-bottom:1rem;">
          <h3 style="margin-bottom:0.35rem;">{c.title}</h3>
          {c.summary && <p>{c.summary}</p>}
          {(c.responsibilities || c.handles || c.provides) && (
            <ul>
              {(c.responsibilities || c.handles || c.provides).map((item: string) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
    <h3>Separate community service from coercive authority</h3>
    <p>
      Appropriate duties move to trained civilian professionals so sworn officers concentrate on work that requires lawful coercive authority:
    </p>
    <ul>
      {(justice.community_safety_corps.civilian_transfer_examples || []).map((e: string) => (
        <li>{e}</li>
      ))}
    </ul>

    <h2>Relationships, not quotas</h2>
    <p>{justice.relationship_policing.meaning}</p>
    <p>{justice.relationship_policing.assigned_areas}</p>
    <p>{justice.relationship_policing.quota_ban}</p>

    <h2>Public professional corrections</h2>
    <blockquote>
      <p>{justice.public_corrections_rule.text}</p>
    </blockquote>
    <p>{justice.public_corrections_rule.ban}</p>
    <p class="status-note">{justice.public_corrections_rule.federal_policy_instability_note}</p>

    <h2>Decision pathways</h2>
    <p>{justice.decision_pathways.summary}</p>
    {
      paths.map((p: any) => (
        <section style="margin-bottom:1rem;">
          <h3 style="margin-bottom:0.35rem;">
            {p.path_id}: {p.title}
          </h3>
          {p.rule && <p>{p.rule}</p>}
          {p.evidence_note && <p class="status-note">{p.evidence_note}</p>}
          {p.responses && (
            <ul>
              {p.responses.map((r: string) => (
                <li>{r}</li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    <h2>Secure restoration campuses</h2>
    <p>{justice.secure_restoration_campuses.summary}</p>
    <p class="status-note">{justice.secure_restoration_campuses.recidivism_note}</p>

    <h2>Reentry from day one</h2>
    <p>{justice.reentry_from_day_one.summary}</p>
    <p>Every returning citizen should leave with:</p>
    <ul>
      {leaveWith.map((item: string) => (
        <li>{item}</li>
      ))}
    </ul>
    <p class="status-note">{justice.reentry_from_day_one.evidence_caution}</p>

    <h2>Productive citizenship</h2>
    <p>{justice.productive_citizenship_destination.summary}</p>

    <h2>Restoration Councils</h2>
    <p class="status-note">Status: {justice.restoration_councils.status}</p>
    <p>{justice.restoration_councils.summary}</p>

    {
      justice.permanent_public_safety_system && (
        <>
          <h2>Permanent Public Safety System</h2>
          <p class="status-note">
            Status: {justice.permanent_public_safety_system.status}. Design agenda — not operating campuses.
          </p>
          <p>
            Rejected language: <em>“{justice.permanent_public_safety_system.rejected_language}.”</em>{" "}
            {justice.permanent_public_safety_system.rejected_language_reason}
          </p>
          <p>
            Correct language:{" "}
            <strong>{justice.permanent_public_safety_system.correct_language}</strong>
          </p>
          <p>{justice.permanent_public_safety_system.language_distinction}</p>
          <p>{justice.permanent_public_safety_system.answer}</p>
          <blockquote>
            <p>{justice.permanent_public_safety_system.constitutional_capitalism_standard}</p>
          </blockquote>

          <h3>Narrowest possible category</h3>
          <p>{justice.permanent_public_safety_system.narrow_eligibility.summary}</p>
          <ul>
            {justice.permanent_public_safety_system.narrow_eligibility.criteria_examples.map(
              (c: string) => (
                <li>{c}</li>
              )
            )}
          </ul>
          <p class="status-note">
            {justice.permanent_public_safety_system.narrow_eligibility.risk_score_rule}
          </p>

          <h3>Secure Public Safety Campuses</h3>
          <p>{justice.permanent_public_safety_system.secure_public_safety_campuses.summary}</p>
          <p>
            Organized around:{" "}
            {justice.permanent_public_safety_system.secure_public_safety_campuses.organized_around.join(
              "; "
            )}
            .
          </p>
          <p class="status-note">
            {justice.permanent_public_safety_system.secure_public_safety_campuses.constitutional_conditions_note}
          </p>

          <h3>Graduated custody</h3>
          <p>{justice.permanent_public_safety_system.graduated_custody.summary}</p>
          <ol>
            {justice.permanent_public_safety_system.graduated_custody.levels.map((l: any) => (
              <li>
                <strong>{l.title}</strong> — {l.for}
              </li>
            ))}
          </ol>
          <p class="status-note">{justice.permanent_public_safety_system.graduated_custody.aging_cost_note}</p>
          <p class="status-note">{justice.permanent_public_safety_system.graduated_custody.aging_risk_note}</p>

          <h3>Periodic dangerousness review</h3>
          <p>{justice.permanent_public_safety_system.periodic_dangerousness_review.summary}</p>
          <p>Cadence: {justice.permanent_public_safety_system.periodic_dangerousness_review.cadence}</p>

          <h3>Pathway when release is unlikely</h3>
          <p>{justice.permanent_public_safety_system.pathway_even_when_release_unlikely.summary}</p>

          <h3>Resource concentration</h3>
          <blockquote>
            <p>{justice.permanent_public_safety_system.resource_concentration.text}</p>
          </blockquote>
          <p>{justice.permanent_public_safety_system.resource_concentration.summary}</p>

          <h3>Reject exile; no private profit from permanent confinement</h3>
          <p>{justice.permanent_public_safety_system.reject_exile_and_banishment.summary}</p>
          <p>{justice.permanent_public_safety_system.no_private_profit_from_permanent_confinement.summary}</p>

          <h3>Anti-misuse safeguards</h3>
          <p>{justice.permanent_public_safety_system.anti_misuse_safeguards.summary}</p>
          <ul>
            {justice.permanent_public_safety_system.anti_misuse_safeguards.rules.map((r: string) => (
              <li>{r}</li>
            ))}
          </ul>
        </>
      )
    }

    <h2>Foundational principle</h2>
    <blockquote>
      <p>{justice.foundational_principle.text}</p>
    </blockquote>

    <h2>Five stages</h2>
    <ol>
      {
        stages.map((s: any) => (
          <li>
            <strong>{s.name}</strong> — {s.summary}
          </li>
        ))
      }
    </ol>

    <h2>Core commitments</h2>
    <ul>
      {
        commitments.map((c: any) => (
          <li>
            <strong>{c.title}</strong> — {c.summary}
          </li>
        ))
      }
    </ul>

    <h2>Justice Test</h2>
    <p>{justice.justice_test.purpose}</p>
    <ol>
      {testQs.map((q: any) => (
        <li>{q.text}</li>
      ))}
    </ol>

    <h2>Domain branches</h2>
    <p>Living-website branches (seeded; detailed pages publish as research matures):</p>
    <ul>
      {branches.map((b: any) => (
        <li>{b.title}</li>
      ))}
    </ul>

    <h2>Research before policy</h2>
    <p>
      Detailed justice legislation is blocked until Phase 2/2.1 diagnosis sources are registered.
      See <a href="/where-we-are/">Where we are</a>, <a href="/evidence/">Evidence</a>, and the
      research domain under <code>content/research/justice/</code>.
    </p>
  </article>
</BaseLayout>
