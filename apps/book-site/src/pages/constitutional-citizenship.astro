---
import BaseLayout from "../layouts/BaseLayout.astro";
import civ from "../../../../data/project/constitutional_citizenship_framework.json";

const testQs = civ.constitutional_citizenship_test?.questions || [];
const branches = civ.website_branches || [];
const stages = civ.developmental_civic_pathway?.stages || [];
const practice = civ.participatory_civic_education?.practice_examples || [];
const youthRoles = civ.youth_leadership_councils?.student_roles || [];
const researchQs = civ.prepared_civic_participation_exploration?.research_questions || [];
const portfolio = civ.civic_graduation?.portfolio_demonstrates || [];
const hosts = civ.schools_as_community_laboratories?.hosts || [];
const service = civ.civic_service?.examples || [];
const scorechecks = civ.civic_scorecards?.example_checks || [];
---

<BaseLayout
  title="Constitutional Citizenship Doctrine"
  path="/constitutional-citizenship/"
  description="Self-government requires education — prepare every generation for responsible civic participation."
>
  <article class="prose">
    <h1>{civ.domain_title}</h1>
    <p class="status-note">
      Core doctrine — build civic capacity, not merely expand rights. Not a locked voting-age statute.
      No invented civics-outcome or turnout statistics.
    </p>
    <p class="lede">{civ.role_in_philosophy}</p>

    <h2>Central question</h2>
    <p>Not primarily: <em>{civ.central_question_shift.not_primary}</em></p>
    <blockquote>
      <p>{civ.central_question_shift.primary}</p>
    </blockquote>
    <p>{civ.central_question_shift.meaning}</p>

    <h2>Foundational doctrine</h2>
    <blockquote>
      <p>{civ.foundational_doctrine.text}</p>
    </blockquote>
    <blockquote>
      <p>{civ.guiding_statement.text}</p>
    </blockquote>

    <h2>Participatory civic education</h2>
    <p>{civ.participatory_civic_education.summary}</p>
    <ul>
      {practice.map((p: string) => (
        <li>{p}</li>
      ))}
    </ul>

    <h2>Developmental civic pathway</h2>
    <p class="status-note">{civ.developmental_civic_pathway.note}</p>
    {
      stages.map((s: any) => (
        <section>
          <h3>
            Ages {s.ages} — {s.focus}
          </h3>
          <ul>
            {s.elements.map((e: string) => (
              <li>{e}</li>
            ))}
          </ul>
          {s.capability ? <p>{s.capability}</p> : null}
        </section>
      ))
    }

    <h2>Youth Leadership Councils</h2>
    <p>{civ.youth_leadership_councils.summary}</p>
    <ul>
      {youthRoles.map((r: string) => (
        <li>{r}</li>
      ))}
    </ul>
    <p>
      <strong>{civ.youth_leadership_councils.adult_rule}</strong>
    </p>

    <h2>Prepared civic participation</h2>
    <p>
      <strong>{civ.prepared_civic_participation_exploration.hard_rule}</strong>
    </p>
    <blockquote>
      <p>{civ.prepared_civic_participation_exploration.governing_question}</p>
    </blockquote>
    <p>
      Illustrative model ({civ.prepared_civic_participation_exploration.illustrative_model.status}):{" "}
      {civ.prepared_civic_participation_exploration.illustrative_model.description}
    </p>
    <p>{civ.prepared_civic_participation_exploration.pilot_posture}</p>
    <p>Questions to study:</p>
    <ul>
      {researchQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ul>
    <p class="status-note">{civ.prepared_civic_participation_exploration.note}</p>

    <h2>Civic Graduation</h2>
    <p>{civ.civic_graduation.summary}</p>
    <p>
      <strong>{civ.civic_graduation.portfolio_name}</strong> demonstrates:
    </p>
    <ul>
      {portfolio.map((p: string) => (
        <li>{p}</li>
      ))}
    </ul>

    <h2>Schools as community laboratories</h2>
    <p>{civ.schools_as_community_laboratories.summary}</p>
    <ul>
      {hosts.map((h: string) => (
        <li>{h}</li>
      ))}
    </ul>

    <h2>Civic service</h2>
    <p>{civ.civic_service.summary}</p>
    <ul>
      {service.map((s: string) => (
        <li>{s}</li>
      ))}
    </ul>

    <h2>Civic scorecards</h2>
    <p>{civ.civic_scorecards.summary}</p>
    <ul>
      {scorechecks.map((c: string) => (
        <li>{c}</li>
      ))}
    </ul>
    <p class="status-note">{civ.civic_scorecards.note}</p>

    <h2>Constitutional Citizenship Test</h2>
    <p>{civ.constitutional_citizenship_test.purpose}</p>
    <ol>
      {testQs.map((q: any) => (
        <li>{q.text}</li>
      ))}
    </ol>

    <h2>Domain branches</h2>
    <ul>
      {branches.map((b: any) => (
        <li>
          <strong>{b.title}</strong> — {b.summary}
        </li>
      ))}
    </ul>

    <p>
      See also <a href="/human-capital/">Human Capital</a>,{" "}
      <a href="/equal-standing/">Equal Standing</a>, <a href="/democracy/">Democracy</a>,{" "}
      <a href="/build-your-community/">Build Your Community</a>, and{" "}
      <a href="/public-service/">Public Service</a>.
    </p>
  </article>
</BaseLayout>
