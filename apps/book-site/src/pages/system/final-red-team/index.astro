---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReadingModes from "../../../components/ReadingModes.astro";
import chapter from "../../../../../../data/project/stage4_pass46_whole_system_final_red_team.json";

const joins = chapter.join_tests || [];
const board = chapter.final_proposition_board || [];
const crash = chapter.crash_test || {};
const ownership = chapter.public_ownership_standard || {};
const visuals = chapter.signature_visuals || [];
const gates = chapter.stage4_pass_gate_card || [];
const core = chapter.surviving_architecture_summary || {};
const dist = chapter.project_build_distinction || {};
const wcf = chapter.what_changed_format || {};
const cert = chapter.certification || {};
const ov = chapter.ov_cx_disposition || [];
const integrity = chapter.join_integrity || {};

function statusChip(s?: string) {
  if (!s) return "chip chip--queued";
  if (
    s === "CERTIFIED_CORE" ||
    s === "JOIN_PASS" ||
    s === "PASS" ||
    s === "RESOLVED" ||
    s === "SYNCHRONIZED" ||
    s === "LOCKED" ||
    s === "STAGE_4_CERTIFIED"
  )
    return "chip chip--done";
  if (s === "CERTIFIED_WITH_GUARDRAILS" || s === "CONDITIONAL" || s === "PILOT_ONLY")
    return "chip chip--live";
  if (s === "FAILED" || s === "LEGAL_CHANGE_REQUIRED") return "chip chip--live";
  if (s === "UNPROVEN" || s === "FUTURE_RESEARCH") return "chip chip--queued";
  return "chip chip--queued";
}
---

<BaseLayout
  title="Pass 4.6 — Whole-System Final Red Team"
  path="/system/final-red-team/"
  description="Join integrity: after 4.1–4.5, do the surviving pieces still form one coherent system?"
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">Stage 4 · CERTIFIED</span>
      <h1>Whole-System Final Red Team</h1>
      <p class="lede">{chapter.governing_question}</p>
      <p class="muted">{chapter.stance}</p>
      <p class="lede" style="margin-top:0.75rem;">
        <strong>{dist.statement}</strong>
        <span class={statusChip(dist.status)}>{dist.status}</span>
      </p>
      <p class="muted">{dist.means} Next: {dist.next}</p>
      <ul class="link-board">
        <li><a href="/system/stage4-certification/">Stage 4 Certification →</a></li>
        <li><a href="/system/changed-our-mind/">Changed Our Mind →</a></li>
        <li><a href="/system/master-map/">Final Master Map →</a></li>
        <li><a href="/build-progress/passes/pass-4-6/">What Changed →</a></li>
      </ul>
      <p class="muted">
        Validation {cert.validation_completion_percent_after}% · Overall{" "}
        {cert.overall_project_completion_percent_after}% · Unabridged 100% · COUNTABLE $0 ·{" "}
        {chapter.decision_id} · {chapter.update_id}
      </p>
      <p class="muted">
        Join fails: <strong>{integrity.join_fails}</strong> · Architectural defects:{" "}
        <strong>{integrity.architectural_defects}</strong> ·{" "}
        <span class={statusChip(integrity.status)}>{integrity.status}</span>
      </p>
    </header>

    <ReadingModes />

    <section class="hub-section" id="board" data-depth="understand" data-depth-keep>
      <h2>Final disposition board</h2>
      <ul class="stack">
        {
          board.map((p: any) => (
            <li>
              <span class={statusChip(p.status)}>{p.status.replaceAll("_", " ")}</span>{" "}
              <strong>{p.id}</strong> — {p.proposition}
              <div class="muted">{p.note}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="joins">
      <h2>Fifteen join tests</h2>
      <ul class="stack">
        {
          joins.map((j: any) => (
            <li>
              <span class={statusChip(j.result)}>{j.result.replaceAll("_", " ")}</span>{" "}
              <strong>
                {j.id} · {j.title}
              </strong>
              <div class="muted">{j.finding}</div>
              {j.final_rule ? <div class="lede">{j.final_rule}</div> : null}
              {j.final_principle ? <div class="lede">{j.final_principle}</div> : null}
              {j.hierarchy ? <div class="lede">{j.hierarchy}</div> : null}
              {j.balanced_rule ? <div class="lede">{j.balanced_rule}</div> : null}
              {j.key_test ? <div class="muted">Key test: {j.key_test}</div> : null}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="ownership">
      <h2>{ownership.name}</h2>
      <span class={statusChip(ownership.status)}>{ownership.status?.replaceAll("_", " ")}</span>
      <ol class="stack">
        {(ownership.gates || []).map((g: string) => <li>{g}</li>)}
      </ol>
      <p class="muted">{ownership.note}</p>
    </section>

    <section class="hub-section" id="crash">
      <h2>{crash.title}</h2>
      <p class="muted">{crash.defect_rule}</p>
      <ol class="stack">
        {
          (crash.phases || []).map((p: any) => (
            <li>
              <strong>{p.phase}</strong> — {p.state}
            </li>
          ))
        }
      </ol>
      <p class="muted">
        <span class={statusChip(crash.result)}>{crash.result}</span>
      </p>
    </section>

    <section class="hub-section" id="core">
      <h2>Surviving architecture</h2>
      <ul class="stack">
        {(core.core || []).map((c: string) => (
          <li>{c}</li>
        ))}
      </ul>
      <h3>Explicitly not in core</h3>
      <ul class="link-board">
        {(core.explicitly_not_in_core || []).map((c: string) => <li>{c}</li>)}
      </ul>
    </section>

    <section class="hub-section" id="visuals">
      <h2>Three signature visuals</h2>
      <ul class="stack">
        {
          visuals.map((v: any) => (
            <li>
              <strong>
                {v.id} · {v.title}
              </strong>
              <div class="muted">{v.shows}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="gates">
      <h2>Stage 4 certification gates</h2>
      <ul class="stack">
        {
          gates.map((g: any) => (
            <li>
              <span class="chip chip--done">PASS</span> <strong>{g.gate}</strong> — {g.result}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>OV / CX dispositions</h2>
      <ul class="stack">
        {
          ov.map((o: any) => (
            <li>
              <span class={statusChip(o.disposition)}>{o.disposition}</span>{" "}
              <strong>{o.id}</strong> — {o.note}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>What We Expected → What We Changed</h2>
      <dl class="glossary-list">
        <dt>What we expected</dt>
        <dd>{wcf.what_we_expected}</dd>
        <dt>What we tested</dt>
        <dd>{wcf.what_we_tested}</dd>
        <dt>What evidence supports</dt>
        <dd>{wcf.what_evidence_supports}</dd>
        <dt>What breaks</dt>
        <dd>{wcf.what_breaks}</dd>
        <dt>What needs guardrails</dt>
        <dd>{wcf.what_needs_guardrails}</dd>
        <dt>What remains unknown</dt>
        <dd>{wcf.what_remains_unknown}</dd>
        <dt>What we changed</dt>
        <dd>{wcf.what_we_changed}</dd>
      </dl>
      <p class="muted">Next: {cert.next}</p>
    </section>
  </article>
</BaseLayout>
