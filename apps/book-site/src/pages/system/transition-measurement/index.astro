---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import siteNav from "../../../../../../data/project/site_spine_navigation.json";
import spineData from "../../../../../../data/project/stage1_pass4_transition_resilience_measurement_spine.json";
import ArkansasPathway from "../../../components/ArkansasPathway.astro";

const spine = (siteNav.spines || []).find((s) => s.slug === "transition-measurement");
if (!spine) throw new Error("Transition measurement spine missing");
const areas = spineData.structural_areas || [];
const map = spineData.arkansas_transition_map;
const dep = spineData.dependency_rule;
---

<BaseLayout
  title={spine.title}
  path="/system/transition-measurement/"
  description={spine.blurb}
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">Pass 4 complete</span>
      <h1>{spine.title}</h1>
      <p class="lede">{spineData.master_architecture_fragment?.one_sentence || spine.blurb}</p>
      <p class="muted">
        Locks: {(spine.locks || []).join(" · ")} · Bones: {areas.length}/8 · Skeleton after pass:{" "}
        {spineData.skeleton_coverage_after_pass}%
      </p>
      <p>
        <a href="/build-progress/passes/pass-4/">What Changed — Pass 4 →</a>
      </p>
    </header>

    <section class="hub-section" aria-labelledby="dep">
      <h2 id="dep">Dependency Rule</h2>
      <p class="lede">{dep.statement}</p>
      <p class="muted"><strong>{dep.one_line}</strong></p>
    </section>

    <section class="hub-section" aria-labelledby="map">
      <h2 id="map">Arkansas Transition Map</h2>
      <ArkansasPathway />
      <p class="lede">{map.chain_display}</p>
      <p class="muted">{map.role.replaceAll("_", " ")} — {map.rule}</p>
      <ul class="stack">
        {
          (map.sequence || []).map((p: any) => (
            <li>
              <strong>{p.label}</strong>
              <div class="muted">{p.structural_purpose}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="bones">
      <h2 id="bones">Eight structural bones</h2>
      <ul class="stack">
        {
          areas.map((a: any) => (
            <li>
              <strong>
                <a href={a.href}>{a.area}</a>
              </strong>
              {a.lock && <span class="muted"> · {a.lock}</span>}
              <div class="muted">{a.objective}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Doctrine & system pages</h2>
      <ul class="link-board">
        {spine.links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="hub-section">
      <h2>Research & next</h2>
      <ul class="link-board">
        {spine.research.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
        <li><a href="/system/#pass-5">Next: Whole-System Closure Audit (Pass 5)</a></li>
        <li><a href="/system/government-power/">Previous: Government & Democratic Power</a></li>
        <li><a href="/system/">System map</a></li>
      </ul>
    </section>
  </article>
</BaseLayout>
