---
import BaseLayout from "../../layouts/BaseLayout.astro";
import siteNav from "../../../../../data/project/site_spine_navigation.json";
import completion from "../../../../../data/project/completion_ladder_and_dashboard.json";

const spines = siteNav.spines || [];
const foundations = siteNav.foundations;
const bars = completion.progress_bars || {};

function chipClass(status?: string) {
  if (status === "COMPLETE") return "chip chip--done";
  if (status === "ACTIVE") return "chip chip--live";
  return "chip chip--queued";
}

function statusLabel(status?: string) {
  if (status === "COMPLETE") return "Pass complete";
  if (status === "ACTIVE") return "Building now";
  return "Queued";
}
---

<BaseLayout
  title="System"
  path="/system/"
  description="Master map of Constitutional Capitalism — five spines covering money, households, government, transition, and closure."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">Stage 1 complete</span>
      <h1>The complete system map</h1>
      <p class="lede">
        Every major function of government, markets, households, communities, capital, and democratic
        power lives on one of these spines. Stage 1 skeleton is certified. Stage 2 develops working
        models without inventing new bones unless a genuine architectural defect appears.
      </p>
      <p class="muted">
        Skeleton coverage: <strong>{bars.skeleton_coverage_percent ?? 0}%</strong> · Overall project
        completion: <strong>{completion.overall_project_completion?.percent ?? 0}%</strong>
        {" · "}
        <a href="/build-progress/passes/pass-5/">Stage 1 certification →</a>
      </p>
    </header>

    <section class="hub-section" aria-labelledby="spine-map">
      <h2 id="spine-map">Five spines</h2>
      <div class="spine-grid">
        {
          spines.map((spine) => (
            <a class="spine-tile" href={spine.href} id={spine.id === "PASS_5" ? "pass-5" : undefined}>
              <span class={chipClass(spine.status)}>{statusLabel(spine.status)}</span>
              <h3>{spine.title}</h3>
              <p>{spine.blurb}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="hub-section" aria-labelledby="foundations">
      <h2 id="foundations">{foundations.title}</h2>
      <p class="lede">{foundations.blurb}</p>
      <ul class="link-board">
        {
          foundations.links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="infra">
      <h2 id="infra">Shared infrastructure</h2>
      <ul class="link-board">
        <li><a href="/system/transition-engine/">Arkansas Transition Engine</a></li>
        <li><a href="/system/government-engine/">Government Operating System</a></li>
        <li><a href="/system/human-community-engine/">Human & Community Capital Engine</a></li>
        <li><a href="/system/household-engine/">Household Prosperity Engine</a></li>
        <li><a href="/system/money-engine/">Arkansas Money Engine</a></li>
        <li><a href="/system/arkansas-state-baseline/">Arkansas State Baseline</a></li>
        <li><a href="/system/visual-language/">Visual language (atlas)</a></li>
        <li><a href="/build-progress/">Build Progress</a></li>
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="os">
      <h2 id="os">Operating-system questions</h2>
      <p class="lede">
        These five questions cut across every spine: ownership, capital formation, market design,
        household economics, and power.
      </p>
      <ul class="link-board">
        {
          (siteNav.research_desk?.os_questions || []).map((q) => (
            <li>
              <a href={`/research/#os-${q.id}`}>{q.label}</a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
