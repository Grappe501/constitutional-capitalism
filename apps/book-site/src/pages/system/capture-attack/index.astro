---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReadingModes from "../../../components/ReadingModes.astro";
import chapter from "../../../../../../data/project/stage4_pass45_political_administrative_capture_attack.json";

const board = chapter.proposition_board || [];
const gov = chapter.hostile_governor_test || {};
const leg = chapter.hostile_legislature_test || {};
const opp = chapter.opposition_test || {};
const loop = chapter.capture_loop || {};
const invest = chapter.public_investment_politics || {};
const ed = chapter.economic_development_capture || {};
const proc = chapter.procurement_capture || {};
const boards = chapter.boards_and_commissions || {};
const admin = chapter.administrative_competence || {};
const metric = chapter.metric_gaming || {};
const ai = chapter.ai_administrative_power || {};
const emerg = chapter.emergency_powers || {};
const local = chapter.localism_and_direct_democracy || {};
const trans = chapter.transparency_architecture || {};
const watch = chapter.watchdog_independence || {};
const surface = chapter.capture_surface_map || {};
const role = chapter.role_concentration || {};
const entropy = chapter.institutional_entropy || {};
const corrupt = chapter.corruption_economics || {};
const tests = chapter.dictator_and_mediocre || {};
const breakers = chapter.breaker_hierarchy || {};
const scenarios = chapter.ten_scenarios || {};
const visuals = chapter.signature_visuals || [];
const design = chapter.design_rule || {};
const semantic = chapter.semantic_capture_lock || {};
const hp = chapter.household_prosperity_panel_lock || {};
const wcf = chapter.what_changed_format || {};
const cert = chapter.certification || {};
const ov = chapter.ov_cx_disposition || [];

function statusChip(s?: string) {
  if (!s) return "chip chip--queued";
  if (
    s === "SURVIVED" ||
    s === "CAPTURE_RESISTANT" ||
    s === "SURVIVED_AS_ARCHITECTURE"
  )
    return "chip chip--done";
  if (
    s === "SURVIVED_WITH_BREAKERS" ||
    s === "SURVIVED_WITH_OPEN_BIND" ||
    s === "REQUIRES_SEPARATION_OF_POWER" ||
    s === "REQUIRES_INDEPENDENT_OVERSIGHT" ||
    s === "CONSTITUTIONAL_PROTECTION_CANDIDATE"
  )
    return "chip chip--live";
  if (
    s === "FAILED_GOVERNANCE_TEST" ||
    s === "POLITICIZATION_RISK" ||
    s === "ADMINISTRATIVELY_FRAGILE" ||
    s === "SEMANTIC_CAPTURE_RISK" ||
    s === "UNPROVEN_NUMERIC"
  )
    return "chip chip--live";
  return "chip chip--queued";
}
---

<BaseLayout
  title="Pass 4.5 — Political, Administrative & Capture Attack"
  path="/system/capture-attack/"
  description="Hostile governance audit: what happens when the machinery falls into hands we do not trust?"
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">Stage 4 · Pass 4.5 complete</span>
      <h1>Political, Administrative &amp; Capture Attack</h1>
      <p class="lede">{chapter.governing_question}</p>
      <p class="muted">{chapter.stance}</p>
      <p class="lede" style="margin-top:0.75rem;">
        <strong>{design.statement}</strong>
        <span class={statusChip(design.status)}>{design.status}</span>
      </p>
      <ul class="link-board">
        <li><a href="/build-progress/passes/pass-4-5/">What Changed →</a></li>
        <li><a href="/system/resilience-attack/">Pass 4.4 Resilience →</a></li>
        <li><a href="/system/behavioral-attack/">Pass 4.3 Behavioral →</a></li>
        <li><a href="/unabridged/validation/">Validation queue →</a></li>
      </ul>
      <p class="muted">
        Validation {cert.validation_completion_percent_after}% · Overall{" "}
        {cert.overall_project_completion_percent_after}% · Unabridged 100% · COUNTABLE $0 ·{" "}
        {chapter.decision_id} · {chapter.update_id}
      </p>
    </header>

    <ReadingModes />

    <section class="hub-section" data-depth="understand" data-depth-keep>
      <h2>Adversarial proposition board</h2>
      <ul class="stack">
        {
          board.map((p: any) => (
            <li>
              <span class={statusChip(p.status)}>{p.status.replaceAll("_", " ")}</span>{" "}
              <span class={statusChip(p.grade)}>{(p.grade || "").replaceAll("_", " ")}</span>{" "}
              <strong>{p.id}</strong> — {p.proposition}
              <div class="muted">{p.note}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="locks">
      <h2>Design locks</h2>
      <ul class="stack">
        <li>
          <span class={statusChip(opp.status)}>{opp.status}</span>{" "}
          <strong>{opp.name}</strong> — {opp.statement}
        </li>
        <li>
          <span class={statusChip(semantic.status)}>{semantic.status}</span>{" "}
          <strong>Semantic-capture lock</strong> — {semantic.statement}
        </li>
        <li>
          <span class={statusChip(hp.status)}>{hp.status}</span>{" "}
          <strong>Household Prosperity panel</strong> — {hp.statement}
        </li>
        <li>
          <span class={statusChip(chapter.public_investment_rule?.status)}>
            {chapter.public_investment_rule?.status}
          </span>{" "}
          <strong>Public investment rule</strong> — {chapter.public_investment_rule?.statement}
        </li>
        <li>
          <span class={statusChip(chapter.ai_public_power_rule?.status)}>
            {chapter.ai_public_power_rule?.status}
          </span>{" "}
          <strong>AI Public Power rule</strong> — {chapter.ai_public_power_rule?.statement}
        </li>
      </ul>
    </section>

    <section class="hub-section" id="governor">
      <h2>{gov.title}</h2>
      <p class="muted">{gov.premise}</p>
      <ul class="stack">
        {
          (gov.capabilities_tested || []).map((c: any) => (
            <li>
              <strong>{c.action}</strong>
              <div class="muted">
                Unprotected: {c.if_unprotected} · With breakers: {c.with_breakers} · {c.breaker}
              </div>
            </li>
          ))
        }
      </ul>
      <p class="muted">
        <span class={statusChip(gov.status)}>{gov.status?.replaceAll("_", " ")}</span> {gov.finding}
      </p>
    </section>

    <section class="hub-section" id="legislature">
      <h2>{leg.title}</h2>
      <p class="muted">{leg.premise}</p>
      <ul class="link-board">
        {(leg.attack_surfaces || []).map((s: string) => <li>{s}</li>)}
      </ul>
      <p class="muted">
        <span class={statusChip(leg.status)}>{leg.status?.replaceAll("_", " ")}</span> {leg.finding}
      </p>
    </section>

    <section class="hub-section" id="capture-loop">
      <h2>{loop.title}</h2>
      <p class="lede">{loop.core_question}</p>
      <ol class="stack">
        {(loop.chain || []).map((step: string) => <li>{step}</li>)}
      </ol>
      <p class="muted">
        <span class={statusChip(loop.status)}>{loop.status?.replaceAll("_", " ")}</span> {loop.finding}
      </p>
    </section>

    <section class="hub-section" id="investment">
      <h2>{invest.title}</h2>
      <p class="lede">{invest.principle}</p>
      <ul class="stack">
        {(invest.questions || []).map((q: string) => <li>{q}</li>)}
      </ul>
      <p class="muted">
        <span class={statusChip(invest.status)}>{invest.status?.replaceAll("_", " ")}</span>{" "}
        {invest.finding}
      </p>
    </section>

    <section class="hub-section" id="deal-ledger">
      <h2>{ed.title}</h2>
      <p class="muted">Joins {ed.joins}. Conventional model: {ed.conventional_model}</p>
      <h3>{ed.public_deal_ledger?.name}</h3>
      <ul class="link-board">
        {(ed.public_deal_ledger?.fields || []).map((f: string) => <li>{f}</li>)}
      </ul>
      <p class="muted">
        <span class={statusChip(ed.status)}>{ed.status?.replaceAll("_", " ")}</span> {ed.finding}
      </p>
    </section>

    <section class="hub-section" id="procurement">
      <h2>{proc.title}</h2>
      <ul class="link-board">
        {(proc.vectors || []).map((v: string) => <li>{v}</li>)}
      </ul>
      <p class="muted">
        <span class={statusChip(proc.status)}>{proc.status?.replaceAll("_", " ")}</span> {proc.finding}
      </p>
    </section>

    <section class="hub-section" id="boards">
      <h2>{boards.title}</h2>
      <p class="muted">Failure modes: {(boards.failure_modes || []).join(" · ")}</p>
      <p class="muted">
        <span class={statusChip(boards.status)}>{boards.status?.replaceAll("_", " ")}</span>{" "}
        {boards.finding}
      </p>
    </section>

    <section class="hub-section" id="admin">
      <h2>{admin.title}</h2>
      <p class="muted">{admin.premise}</p>
      <ul class="stack">
        {(admin.friction_questions || []).map((q: string) => <li>{q}</li>)}
      </ul>
      <p class="lede">
        <strong>{admin.administrative_load_ratio?.name}</strong> —{" "}
        {admin.administrative_load_ratio?.rule}
      </p>
      <p class="muted">
        <span class={statusChip(admin.status)}>{admin.status?.replaceAll("_", " ")}</span>{" "}
        {admin.finding}
      </p>
    </section>

    <section class="hub-section" id="metrics">
      <h2>{metric.title}</h2>
      <ul class="stack">
        {(metric.questions || []).map((q: string) => <li>{q}</li>)}
      </ul>
      <p class="lede">{metric.rule}</p>
      <p class="muted">
        Household Prosperity attack: {metric.household_prosperity?.attack}
      </p>
      <p class="lede">
        <strong>Lock:</strong> {metric.household_prosperity?.lock}
      </p>
      <p class="muted">
        <span class={statusChip(metric.status)}>{metric.status?.replaceAll("_", " ")}</span>{" "}
        {metric.finding}
      </p>
    </section>

    <section class="hub-section" id="ai">
      <h2>{ai.title}</h2>
      <p class="lede">{ai.rule}</p>
      <p class="muted">Chain: {ai.chain_visual}</p>
      <ul class="link-board">
        {(ai.attack_surfaces || []).map((s: string) => <li>{s}</li>)}
      </ul>
      <p class="muted">
        <span class={statusChip(ai.status)}>{ai.status?.replaceAll("_", " ")}</span> {ai.finding}
      </p>
    </section>

    <section class="hub-section" id="emergency">
      <h2>{emerg.title}</h2>
      <ul class="link-board">
        {(emerg.required_package || []).map((p: string) => <li>{p}</li>)}
      </ul>
      <p class="muted">
        <span class={statusChip(emerg.status)}>{emerg.status?.replaceAll("_", " ")}</span>{" "}
        {emerg.finding}
      </p>
    </section>

    <section class="hub-section" id="local-direct">
      <h2>Localism &amp; direct democracy</h2>
      <p class="lede">{local.localism?.architecture}</p>
      <p class="muted">
        <span class={statusChip(local.localism?.status)}>
          {local.localism?.status?.replaceAll("_", " ")}
        </span>{" "}
        {local.localism?.finding}
      </p>
      <p class="muted">
        <span class={statusChip(local.direct_democracy?.status)}>
          {local.direct_democracy?.status?.replaceAll("_", " ")}
        </span>{" "}
        {local.direct_democracy?.finding}
      </p>
    </section>

    <section class="hub-section" id="transparency">
      <h2>{trans.title}</h2>
      <ul class="stack">
        {
          (trans.tiers || []).map((t: any) => (
            <li>
              <strong>{t.tier}</strong> — {t.covers}
            </li>
          ))
        }
      </ul>
      <p class="muted">
        <span class={statusChip(trans.status)}>{trans.status?.replaceAll("_", " ")}</span>{" "}
        {trans.finding}
      </p>
    </section>

    <section class="hub-section" id="watchdogs">
      <h2>{watch.title}</h2>
      <p class="muted">
        <span class={statusChip(watch.status)}>{watch.status?.replaceAll("_", " ")}</span>{" "}
        {watch.finding}
      </p>
    </section>

    <section class="hub-section" id="surface-map">
      <h2>{surface.title}</h2>
      <p class="muted">{surface.finding}</p>
      <p class="muted">
        Controls: {(surface.axes?.controls || []).join(" · ")}
      </p>
    </section>

    <section class="hub-section" id="role">
      <h2>{role.title}</h2>
      <p class="lede">{role.rule}</p>
      <p class="muted">
        <span class={statusChip(role.status)}>{role.status?.replaceAll("_", " ")}</span> {role.finding}
      </p>
    </section>

    <section class="hub-section" id="entropy">
      <h2>{entropy.title}</h2>
      <p class="muted">{entropy.premise}</p>
      <ul class="link-board">
        {(entropy.outcomes || []).map((o: string) => <li>{o}</li>)}
      </ul>
      <p class="muted">
        <span class={statusChip(entropy.status)}>{entropy.status?.replaceAll("_", " ")}</span>{" "}
        {entropy.finding}
      </p>
    </section>

    <section class="hub-section" id="corruption-econ">
      <h2>{corrupt.title}</h2>
      <p class="muted">
        <span class={statusChip(corrupt.status)}>{corrupt.status?.replaceAll("_", " ")}</span>{" "}
        {corrupt.finding}
      </p>
    </section>

    <section class="hub-section" id="dictator-mediocre">
      <h2>Dictator Test &amp; Mediocre Government Test</h2>
      <p class="lede">{tests.dictator_test?.question}</p>
      <p class="muted">
        <span class={statusChip(tests.dictator_test?.status)}>
          {tests.dictator_test?.status?.replaceAll("_", " ")}
        </span>{" "}
        {tests.dictator_test?.finding}
      </p>
      <p class="muted">
        <span class={statusChip(tests.mediocre_government_test?.status)}>
          {tests.mediocre_government_test?.status?.replaceAll("_", " ")}
        </span>{" "}
        {tests.mediocre_government_test?.finding}
      </p>
    </section>

    <section class="hub-section" id="breakers">
      <h2>{breakers.title}</h2>
      <p class="lede">{breakers.punch}</p>
      <ol class="stack">
        {(breakers.order || []).map((b: string) => <li>{b.replace(/^\d+\.\s*/, "")}</li>)}
      </ol>
    </section>

    <section class="hub-section" id="scenarios">
      <h2>{scenarios.title}</h2>
      <ul class="stack">
        {
          (scenarios.rows || []).map((r: any) => (
            <li>
              <span class={statusChip(r.disposition)}>
                {r.disposition.replaceAll("_", " ")}
              </span>{" "}
              <strong>
                {r.id} · {r.name}
              </strong>
              <div class="muted">
                Vector: {r.vector} → Damage: {r.damage}
              </div>
              <div class="muted">
                Breaker: {r.existing_breaker} · Failure: {r.breaker_failure} · Secondary:{" "}
                {r.secondary_breaker}
              </div>
              <div class="muted">Residual: {r.residual_risk}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="visuals">
      <h2>Eight signature visuals</h2>
      <ul class="stack">
        {
          visuals.map((v: any) => (
            <li>
              <strong>
                {v.id} · {v.title}
              </strong>
              <div class="muted">{v.shows}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>OV / CX dispositions</h2>
      <ul class="stack">
        {
          ov.map((o: any) => (
            <li>
              <span class={statusChip(o.disposition)}>{o.disposition.replaceAll("_", " ")}</span>{" "}
              <strong>{o.id}</strong> — {o.note}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>What We Expected → What We Changed</h2>
      <dl class="glossary-list">
        <dt>What we expected</dt>
        <dd>{wcf.what_we_expected}</dd>
        <dt>What we tested</dt>
        <dd>{wcf.what_we_tested}</dd>
        <dt>What evidence supports</dt>
        <dd>{wcf.what_evidence_supports}</dd>
        <dt>What breaks</dt>
        <dd>{wcf.what_breaks}</dd>
        <dt>What needs guardrails</dt>
        <dd>{wcf.what_needs_guardrails}</dd>
        <dt>What remains unknown</dt>
        <dd>{wcf.what_remains_unknown}</dd>
        <dt>What we changed</dt>
        <dd>{wcf.what_we_changed}</dd>
      </dl>
      <p class="muted">Next: {cert.next}</p>
    </section>
  </article>
</BaseLayout>
