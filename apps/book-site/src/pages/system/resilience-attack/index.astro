---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReadingModes from "../../../components/ReadingModes.astro";
import chapter from "../../../../../../data/project/stage4_pass44_resilience_adversarial_attack.json";

const board = chapter.proposition_board || [];
const deck = chapter.shock_deck || {};
const domains = chapter.domain_attacks || {};
const corr = chapter.correlated_shocks || {};
const waterfall = chapter.resilience_waterfall || {};
const floors = chapter.essential_function_floors || {};
const reserves = chapter.reserve_architecture || {};
const matrix = chapter.system_stress_matrix || {};
const measures = chapter.resilience_measures || {};
const hh = chapter.household_shock_test || {};
const five = chapter.five_state_resilience || {};
const principle = chapter.efficiency_resilience_principle || {};
const wcf = chapter.what_changed_format || {};
const cert = chapter.certification || {};
const ov = chapter.ov_cx_disposition || [];

function statusChip(s?: string) {
  if (s === "SURVIVED" || s === "ROBUST") return "chip chip--done";
  if (
    s === "RESILIENT_WITH_GUARDRAILS" ||
    s === "SURVIVED_WITH_OPEN_BIND" ||
    s === "SURVIVED_AS_PRINCIPLE"
  )
    return "chip chip--live";
  if (
    s === "FAILED_UNDER_STRESS" ||
    s === "SHOCK_SENSITIVE" ||
    s === "SINGLE_POINT_FAILURE" ||
    s === "CORRELATED_RISK" ||
    s === "RECOVERY_UNCERTAIN"
  )
    return "chip chip--live";
  return "chip chip--queued";
}
---

<BaseLayout
  title="Pass 4.4 — Resilience & Adversarial Attack"
  path="/system/resilience-attack/"
  description="Hostile shock audit: does Constitutional Capitalism still work when Arkansas gets unlucky?"
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">Stage 4 · Pass 4.4 complete</span>
      <h1>Resilience &amp; Adversarial Attack</h1>
      <p class="lede">{chapter.governing_question}</p>
      <p class="muted">{chapter.stance}</p>
      <p class="lede" style="margin-top:0.75rem;">
        <strong>{principle.statement}</strong>
        <span class={statusChip(principle.status)}>{principle.status}</span>
      </p>
      <ul class="link-board">
        <li><a href="/build-progress/passes/pass-4-4/">What Changed →</a></li>
        <li><a href="/system/behavioral-attack/">Pass 4.3 Behavioral →</a></li>
        <li><a href="/system/fiscal-attack/">Pass 4.1 Fiscal →</a></li>
        <li><a href="/unabridged/validation/">Validation queue →</a></li>
      </ul>
      <p class="muted">
        Validation {cert.validation_completion_percent_after}% · Overall{" "}
        {cert.overall_project_completion_percent_after}% · Unabridged 100% · COUNTABLE $0 ·{" "}
        {chapter.decision_id} · {chapter.update_id}
      </p>
    </header>

    <ReadingModes />

    <section class="hub-section" data-depth="understand" data-depth-keep>
      <h2>Adversarial proposition board</h2>
      <ul class="stack">
        {
          board.map((p: any) => (
            <li>
              <span class={statusChip(p.status)}>{p.status.replaceAll("_", " ")}</span>{" "}
              <span class={statusChip(p.grade)}>{(p.grade || "").replaceAll("_", " ")}</span>{" "}
              <strong>{p.id}</strong> — {p.proposition}
              <div class="muted">{p.note}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="v1">
      <h2>{deck.title}</h2>
      <p class="muted">{deck.note}</p>
      {
        (deck.families || []).map((f: any) => (
          <div>
            <h3>{f.family}</h3>
            <ul class="stack">
              {f.shocks.map((s: any) => (
                <li>
                  <strong>
                    {s.id} · {s.name}
                  </strong>
                  <div class="muted">{(s.assume || []).join(" · ")}</div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="hub-section" id="v2">
      <h2>{matrix.title}</h2>
      <ul class="stack">
        {
          (matrix.rows || []).map((r: any) => (
            <li>
              <span class={statusChip(r.grade)}>{r.grade.replaceAll("_", " ")}</span>{" "}
              <strong>{r.system}</strong>
              <div class="muted">{r.note}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="v3">
      <h2>{corr.title}</h2>
      <ul class="stack">
        {
          (corr.cases || []).map((c: any) => (
            <li>
              <strong>
                {c.id}: {c.name}
              </strong>
              <div class="muted">{c.risk}</div>
            </li>
          ))
        }
      </ul>
      <p class="lede">{corr.finding}</p>
    </section>

    <section class="hub-section" id="v4">
      <h2>{waterfall.title}</h2>
      <h3>When shock hits</h3>
      <ol class="stack">
        {(waterfall.shock_path || []).map((s: string) => <li>{s}</li>)}
      </ol>
      <h3>Recovery</h3>
      <ol class="stack">
        {(waterfall.recovery_path || []).map((s: string) => <li>{s}</li>)}
      </ol>
      <h3>{reserves.title}</h3>
      <ul class="link-board">
        {(reserves.buckets || []).map((b: string) => <li>{b}</li>)}
      </ul>
      <p class="muted">{reserves.rule}</p>
      <h3>{floors.title}</h3>
      <ul class="link-board">
        {(floors.categories || []).map((c: string) => <li>{c}</li>)}
      </ul>
      <p class="muted">{floors.rule}</p>
    </section>

    <section class="hub-section" id="v5">
      <h2>{hh.title}</h2>
      <p class="lede">{hh.finding}</p>
      <p>
        <strong>Events:</strong> {(hh.events || []).join(" · ")}
      </p>
      <p>
        <strong>Mechanisms (not fake dollars):</strong> {(hh.mechanisms_not_fake_dollars || []).join(" · ")}
      </p>
    </section>

    <section class="hub-section" id="v6">
      <h2>Strategic Capacity · Energy · Food</h2>
      <p class="lede">{domains.strategic_capacity_food?.concept}</p>
      <p>{domains.strategic_capacity_food?.finding}</p>
      <p>
        <span class={statusChip(domains.energy?.status)}>
          {domains.energy?.status?.replaceAll("_", " ")}
        </span>{" "}
        {domains.energy?.finding}
      </p>
    </section>

    <section class="hub-section" id="v7">
      <h2>Community concentration · population</h2>
      <p class="lede">{domains.employer_failure?.cascade}</p>
      <p>
        Tracks: {(domains.employer_failure?.index?.tracks || []).join(" · ")}
      </p>
      <p>
        <strong>Graceful Contraction:</strong> {domains.population_decline?.concept}
      </p>
      <p>
        <strong>Growth Absorption:</strong> {domains.population_growth?.concept}
      </p>
    </section>

    <section class="hub-section" id="v8">
      <h2>{measures.title}</h2>
      <ul class="stack">
        {
          (measures.measures || []).map((m: any) => (
            <li>
              <strong>{m.id}:</strong> {m.q}
            </li>
          ))
        }
      </ul>
      <p class="muted">Normal → Shock → Recovery → Adaptation.</p>
    </section>

    <section class="hub-section">
      <h2>Key domain findings</h2>
      <ul class="stack">
        {
          [
            domains.recession,
            domains.financial_crash,
            domains.inflation_rates,
            domains.federal_contraction,
            domains.revenue_concentration,
            domains.enterprise_failure,
            domains.ai_shock,
            domains.political_turnover,
            domains.intergenerational_moral,
          ].map((d: any) =>
            d ? (
              <li>
                <span class={statusChip(d.status)}>{(d.status || "").replaceAll("_", " ")}</span>{" "}
                <strong>{d.title}</strong>
                <div class="muted">{d.finding || d.punch || d.honesty}</div>
              </li>
            ) : null
          )
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>{five.title}</h2>
      <p class="lede">{five.purpose}</p>
      <ul class="link-board">
        {(five.panel || []).map((p: string) => <li>{p}</li>)}
      </ul>
      <p class="muted">
        <span class={statusChip(five.status)}>{five.status?.replaceAll("_", " ")}</span> {five.finding}
      </p>
    </section>

    <section class="hub-section">
      <h2>OV / CX dispositions</h2>
      <ul class="stack">
        {
          ov.map((o: any) => (
            <li>
              <span class={statusChip(o.disposition)}>{o.disposition.replaceAll("_", " ")}</span>{" "}
              <strong>{o.id}</strong> — {o.note}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>What We Expected → What We Changed</h2>
      <dl class="glossary-list">
        <dt>What we expected</dt>
        <dd>{wcf.what_we_expected}</dd>
        <dt>What we tested</dt>
        <dd>{wcf.what_we_tested}</dd>
        <dt>What evidence supports</dt>
        <dd>{wcf.what_evidence_supports}</dd>
        <dt>What breaks</dt>
        <dd>{wcf.what_breaks}</dd>
        <dt>What needs guardrails</dt>
        <dd>{wcf.what_needs_guardrails}</dd>
        <dt>What remains unknown</dt>
        <dd>{wcf.what_remains_unknown}</dd>
        <dt>What we changed</dt>
        <dd>{wcf.what_we_changed}</dd>
      </dl>
      <p class="muted">Next: {cert.next}</p>
    </section>
  </article>
</BaseLayout>
