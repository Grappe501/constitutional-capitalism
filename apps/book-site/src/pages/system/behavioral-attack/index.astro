---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReadingModes from "../../../components/ReadingModes.astro";
import chapter from "../../../../../../data/project/stage4_pass43_household_market_behavioral_attack.json";

const board = chapter.proposition_board || [];
const capture = chapter.household_benefit_capture_test || {};
const incidence = chapter.tax_incidence || {};
const domains = chapter.domain_attacks || {};
const modes = chapter.behavioral_failure_modes || [];
const scenarios = chapter.scenario_families || [];
const grid = chapter.distribution_grid || {};
const visuals = chapter.visual_assets || [];
const wcf = chapter.what_changed_format || {};
const cert = chapter.certification || {};
const ov = chapter.ov_cx_disposition || [];
const lock = chapter.ordinary_humans_lock || {};
const changes = chapter.architectural_changes || [];

function statusChip(s?: string) {
  if (s === "SURVIVED") return "chip chip--done";
  if (
    s === "SURVIVED_WITH_BEHAVIORAL_SAFEGUARD" ||
    s === "SURVIVED_ONLY_UNDER_CONDITIONS" ||
    s === "SURVIVED_AS_RISK_FINDING" ||
    s === "SURVIVED_AS_ARCHITECTURE"
  )
    return "chip chip--live";
  if (s === "FAILED_BEHAVIORALLY" || s === "HIGH_GAMING_RISK" || s === "MARKET_OFFSET_RISK")
    return "chip chip--live";
  return "chip chip--queued";
}
---

<BaseLayout
  title="Pass 4.3 — Household, Market & Behavioral Attack"
  path="/system/behavioral-attack/"
  description="Hostile audit: how will real households and markets react? No reliance on morally superior citizens."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">Stage 4 · Pass 4.3 complete · halfway validation</span>
      <h1>Household, Market &amp; Behavioral Attack</h1>
      <p class="lede">{chapter.governing_question}</p>
      <p class="muted">{chapter.stance}</p>
      <p class="lede" style="margin-top:0.75rem;">
        <strong>{lock.statement}</strong>
        <span class={statusChip(lock.status)}>{lock.status}</span>
      </p>
      <ul class="link-board">
        <li><a href="/build-progress/passes/pass-4-3/">What Changed →</a></li>
        <li><a href="/system/fiscal-attack/">Pass 4.1 Fiscal →</a></li>
        <li><a href="/system/legal-attack/">Pass 4.2 Legal →</a></li>
        <li><a href="/unabridged/validation/">Validation queue →</a></li>
      </ul>
      <p class="muted">
        Validation {cert.validation_completion_percent_after}% · Overall{" "}
        {cert.overall_project_completion_percent_after}% · Unabridged 100% · COUNTABLE $0 ·{" "}
        {chapter.decision_id} · {chapter.update_id}
      </p>
    </header>

    <ReadingModes />

    <section class="hub-section" data-depth="understand" data-depth-keep>
      <h2>Proposition board</h2>
      <ul class="stack">
        {
          board.map((p: any) => (
            <li>
              <span class={statusChip(p.status)}>{p.status.replaceAll("_", " ")}</span>{" "}
              <strong>{p.id}</strong> — {p.proposition}
              <div class="muted">{p.note}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="v1">
      <h2>{capture.title}</h2>
      <p class="lede">
        <code>{capture.chain}</code>
      </p>
      <ol class="stack">
        {(capture.questions || []).map((q: string) => <li>{q}</li>)}
      </ol>
      <p>
        <span class={statusChip(capture.status)}>{capture.status?.replaceAll("_", " ")}</span>{" "}
        {capture.finding}
      </p>
    </section>

    <section class="hub-section" id="v2">
      <h2>{incidence.title}</h2>
      <p class="lede">{incidence.rule}</p>
      <ul class="stack">
        {
          (incidence.types || []).map((t: any) => (
            <li>
              <strong>{t.type}</strong> — Legal: {t.legal_payer}. Likely burden: {t.likely_burden}
            </li>
          ))
        }
      </ul>
      <p class="muted">{incidence.safeguard}</p>
    </section>

    <section class="hub-section" id="v3">
      <h2>Behavioral response map — five scenarios</h2>
      <p class="lede">Any mechanism that only works in Intended Response is fragile.</p>
      <ul class="stack">
        {
          scenarios.map((s: any) => (
            <li>
              <strong>{s.label}:</strong> {s.note}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" id="v4">
      <h2>{domains.housing?.title}</h2>
      <p class="lede">{domains.housing?.core}</p>
      <p>
        <span class={statusChip(domains.housing?.status)}>
          {domains.housing?.status?.replaceAll("_", " ")}
        </span>{" "}
        {domains.housing?.finding}
      </p>
      <p class="muted">{domains.housing?.hostile}</p>
      <h3>If property tax declines, who captures?</h3>
      <ul class="link-board">
        {(domains.housing?.property_tax_decline_capture || []).map((x: string) => <li>{x}</li>)}
      </ul>
    </section>

    <section class="hub-section" id="v5">
      <h2>{domains.public_capital?.title}</h2>
      <p class="lede">{domains.public_capital?.question}</p>
      <ul class="stack">
        {(domains.public_capital?.risks || []).map((r: string) => <li>{r}</li>)}
      </ul>
      <p>
        <span class={statusChip(domains.public_capital?.status)}>
          {domains.public_capital?.status?.replaceAll("_", " ")}
        </span>{" "}
        {domains.public_capital?.finding}
      </p>
    </section>

    <section class="hub-section" id="v6">
      <h2>{domains.pilots?.title}</h2>
      <p class="lede">{domains.pilots?.punch}</p>
      <ol class="stack">
        {(domains.pilots?.questions || []).map((q: string) => <li>{q}</li>)}
      </ol>
      <p class="muted">Feeds {domains.pilots?.feeds}.</p>
    </section>

    <section class="hub-section" id="v7">
      <h2>Behavioral failure-mode register</h2>
      <dl class="glossary-list">
        {
          modes.map((m: any) => (
            <>
              <dt>{m.label || m.id}</dt>
              <dd>{m.plain}</dd>
            </>
          ))
        }
      </dl>
    </section>

    <section class="hub-section">
      <h2>Domain attack summary</h2>
      <ul class="stack">
        {
          Object.values(domains).map((d: any) => (
            <li>
              <span class={statusChip(d.status)}>{(d.status || "").replaceAll("_", " ")}</span>{" "}
              <strong>{d.title}</strong>
              <div class="muted">{d.finding || d.punch || d.safeguard || d.core}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>{grid.title}</h2>
      <p class="muted">Scale: {(grid.scale || []).join(" · ")}</p>
      <ul class="stack">
        {
          (grid.rows || []).map((r: any) => (
            <li>
              <strong>{r.mechanism}</strong>
              <div class="muted">
                {Object.entries(r.effects || {})
                  .filter(([k]) => k !== "note")
                  .map(([k, v]) => `${k}: ${v}`)
                  .join(" · ")}
              </div>
              {r.effects?.note ? <div class="muted">{r.effects.note}</div> : null}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>OV / CX dispositions</h2>
      <ul class="stack">
        {
          ov.map((o: any) => (
            <li>
              <span class={statusChip(o.disposition)}>{o.disposition.replaceAll("_", " ")}</span>{" "}
              <strong>{o.id}</strong> — {o.note}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>What We Expected → What We Changed</h2>
      <dl class="glossary-list">
        <dt>What we expected</dt>
        <dd>{wcf.what_we_expected}</dd>
        <dt>How people/markets could react</dt>
        <dd>{wcf.how_people_markets_could_react}</dd>
        <dt>What evidence supports</dt>
        <dd>{wcf.what_evidence_supports}</dd>
        <dt>What breaks</dt>
        <dd>{wcf.what_breaks}</dd>
        <dt>What needs guardrails</dt>
        <dd>{wcf.what_needs_guardrails}</dd>
        <dt>What remains unknown</dt>
        <dd>{wcf.what_remains_unknown}</dd>
        <dt>What we changed</dt>
        <dd>{wcf.what_we_changed}</dd>
      </dl>
      <ul class="stack">
        {
          changes.map((c: any) => (
            <li>
              <strong>{c.id}</strong> — {c.change}: {c.detail}
            </li>
          ))
        }
      </ul>
      <p class="muted">
        Visuals: {visuals.map((v: any) => v.title).join(" · ")}. Next: {cert.next}
      </p>
    </section>
  </article>
</BaseLayout>
