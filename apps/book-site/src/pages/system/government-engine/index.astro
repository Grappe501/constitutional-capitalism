---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReadingModes from "../../../components/ReadingModes.astro";
import SovereigntyDelegationMap from "../../../components/SovereigntyDelegationMap.astro";
import SubsidiarityLadder from "../../../components/SubsidiarityLadder.astro";
import GovernmentRolesQuadrant from "../../../components/GovernmentRolesQuadrant.astro";
import GovernmentPowerLoop from "../../../components/GovernmentPowerLoop.astro";
import CaptureCircuitBreakers from "../../../components/CaptureCircuitBreakers.astro";
import PublicDollarChain from "../../../components/PublicDollarChain.astro";
import DigitalDueProcess from "../../../components/DigitalDueProcess.astro";
import chapter from "../../../../../../data/project/stage3_pass35_government_democratic_power.json";
import engine from "../../../../../../data/project/stage2_pass24_government_operating_system.json";

const modules = engine.modules || [];
const checklist = Object.values(chapter.category_checklist || {});
const evidence = chapter.arkansas_evidence_bound || {};
const purpose = chapter.purpose_of_government || {};
const sov = chapter.popular_sovereignty || {};
const rights = chapter.constitutional_order || {};
const rep = chapter.representative_democracy || {};
const direct = chapter.direct_democracy || {};
const admin = chapter.administrative_government || {};
const justice = chapter.justice_public_safety || {};
const comp = chapter.comprehensible_government || {};
const econPol = chapter.economic_power_political_independence || {};

function money(n?: number | null) {
  if (n == null) return "—";
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(n);
}

function num(n?: number | null) {
  if (n == null) return "—";
  return new Intl.NumberFormat("en-US").format(n);
}

function chipFor(cls?: string) {
  if (cls === "FACT") return "chip chip--done";
  if (cls === "DERIVED_CALCULATION" || cls === "MODEL") return "chip chip--live";
  if (cls === "UNKNOWN") return "chip chip--queued";
  return "chip chip--queued";
}

function fmtEv(e: any) {
  if (e.value_usd != null) return money(e.value_usd);
  if (e.unit === "percent") return `${e.value}%`;
  if (typeof e.value === "number") return num(e.value);
  return "";
}
---

<BaseLayout
  title="Government & Democratic Power"
  path="/system/government-engine/"
  description="Pass 3.5 unabridged — popular sovereignty, subsidiarity, Role Conflict Test, Capture Loop, Digital Due Process, and Comprehensible Government."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">Pass 3.5 complete · 100%</span>
      <h1>Government &amp; Democratic Power</h1>
      <p class="lede">{chapter.organizing_sentence}</p>
      <p class="muted">{chapter.governing_question}</p>
      <p class="lede" style="margin-top:0.75rem;">
        <strong>{chapter.central_proposition}</strong>
      </p>
      <ul class="link-board">
        <li><a href="/build-progress/passes/pass-3-5/">Pass 3.5 What Changed →</a></li>
        <li><a href="/system/money-engine/">Money, Markets &amp; Ownership →</a></li>
        <li><a href="/system/arkansas-state-baseline/">Arkansas NOW →</a></li>
        <li><a href="/system/government-power/">Government Power spine →</a></li>
      </ul>
    </header>

    <ReadingModes />

    <section class="hub-section" data-depth="understand" data-depth-keep>
      <h2>See the governance system</h2>
      <SovereigntyDelegationMap />
      <SubsidiarityLadder />
      <GovernmentRolesQuadrant />
      <GovernmentPowerLoop />
      <CaptureCircuitBreakers />
      <PublicDollarChain />
      <DigitalDueProcess />
    </section>

    <section class="hub-section" aria-labelledby="purpose">
      <h2 id="purpose">I. Purpose of government</h2>
      <p class="lede">{purpose.test}</p>
      <p class="muted">Not automatic: {(purpose.not_automatic_burden || []).join(" · ")}</p>
    </section>

    <section class="hub-section" aria-labelledby="sov">
      <h2 id="sov">II. Popular sovereignty</h2>
      <p class="lede"><strong>{sov.principle}</strong></p>
      <ul class="stack">
        <li>
          <strong>Delegation of authority</strong> — {sov.distinction?.delegation_of_authority}
        </li>
        <li>
          <strong>Transfer of sovereignty</strong> — {sov.distinction?.transfer_of_sovereignty}
        </li>
      </ul>
      <p class="muted">{sov.join}</p>
    </section>

    <section class="hub-section" aria-labelledby="rights">
      <h2 id="rights">III. Constitutional order and rights</h2>
      <p class="lede"><strong>{rights.central_principle}</strong></p>
      <ul class="link-board">
        {(rights.elements || []).map((x: string) => <li>{x}</li>)}
      </ul>
      <p class="muted">{rights.purpose}</p>
    </section>

    <section class="hub-section" aria-labelledby="rep">
      <h2 id="rep">IV. Representative democracy</h2>
      <ol class="cap-ladder">
        {(rep.chain || []).map((s: string) => <li>{s}</li>)}
      </ol>
      <h3 style="margin-top:0.85rem;">Structural failure modes</h3>
      <ul class="link-board">
        {(rep.failure_modes || []).map((x: string) => <li>{x}</li>)}
      </ul>
      <p class="muted">{rep.harvest_rule}</p>
    </section>

    <section class="hub-section" aria-labelledby="direct">
      <h2 id="direct">V. Direct democracy</h2>
      <p class="lede">{direct.principle}</p>
      <p>{direct.when}</p>
      <ul class="stack">
        {(direct.risks || []).map((r: string) => <li>{r}</li>)}
      </ul>
      <p class="muted">{direct.safeguard} · {direct.contradiction}</p>
    </section>

    <section class="hub-section" aria-labelledby="admin">
      <h2 id="admin">VIII. Administrative government</h2>
      <p class="lede">{admin.insight}</p>
      <ul class="stack">
        <li>
          <strong>Political direction</strong> — {admin.distinction?.political_direction}
        </li>
        <li>
          <strong>Professional administration</strong> — {admin.distinction?.professional_administration}
        </li>
      </ul>
      <ul class="link-board">
        {(admin.principles || []).map((p: string) => <li>{p}</li>)}
      </ul>
      <p class="muted">{admin.goal}</p>
    </section>

    <section class="hub-section" aria-labelledby="justice">
      <h2 id="justice">XI. Justice and public safety</h2>
      <p class="lede">{justice.principle}</p>
      <ul class="link-board">
        {(justice.systems || []).map((s: string) => <li>{s}</li>)}
      </ul>
      <p>{justice.economic_join}</p>
      <p class="muted">{justice.not}</p>
      <p>
        <span class="chip chip--done">FACT</span> DOC FY2026 Allocation A:{" "}
        <strong>{money(justice.arkansas_doc_fy2026_allocation_a_usd)}</strong>
      </p>
    </section>

    <section class="hub-section" aria-labelledby="comp">
      <h2 id="comp">XIII. Comprehensible Government</h2>
      <p class="lede">{comp.insight}</p>
      <ul class="stack">
        {(comp.citizen_questions || []).map((q: string) => <li>{q}</li>)}
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="econpol">
      <h2 id="econpol">XV. Economic power and political independence</h2>
      <ul class="stack">
        {(econPol.arguments || []).map((a: string) => <li>{a}</li>)}
      </ul>
      <p class="lede"><strong>{econPol.objective}</strong></p>
      <p class="muted">
        {econPol.distinction} · Join{" "}
        <a href={econPol.extraction_test_join}>Extraction Test →</a>
      </p>
    </section>

    <section class="hub-section" aria-labelledby="spine">
      <h2 id="spine">Integration — constitutional-democratic heart</h2>
      <p class="lede">{chapter.integration_spine?.while}</p>
      <ol class="cap-ladder">
        {(chapter.integration_spine?.chain || []).map((s: string) => <li>{s}</li>)}
      </ol>
    </section>

    <section class="hub-section" aria-labelledby="evidence">
      <h2 id="evidence">Arkansas evidence bound</h2>
      {
        Object.entries(evidence)
          .filter(([k]) => k !== "gaps")
          .map(([k, arr]) => (
            <div style="margin-bottom:1rem;">
              <h3>{k.replaceAll("_", " ")}</h3>
              <ul class="stack">
                {(Array.isArray(arr) ? arr : []).map((e: any) => (
                  <li>
                    <span class={chipFor(e.claim_class)}>{e.claim_class}</span>{" "}
                    <strong>{e.label}</strong>
                    {e.value != null || e.value_usd != null ? `: ${fmtEv(e)}` : ""}
                    <span class="muted">
                      {" "}
                      · {e.period || e.status || ""}
                      {e.note ? ` · ${e.note}` : ""}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
      }
      <p class="muted">Gaps: {(evidence.gaps || []).join(" · ")}</p>
    </section>

    <section class="hub-section" aria-labelledby="counter">
      <h2 id="counter">Strongest counterarguments</h2>
      <ul class="stack">
        {
          (chapter.counterarguments || []).map((c: any) => (
            <li>
              <strong>“{c.claim}”</strong>
              <div class="muted">Strong form: {c.strong_form}</div>
              <div>{c.architecture_answer}</div>
              <div class="muted">Unresolved: {c.unresolved}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="go">
      <h2 id="go">GO modules integrated</h2>
      <ul class="link-board">
        {
          modules.map((m: any) => (
            <li>
              {m.id} — {m.name}
            </li>
          ))
        }
      </ul>
      <p class="muted">
        First-pass 15-field models remain in Pass 2.4; Pass 3.5 writes the unabridged system around them.
        Harvest — do not reopen.
      </p>
    </section>

    <section class="hub-section" aria-labelledby="openq">
      <h2 id="openq">Open validation questions</h2>
      <ul class="stack">
        {
          (chapter.open_validation_questions || []).map((q: any) => (
            <li>
              <strong>{q.id}</strong> — {q.question}
              <div class="muted">Assign: {q.assign}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="joins">
      <h2 id="joins">Cross-system connections</h2>
      <ul class="link-board">
        {
          (chapter.cross_system_connections || []).map((j: any) => (
            <li>
              <a href={j.href}>
                {j.to} — {j.join}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="check">
      <h2 id="check">Unabridged category checklist</h2>
      <div class="dash-row">
        <div class="dash-cell">
          <strong>{chapter.category_completion_percent}%</strong>
          <span>Pass 3.5 category</span>
        </div>
        <div class="dash-cell">
          <strong>{checklist.length}/{checklist.length}</strong>
          <span>Required elements PRESENT</span>
        </div>
        <div class="dash-cell">
          <strong>63%</strong>
          <span>Unabridged (5/8)</span>
        </div>
        <div class="dash-cell">
          <strong>66%</strong>
          <span>Overall</span>
        </div>
      </div>
      <ul class="stack">
        {
          checklist.map((el: any) => (
            <li>
              <span class="chip chip--done">{el.status}</span> {el.label}
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
