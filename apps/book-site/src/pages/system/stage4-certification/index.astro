---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReadingModes from "../../../components/ReadingModes.astro";
import chapter from "../../../../../../data/project/stage4_pass46_whole_system_final_red_team.json";
import ladder from "../../../../../../data/project/completion_ladder_and_dashboard.json";

const cert = chapter.certification || {};
const gates = chapter.stage4_pass_gate_card || [];
const certGates = cert.gates || {};
const dist = chapter.project_build_distinction || {};
const integrity = chapter.join_integrity || {};
const board = chapter.final_proposition_board || [];
const certified = board.filter((p: any) =>
  ["CERTIFIED_CORE", "CERTIFIED_WITH_GUARDRAILS"].includes(p.status)
);
const failed = board.filter((p: any) => p.status === "FAILED" || p.status === "LEGAL_CHANGE_REQUIRED");
const open = board.filter((p: any) =>
  ["UNPROVEN", "FUTURE_RESEARCH", "CONDITIONAL", "PILOT_ONLY"].includes(p.status)
);
---

<BaseLayout
  title="Stage 4 Certification Report"
  path="/system/stage4-certification/"
  description="Formal Stage 4 certification: the technical system has been built, written, attacked, and certified."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">{cert.verdict}</span>
      <h1>Stage 4 Certification Report</h1>
      <p class="lede">{cert.statement}</p>
      <p class="lede" style="margin-top:0.75rem;">
        <strong>{dist.statement}</strong>
      </p>
      <p class="muted">
        {cert.decision_id || chapter.decision_id} · {cert.update_id || chapter.update_id} ·{" "}
        {chapter.generated_at}
      </p>
      <ul class="link-board">
        <li><a href="/system/final-red-team/">Final Red Team →</a></li>
        <li><a href="/system/changed-our-mind/">Changed Our Mind →</a></li>
        <li><a href="/system/master-map/">Master System Map →</a></li>
        <li><a href="/build-progress/passes/pass-4-6/">What Changed →</a></li>
      </ul>
    </header>

    <ReadingModes />

    <section class="hub-section">
      <h2>Dial scorecard</h2>
      <ul class="link-board">
        <li>
          Skeleton: <strong>{ladder.progress_bars?.skeleton_coverage_percent}%</strong>
        </li>
        <li>
          First pass: <strong>{ladder.progress_bars?.first_pass_coverage_percent}%</strong>
        </li>
        <li>
          Unabridged: <strong>{ladder.progress_bars?.unabridged_completion_percent}%</strong>
        </li>
        <li>
          Validation: <strong>{ladder.progress_bars?.validation_completion_percent}%</strong>
        </li>
        <li>
          Overall: <strong>{ladder.overall_project_completion?.percent}%</strong> ·{" "}
          {ladder.overall_project_completion?.calculation}
        </li>
        <li>COUNTABLE: <strong>$0</strong> (evidence-driven)</li>
        <li>
          Join fails: <strong>{integrity.join_fails}</strong> · Architectural defects:{" "}
          <strong>{integrity.architectural_defects}</strong>
        </li>
      </ul>
    </section>

    <section class="hub-section">
      <h2>Required gates</h2>
      <ul class="stack">
        {
          gates.map((g: any) => (
            <li>
              <span class="chip chip--done">PASS</span> <strong>{g.gate}</strong>
              <div class="muted">{g.result}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Closure checklist</h2>
      <ul class="stack">
        {
          Object.entries(certGates).map(([k, v]) => (
            <li>
              <span class={v ? "chip chip--done" : "chip chip--live"}>{v ? "PASS" : "FAIL"}</span>{" "}
              {k.replaceAll("_", " ")}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Disposition counts</h2>
      <ul class="link-board">
        <li>
          Certified (core + guardrails): <strong>{certified.length}</strong>
        </li>
        <li>
          Failed / legal change required: <strong>{failed.length}</strong>
        </li>
        <li>
          Open (unproven / conditional / pilot / future): <strong>{open.length}</strong>
        </li>
      </ul>
      <p class="muted">
        Stage 4 may certify with UNPROVEN remaining. It cannot certify with hidden contradictions or
        unresolved structural joins.
      </p>
    </section>

    <section class="hub-section">
      <h2>What comes next</h2>
      <p class="lede">{cert.next}</p>
      <p class="muted">{dist.means}</p>
    </section>
  </article>
</BaseLayout>
