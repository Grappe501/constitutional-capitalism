---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReadingModes from "../../../components/ReadingModes.astro";
import CapabilityLadder from "../../../components/CapabilityLadder.astro";
import MultiplePathways from "../../../components/MultiplePathways.astro";
import HumanCapitalFlywheel from "../../../components/HumanCapitalFlywheel.astro";
import ResearchToProsperity from "../../../components/ResearchToProsperity.astro";
import CommunityCapitalPentagon from "../../../components/CommunityCapitalPentagon.astro";
import RetainReturnAttract from "../../../components/RetainReturnAttract.astro";
import chapter from "../../../../../../data/project/stage3_pass33_human_community_capital.json";
import engine from "../../../../../../data/project/stage2_pass23_human_community_capital.json";

const sections = chapter.sections || [];
const modules = engine.modules || [];
const checklist = Object.values(chapter.category_checklist || {});
const evidence = chapter.arkansas_evidence_bound || {};
const finance = chapter.education_financing_architecture || {};
const worker = chapter.worker_to_owner || {};
const service = chapter.service_as_capital || {};
const place = chapter.place_capability_framework || {};
const ai = chapter.ai_human_capital_bargain || {};

function money(n?: number | null) {
  if (n == null) return "—";
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(n);
}

function num(n?: number | null) {
  if (n == null) return "—";
  return new Intl.NumberFormat("en-US").format(n);
}

function chipFor(cls?: string) {
  if (cls === "FACT") return "chip chip--done";
  if (cls === "DERIVED_CALCULATION" || cls === "MODEL") return "chip chip--live";
  return "chip chip--queued";
}

function fmtEv(e: any) {
  if (e.value_usd != null) return money(e.value_usd);
  if (e.unit === "USD") return money(e.value);
  if (e.unit === "percent") return `${e.value}%`;
  if (typeof e.value === "number") return num(e.value);
  return e.label;
}
---

<BaseLayout
  title="Human & Community Capital"
  path="/system/human-community-engine/"
  description="Pass 3.3 unabridged — capability continuum, demand-informed education, community capital, and Retain→Belong for Arkansas."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">Pass 3.3 complete · 100%</span>
      <h1>Human & Community Capital</h1>
      <p class="lede">{chapter.organizing_sentence}</p>
      <p class="muted">{chapter.governing_question}</p>
      <p class="lede" style="margin-top:0.75rem;">
        <strong>{chapter.central_proposition}</strong>
      </p>
      <ul class="link-board">
        <li><a href="/build-progress/passes/pass-3-3/">Pass 3.3 What Changed →</a></li>
        <li><a href="/system/household-engine/">Household Prosperity join →</a></li>
        <li><a href="/system/arkansas-state-baseline/">Arkansas NOW →</a></li>
      </ul>
    </header>

    <ReadingModes />

    <section class="hub-section" data-depth="understand" data-depth-keep>
      <h2>See the capability system</h2>
      <CapabilityLadder />
      <MultiplePathways />
      <HumanCapitalFlywheel />
      <ResearchToProsperity />
      <CommunityCapitalPentagon />
      <RetainReturnAttract />
    </section>

    <section class="hub-section" aria-labelledby="def">
      <h2 id="def">1. Human capability begins before employment</h2>
      <p class="lede">
        Rejected: {chapter.broader_human_capital_definition?.rejects}
      </p>
      <ul class="link-board">
        {
          (chapter.broader_human_capital_definition?.encompasses || []).map((x: string) => (
            <li>{x}</li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="finance">
      <h2 id="finance">4. Education financing & intergenerational investment</h2>
      <p class="lede">
        Frame: <strong>{finance.frame?.replaceAll("_", " ")}</strong>
      </p>
      <ul class="stack">
        {
          Object.entries(finance.layers || {}).map(([k, v]) => (
            <li>
              <strong>{k.replaceAll("_", " ")}</strong>
              <div class="muted">{v}</div>
            </li>
          ))
        }
      </ul>
      <p class="muted">{finance.count_rule}</p>
      <p class="muted">
        Stage 4 tests: {(finance.stage_4_tests || []).join(" · ")}
      </p>
    </section>

    <section class="hub-section" aria-labelledby="owner">
      <h2 id="owner">6. From worker to owner</h2>
      <p class="lede">{worker.objective}</p>
      <ul class="stack">
        {
          (worker.pathways || []).map((p: any) => (
            <li>
              <strong>{p.id}</strong> — {p.chain}
            </li>
          ))
        }
      </ul>
      <p class="muted">{worker.household_join}</p>
    </section>

    <section class="hub-section" aria-labelledby="service">
      <h2 id="service">7. Service as capital formation</h2>
      <p class="lede">{service.principle}</p>
      <ul class="link-board">
        {(service.reciprocal_pathways_may_include || []).map((x: string) => <li>{x}</li>)}
      </ul>
      <p class="muted">{service.rule}</p>
    </section>

    <section class="hub-section" aria-labelledby="place">
      <h2 id="place">10. Place Capability Framework</h2>
      <p class="lede">{place.rule}</p>
      <ul class="link-board">
        {(place.elements || []).map((x: string) => <li>{x}</li>)}
      </ul>
      <p class="muted">
        Recognized geographies: {(place.recognized_geographies || []).join(" · ")}
      </p>
    </section>

    <section class="hub-section" aria-labelledby="ai">
      <h2 id="ai">11. AI changes the human-capital bargain</h2>
      <p class="lede">{ai.structural_problem}</p>
      <ul class="link-board">
        {(ai.architecture_response || []).map((x: string) => <li>{x}</li>)}
      </ul>
      <p class="muted">{ai.ai_social_compact}</p>
    </section>

    <section class="hub-section" aria-labelledby="evidence">
      <h2 id="evidence">Arkansas evidence bound</h2>
      {
        Object.entries(evidence)
          .filter(([k]) => k !== "gaps" && k !== "demand_bridge")
          .map(([k, arr]) => (
            <div style="margin-bottom:1rem;">
              <h3>{k.replaceAll("_", " ")}</h3>
              <ul class="stack">
                {(Array.isArray(arr) ? arr : []).map((e: any) => (
                  <li>
                    <span class={chipFor(e.claim_class)}>{e.claim_class}</span>{" "}
                    <strong>{e.label}</strong>
                    {e.value != null || e.value_usd != null ? `: ${fmtEv(e)}` : ""}
                    <span class="muted">
                      {" "}
                      · {e.period}
                      {e.note ? ` · ${e.note}` : ""}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
      }
      <p class="muted">Gaps: {(evidence.gaps || []).join(" · ")}</p>
    </section>

    <section class="hub-section" aria-labelledby="counter">
      <h2 id="counter">Counterarguments</h2>
      <ul class="stack">
        {
          (chapter.counterarguments || []).map((c: any) => (
            <li>
              <strong>“{c.claim}”</strong>
              <div class="muted">Strong form: {c.strong_form}</div>
              <div>{c.architecture_answer}</div>
              <div class="muted">Unresolved: {c.unresolved}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="hc">
      <h2 id="hc">HC modules integrated</h2>
      <ul class="link-board">
        {
          modules.map((m: any) => (
            <li>
              {m.id} — {m.name}
            </li>
          ))
        }
      </ul>
      <p class="muted">
        First-pass 15-field models remain in Pass 2.3; Pass 3.3 writes the unabridged system around
        them. Sections: {sections.map((s: any) => s.id).join(", ")}.
      </p>
    </section>

    <section class="hub-section" aria-labelledby="openq">
      <h2 id="openq">Open validation questions</h2>
      <ul class="stack">
        {
          (chapter.open_validation_questions || []).map((q: any) => (
            <li>
              <strong>{q.id}</strong> — {q.question}
              <div class="muted">Assign: {q.assign}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="joins">
      <h2 id="joins">Cross-system connections</h2>
      <ul class="link-board">
        {
          (chapter.cross_system_connections || []).map((j: any) => (
            <li>
              <a href={j.href}>
                {j.to} — {j.join}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="check">
      <h2 id="check">Unabridged category checklist</h2>
      <div class="dash-row">
        <div class="dash-cell">
          <strong>{chapter.category_completion_percent}%</strong>
          <span>Pass 3.3 category</span>
        </div>
        <div class="dash-cell">
          <strong>{checklist.length}/{checklist.length}</strong>
          <span>Required elements PRESENT</span>
        </div>
      </div>
      <ul class="stack">
        {
          checklist.map((el: any) => (
            <li>
              <span class="chip chip--done">{el.status}</span> {el.label}
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
