---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReadingModes from "../../../components/ReadingModes.astro";
import mind from "../../../../../../data/project/stage4_changed_our_mind.json";

const entries = mind.entries || [];
---

<BaseLayout
  title="What Constitutional Capitalism Changed Its Mind About"
  path="/system/changed-our-mind/"
  description="Stage 4 killed and redesigned ideas that did not survive hostile attack — with history preserved."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">Stage 4 · Doctrine honesty</span>
      <h1>{mind.title}</h1>
      <p class="lede">{mind.intro}</p>
      <p class="muted">
        {mind.decision_id} · {mind.update_id} · For each idea: Original → Attack → Reason → Final
        doctrine
      </p>
      <ul class="link-board">
        <li><a href={mind.final_board_href}>Final disposition board →</a></li>
        <li><a href={mind.certification_href}>Stage 4 Certification →</a></li>
        <li><a href="/system/final-red-team/">Final Red Team →</a></li>
        <li><a href="/system/master-map/">Master System Map →</a></li>
      </ul>
    </header>

    <ReadingModes />

    <section class="hub-section" data-depth="understand" data-depth-keep>
      <h2>Deaths and redesigns</h2>
      <ul class="stack">
        {
          entries.map((e: any) => (
            <li>
              <span class="chip chip--live">CHANGED</span> <strong>{e.id}</strong>
              <div class="lede">{e.original}</div>
              <dl class="glossary-list">
                <dt>Attack</dt>
                <dd>{e.attack}</dd>
                <dt>Evidence / reason</dt>
                <dd>{e.reason}</dd>
                <dt>Final doctrine</dt>
                <dd>{e.final}</dd>
              </dl>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Why this page exists</h2>
      <p class="lede">
        A prosperity theory that never admits it was wrong cannot earn trust. Stage 4 is the audit
        trail.
      </p>
      <p class="muted">
        Dead propositions are removed from the operating framework. The attack record remains so
        readers can see the intellectual evolution — Original hypothesis → Stage 4 disposition →
        Current surviving architecture.
      </p>
    </section>
  </article>
</BaseLayout>
