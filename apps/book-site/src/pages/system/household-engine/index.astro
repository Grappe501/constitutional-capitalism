---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReadingModes from "../../../components/ReadingModes.astro";
import HouseholdDashboard from "../../../components/HouseholdDashboard.astro";
import HouseholdFunnel from "../../../components/HouseholdFunnel.astro";
import HouseholdBalanceSheet from "../../../components/HouseholdBalanceSheet.astro";
import CostPressureWheel from "../../../components/CostPressureWheel.astro";
import HouseholdIntergenFlywheel from "../../../components/HouseholdIntergenFlywheel.astro";
import chapter from "../../../../../../data/project/stage3_pass32_household_prosperity.json";
import engine from "../../../../../../data/project/stage2_pass22_household_prosperity_engine.json";

const sections = chapter.sections || [];
const ledger = chapter.household_prosperity_ledger || {};
const archetypes = sections.find((s: any) => s.id === "S7")?.archetypes || [];
const counties = ledger.designated_county_context || [];
const checklist = Object.values(chapter.category_checklist || {});
const modules = engine.modules || [];

function money(n?: number | null) {
  if (n == null) return "—";
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(n);
}

function num(n?: number | null) {
  if (n == null) return "—";
  return new Intl.NumberFormat("en-US").format(n);
}

function chipFor(cls?: string) {
  if (cls === "FACT") return "chip chip--done";
  if (cls === "DERIVED_CALCULATION" || cls === "MODEL") return "chip chip--live";
  if (cls === "NATIONAL_PROXY" || cls === "ILLUSTRATION" || cls === "HYPOTHESIS")
    return "chip chip--queued";
  return "chip";
}
---

<BaseLayout
  title="Household Prosperity"
  path="/system/household-engine/"
  description="Pass 3.2 unabridged Household Prosperity — income, cost, security, ownership, and time for Arkansas households."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">Pass 3.2 complete · 100%</span>
      <h1>Household Prosperity</h1>
      <p class="lede">{chapter.organizing_sentence}</p>
      <p class="muted">
        {chapter.governing_question}
      </p>
      <p class="lede" style="margin-top:0.75rem;">
        <strong>{chapter.central_proposition}</strong>
      </p>
      <ul class="link-board">
        <li><a href="/build-progress/passes/pass-3-2/">Pass 3.2 What Changed →</a></li>
        <li><a href="/system/arkansas-state-baseline/">Arkansas NOW baseline →</a></li>
        <li><a href="/build-progress/passes/pass-2-2/">Stage 2 HP first-pass →</a></li>
      </ul>
    </header>

    <ReadingModes />

    <section class="hub-section" data-depth="understand" data-depth-keep>
      <h2>See the household system</h2>
      <HouseholdDashboard />
      <HouseholdFunnel />
      <HouseholdBalanceSheet />
      <CostPressureWheel />
      <HouseholdIntergenFlywheel />
    </section>

    <section class="hub-section" aria-labelledby="five">
      <h2 id="five">Income · Cost · Security · Ownership · Time</h2>
      <p class="lede">{chapter.five_dimension_framework?.insight}</p>
      <div class="spine-grid">
        {
          (chapter.five_dimension_framework?.dimensions || []).map((d: any) => (
            <div class="spine-tile">
              <span class="chip chip--live">{d.id}</span>
              <h3>{d.label}</h3>
              <p>{d.definition}</p>
            </div>
          ))
        }
      </div>
    </section>

    {
      sections.map((s: any) => (
        <section class="hub-section" id={s.id.toLowerCase()} aria-labelledby={`${s.id}-h`}>
          <h2 id={`${s.id}-h`}>
            {s.id.replace("S", "")}. {s.title}
          </h2>
          {s.body && (
            <ul class="stack">
              {s.body.map((p: string) => (
                <li>{p}</li>
              ))}
            </ul>
          )}
          {s.insufficient_alone && (
            <>
              <h3>Insufficient alone</h3>
              <ul class="link-board">
                {s.insufficient_alone.map((x: string) => (
                  <li>{x}</li>
                ))}
              </ul>
            </>
          )}
          {s.success_test && <p class="lede">{s.success_test}</p>}
          {s.formula_flow && (
            <p class="lede">
              <strong>{s.formula_flow}</strong>
            </p>
          )}
          {s.wealth_identity && (
            <p>
              <strong>{s.wealth_identity}</strong>
            </p>
          )}
          {s.time_dimension && <p>{s.time_dimension}</p>}
          {s.insight && <p>{s.insight}</p>}
          {s.surplus_uses_ladder && (
            <ol>
              {s.surplus_uses_ladder.map((step: string) => (
                <li>{step}</li>
              ))}
            </ol>
          )}
          {s.arkansas_evidence && (
            <ul class="stack">
              {s.arkansas_evidence.map((e: any) => (
                <li>
                  <span class={chipFor(e.claim_class)}>{e.claim_class}</span>{" "}
                  <strong>{e.label}</strong>:{" "}
                  {e.unit === "USD" || e.unit === "USD_2022"
                    ? money(e.value)
                    : e.unit === "percent" || e.unit === "percent_of_DPI"
                      ? `${e.value}%`
                      : e.unit === "cents_per_kWh"
                        ? `${e.value}¢/kWh`
                        : num(e.value)}
                  <span class="muted">
                    {" "}
                    · {e.period} · {e.geography}
                  </span>
                  {e.note && <div class="muted">{e.note}</div>}
                </li>
              ))}
            </ul>
          )}
          {s.domains && (
            <ul class="stack">
              {Object.entries(s.domains).map(([k, v]: [string, any]) => (
                <li>
                  <strong>{k}</strong> — {v.status}
                  <div class="muted">{v.bound}</div>
                </li>
              ))}
            </ul>
          )}
          {s.interaction_rule && <p class="lede">{s.interaction_rule}</p>}
          {s.risk_classes && (
            <ul class="link-board">
              {s.risk_classes.map((r: string) => (
                <li>{r}</li>
              ))}
            </ul>
          )}
          {s.arkansas_signals && (
            <ul class="stack">
              {s.arkansas_signals.map((e: any) => (
                <li>
                  <span class={chipFor(e.claim_class || "FACT")}>{e.claim_class || "FACT"}</span>{" "}
                  {e.label}
                  {e.note && <div class="muted">{e.note}</div>}
                  {e.value != null && (
                    <div class="muted">
                      {typeof e.value === "number" && e.unit === "percent"
                        ? `${e.value}%`
                        : e.value}{" "}
                      · {e.period}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          )}
          {s.asset_classes && (
            <ul class="link-board">
              {s.asset_classes.map((a: string) => (
                <li>{a}</li>
              ))}
            </ul>
          )}
          {s.honesty && <p class="muted">{s.honesty}</p>}
          {s.rule && <p class="lede">{s.rule}</p>}
          {s.engine_transmission && (
            <ul class="stack">
              {s.engine_transmission.map((e: any) => (
                <li>
                  <a href={e.href}>
                    <strong>{e.engine}</strong>
                  </a>
                  <div class="muted">{e.path}</div>
                </li>
              ))}
            </ul>
          )}
          {s.prosperity_loop && (
            <p>
              <strong>Prosperity loop:</strong> {s.prosperity_loop}
            </p>
          )}
          {s.extraction_loop && (
            <p>
              <strong>Extraction loop:</strong> {s.extraction_loop}
            </p>
          )}
          {s.annual_core && (
            <ol>
              {s.annual_core.map((m: string) => (
                <li>{m}</li>
              ))}
            </ol>
          )}
          {s.geographic_rule && <p class="muted">{s.geographic_rule}</p>}
          {s.architecture && <p>{s.architecture}</p>}
          {s.gaps && (
            <p class="muted">Gaps: {s.gaps.join(" · ")}</p>
          )}
        </section>
      ))
    }

    <section class="hub-section" id="archetypes" aria-labelledby="arch-h">
      <h2 id="arch-h">Household Archetype Comparison</h2>
      <p class="lede">
        Analytical archetypes — not invented case studies presented as data. County FACT divergence
        from Arkansas NOW:
      </p>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>County</th>
              <th>Pop Δ 2020–23</th>
              <th>MHI</th>
              <th>Poverty %</th>
            </tr>
          </thead>
          <tbody>
            {
              counties.map((c: any) => (
                <tr>
                  <td>{c.county}</td>
                  <td>
                    {c.population_change_2020_2023 > 0 ? "+" : ""}
                    {num(c.population_change_2020_2023)}
                  </td>
                  <td>{money(c.median_household_income_usd)}</td>
                  <td>{c.poverty_rate_all_ages_percent}%</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="spine-grid" style="margin-top:1rem;">
        {
          archetypes.map((a: any) => (
            <div class="spine-tile">
              <span class={chipFor(a.claim_class)}>{a.claim_class}</span>
              <h3>{a.label}</h3>
              <p>{(a.pressure_emphasis || []).join(" · ")}</p>
              {a.evidence_status && <p class="muted">{a.evidence_status}</p>}
            </div>
          ))
        }
      </div>
    </section>

    <section class="hub-section" id="ledger" aria-labelledby="ledger-h">
      <h2 id="ledger-h">Household Prosperity Ledger</h2>
      <p class="lede">{ledger.honesty_rule}</p>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Archetype</th>
              <th>Resources</th>
              <th>Essentials</th>
              <th>Obligations</th>
              <th>Surplus</th>
              <th>Net wealth</th>
              <th>Time / security</th>
            </tr>
          </thead>
          <tbody>
            {
              (ledger.archetype_rows || []).map((r: any) => (
                <tr>
                  <td>{r.label}</td>
                  <td class="muted">UNKNOWN</td>
                  <td class="muted">PARTIAL / UNKNOWN</td>
                  <td class="muted">PARTIAL / UNKNOWN</td>
                  <td>
                    <span class="chip chip--queued">NOT FABRICATED</span>
                  </td>
                  <td class="muted">AR UNKNOWN</td>
                  <td class="muted">Architecture + partial access</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <h3>Shared Arkansas baselines (FACT)</h3>
      <ul class="stack">
        {
          (ledger.shared_arkansas_baselines || []).map((b: any) => (
            <li>
              <span class={chipFor(b.claim_class)}>{b.claim_class}</span>{" "}
              <strong>{b.label}</strong>:{" "}
              {b.unit === "USD" || b.unit === "USD_2022"
                ? money(b.value)
                : b.unit === "percent" || b.unit === "percent_of_DPI"
                  ? `${b.value}%`
                  : b.unit === "cents_per_kWh"
                    ? `${b.value}¢/kWh`
                    : num(b.value)}
              <span class="muted">
                {" "}
                · {b.period} · {b.geography}
              </span>
            </li>
          ))
        }
      </ul>
      <h3>National proxies (labeled)</h3>
      <ul class="stack">
        {
          (ledger.national_proxies_labeled || []).map((b: any) => (
            <li>
              <span class={chipFor(b.claim_class)}>{b.claim_class}</span>{" "}
              <strong>{b.label}</strong>:{" "}
              {b.unit === "USD" || b.unit === "USD_2022"
                ? money(b.value)
                : `${b.value}${b.unit?.includes("percent") ? "%" : ""}`}
              <span class="muted">
                {" "}
                · {b.period} · {b.geography}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="counter-h">
      <h2 id="counter-h">Counterarguments</h2>
      <ul class="stack">
        {
          (chapter.counterarguments || []).map((c: any) => (
            <li>
              <strong>“{c.claim}”</strong>
              <div class="muted">Strong form: {c.strong_form}</div>
              <div>{c.architecture_answer}</div>
              <div class="muted">Unresolved: {c.unresolved}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="hp-mod">
      <h2 id="hp-mod">HP modules integrated (Stage 2 → Stage 3)</h2>
      <ul class="link-board">
        {
          modules.map((m: any) => (
            <li>
              <a href={`#${m.id.toLowerCase()}`}>
                {m.id} — {m.name}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="muted">
        Full 15-field first-pass models remain in the Pass 2.2 artifact; Pass 3.2 writes the
        unabridged household system around them.
      </p>
    </section>

    <section class="hub-section" aria-labelledby="openq">
      <h2 id="openq">Open validation questions</h2>
      <ul class="stack">
        {
          (chapter.open_validation_questions || []).map((q: any) => (
            <li>
              <strong>{q.id}</strong> — {q.question}
              <div class="muted">Assign: {q.assign}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="joins">
      <h2 id="joins">Cross-system connections</h2>
      <ul class="link-board">
        {
          (chapter.cross_system_connections || []).map((j: any) => (
            <li>
              <a href={j.href}>
                {j.to} — {j.join}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="check">
      <h2 id="check">Unabridged category checklist</h2>
      <div class="dash-row">
        <div class="dash-cell">
          <strong>{chapter.category_completion_percent}%</strong>
          <span>Pass 3.2 category</span>
        </div>
        <div class="dash-cell">
          <strong>{checklist.length}/{checklist.length}</strong>
          <span>Required elements PRESENT</span>
        </div>
      </div>
      <ul class="stack">
        {
          checklist.map((el: any) => (
            <li>
              <span class="chip chip--done">{el.status}</span> {el.label}
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .table-wrap {
    overflow-x: auto;
    margin: 1rem 0;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .data-table th,
  .data-table td {
    text-align: left;
    padding: 0.45rem 0.55rem;
    border-bottom: 1px solid color-mix(in srgb, var(--ink, #1a1a1a) 12%, transparent);
    vertical-align: top;
  }
</style>
