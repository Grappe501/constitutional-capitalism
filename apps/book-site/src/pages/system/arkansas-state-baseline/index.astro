---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import corpus from "../../../../../../data/project/arkansas_state_baseline_corpus.json";
import seed from "../../../../../../data/imports/arkansas-state-baseline/normalized/fy2026_general_revenue_allocations_seed.json";

function money(n?: number | null) {
  if (n == null) return "—";
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(n);
}
---

<BaseLayout
  title="Arkansas State Baseline"
  path="/system/arkansas-state-baseline/"
  description="Shared Arkansas budget and fiscal baseline infrastructure — starting balance sheet for the unabridged system, not an exploratory research branch."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--live">Shared infrastructure</span>
      <h1>Arkansas State Baseline</h1>
      <p class="lede">{corpus.organizing_sentence}</p>
      <p class="muted">
        Decision {corpus.decision_id} · Status: {corpus.status.replaceAll("_", " ")}
      </p>
    </header>

    <section class="hub-section" aria-labelledby="role">
      <h2 id="role">Role</h2>
      <p class="lede">{corpus.role}</p>
      <p>
        We are not writing a theoretical government from scratch. The actual State of Arkansas is
        the starting balance sheet and operating system. Acquire and organize budgets now; pull
        analysis into later modules as needed. Do <strong>not</strong> stop Pass 2 to analyze every
        line.
      </p>
      <ul class="link-board">
        <li><a href="/build-progress/passes/pass-2/">Pass 2 changelog</a></li>
        <li><a href="/system/household-place/">Household & Place spine</a></li>
        <li><a href="/research/">Research desk</a></li>
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="fy26">
      <h2 id="fy26">FY2026 seed snapshot</h2>
      <p class="lede">
        From the official 2025 Regular Session Fiscal Legislation Summary (RSA Allocation A /
        agency totals as labeled in source).
      </p>
      <div class="dash-row">
        <div class="dash-cell">
          <strong>{money(seed.headline.general_revenue_distributed_to_agencies_and_institutions_fy2026_a)}</strong>
          <span>GR to agencies & institutions</span>
        </div>
        <div class="dash-cell">
          <strong>+{seed.headline.percent_change}%</strong>
          <span>vs FY2025</span>
        </div>
      </div>
      <ul class="stack">
        {
          (seed.selected_patterns || []).map((p: any) => (
            <li>
              <strong>{p.label}</strong>
              <div>{money(p.fy2026_a)}</div>
              {p.narrative_note && <div class="muted">{p.narrative_note}</div>}
              {p.note && <div class="muted">{p.note}</div>}
            </li>
          ))
        }
      </ul>
      <p class="muted">
        Seed path: <code>{corpus.normalized_seeds?.[0]}</code> · Not a full state-finance model ·
        Not countable Replacement Stack revenue.
      </p>
    </section>

    <section class="hub-section" aria-labelledby="questions">
      <h2 id="questions">Questions later modules must ask</h2>
      <ul class="stack">
        {
          (corpus.capability_questions_for_later_modules || []).map((q: string) => (
            <li>{q}</li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="sources">
      <h2 id="sources">Sources ingested / indexed</h2>
      <ul class="stack">
        {
          (corpus.sources_ingested || []).map((s: any) => (
            <li>
              <strong>{s.title}</strong>
              <div class="muted">
                {s.fiscal_year} · {s.status.replaceAll("_", " ")}
              </div>
              {s.local_path && <div class="muted"><code>{s.local_path}</code></div>}
              {s.url && (
                <div>
                  <a href={s.url} rel="noopener noreferrer">Official document →</a>
                </div>
              )}
              {s.notes && <div class="muted">{s.notes}</div>}
            </li>
          ))
        }
      </ul>
      <p class="muted">
        Years queued: {(corpus.years_queued_for_ingest || []).join(", ")}. Categories to normalize:{" "}
        {(corpus.normalize_categories || []).slice(0, 6).join(", ")}, …
      </p>
    </section>
  </article>
</BaseLayout>
