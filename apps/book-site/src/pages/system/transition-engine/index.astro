---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReadingModes from "../../../components/ReadingModes.astro";
import ArkansasTransitionMapWorking from "../../../components/ArkansasTransitionMapWorking.astro";
import ReplacementReadinessGate from "../../../components/ReplacementReadinessGate.astro";
import BridgeBeforeRoad from "../../../components/BridgeBeforeRoad.astro";
import TransitionControlBoard from "../../../components/TransitionControlBoard.astro";
import FiscalReplacementWaterfall from "../../../components/FiscalReplacementWaterfall.astro";
import IntergenerationalCapitalLedger from "../../../components/IntergenerationalCapitalLedger.astro";
import PilotProofScale from "../../../components/PilotProofScale.astro";
import chapter from "../../../../../../data/project/stage3_pass37_transition_intergenerational.json";
import engine from "../../../../../../data/project/stage2_pass25_arkansas_transition_engine.json";

const modules = engine.modules || [];
const checklist = Object.values(chapter.category_checklist || {});
const steward = chapter.stewardship_premise || {};
const dep = chapter.dependency_rule || {};
const y12 = chapter.years_1_2 || {};
const y35 = chapter.years_3_5 || {};
const y610 = chapter.years_6_10 || {};
const g1 = chapter.generation_1 || {};
const fail = chapter.failure_architecture || {};
const pol = chapter.political_transition || {};
const hum = chapter.human_transition || {};
const geo = chapter.geographic_transition || {};
const res = chapter.resilience_before_replacement || {};
const evidence = chapter.arkansas_evidence_bound || {};

function chipFor(cls?: string) {
  if (cls === "FACT") return "chip chip--done";
  if (cls === "MODEL") return "chip chip--live";
  return "chip chip--queued";
}
---

<BaseLayout
  title="Transition & Intergenerational Arkansas"
  path="/system/transition-engine/"
  description="Pass 3.7 unabridged — Dependency Rule, Replacement Readiness, Build & Prove through Generation 2, without inventing COUNTABLE cash."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">Pass 3.7 complete · 100%</span>
      <h1>Transition &amp; Intergenerational Arkansas</h1>
      <p class="lede">{chapter.organizing_sentence}</p>
      <p class="muted">{chapter.governing_question}</p>
      <p class="lede" style="margin-top:0.75rem;">
        <strong>{chapter.central_proposition}</strong>
      </p>
      <p class="muted"><strong>Hard boundary:</strong> {chapter.hard_boundary}</p>
      <ul class="link-board">
        <li><a href="/build-progress/passes/pass-3-7/">Pass 3.7 What Changed →</a></li>
        <li><a href="/system/arkansas-state-baseline/">Arkansas NOW →</a></li>
        <li><a href="/system/money-engine/">Money Engine →</a></li>
        <li><a href="/system/productive-systems/">Productive Systems →</a></li>
      </ul>
    </header>

    <ReadingModes />

    <section class="hub-section" data-depth="understand" data-depth-keep>
      <h2>See the roadmap</h2>
      <ArkansasTransitionMapWorking />
      <ReplacementReadinessGate />
      <BridgeBeforeRoad />
      <TransitionControlBoard />
      <FiscalReplacementWaterfall />
      <IntergenerationalCapitalLedger />
      <PilotProofScale />
    </section>

    <section class="hub-section" aria-labelledby="steward">
      <h2 id="steward">I. We inherit Arkansas</h2>
      <p class="lede">{steward.principle}</p>
      <ul class="link-board">
        {(steward.inherited || []).map((x: string) => <li>{x}</li>)}
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="dep">
      <h2 id="dep">II. Dependency Rule</h2>
      <p class="lede"><strong>{dep.one_line}</strong></p>
      <p>{dep.rule}</p>
      <ul class="link-board">
        {(dep.especially_important_for || []).map((x: string) => <li>{x}</li>)}
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="y12">
      <h2 id="y12">IV. Years 1–2 — {y12.label}</h2>
      <p class="lede">{y12.objective}</p>
      <p class="muted">Rejected temptation: {y12.temptation_rejected}</p>
      <ul class="link-board">
        {(y12.priorities || []).map((x: string) => <li>{x}</li>)}
      </ul>
      <p class="muted">
        Program disposition: {(y12.program_disposition || []).join(" · ")}. {y12.not}
      </p>
    </section>

    <section class="hub-section" aria-labelledby="y35">
      <h2 id="y35">V. Years 3–5 — {y35.label}</h2>
      <ul class="link-board">
        {(y35.evidence_classes || []).map((x: string) => <li>{x}</li>)}
      </ul>
      <p>{y35.scale_path}</p>
      <p class="muted">{y35.public_income_rule}</p>
      <p class="muted">{y35.not}</p>
    </section>

    <section class="hub-section" aria-labelledby="y610">
      <h2 id="y610">VI. Years 6–10 — {y610.label}</h2>
      <p class="lede">{y610.when}</p>
      <ol class="cap-ladder">
        {(y610.conceptual_order || []).map((s: string) => <li>{s}</li>)}
      </ol>
      <p style="margin-top:0.85rem;">
        <strong>Correct:</strong> {y610.correct_sequence}
      </p>
      <p class="muted"><strong>Wrong:</strong> {y610.wrong_sequence}</p>
    </section>

    <section class="hub-section" aria-labelledby="g1">
      <h2 id="g1">VII. Generation 1 — success tests</h2>
      <p class="lede">{g1.rule}</p>
      <ul class="link-board">
        {(g1.success_tests || []).map((x: string) => <li>{x}</li>)}
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="igen-rule">
      <h2 id="igen-rule">IX. Intergenerational Capital Rule</h2>
      <p class="lede">
        <strong>{chapter.intergenerational_capital_rule?.rule}</strong>
      </p>
      <ul class="stack">
        {(chapter.intergenerational_capital_rule?.means || []).map((x: string) => <li>{x}</li>)}
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="pol">
      <h2 id="pol">XII–XIV. Political, human &amp; geographic transition</h2>
      <h3>Political</h3>
      <ul class="stack">
        {(pol.questions || []).map((q: string) => <li>{q}</li>)}
      </ul>
      <p class="muted">{pol.rule}</p>
      <h3>Human</h3>
      <p class="lede">{hum.principle}</p>
      <ul class="link-board">
        {(hum.effects_may_include || []).map((x: string) => <li>{x}</li>)}
      </ul>
      <p class="muted">{hum.rule}</p>
      <h3>Geographic</h3>
      <p>{geo.insight}</p>
      <ul class="link-board">
        {(geo.start_modes || []).map((x: string) => <li>{x}</li>)}
      </ul>
      <p class="muted">{geo.laboratory}</p>
    </section>

    <section class="hub-section" aria-labelledby="res">
      <h2 id="res">XV. Resilience before replacement</h2>
      <p class="lede">{res.rule}</p>
      <ul class="link-board">
        {(res.stage4_tests || []).map((x: string) => <li>{x}</li>)}
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="fail">
      <h2 id="fail">XVI. Failure is allowed</h2>
      <p class="lede">{fail.cultural_principle}</p>
      <ul class="stack">
        {
          (fail.paths || []).map((p: any) => (
            <li>
              <strong>{p.event}</strong> → {p.action}
            </li>
          ))
        }
      </ul>
      <p>{fail.insight}</p>
      <p class="muted">{fail.anti_excuse}</p>
    </section>

    <section class="hub-section" aria-labelledby="spine">
      <h2 id="spine">Integration — NOW to Generation 2</h2>
      <p class="lede">{chapter.integration_spine?.while}</p>
      <ol class="cap-ladder">
        {(chapter.integration_spine?.chain || []).map((s: string) => <li>{s}</li>)}
      </ol>
    </section>

    <section class="hub-section" aria-labelledby="evidence">
      <h2 id="evidence">Evidence bound</h2>
      <ul class="stack">
        {
          (evidence.architecture_harvest || []).map((e: any) => (
            <li>
              <span class={chipFor(e.claim_class)}>{e.claim_class}</span>{" "}
              <strong>{e.label}</strong>
              <span class="muted">
                {" "}
                · {e.status || ""}
                {e.note ? ` · ${e.note}` : ""}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="muted">Gaps: {(evidence.gaps || []).join(" · ")}</p>
    </section>

    <section class="hub-section" aria-labelledby="counter">
      <h2 id="counter">Counterarguments</h2>
      <ul class="stack">
        {
          (chapter.counterarguments || []).map((c: any) => (
            <li>
              <strong>“{c.claim}”</strong>
              <div class="muted">Strong form: {c.strong_form}</div>
              <div>{c.architecture_answer}</div>
              <div class="muted">Unresolved: {c.unresolved}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="tr">
      <h2 id="tr">TR modules integrated</h2>
      <ul class="link-board">
        {
          modules.map((m: any) => (
            <li>
              {m.id} — {m.name}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="openq">
      <h2 id="openq">Open validation questions</h2>
      <ul class="stack">
        {
          (chapter.open_validation_questions || []).map((q: any) => (
            <li>
              <strong>{q.id}</strong> — {q.question}
              <div class="muted">Assign: {q.assign}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="joins">
      <h2 id="joins">Cross-system connections</h2>
      <ul class="link-board">
        {
          (chapter.cross_system_connections || []).map((j: any) => (
            <li>
              <a href={j.href}>
                {j.to} — {j.join}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="check">
      <h2 id="check">Unabridged category checklist</h2>
      <div class="dash-row">
        <div class="dash-cell">
          <strong>{chapter.category_completion_percent}%</strong>
          <span>Pass 3.7 category</span>
        </div>
        <div class="dash-cell">
          <strong>{checklist.length}/{checklist.length}</strong>
          <span>Required elements PRESENT</span>
        </div>
        <div class="dash-cell">
          <strong>88%</strong>
          <span>Unabridged (7/8)</span>
        </div>
        <div class="dash-cell">
          <strong>72%</strong>
          <span>Overall</span>
        </div>
      </div>
      <ul class="stack">
        {
          checklist.map((el: any) => (
            <li>
              <span class="chip chip--done">{el.status}</span> {el.label}
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
