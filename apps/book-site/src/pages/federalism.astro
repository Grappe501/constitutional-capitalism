---
import BaseLayout from "../layouts/BaseLayout.astro";
import ff from "../../../../data/project/federalism_framework.json";

const responsibilities = ff.core_responsibilities || [];
const notRoutinely = ff.not_routinely || [];
const ladder = ff.competency_ladder || [];
const upward = ff.upward_transfer_test?.questions || [];
const testQs = ff.federalism_test?.questions || [];
const branches = ff.website_branches || [];
const whenFed = ff.when_federal || [];
const fundingDist = ff.federal_funding_without_domination?.required_distinctions || [];
const agencyQs = ff.lean_federal_administration?.periodic_review_questions || [];
---

<BaseLayout
  title="Federalism Doctrine"
  path="/federalism/"
  description="Limited, capable, transparent, and focused federal government — not weak. Power remains local unless national coordination, uniformity, or constitutional rights require otherwise."
>
  <article class="prose">
    <h1>{ff.domain_title}</h1>

    <p class="lede">
      The federal government should not be defined as weak. It should be{" "}
      <strong>{ff.character.is.join(", ")}</strong>.
    </p>

    <h2>Central statement</h2>
    <blockquote>
      <p>{ff.central_statement.text}</p>
    </blockquote>

    <h2>Governing rule</h2>
    <blockquote>
      <p>{ff.governing_rule.text}</p>
    </blockquote>

    <h2>When the federal role is justified</h2>
    <ul>
      {whenFed.map((item: string) => (
        <li>{item}</li>
      ))}
    </ul>

    <h2>Core responsibilities</h2>
    <ol>
      {responsibilities.map((r: any) => (
        <li>
          <strong>
            {r.id}. {r.title}
          </strong>{" "}
          — {r.summary}
        </li>
      ))}
    </ol>

    <h2>What the federal government should not routinely do</h2>
    <ul>
      {notRoutinely.map((item: string) => (
        <li>{item}</li>
      ))}
    </ul>

    <h2>Competency ladder</h2>
    <p>{ladder.join(" → ")}</p>

    <h2>Upward-transfer test</h2>
    <p>{ff.upward_transfer_test.purpose}</p>
    <ol>
      {upward.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>

    <h2>Federal funding without domination</h2>
    <p>{ff.federal_funding_without_domination.problem}</p>
    <p>
      Major programs must distinguish: {fundingDist.join("; ")}.
    </p>
    <p>
      The federal government may say: <em>{ff.federal_funding_without_domination.may_say}</em>
    </p>
    <p>
      It should not automatically dictate:{" "}
      <em>{ff.federal_funding_without_domination.must_not_automatically_dictate}</em>
    </p>

    <h2>Lean federal administration</h2>
    <p>{ff.lean_federal_administration.premise}</p>
    <p>{ff.lean_federal_administration.structure}</p>
    <ol>
      {agencyQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>
    <blockquote>
      <p>{ff.lean_federal_administration.goal}</p>
    </blockquote>

    <h2>Federalism test</h2>
    <p>{ff.federalism_test.purpose}</p>
    <ol>
      {testQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>

    <h2>Website branches</h2>
    <ul>
      {branches.map((b: any) => (
        <li>
          <strong>{b.title}</strong> — {b.summary}
        </li>
      ))}
    </ul>

    <p class="muted">
      See also <a href="/constitutional-defense/">Constitutional Defense</a>,{" "}
      <a href="/equal-standing/">Equal Standing</a>, <a href="/transparency/">Transparency</a>,{" "}
      <a href="/democracy/">Democracy</a>, <a href="/assistance/">Assistance</a>, and{" "}
      <a href="/family/">Family</a>.
    </p>
  </article>
</BaseLayout>
