---
import BaseLayout from "../layouts/BaseLayout.astro";
import assembly from "../../../../data/project/stage5_pass511_whole_book_assembly.json";
import completion from "../../../../data/project/completion_ladder_and_dashboard.json";

const chapters = (assembly.chapters || []).filter((c: any) => c.n <= 10);
const intro = assembly.introduction || {};
const contract = assembly.readers_contract || {};
const book = completion.public_book || {};
---

<BaseLayout
  title="Read the Book"
  path="/book/"
  description="Read Constitutional Capitalism — Volume II. Ten chapters. One continuous argument for Arkansas households."
  bareMain={true}
>
  <section class="reader-hero" aria-labelledby="reader-title">
    <div class="reader-hero__inner">
      <p class="reader-hero__eyebrow">Volume II · Public Book · Free</p>
      <h1 id="reader-title">Constitutional Capitalism</h1>
      <p class="reader-hero__deck">
        If we make more than our parents did—and the country produces more wealth than it ever
        has—why does ordinary prosperity feel harder to reach? Chapter 1 begins in a kitchen.
      </p>
      <div class="reader-hero__actions">
        <a class="button button--primary" href="/public-book/the-arkansas-we-inherited/">
          Begin Chapter 1
        </a>
        <a class="button button--ghost" href="/public-book/introduction/">Introduction</a>
        <a class="button button--ghost" href="/public-book/readers-contract/">Reader's Contract</a>
      </div>
    </div>
  </section>

  <div class="reader-shell">
    <section class="reader-section" aria-labelledby="path-heading">
      <h2 id="path-heading">The reading path</h2>
      <p class="lede">
        Read straight through if you can. Chapters 1–10 are one argument. Use Understand / Learn /
        Prove when you want depth — those doors stay open without interrupting the story.
      </p>
      <div class="chapter-path" role="list">
        {
          chapters.map((ch: any) => (
            <a class="chapter-path__item" href={ch.href} role="listitem">
              <span class="chapter-path__n">{String(ch.n).padStart(2, "0")}</span>
              <div>
                <p class="chapter-path__title">{ch.title}</p>
                <p class="chapter-path__q">{ch.question}</p>
              </div>
              <span class="chapter-path__role">{ch.role}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="reader-section" aria-labelledby="start-heading">
      <h2 id="start-heading">Before you begin</h2>
      <div class="reader-rail">
        <a href="/public-book/introduction/">
          <strong>Introduction</strong>
          <span>Why this book, why Arkansas, why now.</span>
        </a>
        <a href="/public-book/readers-contract/">
          <strong>Reader's Contract</strong>
          <span>What we promise — and what we refuse to pretend.</span>
        </a>
        <a href="/public-book/follow-one-idea/">
          <strong>Follow One Idea</strong>
          <span>A single thread if you don't want the full arc yet.</span>
        </a>
      </div>
    </section>

    <section class="reader-section" aria-labelledby="contract-heading">
      <h2 id="contract-heading">Our contract with you</h2>
      <div class="reader-contract">
        <p class="lede" style="margin:0;">
          You do not have to agree. Our responsibility is to make the argument clear enough that you
          can decide for yourself.
        </p>
        <ol>
          {(contract.promises || []).slice(0, 4).map((p: string) => <li>{p}</li>)}
        </ol>
        <p class="muted" style="margin-top:0.85rem;">
          <a href="/public-book/readers-contract/">Full contract →</a>
        </p>
      </div>
    </section>

    <section class="reader-section" aria-labelledby="deeper-heading">
      <h2 id="deeper-heading">Go deeper when you want</h2>
      <p class="lede">
        The book is the front door. Everything else is drill-down — not a second homework assignment
        before you are allowed to read.
      </p>
      <div class="reader-rail">
        <a href="/compare/explorer/">
          <strong>Learn</strong>
          <span>Comparison Explorer — how CC sits among other systems.</span>
        </a>
        <a href="/unabridged/">
          <strong>Prove</strong>
          <span>Unabridged system + Stage 4 certification.</span>
        </a>
        <a href="/v2/">
          <strong>Build</strong>
          <span>V2 Arkansas redesign — after SEE, now redesign.</span>
        </a>
      </div>
      <p class="muted" style="margin-top:1.25rem;">
        Public Book {book.percent ?? 100}% · Technical system certified · COUNTABLE $0 · Edition
        notes also at <a href="/public-book/">/public-book/</a>
      </p>
    </section>
  </div>
</BaseLayout>
