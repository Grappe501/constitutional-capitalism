---
import BaseLayout from "../layouts/BaseLayout.astro";
import { identity } from "../lib/data";
import siteNav from "../../../../data/project/site_spine_navigation.json";
import completion from "../../../../data/project/completion_ladder_and_dashboard.json";

const spines = siteNav.spines || [];
const bars = completion.progress_bars || {};
const overall = completion.overall_project_completion?.percent ?? 0;

function chipClass(status?: string) {
  if (status === "COMPLETE") return "chip chip--done";
  if (status === "ACTIVE") return "chip chip--live";
  return "chip chip--queued";
}

function statusLabel(status?: string) {
  if (status === "COMPLETE") return "Pass complete";
  if (status === "ACTIVE") return "Building now";
  return "Queued";
}
---

<BaseLayout path="/" bareMain={true}>
  <section class="hero" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero__brand">{identity.title}</h1>
    <p class="hero__subtitle">{identity.subtitle}</p>
    <blockquote class="hero__belief">
      {identity.central_belief}
    </blockquote>
    <div class="cta-row">
      <a class="button button--primary" href="/system/">Enter the system</a>
      <a class="button button--ghost" href="/research/">Research desk</a>
      <a class="button button--ghost" href="/declaration/">Declaration</a>
    </div>
  </section>

  <div class="shell">
    <section class="section" aria-labelledby="path-title">
      <h2 id="path-title">How to read this project</h2>
      <p class="lede">
        The site is organized as five spines — not a flat list of topics. Start with foundations,
        then follow Money & Ownership → Household & Place → Government & Power → Transition &
        Measurement. Research for work-in-progress lives on the Research desk.
      </p>
    </section>

    <section class="section" aria-labelledby="dash-title">
      <h2 id="dash-title">Completion now</h2>
      <p class="muted">
        Legacy research composite ({completion.historical_metric_reconciliation?.legacy_overall_percent ?? 43}%)
        is historical only. These bars are the governing signal.
      </p>
      <div class="dash-row">
        <div class="dash-cell">
          <strong>{overall}%</strong>
          <span>Overall</span>
        </div>
        <div class="dash-cell">
          <strong>{bars.skeleton_coverage_percent ?? 0}%</strong>
          <span>Skeleton</span>
        </div>
        <div class="dash-cell">
          <strong>{bars.first_pass_coverage_percent ?? 0}%</strong>
          <span>First-pass</span>
        </div>
        <div class="dash-cell">
          <strong>{bars.publication_completion_percent ?? 0}%</strong>
          <span>Publication</span>
        </div>
        <div class="dash-cell">
          <strong>{bars.validation_completion_percent ?? 0}%</strong>
          <span>Validation</span>
        </div>
      </div>
      <p>
        <a class="button button--solid" href="/status/">Full status</a>
        <a class="button button--solid" href="/build-progress/passes/pass-5/" style="margin-left:0.5rem;">
          Stage 1 certified
        </a>
        <a class="button button--solid" href="/build-progress/" style="margin-left:0.5rem;">
          Stage 2 active
        </a>
      </p>
    </section>

    <section class="section" aria-labelledby="spines-title">
      <h2 id="spines-title">The five spines</h2>
      <div class="spine-grid">
        {
          spines.map((spine) => (
            <a class="spine-tile" href={spine.href}>
              <span class={chipClass(spine.status)}>{statusLabel(spine.status)}</span>
              <h3>{spine.title}</h3>
              <p>{spine.blurb}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section stack" aria-labelledby="def-title">
      <h2 id="def-title">Canonical definition</h2>
      <blockquote class="quote">{identity.canonical_definition}</blockquote>
      <p>
        <a href="/definition/">Definition</a> ·
        <a href="/foundational-axioms/">Axioms</a> ·
        <a href="/principles/">Principles</a> ·
        <a href="/compare/">Compare systems</a>
      </p>
    </section>

    <section class="section stack" aria-labelledby="free-title">
      <h2 id="free-title">Why the book is free</h2>
      <p class="lede">{identity.public_availability_commitment}</p>
    </section>
  </div>
</BaseLayout>
