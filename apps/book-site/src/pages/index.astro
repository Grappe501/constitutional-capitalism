---
import BaseLayout from "../layouts/BaseLayout.astro";
import { identity } from "../lib/data";
import siteNav from "../../../../data/project/site_spine_navigation.json";
import completion from "../../../../data/project/completion_ladder_and_dashboard.json";

const spines = siteNav.spines || [];
const fb = completion.foundational_build || {};
const book = completion.public_book || {};

function chipClass(status?: string) {
  if (status === "COMPLETE") return "chip chip--done";
  if (status === "ACTIVE") return "chip chip--live";
  return "chip chip--queued";
}

function statusLabel(status?: string) {
  if (status === "COMPLETE") return "Pass complete";
  if (status === "ACTIVE") return "Building now";
  return "Queued";
}
---

<BaseLayout path="/" bareMain={true}>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="home-hero__inner">
      <p class="home-hero__eyebrow">Free public book · Arkansas</p>
      <h1 id="hero-title" class="home-hero__brand">{identity.title}</h1>
      <p class="home-hero__deck">{identity.subtitle}</p>
      <p class="home-hero__belief">{identity.central_belief}</p>
      <div class="home-hero__actions">
        <a class="button button--primary" href="/book/">Read the book</a>
        <a class="button button--ghost" href="/public-book/the-arkansas-we-inherited/">
          Begin Chapter 1
        </a>
      </div>
    </div>
  </section>

  <div class="shell">
    <section class="section" aria-labelledby="path-title">
      <h2 id="path-title">Start with the argument</h2>
      <p class="lede">
        Volume II is ten chapters and one continuous case — from the Arkansas we inherited to the
        Arkansas we could leave behind. System spines, Explorer, and Unabridged stay available as
        drill-down when you want proof, not as homework before you are allowed to read.
      </p>
      <div class="reader-rail">
        <a href="/book/">
          <strong>Read</strong>
          <span>The Public Book foyer — path, contract, and Chapter 1.</span>
        </a>
        <a href="/compare/explorer/">
          <strong>Explore</strong>
          <span>Comparison Explorer — how CC sits among other systems.</span>
        </a>
        <a href="/v2/">
          <strong>Build</strong>
          <span>V2 Arkansas redesign — SEE complete, redesign underway.</span>
        </a>
      </div>
    </section>

    <section class="section" aria-labelledby="dash-title">
      <h2 id="dash-title">Where the project stands</h2>
      <p class="lede">
        <span class="chip chip--done">{fb.banner || "FOUNDATIONAL BUILD — COMPLETE"}</span>
        {" "}
        <span class="chip chip--done">Public Book {book.percent ?? 100}%</span>
      </p>
      <p class="muted">
        Architecture closed. UNDERSTAND → Public Book · LEARN → Comparison Explorer (HOLD) · PROVE →
        Unabridged · BUILD → V2 Blueprint {completion.v2_blueprint?.percent ?? 0}%.
      </p>
      <div class="dash-row">
        <div class="dash-cell">
          <strong>v1.0</strong>
          <span>Foundational — complete</span>
        </div>
        <div class="dash-cell">
          <strong>Vol. II</strong>
          <span>Public Book — certified</span>
        </div>
        <div class="dash-cell">
          <strong>0.1 HOLD</strong>
          <span>Explorer Experience</span>
        </div>
        <div class="dash-cell">
          <strong>{completion.v2_blueprint?.percent ?? 0}%</strong>
          <span>V2 Blueprint</span>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="spines-title">
      <h2 id="spines-title">Behind the book</h2>
      <p class="lede">Five system spines — for readers who want the machinery.</p>
      <div class="spine-grid">
        {
          spines.map((spine) => (
            <a class="spine-tile" href={spine.href}>
              <span class={chipClass(spine.status)}>{statusLabel(spine.status)}</span>
              <h3>{spine.title}</h3>
              <p>{spine.blurb}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section stack" aria-labelledby="def-title">
      <h2 id="def-title">Canonical definition</h2>
      <blockquote class="quote">{identity.canonical_definition}</blockquote>
      <p>
        <a href="/definition/">Definition</a> ·
        <a href="/foundational-axioms/">Axioms</a> ·
        <a href="/principles/">Principles</a> ·
        <a href="/compare/">Compare systems</a>
      </p>
    </section>

    <section class="section stack" aria-labelledby="free-title">
      <h2 id="free-title">Why the book is free</h2>
      <p class="lede">{identity.public_availability_commitment}</p>
    </section>
  </div>
</BaseLayout>
