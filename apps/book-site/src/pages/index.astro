---
import BaseLayout from "../layouts/BaseLayout.astro";
import { identity, snapshot } from "../lib/data";
---

<BaseLayout path="/">
  <section class="hero" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero__brand">{identity.title}</h1>
    <p class="hero__subtitle">{identity.subtitle}</p>
    <blockquote class="hero__belief">
      {identity.central_belief}
    </blockquote>
    <div class="cta-row">
      <a class="button button--primary" href="/declaration/">Read the Declaration</a>
      <a class="button button--ghost" href="/definition/">Definition</a>
      <a class="button button--ghost" href="/principles/">Principles</a>
    </div>
  </section>

  <section class="section" aria-labelledby="def-title">
    <h2 id="def-title">Canonical definition</h2>
    <blockquote class="quote">{identity.canonical_definition}</blockquote>
  </section>

  <section class="section stack" aria-labelledby="preserve-title">
    <h2 id="preserve-title">What the system preserves</h2>
    <p class="lede">
      Private property, free enterprise, entrepreneurship, lawful profit, voluntary exchange,
      innovation, investment, competition, limited government, and the rule of law.
    </p>
  </section>

  <section class="section stack" aria-labelledby="change-title">
    <h2 id="change-title">What the system changes</h2>
    <p class="lede">
      It requires constitutional accountability for economic power; broad ownership pathways;
      protected competition; fairer treatment of ordinary work; and recognition that communities and
      technological inheritance are part of national prosperity.
    </p>
  </section>

  <section class="section stack" aria-labelledby="new-title">
    <h2 id="new-title">Why this framework is new</h2>
    <p class="lede">
      Constitutional Capitalism refuses two failures: unaccountable private power and unaccountable
      state power. It keeps markets and ownership while insisting that public-scale economic power
      remain transparent, rivalrous, and accountable to a free people.
      <a href="/compare/">Compare systems →</a>
    </p>
  </section>

  <section class="section stack" aria-labelledby="free-title">
    <h2 id="free-title">Why the book is free</h2>
    <p class="lede">{identity.public_availability_commitment}</p>
  </section>

  <section class="section stack" aria-labelledby="status-title">
    <h2 id="status-title">Current project status</h2>
    <p class="status-note">
      Living project underway — Declaration drafted; civilizational architecture proposed; evidence
      and baseline work next
    </p>
    <p class="lede">
      Overall progress estimate: <strong>{snapshot.overall_percent ?? 0}%</strong>. The Declaration
      and principles form the philosophical spine. The longer work is a living constitutional
      philosophy — not a finished book alone. Source verification, modeling, and legal review remain
      early-stage.
    </p>
    <p>
      <a class="button button--solid" href="/status/">View public status</a>
      <a class="button button--solid" href="/declaration/" style="margin-left:0.5rem;">Open Declaration</a>
    </p>
  </section>
</BaseLayout>
