---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CompletionLadderViz from "../../components/CompletionLadderViz.astro";
import registry from "../../../../../data/project/build_progress_registry.json";
import completion from "../../../../../data/project/completion_ladder_and_dashboard.json";
import publishing from "../../../../../data/project/publishing_architecture_two_volumes.json";

const bars = completion.progress_bars || {};
const overall = completion.overall_project_completion?.percent ?? 0;
const stages = completion.stages || [];
const passes = registry.passes || [];
const stage2Passes = registry.stage2_passes || [];

function chipClass(status?: string) {
  if (status === "COMPLETE") return "chip chip--done";
  if (status === "ACTIVE") return "chip chip--live";
  return "chip chip--queued";
}

function statusLabel(status?: string) {
  if (status === "COMPLETE") return "Complete";
  if (status === "ACTIVE") return "Building now";
  return "Queued";
}
---

<BaseLayout
  title="Build Progress"
  path="/build-progress/"
  description="Completion ladder, Stage 2 passes, and permanent What Changed changelogs."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--live">Stage 2 active</span>
      <h1>Build Progress</h1>
      <p class="lede">
        Stage 1 skeleton is complete. Stage 2 builds working models — every pass ships intellect
        <strong>and</strong> visual assets, with a BEFORE → AFTER scoreboard you can feel.
      </p>
    </header>

    <section class="hub-section" aria-labelledby="bars">
      <h2 id="bars">Completion ladder</h2>
      <CompletionLadderViz
        overall={overall}
        skeleton={bars.skeleton_coverage_percent ?? 0}
        firstPass={bars.first_pass_coverage_percent ?? 0}
        publication={bars.publication_completion_percent ?? 0}
        validation={bars.validation_completion_percent ?? 0}
        caption="Stage 1 = 100% skeleton. Stage 2 first-pass coverage is the governing dial (12% → 100%)."
      />
      <p class="muted">
        Current stage: <strong>{registry.current_stage}</strong>
        {registry.current_pass && (
          <>
            {" "}
            · Current pass: <strong>{registry.current_pass}</strong>
          </>
        )}
      </p>
      <p>
        <a href="/status/">Full status dials →</a>
        {" · "}
        <a href="/system/money-engine/">Money Engine →</a>
        {" · "}
        <a href="/build-progress/passes/pass-2-1/">Pass 2.1 What Changed →</a>
      </p>
    </section>

    <section class="hub-section" aria-labelledby="next">
      <h2 id="next">Next objective</h2>
      <p class="lede">{registry.next_objective}</p>
      <ul class="link-board">
        <li><a href="/system/household-engine/">Household Prosperity Engine (Pass 2.2 complete)</a></li>
        <li><a href="/build-progress/passes/pass-2-2/">Pass 2.2 BEFORE → AFTER</a></li>
        <li><a href="/system/money-engine/">Money Engine join</a></li>
        <li><a href="/build-progress/passes/pass-5/">Stage 1 certification</a></li>
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="stage2">
      <h2 id="stage2">Stage 2 passes</h2>
      <div class="spine-grid">
        {
          stage2Passes.map((p: any) => (
            <a class="spine-tile" href={p.href}>
              <span class={chipClass(p.status)}>{statusLabel(p.status)}</span>
              <h3>Pass {p.number}</h3>
              <p>{p.name}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="hub-section" aria-labelledby="passes">
      <h2 id="passes">Stage 1 passes (complete)</h2>
      <div class="spine-grid">
        {
          passes.map((p) => (
            <a class="spine-tile" href={p.href}>
              <span class={chipClass(p.status)}>{statusLabel(p.status)}</span>
              <h3>Pass {p.number}</h3>
              <p>{p.name}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="hub-section" aria-labelledby="stages">
      <h2 id="stages">Stages (refined)</h2>
      <ul class="stack">
        {
          stages.map((s: any) => (
            <li>
              <strong>{s.id.replace("_", " ")}</strong> — {s.name}
              <div class="muted">{s.target}</div>
            </li>
          ))
        }
      </ul>
      <p class="muted">
        Volume I = Unabridged source of truth. Volume II ≈ 100-page public book after validation.
        Roadmap: {(publishing.arkansas_development_program_roadmap?.sequence || []).join(" → ")}.
      </p>
    </section>

    <section class="hub-section" aria-labelledby="infra">
      <h2 id="infra">Infrastructure checkpoints</h2>
      <ul class="stack">
        {
          (registry.infrastructure_checkpoints || []).map((c: any) => (
            <li>
              <strong>{c.id}</strong> — {c.title}
              <div class="muted">{c.date}</div>
              <ul class="link-board" style="margin-top:0.75rem;">
                {(c.links || []).map((link: any) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
