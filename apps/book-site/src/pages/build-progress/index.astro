---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CompletionLadderViz from "../../components/CompletionLadderViz.astro";
import registry from "../../../../../data/project/build_progress_registry.json";
import completion from "../../../../../data/project/completion_ladder_and_dashboard.json";
import publishing from "../../../../../data/project/publishing_architecture_two_volumes.json";

const bars = completion.progress_bars || {};
const overall = completion.overall_project_completion?.percent ?? 0;
const stages = completion.stages || [];
const passes = registry.passes || [];
const stage2Passes = registry.stage2_passes || [];
const stage3Passes = registry.stage3_passes || [];
const stage4Passes = registry.stage4_passes || [];
const categoryBars = completion.stage3_category_bars || [];
const stage4Bars = completion.stage4_category_bars || [];
const unabridged =
  bars.unabridged_completion_percent ?? bars.publication_completion_percent ?? 0;

function chipClass(status?: string) {
  if (status === "COMPLETE") return "chip chip--done";
  if (status === "ACTIVE" || status === "NEXT") return "chip chip--live";
  return "chip chip--queued";
}

function statusLabel(status?: string) {
  if (status === "COMPLETE") return "Complete";
  if (status === "ACTIVE" || status === "NEXT") return "Building now";
  return "Queued";
}
---

<BaseLayout
  title="Build Progress"
  path="/build-progress/"
  description="Completion ladder, Stage 3 unabridged categories, and permanent What Changed changelogs."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">FOUNDATIONAL BUILD — COMPLETE</span>
      <h1>Build Progress</h1>
      <p class="lede">
        Foundational System v1.0 is frozen. Explorer Experience 0.1 is on HOLD. V2 BLUEPRINT is a
        separate dial — 0% → 100% by resolved objects.
      </p>
    </header>

    <section class="hub-section" aria-labelledby="triad">
      <h2 id="triad">Three permanent indicators</h2>
      <ul class="link-board">
        <li>
          <span class="chip chip--done">COMPLETE</span>{" "}
          <strong>FOUNDATIONAL SYSTEM v1.0</strong> — frozen
        </li>
        <li>
          <span class="chip chip--queued">HOLD</span>{" "}
          <strong>{completion.comparison_explorer_lane?.label || "EXPLORER EXPERIENCE — 0.1 HOLD"}</strong>
          {" · "}
          <a href="/compare/explorer/">Open →</a>
        </li>
        <li>
          <span class="chip chip--live">BLUEPRINT</span>{" "}
          <strong>{completion.v2_blueprint?.label || "V2 BLUEPRINT"}</strong> —{" "}
          {completion.v2_blueprint?.percent ?? 0}% → 100%
          {" · "}
          <a href="/v2/">Master Build Plan →</a>
          <div class="muted">{completion.v2_blueprint?.note}</div>
        </li>
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="split">
      <h2 id="split">Certified foundational scoreboard</h2>
      <ul class="link-board">
        <li>
          <span class="chip chip--done">CERTIFIED</span>{" "}
          <strong>{completion.technical_system?.label || "TECHNICAL SYSTEM"}</strong> —{" "}
          {completion.technical_system?.percent ?? 100}%
        </li>
        <li>
          <span class="chip chip--done">CERTIFIED</span>{" "}
          <strong>{completion.public_book?.label || "PUBLIC BOOK"}</strong> —{" "}
          {completion.public_book?.percent ?? 100}% ({completion.public_book?.chapters_complete ?? 11}/
          {completion.public_book?.chapters_total ?? 11})
        </li>
      </ul>
      <p class="muted">
        <a href="/public-book/">Public Book hub →</a>
        {" · "}
        <a href="/v2/decisions/">V2 Decision Register →</a>
      </p>
    </section>

    <section class="hub-section" aria-labelledby="bars">
      <h2 id="bars">Technical completion ladder (certified)</h2>
      <CompletionLadderViz
        overall={overall}
        skeleton={bars.skeleton_coverage_percent ?? 0}
        firstPass={bars.first_pass_coverage_percent ?? 0}
        publication={unabridged}
        validation={bars.validation_completion_percent ?? 0}
        caption="Technical System 100% CERTIFIED. Public Book is measured separately below."
      />
      <p class="muted">
        Current stage: <strong>{registry.current_stage}</strong>
        {registry.current_pass && (
          <>
            {" "}
            · Next pass: <strong>{registry.current_pass}</strong>
          </>
        )}
      </p>
    </section>

    <section class="hub-section" aria-labelledby="s5">
      <h2 id="s5">Stage 5 — Public Book chapters</h2>
      <div class="progress-list">
        {(completion.stage5_category_bars || []).map((c: any) => (
          <div class="progress-item">
            <label>
              <span>
                {c.surface && c.status === "COMPLETE" ? (
                  <a href={c.surface}>{c.label}</a>
                ) : c.href && c.status === "COMPLETE" ? (
                  <a href={c.href}>{c.label}</a>
                ) : (
                  c.label
                )}
              </span>
              <span aria-hidden="true">{c.percent}%</span>
            </label>
            <div
              class="bar"
              role="progressbar"
              aria-label={`${c.label} progress`}
              aria-valuemin={0}
              aria-valuemax={100}
              aria-valuenow={c.percent}
            >
              <span style={`width:${c.percent}%`} />
            </div>
          </div>
        ))}
      </div>
      <ul class="link-board">
        {(registry.stage5_passes || []).map((p: any) => (
          <li>
            <span class={chipClass(p.status)}>{statusLabel(p.status)}</span>{" "}
            {p.status === "COMPLETE" ? <a href={p.href}>{p.number} {p.name}</a> : `${p.number} ${p.name}`}
            {p.spine_href ? (
              <>
                {" "}
                · <a href={p.spine_href}>Read chapter →</a>
              </>
            ) : null}
          </li>
        ))}
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="s4">
      <h2 id="s4">Stage 4 attack passes (certified)</h2>
      <div class="progress-list">
        {stage4Bars.map((c: any) => (
          <div class="progress-item">
            <label>
              <span>
                {c.href && c.status === "COMPLETE" ? (
                  <a href={c.href}>{c.label}</a>
                ) : (
                  c.label
                )}
              </span>
              <span aria-hidden="true">{c.percent}%</span>
            </label>
            <div
              class="bar"
              role="progressbar"
              aria-label={`${c.label} progress`}
              aria-valuemin={0}
              aria-valuemax={100}
              aria-valuenow={c.percent}
            >
              <span style={`width:${c.percent}%`} />
            </div>
          </div>
        ))}
      </div>
      <ul class="link-board">
        {stage4Passes.map((p: any) => (
          <li>
            <span class={chipClass(p.status)}>{statusLabel(p.status)}</span>{" "}
            {p.status === "COMPLETE" ? (
              <a href={p.href}>
                Pass {p.number} — {p.name}
              </a>
            ) : (
              <>
                Pass {p.number} — {p.name}
              </>
            )}
          </li>
        ))}
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="cats">
      <h2 id="cats">Stage 3 category bars (frozen)</h2>
      <div class="progress-list">
        {categoryBars.map((c: any) => (
          <div class="progress-item">
            <label>
              <span>
                {c.href && c.status === "COMPLETE" ? (
                  <a href={c.href}>{c.label}</a>
                ) : (
                  c.label
                )}
              </span>
              <span aria-hidden="true">{c.percent}%</span>
            </label>
            <div
              class="bar"
              role="progressbar"
              aria-label={`${c.label} progress`}
              aria-valuemin={0}
              aria-valuemax={100}
              aria-valuenow={c.percent}
            >
              <span style={`width:${c.percent}%`} />
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="hub-section" aria-labelledby="next">
      <h2 id="next">Next objective</h2>
      <p class="lede">{registry.next_objective}</p>
      <ul class="link-board">
        <li><a href="/system/arkansas-state-baseline/">Arkansas NOW / State X-Ray</a></li>
        <li><a href="/build-progress/passes/pass-3-1/">Pass 3.1 What Changed</a></li>
        <li><a href="/system/master-map/">Master System Map</a></li>
        <li><a href="/build-progress/passes/pass-2-6/">Stage 2 certification</a></li>
      </ul>
    </section>

    <section class="hub-section" aria-labelledby="stage3">
      <h2 id="stage3">Stage 3 passes</h2>
      <div class="spine-grid">
        {
          stage3Passes.map((p: any) => (
            <a class="spine-tile" href={p.href}>
              <span class={chipClass(p.status)}>{statusLabel(p.status)}</span>
              <h3>Pass {p.number}</h3>
              <p>{p.name}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="hub-section" aria-labelledby="stage2">
      <h2 id="stage2">Stage 2 passes (complete)</h2>
      <div class="spine-grid">
        {
          stage2Passes.map((p: any) => (
            <a class="spine-tile" href={p.href}>
              <span class={chipClass(p.status)}>{statusLabel(p.status)}</span>
              <h3>Pass {p.number}</h3>
              <p>{p.name}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="hub-section" aria-labelledby="passes">
      <h2 id="passes">Stage 1 passes (complete)</h2>
      <div class="spine-grid">
        {
          passes.map((p) => (
            <a class="spine-tile" href={p.href}>
              <span class={chipClass(p.status)}>{statusLabel(p.status)}</span>
              <h3>Pass {p.number}</h3>
              <p>{p.name}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="hub-section" aria-labelledby="stages">
      <h2 id="stages">Stages</h2>
      <ul class="stack">
        {
          stages.map((s: any) => (
            <li>
              <strong>{s.id.replace("_", " ")}</strong> — {s.name}
              <div class="muted">{s.target}</div>
              <span class={chipClass(s.status)}>{s.status}</span>
            </li>
          ))
        }
      </ul>
      <p class="muted">
        Two volumes: {publishing.volumes?.[0]?.name || "Unabridged"} ·{" "}
        {publishing.volumes?.[1]?.name || "Public Book"}
      </p>
    </section>
  </article>
</BaseLayout>
