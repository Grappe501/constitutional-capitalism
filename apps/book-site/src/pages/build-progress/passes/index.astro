---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import registry from "../../../../../../data/project/build_progress_registry.json";

const passes = registry.passes || [];
const stage2Passes = registry.stage2_passes || [];

function chipClass(status?: string) {
  if (status === "COMPLETE") return "chip chip--done";
  if (status === "ACTIVE") return "chip chip--live";
  return "chip chip--queued";
}

function statusLabel(status?: string) {
  if (status === "COMPLETE") return "Complete";
  if (status === "ACTIVE") return "Building now";
  return "Queued";
}
---

<BaseLayout
  title="Passes"
  path="/build-progress/passes/"
  description="What Changed snapshots for Stage 1 and Stage 2 passes."
>
  <article>
    <header class="hub-banner">
      <p class="muted"><a href="/build-progress/">← Build Progress</a></p>
      <h1>Passes</h1>
      <p class="lede">
        Each pass page is a permanent snapshot: decisions, BEFORE → AFTER, modules, sources,
        deferred items, GitHub commit, and deployment date.
      </p>
    </header>

    <section class="hub-section">
      <h2>Stage 2</h2>
      <ul class="link-board">
        {
          stage2Passes.map((p: any) => (
            <li>
              <a href={p.href}>
                <span class={chipClass(p.status)}>{statusLabel(p.status)}</span>
                {" "}Pass {p.number} — {p.name}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Stage 1</h2>
      <ul class="link-board">
        {
          passes.map((p) => (
            <li>
              <a href={p.href}>
                <span class={chipClass(p.status)}>{statusLabel(p.status)}</span>
                {" "}Pass {p.number} — {p.name}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
