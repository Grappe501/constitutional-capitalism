---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import registry from "../../../../../../data/project/build_progress_registry.json";
import pass1 from "../../../../../../data/project/pass_changelogs/pass_01.json";
import pass2 from "../../../../../../data/project/pass_changelogs/pass_02.json";
import pass3 from "../../../../../../data/project/pass_changelogs/pass_03.json";
import pass4 from "../../../../../../data/project/pass_changelogs/pass_04.json";
import pass5 from "../../../../../../data/project/pass_changelogs/pass_05.json";
import pass21 from "../../../../../../data/project/pass_changelogs/pass_2_1.json";
import pass22 from "../../../../../../data/project/pass_changelogs/pass_2_2.json";
import pass23 from "../../../../../../data/project/pass_changelogs/pass_2_3.json";
import pass24 from "../../../../../../data/project/pass_changelogs/pass_2_4.json";
import pass25 from "../../../../../../data/project/pass_changelogs/pass_2_5.json";
import pass26 from "../../../../../../data/project/pass_changelogs/pass_2_6.json";
import pass31 from "../../../../../../data/project/pass_changelogs/pass_3_1.json";
import pass32 from "../../../../../../data/project/pass_changelogs/pass_3_2.json";
import pass33 from "../../../../../../data/project/pass_changelogs/pass_3_3.json";
import pass34 from "../../../../../../data/project/pass_changelogs/pass_3_4.json";
import pass35 from "../../../../../../data/project/pass_changelogs/pass_3_5.json";
import pass36 from "../../../../../../data/project/pass_changelogs/pass_3_6.json";
import pass37 from "../../../../../../data/project/pass_changelogs/pass_3_7.json";
import pass38 from "../../../../../../data/project/pass_changelogs/pass_3_8.json";
import pass41 from "../../../../../../data/project/pass_changelogs/pass_4_1.json";
import pass42 from "../../../../../../data/project/pass_changelogs/pass_4_2.json";
import pass43 from "../../../../../../data/project/pass_changelogs/pass_4_3.json";
import pass44 from "../../../../../../data/project/pass_changelogs/pass_4_4.json";
import pass45 from "../../../../../../data/project/pass_changelogs/pass_4_5.json";
import pass46 from "../../../../../../data/project/pass_changelogs/pass_4_6.json";
import pass51 from "../../../../../../data/project/pass_changelogs/pass_5_1.json";
import audit from "../../../../../../data/project/stage1_pass5_whole_system_closure_audit.json";
import stage2Audit from "../../../../../../data/project/stage2_pass26_whole_system_integration_audit.json";

export function getStaticPaths() {
  return [
    { params: { pass: "pass-1" } },
    { params: { pass: "pass-2" } },
    { params: { pass: "pass-3" } },
    { params: { pass: "pass-4" } },
    { params: { pass: "pass-5" } },
    { params: { pass: "pass-2-1" } },
    { params: { pass: "pass-2-2" } },
    { params: { pass: "pass-2-3" } },
    { params: { pass: "pass-2-4" } },
    { params: { pass: "pass-2-5" } },
    { params: { pass: "pass-2-6" } },
    { params: { pass: "pass-3-1" } },
    { params: { pass: "pass-3-2" } },
    { params: { pass: "pass-3-3" } },
    { params: { pass: "pass-3-4" } },
    { params: { pass: "pass-3-5" } },
    { params: { pass: "pass-3-6" } },
    { params: { pass: "pass-3-7" } },
    { params: { pass: "pass-3-8" } },
    { params: { pass: "pass-4-1" } },
    { params: { pass: "pass-4-2" } },
    { params: { pass: "pass-4-3" } },
    { params: { pass: "pass-4-4" } },
    { params: { pass: "pass-4-5" } },
    { params: { pass: "pass-4-6" } },
    { params: { pass: "pass-5-1" } },
  ];
}

const { pass: passSlug } = Astro.params;
const meta = (registry.passes || []).find((p: any) => p.slug === passSlug)
  || (registry.stage2_passes || []).find((p: any) => p.slug === passSlug)
  || (registry.stage3_passes || []).find((p: any) => p.slug === passSlug)
  || (registry.stage4_passes || []).find((p: any) => p.slug === passSlug)
  || (registry.stage5_passes || []).find((p: any) => p.slug === passSlug);
const changelogs: Record<string, any> = {
  "pass-1": pass1,
  "pass-2": pass2,
  "pass-3": pass3,
  "pass-4": pass4,
  "pass-5": pass5,
  "pass-2-1": pass21,
  "pass-2-2": pass22,
  "pass-2-3": pass23,
  "pass-2-4": pass24,
  "pass-2-5": pass25,
  "pass-2-6": pass26,
  "pass-3-1": pass31,
  "pass-3-2": pass32,
  "pass-3-3": pass33,
  "pass-3-4": pass34,
  "pass-3-5": pass35,
  "pass-3-6": pass36,
  "pass-3-7": pass37,
  "pass-3-8": pass38,
  "pass-4-1": pass41,
  "pass-4-2": pass42,
  "pass-4-3": pass43,
  "pass-4-4": pass44,
  "pass-4-5": pass45,
  "pass-4-6": pass46,
  "pass-5-1": pass51,
};
const log = changelogs[passSlug || ""] || null;
const isCert = passSlug === "pass-5" && log?.is_stage_1_certification_record;
const isStage2Cert = passSlug === "pass-2-6" && log?.is_stage_2_certification_record;
const isStage2 = Boolean(log?.is_stage_2_pass);
const isStage3 = Boolean(log?.is_stage_3_pass);
const isStage4 = Boolean(log?.is_stage_4_pass);
const isStage5 = Boolean(log?.is_stage_5_pass);
const functions = audit.function_matrix || [];
const architecture = audit.complete_system_architecture_map || {};
const osAudit = audit.five_os_final_audit || {};
const moneyFlow = audit.money_flow_continuity || {};
const timeCont = audit.time_continuity || {};
const cert = audit.stage_1_certification || {};
const stage2Cert = stage2Audit.stage_2_certification || {};
const deferred = audit.deferred_register || [];
const holesClosed = audit.holes_discovered_and_closed || [];

function chipClass(status?: string) {
  if (status === "COMPLETE") return "chip chip--done";
  if (status === "ACTIVE") return "chip chip--live";
  return "chip chip--queued";
}

function statusLabel(status?: string) {
  if (status === "COMPLETE") return "Pass complete";
  if (status === "ACTIVE") return "In progress";
  return "Queued";
}

function dispositionClass(d?: string) {
  if (d === "CLOSED") return "chip chip--done";
  if (d === "HOLE") return "chip chip--live";
  return "chip chip--queued";
}

const title = isCert
  ? "Stage 1 Certification — Pass 5 Closure Audit"
  : isStage2Cert
  ? "Stage 2 Certification — Pass 2.6 Integration Audit"
  : meta
    ? `Pass ${meta.number} — ${meta.name}`
    : "Pass";
const path = `/build-progress/passes/${passSlug}/`;
---

<BaseLayout
  title={title}
  path={path}
  description={log?.summary || `Stage pass ${title} changelog.`}
>
  <article>
    <header class="hub-banner">
      <p class="muted">
        <a href="/build-progress/">Build Progress</a> →
        <a href="/build-progress/passes/">Passes</a> → Pass {meta?.number}
      </p>
      <span class={chipClass(meta?.status || log?.status)}>{statusLabel(meta?.status || log?.status)}</span>
      {
        isCert ? (
          <>
            <h1>Stage 1 certification record</h1>
            <p class="lede">Pass 5 — Whole-System Closure Audit</p>
          </>
        ) : isStage2Cert ? (
          <>
            <h1>Stage 2 certification record</h1>
            <p class="lede">Pass 2.6 — Whole-System Integration & Closure Audit</p>
          </>
        ) : (
          <>
            <h1>What Changed — Pass {meta?.number}</h1>
            <p class="lede">{meta?.name || log?.pass_name}</p>
          </>
        )
      }
    </header>

    {
      !log ? (
        <section class="hub-section">
          <p class="lede">This pass has not started.</p>
        </section>
      ) : (
        <>
          {isCert && cert.certified && (
            <section class="hub-section" aria-labelledby="certification">
              <h2 id="certification">Final Stage 1 certification</h2>
              <p class="lede">{cert.statement}</p>
              <div class="dash-row">
                <div class="dash-cell"><strong>{cert.skeleton_percent}%</strong><span>Skeleton</span></div>
                <div class="dash-cell"><strong>COMPLETE</strong><span>Stage 1</span></div>
                <div class="dash-cell"><strong>0</strong><span>Open holes</span></div>
                <div class="dash-cell"><strong>FROZEN</strong><span>Horizontal expansion</span></div>
              </div>
            </section>
          )}

          {isStage2Cert && stage2Cert.certified && (
            <section class="hub-section" aria-labelledby="stage2-certification">
              <h2 id="stage2-certification">Final Stage 2 certification</h2>
              <p class="lede">{stage2Cert.achievement}</p>
              <div class="dash-row">
                <div class="dash-cell"><strong>100%</strong><span>Skeleton</span></div>
                <div class="dash-cell"><strong>100%</strong><span>First-Pass</span></div>
                <div class="dash-cell"><strong>50/50</strong><span>Modules</span></div>
                <div class="dash-cell"><strong>COMPLETE</strong><span>Stage 2</span></div>
              </div>
              <p class="muted">
                Next: {stage2Cert.next_stage} — {stage2Cert.next_discipline}
              </p>
              <p>
                <a href="/system/master-map/">Open Master System Map →</a>
              </p>
            </section>
          )}

          <section class="hub-section" aria-labelledby="summary">
            <h2 id="summary">Summary</h2>
            <p class="lede">{log.summary}</p>
            <p class="muted">
              Decisions: {(log.decision_ids || []).join(", ") || "—"} · Updates:{" "}
              {(log.update_ids || []).join(", ") || "—"}
            </p>
            <p class="muted">
              Deployment date: <strong>{log.deployment_date || "—"}</strong>
              {log.github_commit && (
                <>
                  {" "}· Commit:{" "}
                  <a href={log.github_commit_url || "#"} rel="noopener noreferrer">
                    <code>{log.github_commit}</code>
                  </a>
                </>
              )}
            </p>
          </section>

          {(isStage2 || isStage3 || isStage4 || isStage5) && log.before_after && (
            <section class="hub-section" aria-labelledby="before-after">
              <h2 id="before-after">BEFORE → AFTER</h2>
              <div class="before-after">
                {log.before_after.map((row: any) => (
                  <div class="before-after__row">
                    <span>{row.label}</span>
                    <strong>
                      {row.before} → {row.after}
                    </strong>
                  </div>
                ))}
              </div>
              {log.experience_links && (
                <ul class="link-board" style="margin-top:1rem;">
                  {log.experience_links.map((l: any) => (
                    <li>
                      <a href={l.href}>{l.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          )}

          <section class="hub-section" aria-labelledby="progress">
            <h2 id="progress">Progress movement</h2>
            <p>{log.progress_movement}</p>
            {log.progress_after && (
              <div class="dash-row">
                <div class="dash-cell">
                  <strong>{log.progress_after.overall_project_completion_percent ?? "—"}%</strong>
                  <span>Overall</span>
                </div>
                <div class="dash-cell">
                  <strong>{log.progress_after.skeleton_coverage_percent ?? "—"}%</strong>
                  <span>Skeleton</span>
                </div>
                <div class="dash-cell">
                  <strong>{log.progress_after.first_pass_coverage_percent ?? "—"}%</strong>
                  <span>First-pass</span>
                </div>
                <div class="dash-cell">
                  <strong>{log.progress_after.unabridged_completion_percent ?? log.progress_after.publication_completion_percent ?? "—"}%</strong>
                  <span>Unabridged</span>
                </div>
                <div class="dash-cell">
                  <strong>{log.progress_after.validation_completion_percent ?? "—"}%</strong>
                  <span>Validation</span>
                </div>
              </div>
            )}
          </section>

          {isCert && (
            <>
              <section class="hub-section" aria-labelledby="architecture">
                <h2 id="architecture">Complete system architecture map</h2>
                <p class="lede">{architecture.one_sentence}</p>
                <ul class="stack">
                  {(architecture.spines || []).map((s: any) => (
                    <li>
                      <a href={s.href}><strong>{s.title}</strong></a>
                      <span class="muted"> — {(s.locks || []).join(", ")}</span>
                    </li>
                  ))}
                </ul>
              </section>
              <section class="hub-section" aria-labelledby="functions">
                <h2 id="functions">Twenty-function closure matrix</h2>
                <ul class="stack">
                  {functions.map((f: any) => (
                    <li>
                      <span class={dispositionClass(f.disposition)}>{f.disposition}</span>{" "}
                      <strong>{f.id} — {f.function}</strong>
                      <div class="muted">{f.closure_question}</div>
                      <ul class="link-board" style="margin-top:0.5rem;">
                        {(f.hrefs || []).slice(0, 4).map((h: string) => (
                          <li><a href={h}>{h}</a></li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ul>
              </section>
              <section class="hub-section" aria-labelledby="holes">
                <h2 id="holes">Holes discovered and closed</h2>
                {holesClosed.length === 0 ? (
                  <p class="lede">None. No true structural holes were found during Pass 5.</p>
                ) : null}
              </section>
              <section class="hub-section" aria-labelledby="os">
                <h2 id="os">Five OS questions — final crosscut</h2>
                <ul class="stack">
                  <li><strong>Who owns it?</strong><div class="muted">{osAudit.ownership}</div></li>
                  <li><strong>How is capital formed?</strong><div class="muted">{osAudit.capital_formation}</div></li>
                  <li><strong>How is the market designed?</strong><div class="muted">{osAudit.market_design}</div></li>
                  <li><strong>What happens to the household?</strong><div class="muted">{osAudit.household_economics}</div></li>
                  <li><strong>Where does power accumulate?</strong><div class="muted">{osAudit.power}</div></li>
                </ul>
              </section>
              <section class="hub-section" aria-labelledby="money">
                <h2 id="money">Money-flow continuity</h2>
                <p><span class="chip chip--done">{moneyFlow.result}</span></p>
                <p class="lede">{moneyFlow.statement}</p>
              </section>
              <section class="hub-section" aria-labelledby="time">
                <h2 id="time">Time continuity</h2>
                <p><span class="chip chip--done">{timeCont.result}</span></p>
                <p class="lede">{timeCont.statement}</p>
              </section>
            </>
          )}

          <section class="hub-section" aria-labelledby="modules">
            <h2 id="modules">Modules added or modified</h2>
            <ul class="stack">
              {(log.modules_added_or_modified || []).map((m: any) => (
                <li>
                  <strong>{m.label}</strong>
                  <span class="muted"> — {m.change}</span>
                  {m.href && <div><a href={m.href}>Open on site →</a></div>}
                  {m.path && <div class="muted"><code>{m.path}</code></div>}
                </li>
              ))}
            </ul>
          </section>

          <section class="hub-section" aria-labelledby="sources">
            <h2 id="sources">Source documents</h2>
            <ul class="stack">
              {(log.source_documents || []).map((s: any) => (
                <li>
                  <strong>{s.label}</strong>
                  {s.path && <div class="muted"><code>{s.path}</code></div>}
                </li>
              ))}
            </ul>
          </section>

          <section class="hub-section" aria-labelledby="deferred">
            <h2 id="deferred">{isCert ? "Deferred items by destination stage" : "Unresolved / deferred"}</h2>
            <ul class="stack">
              {(isCert ? deferred : log.unresolved_deferred || []).map((u: any) => (
                <li>
                  <strong>{u.item}</strong>
                  <div class="muted">
                    {u.disposition}
                    {u.defer_to ? ` → ${u.defer_to}` : ""}
                    {u.home ? ` · Home: ${u.home}` : ""}
                  </div>
                </li>
              ))}
            </ul>
          </section>

          {log.next_pass_only && (
            <section class="hub-section" aria-labelledby="next">
              <h2 id="next">Next</h2>
              <p class="lede">{log.next_pass_only}</p>
            </section>
          )}
        </>
      )
    }
  </article>
</BaseLayout>
