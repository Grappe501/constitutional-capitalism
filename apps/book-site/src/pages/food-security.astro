---
import BaseLayout from "../layouts/BaseLayout.astro";
import food from "../../../../data/project/community_food_security_framework.json";

const testQs = food.community_food_security_test?.questions || [];
const branches = food.website_branches || [];
const valueChain = food.keep_value_local?.value_chain_example || [];
const indicators = food.community_food_dashboard?.candidate_indicators || [];
---

<BaseLayout
  title="Community Food Security System"
  path="/food-security/"
  description="Food as critical infrastructure — local capacity plus broader markets for resilience and opportunity."
>
  <article class="prose">
    <h1>{food.domain_title}</h1>

    <p class="lede">{food.role_in_philosophy}</p>

    <h2>Central principle</h2>
    <blockquote>
      <p>{food.central_principle.text}</p>
    </blockquote>

    <h2>What this rejects</h2>
    <p>
      Rejected principle: <em>“{food.rejected_principle.text}”</em>
    </p>
    <p>{food.rejected_principle.reason}</p>

    <h2>Governing doctrine</h2>
    <blockquote>
      <p>{food.governing_doctrine.text}</p>
    </blockquote>

    <h2>Food as critical infrastructure</h2>
    <p>{food.food_as_critical_infrastructure.summary}</p>
    

    <h2>Local First, Export Second</h2>
    <blockquote>
      <p>{food.local_first_export_second.text}</p>
    </blockquote>
    <p>
      This is not {food.local_first_export_second.not.toLowerCase()}. It is{" "}
      {food.local_first_export_second.is.toLowerCase()}.
    </p>

    <h2>Regional Food Network</h2>
    
    <p>{food.regional_food_network.summary}</p>
    
    <ul>
      {food.regional_food_network.each_district_includes.map((item: string) => (
        <li>{item}</li>
      ))}
    </ul>

    <h2>State Food Exchange</h2>
    
    <p>{food.state_food_exchange.summary}</p>

    <h2>Keep value local</h2>
    <p>{food.keep_value_local.summary}</p>
    <ol>
      {valueChain.map((step: string) => (
        <li>{step}</li>
      ))}
    </ol>

    <h2>Fresh Food Networks</h2>
    <p>{food.fresh_food_networks.summary}</p>

    <h2>Reduce food waste</h2>
    <p>{food.reduce_food_waste.summary}</p>
    

    <h2>Community Food Reserves</h2>
    
    <p>{food.community_food_reserves.summary}</p>

    <h2>Regenerative agriculture</h2>
    <p>{food.regenerative_agriculture_link.summary}</p>
    <p>
      See also <a href="/resource-sovereignty/">Resource Sovereignty</a>.
    </p>

    <h2>Food education</h2>
    <p>{food.food_education.summary}</p>

    <h2>Community Food Dashboard</h2>
    
    <p>{food.community_food_dashboard.summary}</p>
    <ul>
      {indicators.map((i: string) => (
        <li>{i}</li>
      ))}
    </ul>

    <h2>Community Food Security Test</h2>
    <p>{food.community_food_security_test.purpose}</p>
    <ol>
      {testQs.map((q: any) => (
        <li>{q.text}</li>
      ))}
    </ol>

    <h2>Domain branches</h2>
    <ul>
      {branches.map((b: any) => (
        <li>{b.title}</li>
      ))}
    </ul>

    <h2>Research before policy</h2>
    <p>
      Detailed food statutes are blocked until Phase 2/2.1 diagnosis modules exist.
      See <a href="/resource-sovereignty/">Resource Sovereignty</a>,{" "}
      <a href="/human-capital/">Human Capital</a>, and <a href="/where-we-are/">Where we are</a>.
    </p>
  </article>
</BaseLayout>
