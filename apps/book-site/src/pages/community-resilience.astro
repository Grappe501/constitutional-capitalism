---
import BaseLayout from "../layouts/BaseLayout.astro";
import f from "../../../../data/project/community_resilience_framework.json";

const components = f.integrated_system?.components || [];
const prevention = f.prosperity_through_lower_risk?.examples || [];
const dividendMetrics = f.community_safety_dividend?.metrics_examples || [];
const volunteerEarn = f.professional_volunteer_partnership?.volunteer_may_earn || [];
const reserveFunds = f.community_emergency_reserve?.funds || [];
const healthStrengthen = f.healthcare_integration?.strengthen || [];
const insuranceExamples = f.insurance_partnership?.examples || [];
const serviceForms = f.national_service_pathway?.recognized_forms_examples || [];
const scorecard = f.community_resilience_scorecard?.indicators || [];
const pillars = f.design_pillars?.pillars || [];
const baselines = f.sourced_context_baselines?.items || [];
const testQs = f.community_resilience_test?.questions || [];
const branches = f.website_branches || [];
---

<BaseLayout
  title="Community Resilience"
  path="/community-resilience/"
  description="Safe communities are prosperous communities. Fire, EMS, disaster preparedness, and public health are prosperity infrastructure."
>
  <article class="prose">
    <h1>{f.domain_title}</h1>

    <h2>Principle</h2>
    <blockquote>
      <p>{f.principle.text}</p>
    </blockquote>

    <h2>Compact</h2>
    <blockquote>
      <p>{f.compact_language.text}</p>
    </blockquote>

    <h2>Mission</h2>
    <p>{f.mission.text}</p>
    <p class="muted">
      Budgeting shifts from <em>{f.budgeting_shift.from}</em> to{" "}
      <em>{f.budgeting_shift.to}</em>
    </p>

    <h2>Sourced context baselines</h2>
    <ul>
      {baselines.map((b: any) => (
        <li>
          <code>{b.id}</code> — {b.text}
        </li>
      ))}
    </ul>

    <h2>{f.integrated_system.title}</h2>
    <p>{f.integrated_system.summary}</p>
    <ul>
      {components.map((c: string) => (
        <li>{c}</li>
      ))}
    </ul>

    <h2>{f.prosperity_through_lower_risk.title}</h2>
    <p>{f.prosperity_through_lower_risk.summary}</p>
    <ul>
      {prevention.map((e: string) => (
        <li>{e}</li>
      ))}
    </ul>

    <h2>{f.community_safety_dividend.title}</h2>
    <p>{f.community_safety_dividend.summary}</p>
    <ul>
      {dividendMetrics.map((m: string) => (
        <li>{m}</li>
      ))}
    </ul>

    <h2>{f.professional_volunteer_partnership.title}</h2>
    <p>{f.professional_volunteer_partnership.summary}</p>
    <p>Volunteers may earn:</p>
    <ul>
      {volunteerEarn.map((v: string) => (
        <li>{v}</li>
      ))}
    </ul>

    <h2>{f.community_emergency_reserve.title}</h2>
    <p>{f.community_emergency_reserve.summary}</p>
    <ul>
      {reserveFunds.map((r: string) => (
        <li>{r}</li>
      ))}
    </ul>

    <h2>{f.healthcare_integration.title}</h2>
    <p>{f.healthcare_integration.summary}</p>
    <ul>
      {healthStrengthen.map((h: string) => (
        <li>{h}</li>
      ))}
    </ul>
    <p>{f.healthcare_integration.measurement_rule}</p>

    <h2>{f.insurance_partnership.title}</h2>
    <p>{f.insurance_partnership.summary}</p>
    <ul>
      {insuranceExamples.map((e: string) => (
        <li>{e}</li>
      ))}
    </ul>

    <h2>{f.economic_development_asset.title}</h2>
    <p>{f.economic_development_asset.summary}</p>

    <h2>{f.national_service_pathway.title}</h2>
    <p>{f.national_service_pathway.summary}</p>
    <ul>
      {serviceForms.map((s: string) => (
        <li>{s}</li>
      ))}
    </ul>

    <h2>{f.community_resilience_scorecard.title}</h2>
    <p>{f.community_resilience_scorecard.summary}</p>
    <ul>
      {scorecard.map((i: string) => (
        <li>{i}</li>
      ))}
    </ul>

    <h2>Community wealth link</h2>
    <p>{f.community_wealth_link.text}</p>

    <h2>Ten design pillars</h2>
    {
      pillars.map((p: any) => (
        <section style="margin-bottom:1rem;">
          <h3>
            {p.id}. {p.title}
          </h3>
          <p>{p.summary}</p>
        </section>
      ))
    }

    <h2>Community resilience test</h2>
    <p>{f.community_resilience_test.purpose}</p>
    <ol>
      {testQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>

    <h2>Website branches</h2>
    <ul>
      {branches.map((b: any) => (
        <li>
          <strong>{b.title}</strong> — {b.summary}
        </li>
      ))}
    </ul>

    <p class="muted">
      See also <a href="/health/">Health</a>,{" "}
      <a href="/community-prosperity/">Community Prosperity</a>,{" "}
      <a href="/civic-wealth/">Civic Wealth</a>,{" "}
      <a href="/constitutional-defense/">Constitutional Defense</a>, and{" "}
      <a href="/energy-sovereignty/">Energy Sovereignty</a>.
    </p>
  </article>
</BaseLayout>
