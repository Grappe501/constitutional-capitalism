---
import BaseLayout from "../layouts/BaseLayout.astro";
import { declarationSource, parseDeclaration, identity } from "../lib/data";

const { sections, words, minutes } = parseDeclaration(declarationSource);
const toc = sections.filter((s) => s.level === 2);
---

<BaseLayout
  title="Declaration"
  path="/declaration/"
  description="The Declaration of Constitutional Capitalism — first draft philosophical foundation."
>
  <article class="declaration">
    <header class="declaration__header">
      <p class="status-note">First draft — not a final ratified text</p>
      <h1>The Declaration of Constitutional Capitalism</h1>
      <p class="lede">
        The governing philosophical document for {identity.title}. Version 0.1.0-draft · Updated
        2026-08-04 · About {minutes} min read ({words.toLocaleString()} words)
      </p>
      <p>
        <a class="button button--solid" href="/definition/">Definition</a>
        <a class="button button--solid" href="/principles/" style="margin-left:0.5rem;">Principles</a>
      </p>
    </header>

    <nav class="declaration__toc" aria-label="Declaration sections">
      <h2>Contents</h2>
      <ol>
        {
          toc.map((s) => (
            <li>
              <a href={`#${s.id}`}>{s.title}</a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="declaration__body prose">
      {
        sections.map((section) => (
          <section id={section.id} class="declaration__section">
            {section.level === 2 ? <h2>{section.title}</h2> : <h3>{section.title}</h3>}
            {section.content.map((line) => {
              const t = line.trim();
              if (!t) return null;
              if (t.startsWith("> ")) {
                return <blockquote class="quote">{t.replace(/^>\s*/, "")}</blockquote>;
              }
              if (t.startsWith("- ") || t.startsWith("* ")) {
                return <p>{t.replace(/^[-*]\s*/, "• ")}</p>;
              }
              if (t.startsWith("*") && t.endsWith("*")) {
                return <p class="declaration__meta">{t.replace(/^\*|\*$/g, "")}</p>;
              }
              return <p>{t}</p>;
            })}
          </section>
        ))
      }
    </div>
  </article>
</BaseLayout>

<style>
  .declaration__header {
    margin-bottom: 2rem;
  }
  .declaration__toc {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 1.25rem 0;
    margin-bottom: 2rem;
  }
  .declaration__toc h2 {
    font-family: var(--serif);
    font-size: 1.25rem;
    margin: 0 0 0.75rem;
  }
  .declaration__toc ol {
    margin: 0;
    padding-left: 1.2rem;
    columns: 2;
    gap: 2rem;
  }
  @media (max-width: 720px) {
    .declaration__toc ol {
      columns: 1;
    }
  }
  .declaration__section {
    margin: 2rem 0;
    scroll-margin-top: 5rem;
  }
  .declaration__body {
    max-width: 42rem;
  }
  .declaration__meta {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  @media print {
    .site-header,
    .site-footer,
    .cta-row,
    .declaration__toc {
      display: none !important;
    }
    .declaration__body {
      max-width: none;
    }
    body {
      background: white;
      color: black;
    }
  }
</style>
