---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import atlas from "@data/project/cc_v2_2_2_functional_geography_atlas.json";

const layers = atlas.layers || [];
---

<BaseLayout
  title="Functional Geography Atlas — V2.2.2"
  path="/v2/redesign/functional-geography-atlas/"
  description="Political geography versus functional geography across healthcare, education, water, transport, and more."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">SIGNATURE OUTPUT</span>
      <h1>{atlas.title}</h1>
      <p class="lede">{atlas.rule}</p>
      <p class="muted">
        County Opportunity Portfolios: <strong>{atlas.county_opportunity_portfolios}</strong> · No
        boundary redraw
      </p>
      <p>
        <a href="/v2/redesign/institutional-geographic/">Institutional pass →</a>
        {" · "}
        <a href="/v2/redesign/institutional-future-map/">Future Map →</a>
        {" · "}
        <a href="/v2/see-arkansas/counties/">County twins (SEE) →</a>
      </p>
    </header>

    {
      layers.map((layer: any) => (
        <section class="hub-section">
          <h2>{layer.title}</h2>
          <ul class="stack">
            <li>
              <strong>Political geography</strong> — {layer.political}
            </li>
            <li>
              <strong>Functional geography</strong> — {layer.functional}
            </li>
            <li>
              <strong>Alignment</strong> —{" "}
              <span class={layer.alignment === "DIVERGE" ? "chip chip--live" : "chip chip--done"}>
                {layer.alignment}
              </span>
            </li>
            <li>
              <strong>Implication</strong> — {layer.implication}
            </li>
            <li class="muted">Homes: {(layer.homes || []).join(", ")}</li>
          </ul>
        </section>
      ))
    }

    <section class="hub-section">
      <h2>What this is not</h2>
      <ul class="stack">
        <li>Not a single regional map that replaces counties.</li>
        <li>Not an assignment of which county becomes which industry.</li>
        <li>Not a boundary commission proposal.</li>
      </ul>
    </section>
  </article>
</BaseLayout>
