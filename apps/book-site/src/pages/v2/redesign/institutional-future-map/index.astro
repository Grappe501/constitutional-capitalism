---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import pass from "@data/project/cc_v2_2_2_institutional_geographic_redesign.json";

const rows = pass.institutional_future_map || [];
---

<BaseLayout
  title="Institutional Future Map — V2.2.2"
  path="/v2/redesign/institutional-future-map/"
  description="38-row Institutional Future Map: function, F disposition, architecture, geography, roles, tests."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">38 / 38 I CLOSED</span>
      <h1>Institutional Future Map</h1>
      <p class="lede">
        Every home: who performs it, where, under what architecture — without inventing funding or
        assigning county futures.
      </p>
      <p>
        <a href="/v2/redesign/institutional-geographic/">Pass hub →</a>
        {" · "}
        <a href="/v2/redesign/functional-geography-atlas/">Atlas →</a>
        {" · "}
        <a href="/v2/redesign/">Redesign →</a>
      </p>
    </header>

    <section class="hub-section">
      <div style="overflow-x:auto;">
        <table class="data-table">
          <thead>
            <tr>
              <th>Function</th>
              <th>F</th>
              <th>Architecture</th>
              <th>Verb</th>
              <th>Levels</th>
              <th>Gov role</th>
              <th>Market</th>
              <th>Blocker</th>
              <th>Conf.</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r: any) => (
                <tr>
                  <td>
                    <strong>{r.function}</strong>
                    <div class="muted" style="font-size:0.8rem;">
                      {r.status}
                    </div>
                  </td>
                  <td>{r.f_disposition}</td>
                  <td>{r.proposed_institutional_architecture}</td>
                  <td>{r.structural_verb}</td>
                  <td>{(r.geographic_levels || []).join(", ")}</td>
                  <td>{r.government_role}</td>
                  <td>{r.market_role}</td>
                  <td>{r.blocker || "—"}</td>
                  <td>{r.confidence}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="hub-section">
      <h2>How to read a row</h2>
      <ul class="stack">
        <li>
          <strong>Architecture</strong> is the institutional form — not an exclusive geographic label.
        </li>
        <li>
          <strong>Verb</strong> appears only when regionalize / devolve / consolidate / reform burdens
          passed.
        </li>
        <li>
          <strong>Layers</strong> (on the pass page) separate standard-setting, capacity, and delivery.
        </li>
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  .data-table th,
  .data-table td {
    text-align: left;
    vertical-align: top;
    padding: 0.55rem 0.65rem;
    border-bottom: 1px solid var(--line);
  }
  .data-table th {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
</style>
