---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import hub from "@data/project/cc_v2_2_redesign_arkansas.json";
import completion from "@data/project/completion_ladder_and_dashboard.json";

const bp = completion.v2_blueprint || {};
const passes = hub.passes || [];
const prog = hub.progress || {};
---

<BaseLayout
  title="V2.2 — REDESIGN ARKANSAS"
  path="/v2/redesign/"
  description="Function-first redesign under Constitutional Capitalism. Every should points to V2.1 evidence."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">V2.2 CERTIFIED · FROZEN</span>
      <h1>{hub.title}</h1>
      <p class="lede">{hub.governing_question}</p>
      <p class="lede">{hub.should_rule}</p>
      <p class="muted">
        SEE <a href="/v2/see-arkansas/">CERTIFIED</a> · REDESIGN{" "}
        <a href="/v2/redesign/certification/">CERTIFIED</a> · Blueprint{" "}
        <strong>{bp.percent ?? prog.v2_blueprint_percent}%</strong>
      </p>
    </header>

    <section class="hub-section">
      <h2>Progress</h2>
      <ul class="link-board">
        <li>
          Redesign objects <strong>{prog.redesign_objects_closed}/{prog.redesign_objects_total}</strong> ·
          V2.2 <strong>{prog.v2_2_percent}%</strong>
        </li>
        <li>
          F closed {prog.f_objects_closed} · I closed {prog.i_objects_closed ?? 0} · O closed{" "}
          {prog.o_objects_closed ?? 0}
        </li>
        <li>
          <span class="chip chip--done">COMPLETE</span> Foundational v1.0 ·{" "}
          <span class="chip chip--done">CERTIFIED</span> SEE
        </li>
      </ul>
    </section>

    <section class="hub-section">
      <h2>Four redesign passes</h2>
      <ul class="stack">
        {
          passes.map((p: any) => (
            <li>
              <span
                class={
                  p.status === "COMPLETE"
                    ? "chip chip--done"
                    : p.status === "NEXT"
                      ? "chip chip--live"
                      : "chip chip--queued"
                }
              >
                {p.status}
              </span>{" "}
              <strong>
                {p.id} — {p.name}
              </strong>
              <div class="muted">{p.exit}</div>
              {p.href && (
                <div>
                  <a href={p.href}>Open →</a>
                  {p.what_changed && (
                    <>
                      {" · "}
                      <a href={p.what_changed}>What Changed →</a>
                    </>
                  )}
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Disposition vocabulary</h2>
      <ul class="link-board">
        {(hub.disposition_vocabulary || []).map((d: string) => (
          <li>
            <strong>{d}</strong>
          </li>
        ))}
      </ul>
      <p>
        <a href="/v2/redesign/disposition-map/">Disposition Map →</a>
        {" · "}
        <a href="/v2/redesign/operating-system/">Operating System →</a>
        {" · "}
        <a href="/v2/redesign/life-events/">Life Events →</a>
        {" · "}
        <a href="/v2/redesign/public-decision-receipt/">Public Decision Receipt →</a>
        {" · "}
        <a href="/v2/redesign/certification/">Certification →</a>
        {" · "}
        <a href="/v2/redesign/proposed-operating-model/">Operating Model →</a>
        {" · "}
        <a href="/v2/redesign/changed-our-mind/">Changed Our Mind →</a>
        {" · "}
        <a href="/v2/redesign/institutional-future-map/">Institutional Future Map →</a>
        {" · "}
        <a href="/v2/redesign/functional-geography-atlas/">Functional Geography Atlas →</a>
        {" · "}
        <a href="/v2/">Master Build Plan →</a>
      </p>
    </section>
  </article>
</BaseLayout>
