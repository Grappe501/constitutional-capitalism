---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import pass from "@data/project/cc_v2_2_3_program_process_administrative_redesign.json";

const events = pass.life_events || {};
const door = pass.one_arkansas_front_door || {};
---

<BaseLayout
  title="Life Events — V2.2.3"
  path="/v2/redesign/life-events/"
  description="Organize Arkansas public service around life events—not agency org charts."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">LIFE-EVENT ARCHITECTURE</span>
      <h1>Organize around life events</h1>
      <p class="lede">
        The back end may involve five agencies. The citizen should not have to coordinate those five
        agencies themselves.
      </p>
    </header>

    <section class="hub-section">
      <h2>One Arkansas Front Door (concept)</h2>
      <p class="muted">{door.not}</p>
      <p class="lede">{(door.flow || []).join(" → ")}</p>
    </section>

    <section class="hub-section">
      <h2>Household</h2>
      <ul class="link-board">
        {(events.household || []).map((e: string) => (
          <li>{e}</li>
        ))}
      </ul>
    </section>

    <section class="hub-section">
      <h2>Productive life</h2>
      <ul class="link-board">
        {(events.productive || []).map((e: string) => (
          <li>{e}</li>
        ))}
      </ul>
    </section>

    <section class="hub-section">
      <h2>Civic life</h2>
      <ul class="link-board">
        {(events.civic || []).map((e: string) => (
          <li>{e}</li>
        ))}
      </ul>
    </section>

    <section class="hub-section">
      <h2>Next</h2>
      <p>
        <a href="/v2/redesign/operating-system/">Operating system cards →</a>
        {" · "}
        <a href="/v2/redesign/public-decision-receipt/">Public Decision Receipt →</a>
      </p>
    </section>
  </article>
</BaseLayout>
