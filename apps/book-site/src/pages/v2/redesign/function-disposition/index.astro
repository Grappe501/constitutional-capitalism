---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import pass from "@data/project/cc_v2_2_1_government_function_disposition.json";

const cards = pass.cards || [];
const families = pass.families || {};
const counts = pass.disposition_counts || {};
const deps = pass.redesign_dependency_graph_seed || [];

const byFamily: Record<string, any[]> = {};
for (const c of cards) {
  const k = c.family || "other";
  if (!byFamily[k]) byFamily[k] = [];
  byFamily[k].push(c);
}
---

<BaseLayout
  title="V2.2.1 — Government Function Disposition"
  path="/v2/redesign/function-disposition/"
  description="What should Arkansas government be responsible for? Function first. Institution second. Money later."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">PASS COMPLETE</span>
      <h1>{pass.title}</h1>
      <p class="lede">{pass.governing_question}</p>
      <p class="lede">{pass.should_rule}</p>
      <p class="muted">
        {pass.slice_id} · Blueprint <strong>{pass.progress?.v2_blueprint_percent}%</strong> · Redesign{" "}
        {pass.progress?.redesign_objects_closed}/{pass.progress?.redesign_objects_total}
      </p>
    </header>

    <section class="hub-section">
      <h2>Discipline</h2>
      <ul class="stack">
        {(pass.discipline || []).map((d: string) => <li>{d}</li>)}
      </ul>
      <p>
        <a href="/v2/redesign/what-changed/v2-2-1/">What Changed →</a>
        {" · "}
        <a href="/v2/redesign/disposition-map/">Disposition Map →</a>
        {" · "}
        <a href="/v2/redesign/">Redesign hub →</a>
      </p>
    </section>

    <section class="hub-section">
      <h2>Disposition counts</h2>
      <ul class="link-board">
        {
          Object.entries(counts).map(([k, v]) => (
            <li>
              <strong>{k}</strong>: {v}
            </li>
          ))
        }
      </ul>
      <p class="muted">
        Government roles: {(pass.government_roles || []).join(" · ")}. Investor/Owner only under eight
        gates.
      </p>
    </section>

    {
      Object.entries(byFamily).map(([fid, list]) => (
        <section class="hub-section">
          <h2>{(families[fid] && families[fid].label) || fid}</h2>
          <ul class="stack">
            {(list as any[]).map((c) => (
              <li>
                <strong>{c.label}</strong>{" "}
                <span class="chip chip--live">{c.disposition}</span>
                <div class="muted">{(c.government_roles || []).join(" · ")}</div>
                <div>{c.current_function}</div>
                <div class="muted">SEE problem: {c.problem_opportunity_from_see}</div>
                <div class="muted">
                  Household: {c.household_effect} · V2.1: {(c.v2_1_should_backlink || []).join("; ")}
                </div>
                {(c.evidence_blockers || []).length > 0 && (
                  <div class="muted">Blockers: {(c.evidence_blockers || []).join(", ")}</div>
                )}
                <div class="muted">
                  Fiscal: {c.fiscal_questions_v2_3} · Legal: {c.legal_questions_v2_4}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="hub-section">
      <h2>Redesign dependency seeds</h2>
      <ul class="stack">
        {
          deps.map((d: any) => (
            <li>
              <strong>{d.id}</strong>: {d.from} → requires {d.requires} → then {d.then}
            </li>
          ))
        }
      </ul>
      <p class="lede">Next: {pass.next}</p>
    </section>
  </article>
</BaseLayout>
