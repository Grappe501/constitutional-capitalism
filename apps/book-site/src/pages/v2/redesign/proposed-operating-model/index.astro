---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import pass from "@data/project/cc_v2_2_4_redesign_integration_certification.json";

const homes = pass.proposed_arkansas_operating_model?.homes || [];
const byFamily: Record<string, any[]> = {};
for (const h of homes) {
  const k = h.family || "other";
  if (!byFamily[k]) byFamily[k] = [];
  byFamily[k].push(h);
}
---

<BaseLayout
  title="Proposed Arkansas Operating Model"
  path="/v2/redesign/proposed-operating-model/"
  description="Canonical join of 38 function homes across disposition, institutions, geography, and operating system."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">38 HOMES JOINED</span>
      <h1>Proposed Arkansas Operating Model</h1>
      <p class="lede">
        One canonical table. No rewriting of underlying F/I/O decisions during assembly.
      </p>
      <p class="muted">
        Objects <strong>114/114</strong> · Funding invented{" "}
        <strong>{pass.discipline?.funding_invented}</strong>
      </p>
    </header>

    {
      Object.entries(byFamily).map(([fam, list]) => (
        <section class="hub-section">
          <h2>{list[0]?.family_label || fam}</h2>
          <ul class="stack">
            {list.map((h: any) => (
              <li>
                <strong>{h.label}</strong>
                <div class="muted">
                  {h.function_disposition} · {h.institutional_architecture} ·{" "}
                  {h.structural_verb}
                </div>
                <div>
                  <span class="muted">Gov role:</span> {String(h.government_role)}
                </div>
                <div>
                  <span class="muted">Rights floor:</span> {h.rights_floor}
                </div>
                <div>
                  <span class="muted">V2.3 fiscal:</span> {h.v2_3_fiscal_question}
                </div>
                <div>
                  <span class="muted">V2.4 legal:</span> {h.v2_4_legal_question}
                </div>
                <div>
                  <span class="muted">V2.5 transition:</span> {h.v2_5_transition_dependency}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <p>
      <a href="/v2/redesign/certification/">Certification →</a>
      {" · "}
      <a href="/v2/redesign/">Redesign hub →</a>
    </p>
  </article>
</BaseLayout>
