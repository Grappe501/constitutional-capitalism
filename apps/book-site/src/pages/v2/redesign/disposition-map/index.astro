---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import pass from "@data/project/cc_v2_2_1_government_function_disposition.json";

const cards = pass.cards || [];
const order = pass.disposition_vocabulary || [];
const groups: Record<string, any[]> = {};
for (const d of order) groups[d] = [];
for (const c of cards) {
  const d = c.disposition || "HOLD / INSUFFICIENT EVIDENCE";
  if (!groups[d]) groups[d] = [];
  groups[d].push(c);
}
---

<BaseLayout
  title="Disposition Map — V2.2"
  path="/v2/redesign/disposition-map/"
  description="How radical—or conservative—is the redesign? KEEP is celebrated when earned."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--live">DISPOSITION MAP</span>
      <h1>38-home Disposition Map</h1>
      <p class="lede">
        Concise picture of redesign posture after function disposition. KEEP is a success when earned.
      </p>
      <p>
        <a href="/v2/redesign/function-disposition/">Function cards →</a>
        {" · "}
        <a href="/v2/redesign/institutional-future-map/">Institutional Future Map →</a>
        {" · "}
        <a href="/v2/redesign/functional-geography-atlas/">Functional Geography Atlas →</a>
        {" · "}
        <a href="/v2/redesign/">Redesign hub →</a>
      </p>
    </header>

    {
      order.map((d: string) => (
        <section class="hub-section">
          <h2>
            {d}{" "}
            <span class="muted">({(groups[d] || []).length})</span>
          </h2>
          {(groups[d] || []).length === 0 ? (
            <p class="muted">None in V2.2.1 function pass.</p>
          ) : (
            <ul class="stack">
              {(groups[d] || []).map((c: any) => (
                <li>
                  <strong>{c.label}</strong>
                  <div class="muted">{(c.government_roles || []).join(" · ")}</div>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </article>
</BaseLayout>
