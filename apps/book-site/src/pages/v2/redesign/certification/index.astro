---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import pass from "@data/project/cc_v2_2_4_redesign_integration_certification.json";

const joins = pass.join_tests || [];
const cert = pass.certification || {};
const thresh = cert.threshold || {};
const vis = pass.operating_system_visual || {};
const blockers = pass.blockers || [];
---

<BaseLayout
  title="V2.2 — REDESIGN ARKANSAS CERTIFIED"
  path="/v2/redesign/certification/"
  description="Integration and hostile certification of Arkansas' Proposed Operating Model under Constitutional Capitalism."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">CERTIFIED</span>
      <span class="chip chip--done">FROZEN</span>
      <h1>{cert.title || "V2.2 — REDESIGN ARKANSAS: CERTIFIED"}</h1>
      <p class="lede">{pass.governing_question}</p>
      <p class="muted">
        {pass.slice_id} · {pass.decision_id} · {pass.update_id} · Blueprint{" "}
        <strong>{pass.progress?.v2_blueprint_percent}%</strong>
      </p>
    </header>

    <section class="hub-section">
      <h2>Certification threshold</h2>
      <ul class="link-board">
        {
          Object.entries(thresh).map(([k, v]) => (
            <li>
              <strong>{k}</strong>: {String(v)}
            </li>
          ))
        }
      </ul>
      <p class="lede">{cert.freeze?.v2_3_forbidden}</p>
    </section>

    <section class="hub-section">
      <h2>Arkansas' Proposed Operating System</h2>
      <p class="muted">{vis.not}</p>
      <div class="os-visual" aria-label="Proposed operating system diagram">
        <p class="os-center"><strong>{vis.center?.label}</strong></p>
        <ul class="link-board">
          {(vis.inner_ring || []).map((n: any) => (
            <li>
              <strong>{n.label}</strong>
            </li>
          ))}
        </ul>
        <p>
          <strong>{(vis.outer_ring || [])[0]?.label}</strong>
        </p>
        <p class="lede">Flows: {(vis.flows || []).join(" · ")}</p>
        <p class="muted">{vis.foundation?.label}</p>
        <p>{vis.v2_3_handoff}</p>
      </div>
    </section>

    <section class="hub-section">
      <h2>12-join tests</h2>
      <ul class="stack">
        {
          joins.map((j: any) => (
            <li>
              <span
                class={
                  j.disposition === "PASS"
                    ? "chip chip--done"
                    : j.disposition === "PASS-WITH-BLOCKER"
                      ? "chip chip--live"
                      : "chip chip--queued"
                }
              >
                {j.disposition}
              </span>{" "}
              <strong>
                {j.id} — {j.name}
              </strong>
              <div class="muted">{j.question}</div>
              <div>{j.finding}</div>
              {j.blocker && <div class="muted">Blocker: {j.blocker}</div>}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Hostile battery</h2>
      <ul class="link-board">
        <li>
          <strong>Opposition</strong>: {pass.opposition_test?.disposition}
        </li>
        <li>
          <strong>Mediocre Government</strong>: {pass.mediocre_government_test?.disposition}
        </li>
        <li>
          <strong>Capture</strong>: {pass.capture_test?.disposition}
        </li>
        <li>
          <strong>Market Crowding</strong>: {pass.market_crowding_test?.disposition}
        </li>
        <li>
          <strong>Household Burden Transfer</strong>:{" "}
          {pass.household_burden_transfer_test?.disposition}
        </li>
        <li>
          <strong>Rights Floor</strong>: {pass.rights_floor_test?.disposition}
        </li>
        <li>
          <strong>Complexity</strong>: {pass.complexity_test?.disposition}
        </li>
        <li>
          <strong>Arkansas 75</strong>: {pass.arkansas_75_test?.disposition}
        </li>
      </ul>
    </section>

    <section class="hub-section">
      <h2>Downstream blockers</h2>
      <ul class="stack">
        {
          blockers.map((b: any) => (
            <li>
              <strong>{b.id}</strong> — {b.title}
              <div class="muted">
                {b.disposition} · prevents certification: {String(b.prevents_certification)}
              </div>
              <div>{b.note}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Surfaces</h2>
      <p>
        <a href="/v2/redesign/proposed-operating-model/">Proposed Operating Model →</a>
        {" · "}
        <a href="/v2/redesign/contradiction-register/">Contradiction Register →</a>
        {" · "}
        <a href="/v2/redesign/changed-our-mind/">Changed Our Mind →</a>
        {" · "}
        <a href="/v2/redesign/what-changed/v2-2-4/">What Changed →</a>
        {" · "}
        <a href="/v2/redesign/">Redesign hub →</a>
      </p>
      <p class="muted">Next: {pass.next}</p>
    </section>
  </article>
</BaseLayout>

<style>
  .os-visual {
    border-top: 1px solid color-mix(in srgb, var(--ink, #1a2b24) 12%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--ink, #1a2b24) 12%, transparent);
    padding: 1.25rem 0;
  }
  .os-center {
    font-size: 1.25rem;
    letter-spacing: 0.02em;
  }
</style>
