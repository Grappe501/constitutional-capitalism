---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import pass from "@data/project/cc_v2_2_4_redesign_integration_certification.json";

const rows = pass.contradiction_register || [];
---

<BaseLayout
  title="Redesign Contradiction Register"
  path="/v2/redesign/contradiction-register/"
  description="Conflicts found while joining V2.2 decisions — dispositioned without quiet redesign."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">REGISTER</span>
      <h1>Redesign Contradiction Register</h1>
      <p class="lede">
        Record conflicts first. Only ARCHITECTURAL_DEFECT reopens V2.2 design. Downstream questions
        stay downstream.
      </p>
    </header>

    <section class="hub-section">
      <ul class="stack">
        {
          rows.map((c: any) => (
            <li>
              <strong>{c.id}</strong>
              <div class="muted">
                {c.decision_a} ↔ {c.decision_b}
              </div>
              <div>
                <strong>Conflict:</strong> {c.conflict}
              </div>
              <div>
                <span class="chip chip--live">{c.severity}</span>{" "}
                <span class="chip chip--done">{c.disposition}</span>
              </div>
              {c.condition && <div class="muted">{c.condition}</div>}
            </li>
          ))
        }
      </ul>
    </section>

    <p>
      <a href="/v2/redesign/certification/">Certification →</a>
      {" · "}
      <a href="/v2/redesign/">Redesign hub →</a>
    </p>
  </article>
</BaseLayout>
