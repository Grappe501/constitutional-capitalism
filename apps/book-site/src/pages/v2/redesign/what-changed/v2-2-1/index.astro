---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import log from "@data/project/pass_changelogs/v2_2_1.json";
---

<BaseLayout
  title="What Changed — V2.2.1"
  path="/v2/redesign/what-changed/v2-2-1/"
  description="Opened REDESIGN. Function dispositions complete. No funding design."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">WHAT CHANGED</span>
      <h1>
        {log.pass_id} — {log.pass_name}
      </h1>
      <p class="muted">{log.decision_id}</p>
    </header>

    <section class="hub-section">
      <h2>BEFORE → AFTER</h2>
      <ul class="stack">
        {
          (log.before_after || []).map((row: any) => (
            <li>
              <strong>{row.label}</strong>
              <div class="muted">
                {row.before} → <strong>{row.after}</strong>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Disposition posture</h2>
      <ul class="link-board">
        {
          Object.entries(log.disposition_counts || {}).map(([k, v]) => (
            <li>
              <strong>{k}</strong>: {v}
            </li>
          ))
        }
      </ul>
      <p class="lede">Funding invented this pass: 0</p>
    </section>

    <section class="hub-section">
      <h2>Surfaces</h2>
      <ul class="link-board">
        {
          (log.experience_links || []).map((l: any) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
