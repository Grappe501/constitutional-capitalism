---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import pass from "@data/project/cc_v2_1_4_institutions_power_constraints.json";

const auth = pass.authority_ledger || {};
const change = pass.change_pathway_matrix || {};
const appt = pass.appointment_power_graph || {};
const money = pass.public_dollar_power_chain || {};
const constr = pass.constraint_ledger || {};
const fed = pass.federalism_functional_map || {};
const dem = pass.democratic_power_map || {};
const admin = pass.administrative_decision_map || {};
const trans = pass.transparency_architecture || {};
const cps = pass.power_chokepoints || [];
const patterns = pass.observed_patterns || [];
const who = pass.visual_who_runs_what || {};
const can = pass.visual_can_arkansas_change || {};
const edges = pass.county_network_edges_institutional || [];
---

<BaseLayout
  title="V2.1.4 — Institutions, Power & Constraints"
  path="/v2/see-arkansas/institutions-power-constraints/"
  description="Who can make, administer, finance, constrain, challenge, or reverse Arkansas decisions — observation only."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">PASS COMPLETE</span>
      <h1>{pass.title}</h1>
      <p class="lede">{pass.governing_question}</p>
      <p class="muted">
        {pass.slice_id} · recommendations: <strong>0</strong> · not a civics textbook — a control diagram
      </p>
    </header>

    <section class="hub-section">
      <h2>Progress</h2>
      <ul class="link-board">
        <li>
          Objects <strong>{pass.progress?.baseline_objects_closed_after}/152</strong> (+{pass.progress
            ?.objects_newly_closed}) · Blueprint <strong>{pass.progress?.v2_blueprint_percent}%</strong>
        </li>
        <li>
          GEO essential {pass.progress?.geo_essential_systems_partial}/75 · connectivity{" "}
          {pass.progress?.geo_connectivity_partial}/75 · institutional edges{" "}
          {pass.progress?.network_edges_institutional}
        </li>
        <li>
          emergency_government objects: <strong>{pass.progress?.emergency_government_objects}</strong>
        </li>
        <li>Recommendations: <strong>0</strong></li>
      </ul>
      <p>
        <a href="/v2/see-arkansas/what-changed/v2-1-4/">What Changed →</a>
        {" · "}
        <a href="/v2/see-arkansas/">V2.1 hub →</a>
      </p>
    </section>

    <section class="hub-section">
      <h2>{who.title}</h2>
      <ol class="stack">
        {(who.nodes || []).map((n: string) => (
          <li>
            <strong>{n}</strong>
          </li>
        ))}
      </ol>
      <p class="muted">
        Click-reveal fields (data contract): {(who.node_reveal_fields || []).join(" · ")}
      </p>
      <p class="muted">{who.note}</p>
    </section>

    <section class="hub-section">
      <h2>{can.title}</h2>
      <p class="lede">{can.rule}</p>
      <p class="muted">Returns: {(can.returns || []).join(" · ")}</p>
      <ul class="stack">
        {
          (change.rows || []).map((r: any) => (
            <li>
              <strong>{r.subject}</strong>
              <div>
                Pathway: {r.primary_pathway}
                {r.also?.length ? ` (+ ${(r.also || []).join(", ")})` : ""}
              </div>
              <div class="muted">
                Federal: {r.federal} · confidence {r.confidence} · {r.evidence_class}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Authority Ledger</h2>
      <p class="lede">{auth.rule}</p>
      <ul class="stack">
        {
          (auth.actors || []).map((a: any) => (
            <li>
              <strong>{a.label}</strong>
              <div class="muted">{(a.power_forms || []).join(" · ")}</div>
              <div>Controls: {a.controls}</div>
              <div class="muted">
                Source: {a.source_of_authority} · {a.evidence_class} · confidence {a.confidence}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Six forms of power</h2>
      <ul class="link-board">
        {(pass.power_forms || []).map((f: string) => (
          <li>
            <strong>{f}</strong>
          </li>
        ))}
      </ul>
      <p class="muted">Institutions may hold several — recorded separately on each actor.</p>
    </section>

    <section class="hub-section">
      <h2>Appointment power</h2>
      <p class="muted">{(appt.chain || []).join(" → ")}</p>
      <ul class="stack">
        {
          (appt.nodes || []).map((n: any) => (
            <li>
              <strong>{n.id}</strong> — {n.appointment_authority}
              <div class="muted">
                Confirmation: {n.confirmation} · {n.evidence_class}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Public-dollar power chain</h2>
      <p class="lede">{money.join}</p>
      <ol class="stack">
        {
          (money.spine || []).map((s: any) => (
            <li>
              <strong>{s.step}</strong> — {(s.actors || []).join("; ")}
              <div class="muted">
                {s.evidence_class}
                {s.note ? ` · ${s.note}` : ""}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="hub-section">
      <h2>Constraint Ledger</h2>
      <ul class="stack">
        {
          (constr.by_domain || []).map((d: any) => (
            <li>
              <strong>{d.domain}</strong>
              <div class="muted">{(d.constraints || []).join(" · ")}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Federalism (functional)</h2>
      <ul class="stack">
        {
          (fed.systems || []).map((s: any) => (
            <li>
              <strong>{s.system}</strong>
              <div class="muted">
                AR roles: {(s.arkansas_roles || []).join(", ")} · local: {s.local} · private/nonprofit:{" "}
                {s.private_nonprofit}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Democratic Power Map</h2>
      <p class="lede">{dem.rule}</p>
      <ol class="stack">
        {
          (dem.loop || []).map((s: any) => (
            <li>
              <strong>{s.step}</strong> — {(s.mechanisms || []).join(", ")}
              <span class="muted"> ({s.evidence_class})</span>
            </li>
          ))
        }
      </ol>
      <h3>Alongside</h3>
      <ul class="stack">
        {
          (dem.alongside || []).map((m: any) => (
            <li>
              <strong>{m.mechanism}</strong> — {m.status}
              {m.fulfillment_stats && <span class="muted"> · fulfillment: {m.fulfillment_stats}</span>}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Administrative decisions (representative)</h2>
      <ul class="stack">
        {
          (admin.types || []).map((t: any) => (
            <li>
              <strong>{t.type}</strong>
              <div class="muted">
                {t.maker} → {t.standard} → appeal: {t.appeal}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Transparency architecture</h2>
      <ul class="stack">
        {
          (trans.domains || []).map((d: any) => (
            <li>
              <strong>{d.domain}</strong> — {d.availability}
              <span class="muted"> ({d.evidence_class})</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Power chokepoints</h2>
      <p class="lede">Chokepoint ≠ bad. Judgment: NONE.</p>
      <ul class="stack">
        {
          cps.map((c: any) => (
            <li>
              <strong>{c.id}</strong> — {c.actor}: {c.power}
              <div class="muted">
                Affects: {(c.affected_functions || []).join(", ")} · confidence {c.confidence}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Institutional network edges</h2>
      <ul class="stack">
        {
          edges.map((e: any) => (
            <li>
              <strong>{e.id}</strong> — {e.relationship}: {e.source_label} → {e.destination_label}
              <div class="muted">
                {e.evidence_class} · {e.evidence}
              </div>
            </li>
          ))
        }
      </ul>
      <p>
        <a href="/v2/see-arkansas/counties/network/">Network contract →</a>
      </p>
    </section>

    <section class="hub-section">
      <h2>Observed patterns</h2>
      <ul class="stack">
        {
          patterns.map((p: any) => (
            <li>
              <strong>{p.id}</strong>
              <div>{p.observation}</div>
              <div class="muted">Not: {p.not}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Deferred</h2>
      <ul class="stack">
        {(pass.deferred || []).map((d: string) => <li>{d}</li>)}
      </ul>
      <p class="lede">Next: {pass.next}</p>
    </section>
  </article>
</BaseLayout>
