---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import cards from "@data/project/cc_v2_1_home_baseline_cards.json";
import objects from "@data/project/cc_v2_1_closure_objects.json";

const list = cards.cards || [];
const byHome: Record<string, any[]> = {};
for (const o of objects.objects || []) {
  (byHome[o.home_id] ||= []).push(o);
}
---

<BaseLayout
  title="V2.1 — Home baseline cards"
  path="/v2/see-arkansas/homes/"
  description="38 operating-system homes with the same baseline fields. Enough to close SEE — not dissertations."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--live">38-HOME RULE</span>
      <h1>Home baseline cards</h1>
      <p class="lede">{cards.rule}</p>
      <p class="muted">{cards.slice_id} · {list.length} homes</p>
    </header>

    <section class="hub-section">
      <ul class="stack">
        {
          list.map((c: any) => {
            const objs = byHome[c.home_id] || [];
            const closed = objs.filter((o) => o.status === "COMPLETE" || o.status === "UNKNOWN-COMPLETE").length;
            return (
              <li>
                <a href={`/v2/see-arkansas/homes/${c.home_id}/`}>
                  <strong>{c.label}</strong>
                </a>
                <span class="muted">
                  {" "}
                  · {c.status} · objects {closed}/4
                </span>
              </li>
            );
          })
        }
      </ul>
      <p>
        <a href="/v2/see-arkansas/">V2.1 hub →</a>
      </p>
    </section>
  </article>
</BaseLayout>
