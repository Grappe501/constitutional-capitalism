---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import log from "@data/project/pass_changelogs/v2_1_5.json";
---

<BaseLayout
  title="What Changed — V2.1.5"
  path="/v2/see-arkansas/what-changed/v2-1-5/"
  description="SEE ARKANSAS certified. One joined operating system. Recommendations: 0."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">SEE CERTIFIED</span>
      <h1>
        {log.pass_id} — {log.pass_name}
      </h1>
      <p class="muted">
        {log.decision_id} · recommendations during SEE: <strong>0</strong>
      </p>
    </header>

    <section class="hub-section">
      <h2>BEFORE → AFTER</h2>
      <ul class="stack">
        {
          (log.before_after || []).map((row: any) => (
            <li>
              <strong>{row.label}</strong>
              <div class="muted">
                {row.before} → <strong>{row.after}</strong>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Recommendations during SEE</h2>
      <p class="lede" style="font-size:2rem;font-weight:700;">0</p>
    </section>

    <section class="hub-section">
      <h2>Objects dispositioned this pass</h2>
      <p class="muted" style="font-size:0.9rem;">
        {(log.objects_dispositioned_this_pass || []).join(" · ")}
      </p>
      <p class="muted">
        V2.2 blockers carried: {(log.v2_2_blockers_carried || []).join(", ")}
      </p>
    </section>

    <section class="hub-section">
      <h2>Surfaces</h2>
      <ul class="link-board">
        {
          (log.experience_links || []).map((l: any) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
