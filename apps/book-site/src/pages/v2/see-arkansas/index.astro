---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import v21 from "@data/project/cc_v2_1_see_arkansas.json";
import objects from "@data/project/cc_v2_1_closure_objects.json";
import completion from "@data/project/completion_ladder_and_dashboard.json";

const bp = completion.v2_blueprint || {};
const passes = v21.passes || [];
const closed = objects.closed_objects ?? 0;
const total = objects.total_objects ?? 152;
const pct = objects.v2_1_completion_percent ?? 0;
---

<BaseLayout
  title="V2.1 — SEE ARKANSAS"
  path="/v2/see-arkansas/"
  description="Describe how Arkansas presently functions before redesign. Object-counted baseline."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--live">V2.1 ACTIVE</span>
      <h1>{v21.title}</h1>
      <p class="lede">{v21.governing_question}</p>
      <p class="muted">
        Finished when the answer is yes — via closed objects, not words written. Describe only.
      </p>
    </header>

    <section class="hub-section">
      <h2>Progress</h2>
      <ul class="link-board">
        <li>
          <span class="chip chip--live">V2.1</span>{" "}
          <strong>{closed}/{total}</strong> objects · {pct}%
        </li>
        <li>
          <span class="chip chip--live">BLUEPRINT</span>{" "}
          <strong>{bp.percent ?? v21.progress?.v2_blueprint_percent ?? 0}%</strong> → 100%
        </li>
        <li>
          <span class="chip chip--queued">HOLD</span> Explorer 0.1
        </li>
        <li>
          <span class="chip chip--done">COMPLETE</span> Foundational v1.0
        </li>
      </ul>
      <div class="progress-list" style="margin-top:1rem;">
        <div class="progress-item">
          <label>
            <span>V2.1 SEE ARKANSAS</span>
            <span aria-hidden="true">{pct}%</span>
          </label>
          <div class="bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={pct}>
            <span style={`width:${pct}%`} />
          </div>
        </div>
      </div>
    </section>

    <section class="hub-section">
      <h2>Five finite passes</h2>
      <ul class="stack">
        {
          passes.map((p: any) => (
            <li>
              <span
                class={
                  p.status === "COMPLETE"
                    ? "chip chip--done"
                    : p.status === "NEXT"
                      ? "chip chip--live"
                      : "chip chip--queued"
                }
              >
                {p.status}
              </span>{" "}
              <strong>
                {p.id} — {p.name}
              </strong>
              <div class="muted">{p.exit}</div>
              {p.href && (
                <div>
                  <a href={p.href}>Open pass →</a>
                  {p.what_changed && (
                    <>
                      {" · "}
                      <a href={p.what_changed}>What Changed →</a>
                    </>
                  )}
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Discipline</h2>
      <p class="lede">No recommendations hidden inside baseline language.</p>
      <ul class="stack">
        {(v21.discipline?.forbidden || []).map((f: string) => <li>{f}</li>)}
      </ul>
      <p>
        <a href="/v2/see-arkansas/homes/">38 home baseline cards →</a>
        {" · "}
        <a href="/v2/see-arkansas/counties/">Arkansas 75 — County Digital Twins →</a>
        {" · "}
        <a href="/v2/see-arkansas/unknowns/">Unknown Register →</a>
        {" · "}
        <a href="/v2/">Master Build Plan →</a>
      </p>
    </section>
  </article>
</BaseLayout>
