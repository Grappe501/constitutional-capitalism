---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import pass from "@data/project/cc_v2_1_2_government_money.json";
import money from "@data/project/cc_v2_1_2_money_ledgers.json";

const ledgers = money.ledgers || {};
const hist = money.historical_panel || pass.historical_panel || {};
const flex = money.flexibility_map || {};
const fed = money.federal_dependency || {};
const patterns = money.observed_patterns || [];
const visuals = money.visuals || [];
const spine = pass.money_map?.spine_now || {};
const flow = pass.money_map?.flow || [];

function moneyFmt(n?: number | null) {
  if (n == null) return "—";
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(n);
}
function millions(n?: number | null) {
  if (n == null) return "—";
  return `$${n.toLocaleString("en-US")}M`;
}
---

<BaseLayout
  title="V2.1.2 — Government & Money"
  path="/v2/see-arkansas/government-money/"
  description="Arkansas Public Money System — observation only. Where money comes from, where it goes, what claims it."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">PASS COMPLETE</span>
      <h1>{pass.title}</h1>
      <p class="lede">{pass.governing_question}</p>
      <p class="muted">
        {pass.slice_id} · {pass.decision_id} · recommendations: <strong>0</strong>
      </p>
    </header>

    <section class="hub-section">
      <h2>Progress</h2>
      <ul class="link-board">
        <li>
          Objects: <strong>{pass.progress?.baseline_objects_closed_after}/152</strong> · Blueprint{" "}
          <strong>{pass.progress?.v2_blueprint_percent}%</strong>
        </li>
        <li>
          GEO public-money PARTIAL:{" "}
          <strong>{pass.progress?.county_geo_government_public_money_partial}/75</strong>
        </li>
        <li>
          Patterns: <strong>{pass.progress?.observed_patterns}</strong> · Recommendations:{" "}
          <strong>0</strong>
        </li>
      </ul>
      <p>
        <a href="/v2/see-arkansas/what-changed/v2-1-2/">What Changed →</a>
        {" · "}
        <a href="/v2/see-arkansas/">V2.1 hub →</a>
      </p>
    </section>

    <section class="hub-section">
      <h2>Arkansas Public Money System (flow)</h2>
      <ol class="stack">
        {flow.map((step: string) => (
          <li>
            <strong>{step}</strong>
          </li>
        ))}
      </ol>
      <p class="muted">Alongside: {(pass.money_map?.claims_on_flexibility || []).join(" · ")}</p>
      <ul class="link-board">
        <li>
          Gross GR FY2026: <strong>{moneyFmt(spine.gross_gr_fy2026_usd)}</strong>
        </li>
        <li>
          Net available GR FY2026: <strong>{moneyFmt(spine.net_available_gr_fy2026_usd)}</strong>
        </li>
        <li>
          Allocation A FY2026: <strong>{moneyFmt(spine.allocation_a_fy2026_usd)}</strong>
        </li>
      </ul>
      <p class="muted">Not claimed: {(spine.not_claimed || []).join(" · ")}</p>
    </section>

    <section class="hub-section">
      <h2>Seven money ledgers</h2>
      {
        Object.values(ledgers).map((L: any) => (
          <div style="margin-bottom:1.5rem;">
            <h3>
              {L.id} — {L.question}
            </h3>
            <p class="muted">
              Status: {L.status}
              {L.scope_note && <> · {L.scope_note}</>}
              {L.rule && <> · {L.rule}</>}
            </p>
            <ul class="stack">
              {(L.entries || []).slice(0, 12).map((e: any) => (
                <li>
                  <span class="chip chip--queued">{e.evidence_class || "—"}</span>{" "}
                  <strong>{e.label}</strong>
                  {e.fy2026_usd != null && <> · {moneyFmt(e.fy2026_usd)}</>}
                  {e.fy2026_allocation_a_usd != null && <> · {moneyFmt(e.fy2026_allocation_a_usd)}</>}
                  {e.fy2026_actual_millions != null && <> · {millions(e.fy2026_actual_millions)}</>}
                  {e.see_class && <div class="muted">SEE class: {e.see_class}</div>}
                  {e.flexibility && <div class="muted">Flexibility: {e.flexibility}</div>}
                  {e.note && <div class="muted">{e.note}</div>}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="hub-section">
      <h2>Historical panel (FY2016–FY2026)</h2>
      <p class="lede">{hist.comparability_rule}</p>
      <p class="muted">Transforms when data exists: {(hist.transforms_attempted_when_data_exists || []).join(" · ")}</p>
      {
        (hist.series || []).map((s: any) => (
          <div style="margin-bottom:1rem;">
            <h3>{s.label}</h3>
            <ul class="stack">
              {Object.entries(s.by_year || {}).map(([y, cell]: [string, any]) => (
                <li>
                  <strong>{y}</strong>:{" "}
                  {cell.value == null
                    ? "UNKNOWN"
                    : typeof cell.value === "number" && cell.value > 10000
                      ? moneyFmt(cell.value)
                      : String(cell.value)}{" "}
                  <span class="muted">({cell.evidence_class})</span>
                </li>
              ))}
            </ul>
            {s.transforms && (
              <p class="muted">
                {Object.entries(s.transforms)
                  .map(([k, v]) => `${k}: ${v}`)
                  .join(" · ")}
              </p>
            )}
          </div>
        ))
      }
    </section>

    <section class="hub-section" id="flexibility">
      <h2>Fiscal Flexibility Map</h2>
      <p class="lede">{flex.rule}</p>
      <ul class="stack">
        {
          (flex.buckets || []).map((b: any) => (
            <li>
              <strong>{b.class}</strong>
              <div class="muted">{(b.examples || []).join(" · ")}</div>
              {b.caveat && <div class="muted">{b.caveat}</div>}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Federal Dependency Lens</h2>
      <p class="lede">{fed.rule}</p>
      <ul class="stack">
        {
          (fed.functions || []).map((f: any) => (
            <li>
              <strong>{f.function}</strong>
              <div class="muted">
                Federal share: {f.federal_share || "—"} · {f.evidence_class}
                {f.note && <> · {f.note}</>}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Observed Pattern Register</h2>
      <p class="muted">OBSERVATION — not PROBLEM. V2.2 decides desirability.</p>
      <ul class="stack">
        {
          patterns.map((p: any) => (
            <li>
              <strong>{p.id}</strong>
              <div>{p.observation}</div>
              <div class="muted">Not: {p.not}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Four visuals (contracts)</h2>
      <ul class="stack">
        {
          visuals.map((v: any) => (
            <li>
              <strong>{v.title}</strong> — {v.status}
              <div class="muted">{v.rule || v.reason}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Deferred</h2>
      <ul class="stack">
        {(pass.deferred || []).map((d: string) => <li>{d}</li>)}
      </ul>
      <p class="lede">Next: {pass.next}</p>
    </section>
  </article>
</BaseLayout>
