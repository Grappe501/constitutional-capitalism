---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import schema from "@data/project/cc_v2_geo_county_digital_twin_schema.json";
import inventory from "@data/project/cc_v2_geo_arkansas_75_inventory.json";
import geoDec from "@data/project/cc_v2_geo_001_decision.json";

const dims = schema.dimensions || [];
const records = inventory.records || [];
const partial = inventory.cells_partial ?? 0;
const empty = inventory.cells_empty ?? 0;
---

<BaseLayout
  title="Arkansas 75 — County Digital Twins"
  path="/v2/see-arkansas/counties/"
  description="75 standardized county records × 12 dimensions. Same model for every county. No rankings. No county books."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">{geoDec.id} LOCKED</span>
      <h1>{schema.title}</h1>
      <p class="lede">
        A structured county layer inside V2.1 — not 75 research projects, and not a sixth gate.
      </p>
      <p class="muted">
        {inventory.county_count} counties · {inventory.dimension_count} dimensions ·{" "}
        {inventory.matrix_cells} cells · {partial} PARTIAL · {empty} EMPTY
      </p>
    </header>

    <section class="hub-section">
      <h2>Two questions (never collapse them)</h2>
      <ul class="link-board">
        <li>
          <strong>{schema.two_questions?.arkansas_now?.label}</strong>
          <div class="muted">{schema.two_questions?.arkansas_now?.question}</div>
        </li>
        <li>
          <strong>{schema.two_questions?.cc_future?.label}</strong>
          <div class="muted">{schema.two_questions?.cc_future?.question}</div>
          <div class="muted">{schema.two_questions?.cc_future?.rule}</div>
        </li>
      </ul>
    </section>

    <section class="hub-section">
      <h2>12 dimensions (same for every county)</h2>
      <ul class="stack">
        {
          dims.map((d: any) => (
            <li>
              <strong>{d.label}</strong>
              <div class="muted">{d.question}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Build method</h2>
      <p class="lede">
        Wrong: County 1 → perfect book → County 2. Right:{" "}
        <strong>Field 1 → all 75</strong>, then Field 2 → all 75.
      </p>
      <p class="muted">{schema.decomposition_rule?.text}</p>
      <ul class="stack">
        {(geoDec.guardrails || []).map((g: string) => <li>{g}</li>)}
      </ul>
    </section>

    <section class="hub-section">
      <h2>75 counties</h2>
      <ul class="link-board">
        {
          records.map((r: any) => {
            const filled = Object.values(r.dimensions || {}).filter(
              (d: any) => d.status === "PARTIAL" || d.status === "COMPLETE",
            ).length;
            return (
              <li>
                <a href={`/v2/see-arkansas/counties/${r.fips}/`}>
                  <strong>{r.label}</strong>
                </a>
                <span class="muted">
                  {" "}
                  · {r.fips} · dims {filled}/12
                </span>
              </li>
            );
          })
        }
      </ul>
      <p>
        <a href="/v2/see-arkansas/counties/network/">County Network contract →</a>
        {" · "}
        <a href="/v2/see-arkansas/what-changed/v2-geo-001/">What Changed →</a>
        {" · "}
        <a href="/v2/see-arkansas/">V2.1 hub →</a>
      </p>
    </section>
  </article>
</BaseLayout>
