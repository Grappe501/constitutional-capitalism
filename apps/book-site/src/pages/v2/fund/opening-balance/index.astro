---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import pass from "@data/project/cc_v2_3_1_current_fiscal_baseline.json";

const ob = pass.opening_balance_and_flow_statement || {};
const stock = ob.stock || {};
const flow = ob.flow_fy2024 || {};
const gr = ob.gr_bridge_fy2026 || {};
---

<BaseLayout
  title="Arkansas' Opening Balance & Flow Statement"
  path="/v2/fund/opening-balance/"
  description="Stock and flow of Arkansas public money — without pretending net position is spendable cash."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">FOUNDATIONAL ARTIFACT</span>
      <span class="chip chip--done">COUNTABLE $0</span>
      <h1>{ob.title}</h1>
      <p class="lede">{ob.purpose}</p>
    </header>

    <section class="hub-section">
      <h2>Stock (as of ACFR 6/30/2024)</h2>
      <ul class="stack">
        <li>
          <strong>Ending net position</strong>: $
          {((stock.ending_net_position_acfr_usd || 0) / 1e9).toFixed(2)}B
          <div class="muted">{stock.not_spendable_note}</div>
        </li>
        <li>
          <strong>Bonds / notes / installment</strong>: $
          {((stock.claims_stock_usd?.bonds_notes_installment || 0) / 1e9).toFixed(2)}B
        </li>
        <li>
          <strong>Net pension liability</strong>: $
          {((stock.claims_stock_usd?.net_pension_liability || 0) / 1e9).toFixed(2)}B
        </li>
        <li>
          <strong>Total OPEB liability</strong>: $
          {((stock.claims_stock_usd?.total_opeb_liability || 0) / 1e9).toFixed(2)}B
        </li>
      </ul>
    </section>

    <section class="hub-section">
      <h2>Flow (FY2024)</h2>
      <ul class="stack">
        <li>
          <strong>ACFR revenues</strong>: ${((flow.money_in_acfr_total_usd || 0) / 1e9).toFixed(2)}B
        </li>
        <li>
          <strong>ACFR expenses</strong>: ${((flow.money_out_acfr_expenses_usd || 0) / 1e9).toFixed(2)}B
        </li>
        <li>
          <strong>Federal grants in (op+cap)</strong>: $
          {((flow.federal_grants_in_usd || 0) / 1e9).toFixed(2)}B
        </li>
        <li>
          <strong>AFY operating total</strong>: $
          {((flow.afy_operating_total_usd || 0) / 1e9).toFixed(2)}B · federal column $
          {((flow.afy_federal_column_usd || 0) / 1e9).toFixed(2)}B
        </li>
      </ul>
    </section>

    <section class="hub-section">
      <h2>GR bridge (FY2026 vintage — labeled separately)</h2>
      <ul class="link-board">
        <li>Gross GR ${(gr.gross_gr_usd / 1e9).toFixed(3)}B</li>
        <li>Net available ${(gr.net_available_usd / 1e9).toFixed(3)}B</li>
        <li>Allocation A ${(gr.allocation_a_usd / 1e9).toFixed(3)}B</li>
        <li>Surplus ${(gr.surplus_usd / 1e9).toFixed(3)}B</li>
      </ul>
      <p class="muted">{gr.note}</p>
    </section>

    <section class="hub-section">
      <h2>Rules</h2>
      <ul class="stack">
        {(ob.rules || []).map((r: string) => (
          <li>{r}</li>
        ))}
      </ul>
      <p>
        <strong>COUNTABLE public cash:</strong> ${ob.countable_public_cash_usd ?? 0}
      </p>
    </section>

    <p>
      <a href="/v2/fund/public-money-statement/">Public Money Statement →</a>
      {" · "}
      <a href="/v2/fund/current-baseline/">Baseline →</a>
      {" · "}
      <a href="/v2/fund/">FUND hub →</a>
    </p>
  </article>
</BaseLayout>
