---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import hub from "@data/project/cc_v2_3_fund_arkansas.json";

const prog = hub.progress || {};
const passes = hub.passes || [];
---

<BaseLayout
  title="V2.3 — FUND ARKANSAS"
  path="/v2/fund/"
  description="Cost the frozen redesign. Prove dollars exist before they pay for anything. COUNTABLE starts at $0."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--live">V2.3 ACTIVE</span>
      <span class="chip chip--done">COUNTABLE ${prog.countable_public_cash_usd ?? 0}</span>
      <h1>{hub.title}</h1>
      <p class="lede">{hub.governing_question}</p>
      <p class="lede">{hub.countable_rule}</p>
      <p class="muted">
        SEE CERTIFIED · REDESIGN FROZEN · Blueprint <strong>{prog.v2_blueprint_percent}%</strong> ·
        Objects <strong>{prog.fund_objects_closed}/{prog.fund_objects_total}</strong>
      </p>
    </header>

    <section class="hub-section">
      <h2>Honesty meter</h2>
      <ul class="link-board">
        <li>
          <strong>COUNTABLE public cash</strong>: ${prog.countable_public_cash_usd ?? 0}
        </li>
        <li>
          <strong>UNPROVEN / MODELED</strong>: ${prog.unproven_modeled_usd ?? 0}
        </li>
      </ul>
    </section>

    <section class="hub-section">
      <h2>Sequence (taxes last)</h2>
      <p class="lede">{(hub.sequence || []).join(" → ")}</p>
    </section>

    <section class="hub-section">
      <h2>Five FUND passes</h2>
      <ul class="stack">
        {
          passes.map((p: any) => (
            <li>
              <span
                class={
                  p.status === "COMPLETE"
                    ? "chip chip--done"
                    : p.status === "NEXT"
                      ? "chip chip--live"
                      : "chip chip--queued"
                }
              >
                {p.status}
              </span>{" "}
              <strong>
                {p.id} — {p.name}
              </strong>
              <div class="muted">{p.exit}</div>
              {p.href && (
                <div>
                  <a href={p.href}>Open →</a>
                  {p.what_changed && (
                    <>
                      {" · "}
                      <a href={p.what_changed}>What Changed →</a>
                    </>
                  )}
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <p>
      <a href="/v2/fund/opening-balance/">Opening Balance & Flow →</a>
      {" · "}
      <a href="/v2/fund/public-money-statement/">Public Money Statement →</a>
      {" · "}
      <a href="/v2/redesign/certification/">Frozen Redesign →</a>
    </p>
  </article>
</BaseLayout>
