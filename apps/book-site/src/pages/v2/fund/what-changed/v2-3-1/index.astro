---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import log from "@data/project/pass_changelogs/v2_3_1.json";

const ship = log.ship_record || {};
---

<BaseLayout
  title="What Changed — V2.3.1"
  path="/v2/fund/what-changed/v2-3-1/"
  description="What changed in V2.3.1 Current Fiscal Baseline."
>
  <article>
    <header class="hub-banner">
      <span class="chip chip--done">{log.status}</span>
      <h1>{log.pass_name}</h1>
      <p class="muted">
        {log.pass_id} · {log.decision_id} · {log.update_id} · {log.generated_at}
      </p>
      <p>
        <strong>COUNTABLE:</strong> ${log.countable_public_cash_usd ?? 0}
      </p>
    </header>

    <section class="hub-section">
      <h2>Ship record</h2>
      <ul class="link-board">
        <li>
          <strong>Closure gate</strong>: {ship.closure_gate || "—"}
        </li>
        <li>
          <strong>Git commit</strong>:{" "}
          {ship.git_commit_short ? <code>{ship.git_commit_short}</code> : "pending"}
        </li>
        <li>
          <strong>Deploy</strong>: {ship.deploy_id ? <code>{ship.deploy_id}</code> : "pending"}
        </li>
      </ul>
    </section>

    <section class="hub-section">
      <h2>Before → After</h2>
      <ul class="stack">
        {
          (log.before_after || []).map((row: any) => (
            <li>
              <strong>{row.label}</strong>
              <div class="muted">
                {row.before} → <strong>{row.after}</strong>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="hub-section">
      <h2>Surfaces</h2>
      <ul class="link-board">
        {
          (log.experience_links || []).map((l: any) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
