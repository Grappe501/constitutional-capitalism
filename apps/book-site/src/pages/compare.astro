---
import BaseLayout from "../layouts/BaseLayout.astro";
import { comparison, comparisonGroupedByFamily, type EconomicSystem } from "../lib/data";

const groups = comparisonGroupedByFamily();
const count = comparison.systems.length;
const CROSSWALK_DOMAINS = [
  "wealth",
  "labor",
  "competition",
  "democracy",
  "healthcare",
  "agriculture",
  "fiscal",
] as const;

const boundSystems = comparison.systems.filter((s) => s.phase3_crosswalk?.domains?.length);
const boundCount = boundSystems.length;

function hasDomain(s: EconomicSystem, domain: string): boolean {
  return (s.phase3_crosswalk?.domains || []).includes(domain);
}
---

<BaseLayout
  title="Compare Systems"
  path="/compare/"
  description="Phase 3 comparative systems matrix — evidence crosswalk, Arkansas relevance, and transition feasibility."
>
  <article>
    <h1 style="font-family:var(--serif);margin-top:0;">Economic system comparison</h1>
    <p class="muted">
      Developing analytical tool — not settled scholarship · {count} systems · {boundCount} with Phase 3
      evidence crosswalk
    </p>
    <p class="lede">
      This matrix is an expanded philosophical comparison, including historical ideal-types and modern
      variants. Categories overlap. Real-world systems are usually hybrids. Descriptions aim to be
      fair enough that an informed adherent would recognize them, while clearly distinguishing
      analysis from endorsement. This page invents no statistics.
    </p>

    <section class="phase3-intro" aria-labelledby="phase3-heading">
      <h2 id="phase3-heading" class="compare-family__title">Phase 3 — Evidence crosswalk</h2>
      <p>
        Phase 1 asked what each system claims. Phase 2 bound evidence layers on priority dossiers.
        Phase 3 adds a <strong>shared-dial crosswalk</strong>: which systems are already connected to
        the same observable domains (wealth, labor, competition, democracy, healthcare, agriculture,
        fiscal) so readers can compare coverage — not a ranking, score, or endorsement.
      </p>
      <p class="muted">
        Holds: observational dials ≠ capture proofs; <code>CC-CLAIM-003</code> remains NEE; HYP-125–129
        stay research tracks.
      </p>

      <div class="table-wrap">
        <table class="crosswalk-table">
          <thead>
            <tr>
              <th scope="col">System</th>
              {CROSSWALK_DOMAINS.map((d) => (
                <th scope="col">{d}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {boundSystems.map((s) => (
              <tr>
                <th scope="row">
                  <a href={`/compare/${s.slug}/`}>{s.name}</a>
                </th>
                {CROSSWALK_DOMAINS.map((d) => (
                  <td class={hasDomain(s, d) ? "cell-on" : "cell-off"}>
                    {hasDomain(s, d) ? "●" : "·"}
                    <span class="sr-only">
                      {hasDomain(s, d) ? `${d} bound` : `${d} not bound`}
                    </span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted crosswalk-note">
        ● = existing evidence panels bound for that domain on the system dossier. Empty cells mean not
        yet bound — not “the system lacks the issue.”
      </p>
    </section>

    <p>
      Click any system name for definition, function, emergence, claimed benefits, weaknesses,
      exemplars, neighbors, and sources. Systems with evidence layers also render live panels plus
      Arkansas relevance, for/against/NEE verdicts, and transition feasibility.
    </p>

    {
      groups.map((g) => (
        <section class="compare-family" aria-labelledby={`family-${g.family}`}>
          <h2 id={`family-${g.family}`} class="compare-family__title">
            {g.family}
            <span class="muted"> · {g.systems.length}</span>
          </h2>
          <div class="table-wrap">
            <table class="compare-table">
              <thead>
                <tr>
                  <th scope="col">System</th>
                  <th scope="col">Ownership</th>
                  <th scope="col">Property</th>
                  <th scope="col">Markets</th>
                  <th scope="col">Government / polity</th>
                  <th scope="col">Labor</th>
                  <th scope="col">Power &amp; concentration</th>
                  <th scope="col">Accountability</th>
                  <th scope="col">Historical exemplars</th>
                  <th scope="col">Relation to CC</th>
                </tr>
              </thead>
              <tbody>
                {g.systems.map((s) => (
                  <tr>
                    <th scope="row">
                      <a href={`/compare/${s.slug}/`}>{s.name}</a>
                      {s.phase3_crosswalk ? (
                        <div class="compare-phase2 muted">Phase 3 crosswalk</div>
                      ) : s.phase2_evidence ? (
                        <div class="compare-phase2 muted">Phase 2 evidence</div>
                      ) : null}
                      <div class="compare-era muted">{s.era}</div>
                    </th>
                    <td>{s.ownership_model}</td>
                    <td>{s.private_property}</td>
                    <td>{s.role_of_markets}</td>
                    <td>{s.role_of_government}</td>
                    <td>{s.labor_treatment}</td>
                    <td>{s.concentrated_power_approach}</td>
                    <td>{s.accountability_source}</td>
                    <td>{(s.historical_exemplars || []).join("; ")}</td>
                    <td>{s.relationship_to_cc}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))
    }

    <p class="lede" style="margin-top:1.5rem;">
      Repository notes: <code>content/public-resources/economic-system-comparison.md</code> and
      dossiers under <code>content/public-resources/systems/</code>. Also see
      <a href="/resources/">Resources</a>.
    </p>
  </article>
</BaseLayout>

<style>
  .table-wrap {
    overflow-x: auto;
    margin: 0.75rem 0 2rem;
    border: 1px solid var(--line);
  }
  .compare-family__title {
    font-family: var(--serif);
    font-size: 1.35rem;
    margin: 2rem 0 0.5rem;
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
    min-width: 1100px;
  }
  .compare-table th,
  .compare-table td {
    border-bottom: 1px solid var(--line);
    text-align: left;
    padding: 0.65rem 0.5rem;
    vertical-align: top;
  }
  .compare-table thead th {
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
    background: var(--paper, transparent);
    position: sticky;
    top: 0;
  }
  .compare-table tbody th {
    position: sticky;
    left: 0;
    background: var(--bg, #fff);
    min-width: 11rem;
    max-width: 14rem;
    z-index: 1;
    font-weight: 650;
  }
  .compare-table tbody th a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .compare-era {
    font-weight: 400;
    font-size: 0.78rem;
    margin-top: 0.25rem;
    line-height: 1.35;
  }
  .compare-phase2 {
    font-weight: 500;
    font-size: 0.72rem;
    margin-top: 0.2rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .crosswalk-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    min-width: 720px;
  }
  .crosswalk-table th,
  .crosswalk-table td {
    border-bottom: 1px solid var(--line);
    padding: 0.55rem 0.45rem;
    text-align: center;
    vertical-align: middle;
  }
  .crosswalk-table thead th {
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .crosswalk-table tbody th {
    text-align: left;
    font-weight: 650;
    position: sticky;
    left: 0;
    background: var(--bg, #fff);
    min-width: 12rem;
  }
  .crosswalk-table tbody th a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .cell-on {
    color: var(--ink, #111);
    font-size: 1.05rem;
  }
  .cell-off {
    color: var(--ink-soft);
    opacity: 0.45;
  }
  .crosswalk-note {
    margin-top: -0.75rem;
    margin-bottom: 1.5rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
