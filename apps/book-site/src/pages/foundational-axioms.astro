---
import BaseLayout from "../layouts/BaseLayout.astro";
import ax from "../../../../data/project/foundational_axioms.json";

const axioms = ax.axioms || [];
const components = ax.component_maturity_estimate?.components || [];
const related = ax.first_principle?.related_existing || [];
const never = axioms.find((a: any) => a.id === "CC-AXIOM-09")?.never_compromise || [];
const prosperityIncludes = axioms.find((a: any) => a.id === "CC-AXIOM-01")?.includes || [];
const prosperityNot = axioms.find((a: any) => a.id === "CC-AXIOM-01")?.is_not || [];
---

<BaseLayout
  title="Foundational Axioms"
  path="/foundational-axioms/"
  description="The Ten Foundational Axioms of Constitutional Capitalism — distill philosophy into a coherent operating doctrine."
>
  <article class="prose">
    <h1>{ax.title}</h1>
    <p class="muted">
      Proposed distillation ({ax.decision_id}). Not a new policy principle and not a Declaration
      rewrite. Philosophy integration for the remaining foundational-philosophy work — integrate,
      bound, and operationalize rather than add domains.
    </p>

    <h2>Why this document</h2>
    <p>{ax.purpose}</p>
    <p>{ax.foundational_philosophy_diagnosis.layer_percent_note}</p>
    <p>Remaining work is:</p>
    <ul>
      {ax.foundational_philosophy_diagnosis.remaining_work_is.map((x: string) => (
        <li>{x}</li>
      ))}
    </ul>
    <p>Remaining work is not:</p>
    <ul>
      {ax.foundational_philosophy_diagnosis.remaining_work_is_not.map((x: string) => (
        <li>{x}</li>
      ))}
    </ul>

    <h2>First Principle</h2>
    <blockquote>
      <p>{ax.first_principle.text}</p>
    </blockquote>
    <p>{ax.first_principle.rule}</p>
    <p class="muted">Related existing commitments (not replaced):</p>
    <ul>
      {related.map((r: any) => (
        <li>
          <code>{r.id}</code> — {r.text}
        </li>
      ))}
    </ul>

    <h2>Derivation rule</h2>
    <p>{ax.derivation_rule.text}</p>

    <h2>The Ten Axioms</h2>
    {
      axioms.map((a: any, i: number) => (
        <section style="margin-bottom:1.25rem;">
          <h3>
            {i + 1}. {a.title}
          </h3>
          <blockquote>
            <p>{a.text}</p>
          </blockquote>
          {a.framing ? <p>{a.framing}</p> : null}
          {a.why ? <p class="muted">{a.why}</p> : null}
          {a.id === "CC-AXIOM-01" ? (
            <>
              <p>Includes:</p>
              <ul>
                {prosperityIncludes.map((x: string) => (
                  <li>{x}</li>
                ))}
              </ul>
              <p>Is not:</p>
              <ul>
                {prosperityNot.map((x: string) => (
                  <li>{x}</li>
                ))}
              </ul>
            </>
          ) : null}
          {a.id === "CC-AXIOM-09" ? (
            <ul>
              {never.map((x: string) => (
                <li>{x}</li>
              ))}
            </ul>
          ) : null}
          {a.dignity_guardrail ? <p>{a.dignity_guardrail}</p> : null}
        </section>
      ))
    }

    <h2>Working maturity estimates</h2>
    <p class="muted">{ax.component_maturity_estimate.note}</p>
    <p>{ax.component_maturity_estimate.synthesis}</p>
    <ul>
      {components.map((c: any) => (
        <li>
          {c.component}: {c.completion_percent}%
        </li>
      ))}
    </ul>

    <h2>Declaration rule</h2>
    <p>{ax.declaration_rule.text}</p>

    <p class="muted">
      See also <a href="/declaration/">Declaration</a>, <a href="/human-capital/">Human Capital</a>,{" "}
      <a href="/civic-wealth/">Civic Wealth</a>, and{" "}
      <a href="/local-ownership/">Local Ownership</a>.
    </p>
  </article>
</BaseLayout>
