---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { claims, sources } from "../../lib/data";

const list = claims.claims || [];
const supportCounts: Record<string, number> = {};
for (const c of list) {
  const k = c.support_level || "unknown";
  supportCounts[k] = (supportCounts[k] || 0) + 1;
}
---

<BaseLayout
  title="Evidence"
  path="/evidence/"
  description="Claim ledger and source registry for Constitutional Capitalism — opposing evidence visible."
>
  <article class="prose">
    <h1>Evidence</h1>
    <p class="lede">
      Public view of the claim ledger and registered sources. Empty support is shown as empty —
      never filled with invented citations.
    </p>
    <p>
      <a href="/evidence/methodology/">Methodology</a> ·
      <a href="/evidence/open-questions/">Open questions</a>
    </p>

    <div class="progress-list" style="margin:1.25rem 0;">
      <p style="margin:0;">
        Sources: <strong>{sources.sources?.length ?? 0}</strong> · Claims:
        <strong>{list.length}</strong>
      </p>
      <ul>
        {Object.entries(supportCounts).map(([k, v]) => (
          <li>
            {k}: {v}
          </li>
        ))}
      </ul>
    </div>

    <h2>Priority claims</h2>
    <ul class="list-plain" style="padding:0;list-style:none;">
      {
        list.map((c: any) => (
          <li style="margin:0 0 1.25rem;padding-bottom:1rem;border-bottom:1px solid var(--line);">
            <div>
              <code>{c.claim_id}</code>{" "}
              <span class="status-note" style="display:inline;padding:0.15rem 0.45rem;">
                {c.support_level}
              </span>
            </div>
            <p style="margin:0.4rem 0;">{c.public_wording || c.claim_text}</p>
            <p style="margin:0;font-size:0.92rem;color:var(--ink-soft);">
              Sources: {(c.source_ids || []).length ? c.source_ids.join(", ") : "none yet"}
            </p>
            {
              (c.opposing_evidence || []).length > 0 && (
                <details style="margin-top:0.5rem;">
                  <summary>Contrary evidence</summary>
                  <ul>
                    {c.opposing_evidence.map((o: string) => (
                      <li>{o}</li>
                    ))}
                  </ul>
                </details>
              )
            }
          </li>
        ))
      }
    </ul>

    <h2>Registered sources</h2>
    <ul>
      {
        (sources.sources || []).map((s: any) => (
          <li>
            <code>{s.source_id}</code> — {s.title} ({s.year})
            {s.primary_or_secondary ? ` · ${s.primary_or_secondary}` : ""}
            {s.url ? (
              <>
                {" "}
                · <a href={s.url} rel="noopener noreferrer">link</a>
              </>
            ) : null}
          </li>
        ))
      }
    </ul>
  </article>
</BaseLayout>
