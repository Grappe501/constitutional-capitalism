---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { claims } from "../../lib/data";

const open = (claims.claims || []).filter((c: any) =>
  ["requires_additional_research", "unsupported", "contested"].includes(c.support_level)
);
---

<BaseLayout
  title="Open evidence questions"
  path="/evidence/open-questions/"
  description="Claims that remain incomplete, contested, or unsupported."
>
  <article class="prose">
    <h1>Open questions</h1>
    <p class="lede">
      Incomplete is marked incomplete. These claims are tracked so the project cannot quietly treat
      them as settled.
    </p>
    <ul>
      {
        open.map((c: any) => (
          <li>
            <code>{c.claim_id}</code> ({c.support_level}) — {c.claim_text}
            {c.uncertainty ? <em> Uncertainty: {c.uncertainty}</em> : null}
          </li>
        ))
      }
    </ul>
    <p><a href="/evidence/">← Evidence</a></p>
  </article>
</BaseLayout>
