---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { baselineMethodology } from "../../lib/data";
---

<BaseLayout
  title="Evidence methodology"
  path="/evidence/methodology/"
  description="How Constitutional Capitalism registers sources and rates claims."
>
  <article class="prose">
    <h1>Evidence methodology</h1>
    <p class="lede">
      Diagnosis before prescription. Every number needs a source ID, reference period, definition,
      and limitations.
    </p>

    <h2>Hard rules</h2>
    <ul>
      <li>No invented statistics or fake citations.</li>
      <li>Federal/primary sources preferred; secondary sources labeled.</li>
      <li>Supporting and contrary evidence both recorded.</li>
      <li>Normative proposals and predictions are labeled — not presented as established fact.</li>
      <li>Contested items stay contested.</li>
    </ul>

    <h2>Support levels</h2>
    <ul>
      <li><strong>supported</strong> — strong primary evidence for the claim as worded</li>
      <li><strong>partially_supported</strong> — real evidence with material caveats</li>
      <li><strong>contested</strong> — serious conflicting literatures</li>
      <li><strong>unsupported</strong> — no adequate evidence (includes untested predictions)</li>
      <li><strong>requires_additional_research</strong> — architecture present; sourcing incomplete</li>
    </ul>

    <h2>Baseline methodology</h2>
    <ul>
      {(baselineMethodology.principles || []).map((p: string) => (
        <li>{p}</li>
      ))}
    </ul>

    <p><a href="/evidence/">← Evidence</a> · <a href="/evidence/open-questions/">Open questions</a></p>
  </article>
</BaseLayout>
