---
import BaseLayout from "../layouts/BaseLayout.astro";
import EvidencePanel from "../components/EvidencePanel.astro";
import { claims, sources, baselineStatus } from "../lib/data";
import panels from "../../../../data/project/publication_evidence_panels.json";

const priorityDomains = [
  { id: "wealth", title: "Wealth and ownership", claim: "CC-CLAIM-011", note: "Fed SCF/DFA: high concentration; mean far above median. See Evidence Panel below." },
  { id: "wages", title: "Wages and productivity", claim: "CC-CLAIM-002", note: "Recent dials: real AHE +1.1% (L01), productivity +2.3% (L02); longer BLS/EPI gap debate remains open." },
  { id: "taxation", title: "Taxation", claim: "CC-CLAIM-013", note: "CBO 2021: transfers and federal taxes compress inequality without erasing it." },
  { id: "concentration", title: "Corporate power / concentration", claim: "CC-CLAIM-005", note: "DOJ ATR criminal cases filed: 20 (FY2024, C03). Census CR ratios remain industry-specific — not a national %." },
  { id: "ownership", title: "Worker ownership", claim: "CC-CLAIM-004", note: "Research finds modest average gains with heterogeneity — not universal improvement." },
  { id: "rural", title: "Local and rural economies", claim: "CC-CLAIM-019", note: "ERS/FDIC: widespread county stress indicators alongside uneven recent gains." },
  { id: "commerce", title: "Internet commerce", claim: "CC-CLAIM-016", note: "Architecture ready; national leakage magnitudes not yet sourced." },
  { id: "power", title: "Political and economic power", claim: "CC-CLAIM-003", note: "Concentration measurable; democratic-accountability causation still open (NEE). Disclosure spine and D04 now shown on Democracy." },
  { id: "justice", title: "Justice, safety, and restoration", claim: "CC-CLAIM-021", note: "Developing doctrine seeded; sourced diagnosis queued for Phase 2.1 — no invented justice statistics." },
  { id: "democracy", title: "Democracy and distributed government", claim: "CC-CLAIM-025", note: "Rucho sourced; D04 campaign-funding concentration 73%; public trust 15.4% (D10); competition metrics still thin." },
  { id: "public-service", title: "Public service and institutional modernization", claim: "CC-CLAIM-031", note: "Invisible—but never unaccountable; reduce friction while improving service — architecture seeded; no invented board counts." },
  { id: "transparency", title: "Constitutional transparency and the People's Ledger", claim: "CC-CLAIM-034", note: "People's Ledger is a design agenda. Arkansas 90-day coding: outlet presence ≠ institutional scrutiny." },
  { id: "essential-systems", title: "Essential systems (banking, insurance, healthcare)", claim: "CC-CLAIM-038", note: "System-design framing — incentives and outcomes, not inherent corruption; Community Health Index is a design agenda." },
  { id: "human-capital", title: "Human capital doctrine and regional academies", claim: "CC-CLAIM-042", note: "Multiple pathways of equal dignity; academies are a pilot design agenda — no invented outcomes." },
  { id: "build-community", title: "Build your community / playbooks", claim: "CC-CLAIM-046", note: "Playbooks and Community OS are design agendas — no invented town growth outcomes." },
];

const byId = Object.fromEntries((claims.claims || []).map((c: any) => [c.claim_id, c]));
const sourcedClaims = (claims.claims || []).filter((c: any) => (c.source_ids || []).length > 0).length;
const wealthPanel = (panels.panels || []).find((p: { panel_id: string }) => p.panel_id === "CC-EP-WEALTH-BASELINE-1");
const trustPanel = (panels.panels || []).find((p: { panel_id: string }) => p.panel_id === "CC-EP-TRUST-AND-BASELINE-DIAL-1");
const wagesPanel = (panels.panels || []).find((p: { panel_id: string }) => p.panel_id === "CC-EP-WAGES-PRODUCTIVITY-1");
const competitionPanel = (panels.panels || []).find(
  (p: { panel_id: string }) => p.panel_id === "CC-EP-COMPETITION-ENFORCEMENT-1"
);
---

<BaseLayout
  title="Where We Are"
  path="/where-we-are/"
  description="Cautious national diagnosis: present condition, evidence, and open questions."
>
  <article class="prose">
    <h1>Where we are</h1>
    <p class="lede">
      Phase 2 asks what the present condition of American economic and civic life is — and what
      evidence would justify restructuring the system. Findings below are sourced or explicitly marked incomplete.
    </p>
    <p class="muted">
      National diagnosis: first-pass in progress. Sources registered: {sources.sources?.length ?? 0}.
      Claims with sources: {sourcedClaims}. Baseline metrics sourced: {baselineStatus.sourced_metrics ?? 0}
      / {baselineStatus.total_metrics ?? "—"}.
    </p>

    {trustPanel ? <EvidencePanel panel={trustPanel} /> : null}
    {wealthPanel ? <EvidencePanel panel={wealthPanel} /> : null}
    {wagesPanel ? <EvidencePanel panel={wagesPanel} /> : null}
    {competitionPanel ? <EvidencePanel panel={competitionPanel} /> : null}

    <h2>Priority domains</h2>
    {
      priorityDomains.map((d) => {
        const c = byId[d.claim];
        return (
          <section id={d.id} style="margin-bottom:1.75rem;">
            <h3 style="margin-bottom:0.35rem;">{d.title}</h3>
            <p style="margin:0 0 0.5rem;">{d.note}</p>
            {
              c && (
                <p style="margin:0;font-size:0.95rem;">
                  <code>{c.claim_id}</code> — {c.support_level}
                  {c.public_wording ? ` · ${c.public_wording}` : ""}
                </p>
              )
            }
          </section>
        );
      })
    }

    <h2>What this page is not</h2>
    <ul>
      <li>Not a finished national diagnosis across all domains.</li>
      <li>Not a forecast of Constitutional Capitalism outcomes (predictions stay labeled unsupported).</li>
      <li>Not a partisan scorecard. Contrary evidence is preserved in the claim ledger.</li>
    </ul>
    <p>
      See <a href="/justice/">Justice</a>, <a href="/democracy/">Democracy</a>,
      <a href="/public-service/">Public Service</a>,
      <a href="/transparency/">Transparency</a>,
      <a href="/essential-systems/">Essential Systems</a>,
      <a href="/human-capital/">Human Capital</a>, and
      <a href="/build-your-community/">Build Your Community</a> for developing doctrine domains,
      <a href="/evidence/">Evidence</a> for claim support levels, and
      <a href="/metrics/">Metrics</a> for baseline completeness.
    </p>
  </article>
</BaseLayout>
