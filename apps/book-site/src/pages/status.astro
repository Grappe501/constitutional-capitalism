---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  snapshot,
  publicProgressLayers,
  updates,
  baselineStatus,
  principles,
} from "../lib/data";
import phase2Lock from "../../../../data/project/phase2_mission_lock.json";
import ia from "../../../../data/project/website_information_architecture.json";
import latestReturn from "../../../../data/project/latest_cursor_return.json";
import completion from "../../../../data/project/completion_ladder_and_dashboard.json";

const publicLayers = publicProgressLayers();
const publicUpdates = (updates.updates || [])
  .filter((u: any) => u.public)
  .slice(-8)
  .reverse();
const seededDomains = (ia.domain_tree || []).filter((n: any) => n.status === "seeded");
const majorDomains = seededDomains.filter((n: any) => n.path || n.framework_file);
const principleCount = principles.principles?.length ?? snapshot.principles_count ?? 0;
const research = snapshot.research || {};
const doctrine = snapshot.doctrine || {};
const bars = completion.progress_bars || {};
const overallCompletion = completion.overall_project_completion?.percent ?? 0;
const generatedLabel = snapshot.generated_at
  ? new Date(snapshot.generated_at).toLocaleString("en-US", {
      timeZone: "UTC",
      year: "numeric",
      month: "short",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    }) + " UTC"
  : "—";
---

<BaseLayout
  title="Status"
  path="/status/"
  description="Public project status for Constitutional Capitalism — inventory, honesty dials, and progress layers."
>
  <article class="prose">
    <h1>Project status</h1>
    <p class="lede">
      <span class="chip chip--done">{completion.foundational_build?.banner || "FOUNDATIONAL BUILD — COMPLETE"}</span>
    </p>
    <p class="lede">
      <strong>
        {completion.foundational_build?.name || "Constitutional Capitalism Foundational System"}{" "}
        {completion.foundational_build?.version || "v1.0"}
      </strong>
    </p>
    <p class="lede">
      {completion.foundational_build?.distinction ||
        "The Constitutional Capitalism foundational build is complete."}
    </p>
    <p>
      Depths: <a href="/public-book/">UNDERSTAND</a> ·{" "}
      <a href="/compare/explorer/">LEARN</a> · <a href="/unabridged/">PROVE</a>
    </p>
    <p class="muted">
      Snapshot {generatedLabel}. Architecture is closed. Later work is stewardship — versions,
      evidence, public understanding, and deliberately chosen pilots.
    </p>

    <h2>Certified lanes</h2>
    <p class="lede">
      <strong>Technical System — Certified</strong>
      {" · "}
      <strong>Public Book — Certified</strong>
      {" · "}
      <strong>Validation — Certified</strong>
      {" · "}
      <strong>Unabridged — Published</strong>
    </p>
    <h2>Three permanent indicators</h2>
    <ul class="link-board" style="margin:0.75rem 0 1rem;">
      <li>
        <span class="chip chip--done">COMPLETE</span>{" "}
        <strong>FOUNDATIONAL SYSTEM v1.0</strong> — frozen
      </li>
      <li>
        <span class="chip chip--queued">HOLD</span>{" "}
        <strong>{completion.comparison_explorer_lane?.label || "EXPLORER EXPERIENCE — 0.1 HOLD"}</strong>
        {" · "}
        <a href="/compare/explorer/">Open →</a>
      </li>
      <li>
        <span class="chip chip--live">BLUEPRINT</span>{" "}
        <strong>{completion.v2_blueprint?.label || "V2 BLUEPRINT"}</strong> —{" "}
        {completion.v2_blueprint?.percent ?? 0}% → 100%
        {" · "}
        <a href="/v2/">Master Build Plan →</a>
        <div class="muted">{completion.v2_blueprint?.note}</div>
      </li>
    </ul>
    <p class="muted">
      Recommended next:{" "}
      <a href="/v2/">V2.1 — SEE ARKANSAS</a> (baseline objects only). Map frozen · Explorer 0.1 HOLD ·
      no redesign/funding/pilots yet.
    </p>
    <div class="progress-list" style="margin-top:1rem;">
      {[
        ["Skeleton coverage", bars.skeleton_coverage_percent],
        ["First-pass coverage", bars.first_pass_coverage_percent],
        ["Unabridged completion", bars.unabridged_completion_percent ?? bars.publication_completion_percent],
        ["Validation completion", bars.validation_completion_percent],
        ["Public Book (Stage 5)", completion.public_book?.percent ?? 0],
      ].map(([label, percent]) => (
        <div class="progress-item">
          <label>
            <span>{label}</span>
            <span aria-hidden="true">{percent ?? 0}%</span>
          </label>
          <div
            class="bar"
            role="progressbar"
            aria-label={`${label} progress`}
            aria-valuemin={0}
            aria-valuemax={100}
            aria-valuenow={percent ?? 0}
          >
            <span style={`width:${percent ?? 0}%`} />
          </div>
        </div>
      ))}
    </div>
    <p class="muted" style="margin-top:0.75rem;">
      Active stage: {completion.stages?.find((s: any) => s.status === "ACTIVE" || s.status === "IN_PROGRESS")?.name || "—"}.
      <a href="/public-book/">Public Book hub →</a>
      {completion.horizontal_expansion_frozen && <> Horizontal expansion frozen.</>}
    </p>

    {(completion.stage3_category_bars || []).length > 0 && (
      <>
        <h3>Stage 3 categories</h3>
        <div class="progress-list" style="margin-top:0.75rem;">
          {(completion.stage3_category_bars || []).map((c: any) => (
            <div class="progress-item">
              <label>
                <span>{c.label}</span>
                <span aria-hidden="true">{c.percent}%</span>
              </label>
              <div
                class="bar"
                role="progressbar"
                aria-label={`${c.label} progress`}
                aria-valuemin={0}
                aria-valuemax={100}
                aria-valuenow={c.percent}
              >
                <span style={`width:${c.percent}%`} />
              </div>
            </div>
          ))}
        </div>
      </>
    )}

    <h2>Honesty dials</h2>
    <ul>
      <li>
        Phase 1: <span class="chip">{phase2Lock.phase_1?.status || "LOCKED / CLOSED"}</span>
      </li>
      <li>
        Phase 2: <span class="chip">{latestReturn.phase_2_status || "PARTIAL"}</span> — architecture
        ahead of evidence
      </li>
      <li>
        National baseline:{" "}
        <span class="chip">
          {baselineStatus.sourced_metrics ?? 0}/{baselineStatus.total_metrics ?? 86} sourced
        </span>
      </li>
      <li>
        Economic modeling: <span class="chip">0%</span>
      </li>
      <li>
        Legal review: <span class="chip">0%</span>
      </li>
      <li>
        Active mission: <code>{latestReturn.mission_id || phase2Lock.active_mission?.mission_id || "—"}</code>
      </li>
    </ul>

    <h2>Layer inventory (legacy)</h2>
    <p class="muted">
      Layer percents below remain useful scaffolding inventory. They are not the Stage completion
      dashboard.
    </p>

    <div class="progress-list" style="margin-top:1.25rem;">
      {
        publicLayers.map((layer) => (
          <div class="progress-item">
            <label>
              <span>{layer.label}</span>
              <span aria-hidden="true">{layer.percent}%</span>
            </label>
            <div
              class="bar"
              role="progressbar"
              aria-label={`${layer.label} progress`}
              aria-valuemin={0}
              aria-valuemax={100}
              aria-valuenow={layer.percent}
            >
              <span style={`width:${layer.percent}%`} />
            </div>
          </div>
        ))
      }
    </div>

    <h2>Current inventory</h2>
    <ul>
      <li>
        Principles registered: <strong>{principleCount}</strong>
      </li>
      <li>
        Developing doctrine items: <strong>{doctrine.items ?? "—"}</strong>
      </li>
      <li>
        Capture clusters: <strong>{doctrine.clusters ?? "—"}</strong>
      </li>
      <li>
        Claims registered: <strong>{research.claims ?? 0}</strong>
        {research.supported_claims != null ? ` (${research.supported_claims} supported/partial)` : ""}
      </li>
      <li>
        Sources registered: <strong>{research.sources ?? 0}</strong>
        {research.verified_sources != null ? ` (${research.verified_sources} verification-confirmed)` : ""}
      </li>
      <li>
        Claims with source links: <strong>{research.claims_with_sources ?? "—"}</strong>
      </li>
      <li>
        Book-structure chapter units: <strong>{snapshot.manuscript?.units ?? "—"}</strong>
        {" "}({snapshot.manuscript?.outlined_units ?? 0} outlined · manuscript drafting still early)
      </li>
      <li>
        Decisions approved / open:{" "}
        <strong>
          {snapshot.decisions?.approved ?? 0} / {snapshot.decisions?.open ?? 0}
        </strong>
      </li>
      <li>
        Seeded website domains: <strong>{snapshot.website?.seeded_nodes ?? majorDomains.length}</strong>
      </li>
    </ul>

    <h2>Major seeded domains</h2>
    <p class="muted">
      Architecture pages for public reading. Architecture ≠ proof that institutions already exist.
    </p>
    <ul>
      {
        majorDomains.map((n: any) => (
          <li>
            {n.path ? <a href={n.path}>{n.title}</a> : n.title}
            {n.decision_id ? (
              <>
                {" "}
                · <code>{n.decision_id}</code>
              </>
            ) : null}
          </li>
        ))
      }
    </ul>

    <h2>Recent public updates</h2>
    <ul>
      {
        publicUpdates.map((u: any) => (
          <li>
            <strong>{u.id}</strong> — {u.title}
            <br />
            <span class="muted" style="margin:0;">{u.summary}</span>
          </li>
        ))
      }
    </ul>
    <p>
      <a href="/updates/">All updates</a> · <a href="/where-we-are/">Where we are</a> ·{" "}
      <a href="/evidence/">Evidence</a> · <a href="/metrics/">Baseline metrics</a>
    </p>

    <h2>What this page does not claim</h2>
    <ul>
      <li>Not Phase 2 completion.</li>
      <li>Not that modeling or legal review has begun.</li>
      <li>Not that National Baseline is filled in (still {baselineStatus.sourced_metrics ?? 2}/{baselineStatus.total_metrics ?? 86}).</li>
      <li>Not that doctrine architecture equals empirical proof.</li>
    </ul>
  </article>
</BaseLayout>
