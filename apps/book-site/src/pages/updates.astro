---
import BaseLayout from "../layouts/BaseLayout.astro";
import { updates } from "../lib/data";
---

<BaseLayout title="Updates" path="/updates/" description="Versioned project updates.">
  <article class="prose">
    <h1>Project updates</h1>
    <div class="stack">
      {
        updates.updates
          .filter((u) => u.public)
          .map((u) => (
            <section class="principle">
              <div class="principle__id">
                {u.date} · {u.id}
              </div>
              <h2 style="font-size:1.25rem;margin:0.35rem 0;">{u.title}</h2>
              <p>{u.summary}</p>
            </section>
          ))
      }
    </div>
  </article>
</BaseLayout>
