---
import BaseLayout from "../layouts/BaseLayout.astro";
import es from "../../../../data/project/energy_sovereignty_framework.json";

const priorities = es.priority_sequence?.order || [];
const fuels = es.diversified_system?.develop || [];
const corpMay = es.american_energy_and_resilience_corporation?.may || [];
const corpGov = es.american_energy_and_resilience_corporation?.governance || [];
const fundSources = es.national_energy_prosperity_fund?.revenue_sources || [];
const allocation =
  es.national_energy_prosperity_fund?.illustrative_distributable_allocation?.shares || [];
const debtEra = es.debt_first_then_prosperity?.debt_era_priority || [];
const postDebt = es.debt_first_then_prosperity?.post_debt_shift || [];
const hostExamples = es.community_energy_dividends?.hosting_examples || [];
const hostBenefits = es.community_energy_dividends?.benefits || [];
const exportForms = es.export_forms?.forms || [];
const prosperityQs = es.domestic_prosperity_test?.questions || [];
const localOpts = es.community_owned_stack?.local_options || [];
const stack = es.community_owned_stack?.national_stack || [];
const guard = es.guardrails?.require || [];
const fullCosts = es.environmental_responsibility?.full_costs || [];
const baselines = es.sourced_context_baselines?.items || [];
const testQs = es.energy_sovereignty_test?.questions || [];
const branches = es.website_branches || [];
---

<BaseLayout
  title="Energy Sovereignty"
  path="/energy-sovereignty/"
  description="Power America first. Strengthen the free world second. Return the profit to the people. Energy sovereignty with a People’s Energy Dividend."
>
  <article class="prose">
    <h1>{es.domain_title}</h1>
    <p class="status-note">
      Major national doctrine — architecture before statutes. Prosperity Fund percentages are
      illustrative design parameters requiring modeling. Legal drafting and fund modeling remain 0%.
      EIA/DOE baselines are sourced context — not proof that public-return institutions already exist.
    </p>

    <h2>Governing principle</h2>
    <blockquote>
      <p>{es.governing_principle.text}</p>
    </blockquote>

    <h2>Memorable principle</h2>
    <blockquote>
      <p>{es.memorable_principle.text}</p>
    </blockquote>

    <h2>Doctrine</h2>
    <blockquote>
      <p>{es.doctrine_statement.text}</p>
    </blockquote>

    <h2>Order of priority</h2>
    <ol>
      {priorities.map((p: string) => (
        <li>{p}</li>
      ))}
    </ol>
    <blockquote>
      <p>{es.priority_sequence.principle}</p>
    </blockquote>
    <p>{es.priority_sequence.export_constraint}</p>

    <h2>Sovereignty, not autarky</h2>
    <p>{es.sovereignty_not_autarky.summary}</p>
    <blockquote>
      <p>{es.sovereignty_not_autarky.definition}</p>
    </blockquote>

    <h2>Sourced context baselines</h2>
    <p class="status-note">{es.sourced_context_baselines.note}</p>
    <ul>
      {baselines.map((b: any) => (
        <li>
          <code>{b.id}</code> — {b.text}
        </li>
      ))}
    </ul>

    <h2>Diversified national energy system</h2>
    <p>{es.diversified_system.summary}</p>
    <blockquote>
      <p>{es.diversified_system.engineering_question}</p>
    </blockquote>
    <ul>
      {fuels.map((f: string) => (
        <li>{f}</li>
      ))}
    </ul>

    <h2>American Energy and Resilience Corporation</h2>
    <p>{es.american_energy_and_resilience_corporation.summary}</p>
    <p>It could:</p>
    <ul>
      {corpMay.map((m: string) => (
        <li>{m}</li>
      ))}
    </ul>
    <p>Governance:</p>
    <ul>
      {corpGov.map((g: string) => (
        <li>{g}</li>
      ))}
    </ul>
    <p>
      <strong>Does not:</strong> {es.american_energy_and_resilience_corporation.does_not}
    </p>

    <h2>National Energy Prosperity Fund</h2>
    <p>{es.national_energy_prosperity_fund.summary}</p>
    <ul>
      {fundSources.map((s: string) => (
        <li>{s}</li>
      ))}
    </ul>
    <p class="status-note">
      {es.national_energy_prosperity_fund.illustrative_distributable_allocation.note}
    </p>
    <ul>
      {allocation.map((a: any) => (
        <li>
          {a.percent}% — {a.use}
        </li>
      ))}
    </ul>

    <h2>Debt first, then community prosperity</h2>
    <p>{es.debt_first_then_prosperity.summary}</p>
    <p>Debt-era priority:</p>
    <ul>
      {debtEra.map((d: string) => (
        <li>{d}</li>
      ))}
    </ul>
    <p>Later shift:</p>
    <ul>
      {postDebt.map((d: string) => (
        <li>{d}</li>
      ))}
    </ul>
    <blockquote>
      <p>{es.debt_first_then_prosperity.public_promise}</p>
    </blockquote>

    <h2>Community Energy Dividends</h2>
    <p>{es.community_energy_dividends.summary}</p>
    <p>Hosting examples:</p>
    <ul>
      {hostExamples.map((h: string) => (
        <li>{h}</li>
      ))}
    </ul>
    <p>Benefits:</p>
    <ul>
      {hostBenefits.map((b: string) => (
        <li>{b}</li>
      ))}
    </ul>

    <h2>Export forms</h2>
    <p>{es.export_forms.summary}</p>
    <ul>
      {exportForms.map((f: string) => (
        <li>{f}</li>
      ))}
    </ul>

    <h2>Domestic Prosperity Test</h2>
    <p>{es.domestic_prosperity_test.summary}</p>
    <ol>
      {prosperityQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>

    <h2>Community-owned production</h2>
    <p>{es.community_owned_stack.summary}</p>
    <ul>
      {localOpts.map((o: string) => (
        <li>{o}</li>
      ))}
    </ul>
    <ol>
      {stack.map((s: string) => (
        <li>{s}</li>
      ))}
    </ol>

    <h2>Guardrails</h2>
    <p>{es.guardrails.summary}</p>
    <ul>
      {guard.map((g: string) => (
        <li>{g}</li>
      ))}
    </ul>

    <h2>Environmental responsibility</h2>
    <p>{es.environmental_responsibility.summary}</p>
    <ul>
      {fullCosts.map((c: string) => (
        <li>{c}</li>
      ))}
    </ul>

    <h2>Energy sovereignty test</h2>
    <p>{es.energy_sovereignty_test.purpose}</p>
    <ol>
      {testQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>

    <h2>Website branches</h2>
    <ul>
      {branches.map((b: any) => (
        <li>
          <strong>{b.title}</strong> — {b.summary}
        </li>
      ))}
    </ul>

    <p class="status-note">
      See also <a href="/resource-sovereignty/">Resource Sovereignty</a>,{" "}
      <a href="/federalism/">Federalism</a>,{" "}
      <a href="/constitutional-defense/">Constitutional Defense</a>, and{" "}
      <a href="/civic-wealth/">Civic Wealth</a>.
    </p>
  </article>
</BaseLayout>
