---
import BaseLayout from "../layouts/BaseLayout.astro";
import EvidencePanel from "../components/EvidencePanel.astro";
import gov from "../../../../data/project/government_capacity_framework.json";
import panels from "../../../../data/project/publication_evidence_panels.json";

const fiscalPanel = (panels.panels || []).find(
  (p: { panel_id: string }) => p.panel_id === "CC-EP-FISCAL-REVENUE-SYSTEM-1"
);
const testQs = gov.government_capacity_test?.questions || [];
const branches = gov.website_branches || [];
const pipeline = gov.civic_leadership_pipeline || [];
const reviewQs = gov.public_authority_inventory?.review_questions || [];
const rtest = gov.regulation_reason_test?.questions || [];
const formulaAdd = gov.lean_government_formula?.add || [];
const formulaSub = gov.lean_government_formula?.subtract || [];
---

<BaseLayout
  title="Public Service and the 21st-Century State"
  path="/public-service/"
  description="Government should become invisible—but never unaccountable. Reduce friction; improve service."
>
  <article class="prose">
    <h1>{gov.domain_title}</h1>

    <h2>The design question</h2>
    <p>Most debates ask: <em>{gov.defining_design_question.rejected_frame}</em></p>
    <p class="lede">{gov.defining_design_question.constitutional_question}</p>
    {fiscalPanel ? <EvidencePanel panel={fiscalPanel} /> : null}

    <h2>Iconic phrase</h2>
    <blockquote>
      <p><strong>{gov.iconic_phrase.text}</strong></p>
    </blockquote>
    <p>
      <strong>Invisible</strong> means {gov.iconic_phrase.meaning.invisible}
    </p>
    <p>
      <strong>Never unaccountable</strong> means {gov.iconic_phrase.meaning.never_unaccountable}
    </p>

    <h2>Friction-reduction principle</h2>
    <blockquote>
      <p>{gov.friction_reduction_principle.text}</p>
    </blockquote>
    <p>{gov.friction_reduction_principle.clarification}</p>

    <h2>Lean constitutional government</h2>
    <p>
      {formulaAdd.join(" + ")} − {formulaSub.join(" − ")} ={" "}
      <strong>{gov.lean_government_formula.equals}</strong>
    </p>

    <h2>Government as platform</h2>
    <p>{gov.government_as_platform.summary}</p>
    <p>
      <strong>Collect once.</strong> {gov.collect_once_principle.text} —
      {gov.collect_once_principle.summary}
    </p>

    <h2>Move people up the value chain</h2>
    <p>
      Wrong question: <em>{gov.value_chain_doctrine.wrong_question}</em><br />
      Right question: <em>{gov.value_chain_doctrine.right_question}</em>
    </p>
    <p>
      Working heuristic (not a measured universal statistic): technology should absorb routine
      processing so humans excel where judgment, ethics, investigation, and compassion matter.
    </p>

    <h2>Citizen experience is the metric</h2>
    <p>
      Wrong: <em>{gov.citizen_experience_metric.wrong_question}</em><br />
      Right: <em>{gov.citizen_experience_metric.right_question}</em>
    </p>
    <p>{gov.citizen_experience_metric.organization_rule}</p>
    <p>
      Example — “{gov.citizen_experience_metric.life_event_example.event}”: the citizen sees{" "}
      {gov.citizen_experience_metric.life_event_example.citizen_sees}
    </p>

    <h2>Technology doctrine</h2>
    <blockquote>
      <p>{gov.technology_doctrine.text}</p>
    </blockquote>
    <p>{gov.technology_doctrine.guardrail}</p>

    <h2>AI in government</h2>
    <p>{gov.ai_in_government.rule}</p>
    <p>{gov.ai_in_government.final_judgment}</p>

    <h2>Regulation Reason Test</h2>
    <ol>
      {rtest.map((q: any) => (
        <li>{q.text}</li>
      ))}
    </ol>
    <p>
      New rules should trigger workflow review — not crude scorekeeping alone. Design question:{" "}
      {gov.regulatory_workflow_rule.design_question}
    </p>

    <h2>Government Capacity Test</h2>
    <p>{gov.government_capacity_test.purpose}</p>
    <ol>
      {testQs.map((q: any) => (
        <li>{q.text}</li>
      ))}
    </ol>

    <h2>Noble public service</h2>
    <p>
      <strong>Professional public administration</strong> —
      {gov.career_distinction.professional_public_administration.summary}
    </p>
    <p>
      <strong>Civic leadership</strong> — {gov.career_distinction.civic_leadership.summary}
    </p>

    <h2>Civic leadership pipeline</h2>
    <ol>
      {pipeline.map((step: string) => (
        <li>{step}</li>
      ))}
    </ol>

    <h2>Visible boards and Public Authority Inventory</h2>
    <blockquote>
      <p>{gov.citizen_visibility_question}</p>
    </blockquote>
    <p>{gov.public_authority_inventory.note}</p>
    <ol>
      {reviewQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>

    <h2>Arkansas objective</h2>
    <blockquote>
      <p>{gov.arkansas_objective.text}</p>
    </blockquote>

    <h2>Domain branches</h2>
    <ul>
      {branches.map((b: any) => (
        <li>{b.title}</li>
      ))}
    </ul>

    <h2>Related: responsibility, not privilege</h2>
    <p>
      Public office is constitutional service, not a pathway to a privileged class. See the complementary
      doctrine <a href="/citizen-service/">Citizen-Service Government</a> — equal systems, no office-tied
      lifelong privilege, citizen legislature, cooling-off, and civic honor.
    </p>

    <p>
      See also <a href="/transparency/">Transparency</a>, <a href="/justice/">Justice</a>,
      <a href="/democracy/">Democracy</a>, and <a href="/where-we-are/">Where we are</a>.
    </p>
  </article>
</BaseLayout>
