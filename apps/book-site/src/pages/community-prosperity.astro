---
import BaseLayout from "../layouts/BaseLayout.astro";
import EvidencePanel from "../components/EvidencePanel.astro";
import f from "../../../../data/project/community_prosperity_framework.json";
import panels from "../../../../data/project/publication_evidence_panels.json";

const ruralPanel = (panels.panels || []).find(
  (p: { panel_id: string }) => p.panel_id === "CC-EP-RURAL-LOCAL-CAPITAL-SYSTEM-1"
);
const pillars = f.design_pillars?.pillars || [];
const baselines = f.sourced_context_baselines?.items || [];
const credits = f.citizenship_creates_equity?.credit_examples || [];
const assets = f.two_retirement_components?.community_prosperity_account?.example_assets || [];
const returns = f.two_retirement_components?.community_prosperity_account?.returns_may_include || [];
const safeguards = f.safeguards?.rules || [];
const metrics = f.prosperity_metrics?.examples || [];
const testQs = f.community_prosperity_test?.questions || [];
const branches = f.website_branches || [];
const fromQ = f.political_shift?.from_questions || [];
const toQ = f.political_shift?.to_questions || [];
---

<BaseLayout
  title="Community Prosperity"
  path="/community-prosperity/"
  description="Own a stake in the long-term prosperity of the community you help build — complementing, not replacing, diversified retirement savings."
>
  <article class="prose">
    <h1>{f.domain_title}</h1>
    <p class="muted">
      Architecture Candidate under doctrine freeze (CC-DEC-093) — Hypothesis Card HYP-111/112.
      Evidence, modeling, and legal review are not complete; not manuscript-publishable doctrine.
    </p>

    <h2>Core question</h2>
    <blockquote>
      <p>{f.core_question.text}</p>
    </blockquote>
    <p>{f.core_principle.text}</p>
    {ruralPanel ? <EvidencePanel panel={ruralPanel} /> : null}

    <h2>Compact</h2>
    <blockquote>
      <p>{f.compact_language.text}</p>
    </blockquote>

    <h2>Foundational communities</h2>
    <p>{f.foundational_communities_bridge.text}</p>

    <h2>Sourced context baselines</h2>
    <ul>
      {baselines.map((b: any) => (
        <li>
          <code>{b.id}</code> — {b.text}
        </li>
      ))}
    </ul>

    <h2>Two retirement components</h2>
    <p>{f.two_retirement_components.summary}</p>
    <h3>{f.two_retirement_components.traditional_retirement.title}</h3>
    <p>{f.two_retirement_components.traditional_retirement.text}</p>
    <h3>{f.two_retirement_components.community_prosperity_account.title}</h3>
    <p>{f.two_retirement_components.community_prosperity_account.text}</p>
    <p>Approved local projects may include:</p>
    <ul>
      {assets.map((a: string) => (
        <li>{a}</li>
      ))}
    </ul>
    <p>Returns may include:</p>
    <ul>
      {returns.map((r: string) => (
        <li>{r}</li>
      ))}
    </ul>

    <h2>{f.community_investment_units.title}</h2>
    <p>{f.community_investment_units.summary}</p>
    <p>{f.community_investment_units.design_rule}</p>

    <h2>{f.incentive_structure.title}</h2>
    <p class="muted">Today: {f.incentive_structure.from}</p>
    <p>{f.incentive_structure.to}</p>
    <p>
      Psychology shifts from <em>{f.incentive_structure.psychology_shift.from}</em> to{" "}
      <em>{f.incentive_structure.psychology_shift.to}</em>
    </p>

    <h2>{f.citizenship_creates_equity.title}</h2>
    <p>{f.citizenship_creates_equity.summary}</p>
    <ul>
      {credits.map((c: string) => (
        <li>{c}</li>
      ))}
    </ul>
    <p>{f.citizenship_creates_equity.underlying_idea}</p>

    <h2>{f.cities_as_wealth_builders.title}</h2>
    <p class="muted">Not only: {f.cities_as_wealth_builders.budget_question}</p>
    <blockquote>
      <p>{f.cities_as_wealth_builders.wealth_question}</p>
    </blockquote>
    <p>{f.cities_as_wealth_builders.evaluation_rule}</p>

    <h2>{f.prosperity_metrics.title}</h2>
    <p>{f.prosperity_metrics.summary}</p>
    <ul>
      {metrics.map((m: string) => (
        <li>{m}</li>
      ))}
    </ul>

    <h2>{f.healthy_competition.title}</h2>
    <p>{f.healthy_competition.summary}</p>

    <h2>{f.safeguards.title}</h2>
    <p>{f.safeguards.summary}</p>
    <ul>
      {safeguards.map((r: any) => (
        <li>
          <strong>{r.id.replaceAll("_", " ")}</strong> — {r.text}
        </li>
      ))}
    </ul>

    <h2>{f.political_shift.title}</h2>
    <p class="muted">From:</p>
    <ul>
      {fromQ.map((q: string) => (
        <li>{q}</li>
      ))}
    </ul>
    <p>Toward:</p>
    <ul>
      {toQ.map((q: string) => (
        <li>{q}</li>
      ))}
    </ul>
    <p>{f.political_shift.outcome}</p>

    <h2>Ten design pillars</h2>
    {
      pillars.map((p: any) => (
        <section style="margin-bottom:1rem;">
          <h3>
            {p.id}. {p.title}
          </h3>
          <p>{p.summary}</p>
        </section>
      ))
    }

    <h2>Community prosperity test</h2>
    <p>{f.community_prosperity_test.purpose}</p>
    <ol>
      {testQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ol>

    <h2>Website branches</h2>
    <ul>
      {branches.map((b: any) => (
        <li>
          <strong>{b.title}</strong> — {b.summary}
        </li>
      ))}
    </ul>

    <p class="muted">
      See also <a href="/local-ownership/">Local Ownership</a>,{" "}
      <a href="/community-resilience/">Community Resilience</a>,{" "}
      <a href="/prosperous-aging/">Prosperous Aging</a>,{" "}
      <a href="/civic-wealth/">Civic Wealth</a>,{" "}
      <a href="/energy-sovereignty/">Energy Sovereignty</a>,{" "}
      <a href="/family-farm-prosperity/">Family Farm Prosperity</a>, and{" "}
      <a href="/health/">Health</a>.
    </p>
  </article>
</BaseLayout>
