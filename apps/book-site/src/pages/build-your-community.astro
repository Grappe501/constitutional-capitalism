---
import BaseLayout from "../layouts/BaseLayout.astro";
import cos from "../../../../data/project/community_operating_system_framework.json";

const levels = cos.four_levels?.levels || [];
const layers = cos.seven_layer_architecture?.layers || [];
const assets = cos.community_asset_inventory?.asset_categories || [];
const milestones = cos.twenty_five_year_prosperity_plan?.milestones || [];
const dashboard = cos.community_dashboard_fields || [];
const attract = cos.local_prosperity_engine?.attract || [];
const owners = cos.local_prosperity_engine?.make_owners?.ownership_forms || [];
const peopleQs = cos.people_first_rule?.questions || [];
const testQs = cos.implementation_completeness_test?.questions || [];
const branches = cos.website_branches || [];
const stages = cos.build_your_community_surface?.output_stages || [];
---

<BaseLayout
  title="Build Your Community"
  path="/build-your-community/"
  description="Playbooks and a Community Operating System architecture — same principles, different local implementation."
>
  <article class="prose">
    <h1>{cos.domain_title}</h1>
    <p class="status-note">
      Design agenda — not an operating town-plan product. No invented population trajectories or dashboard values.
      AI may organize best practices; it does not make policy.
    </p>

    <h2>The practical question</h2>
    <blockquote>
      <p>{cos.signature_of_movement.practical_question}</p>
    </blockquote>
    <p>{cos.signature_of_movement.contrast}</p>
    <p>
      <strong>Signature of the movement:</strong> {cos.signature_of_movement.text}
    </p>

    <h2>Playbooks</h2>
    <p>{cos.playbook_rule.text}</p>
    <ul>
      {cos.playbook_rule.examples_of_difference.map((e: string) => (
        <li>{e}</li>
      ))}
    </ul>

    <h2>Permanent rule</h2>
    <blockquote>
      <p>{cos.implementation_completeness_rule.text}</p>
    </blockquote>
    <p>Practical test: {cos.implementation_completeness_rule.practical_test}</p>

    <h2>Four levels</h2>
    <ol>
      {levels.map((l: any) => (
        <li>
          <strong>{l.name}</strong> — {l.question}
        </li>
      ))}
    </ol>

    <h2>Seven-layer architecture</h2>
    <ol>
      {layers.map((l: any) => (
        <li>
          <strong>{l.name}</strong> — {l.purpose}
        </li>
      ))}
    </ol>

    <h2>Start with assets and people</h2>
    <p>
      First page question: <em>{cos.community_blueprint_hierarchy.first_page_question}</em> — not{" "}
      <em>{cos.community_blueprint_hierarchy.rejected_opening}</em>
    </p>
    <p>
      <strong>{cos.community_asset_inventory.title}:</strong>{" "}
      {cos.community_asset_inventory.first_exercise}
    </p>
    <ul>
      {assets.map((a: string) => (
        <li>{a}</li>
      ))}
    </ul>
    <p>{cos.people_first_rule.text}</p>
    <ul>
      {peopleQs.map((q: string) => (
        <li>{q}</li>
      ))}
    </ul>

    <h2>25-Year Community Prosperity Plan</h2>
    <p>{cos.twenty_five_year_prosperity_plan.summary}</p>
    <ol>
      {milestones.map((m: any) => (
        <li>
          Year {m.year}: {m.focus}
        </li>
      ))}
    </ol>

    <h2>Local Prosperity Engine</h2>
    <p>Attract:</p>
    <ul>
      {attract.map((a: string) => (
        <li>{a}</li>
      ))}
    </ul>
    <p>{cos.local_prosperity_engine.keep}</p>
    <p>{cos.local_prosperity_engine.make_owners.question}</p>
    <ul>
      {owners.map((o: string) => (
        <li>{o}</li>
      ))}
    </ul>

    <h2>Incubator towns</h2>
    <p>{cos.incubator_town_model.summary}</p>
    <p class="status-note">{cos.incubator_town_model.illustrative_contrast.example_note}</p>

    <h2>Community dashboard fields</h2>
    <ul>
      {dashboard.map((d: string) => (
        <li>{d}</li>
      ))}
    </ul>

    <h2>Community OS (design agenda)</h2>
    <p>
      <strong>{cos.community_operating_system.name}</strong> — {cos.community_operating_system.summary}
    </p>
    <p>{cos.community_operating_system.revolutionary_claim}</p>
    <p>Intended stages when productized:</p>
    <ol>
      {stages.map((s: string) => (
        <li>{s}</li>
      ))}
    </ol>
    <p>{cos.build_your_community_surface.ai_role}</p>

    <h2>Implementation Completeness Test</h2>
    <p>{cos.implementation_completeness_test.purpose}</p>
    <ol>
      {testQs.map((q: any) => (
        <li>{q.text}</li>
      ))}
    </ol>

    <h2>Domain branches</h2>
    <ul>
      {branches.map((b: any) => (
        <li>{b.title}</li>
      ))}
    </ul>

    <p>
      See also <a href="/human-capital/">Human Capital</a>,
      <a href="/essential-systems/">Essential Systems</a>, and
      <a href="/where-we-are/">Where we are</a>.
    </p>
  </article>
</BaseLayout>
