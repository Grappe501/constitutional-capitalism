{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/developing_doctrine.schema.json",
  "title": "DevelopingDoctrine",
  "type": "object",
  "required": ["version", "items"],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "status": { "type": "string" },
    "note": { "type": "string" },
    "capture_clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cluster_id",
          "title",
          "maturity",
          "evidence_status",
          "affected_domains",
          "constitutional_questions",
          "implementation_level",
          "risks",
          "phase_destination",
          "related_doctrine_ids"
        ],
        "properties": {
          "cluster_id": { "type": "string" },
          "title": { "type": "string" },
          "maturity": { "type": "string" },
          "evidence_status": { "type": "string" },
          "affected_domains": { "type": "array", "items": { "type": "string" } },
          "constitutional_questions": { "type": "array", "items": { "type": "string" } },
          "implementation_level": { "type": "array", "items": { "type": "string" } },
          "risks": { "type": "array", "items": { "type": "string" } },
          "phase_destination": { "type": "string" },
          "related_doctrine_ids": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["doctrine_id", "statement", "maturity", "status"],
        "properties": {
          "doctrine_id": { "type": "string", "pattern": "^CC-DEV-\\d{3}$" },
          "statement": { "type": "string", "minLength": 20 },
          "origin": { "type": "string" },
          "maturity": { "type": "string" },
          "implications": { "type": "array", "items": { "type": "string" } },
          "conflicts": { "type": "array", "items": { "type": "string" } },
          "research_required": { "type": "array", "items": { "type": "string" } },
          "declaration_revision_candidate": { "type": "boolean" },
          "status": { "type": "string" },
          "related_decision_ids": { "type": "array", "items": { "type": "string" } },
          "evidence_status": { "type": "string" },
          "affected_domains": { "type": "array", "items": { "type": "string" } },
          "constitutional_questions": { "type": "array", "items": { "type": "string" } },
          "implementation_level": { "type": ["string", "array"] },
          "risks": { "type": "array", "items": { "type": "string" } },
          "phase_destination": { "type": "string" }
        }
      }
    }
  }
}
