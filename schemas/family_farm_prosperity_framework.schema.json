{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/family_farm_prosperity_framework.schema.json",
  "title": "FamilyFarmProsperityFramework",
  "type": "object",
  "required": [
    "version",
    "domain_title",
    "central_promise",
    "compact_language",
    "thirteen_pillars",
    "economic_cycle",
    "family_farm_prosperity_test",
    "website_branches"
  ],
  "properties": {
    "version": { "type": "string" },
    "domain_title": { "type": "string" },
    "central_promise": { "type": "object", "required": ["text"] },
    "compact_language": { "type": "object", "required": ["text"] },
    "thirteen_pillars": {
      "type": "object",
      "required": ["pillars"],
      "properties": {
        "pillars": { "type": "array", "minItems": 13 }
      }
    },
    "economic_cycle": {
      "type": "object",
      "required": ["flow"]
    },
    "family_farm_prosperity_test": {
      "type": "object",
      "required": ["questions"]
    },
    "website_branches": { "type": "array", "minItems": 8 }
  }
}
