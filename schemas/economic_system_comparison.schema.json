{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "slug",
      "name",
      "family",
      "era",
      "ownership_model",
      "role_of_markets",
      "role_of_government",
      "private_property",
      "labor_treatment",
      "concentrated_power_approach",
      "accountability_source",
      "strengths",
      "risks",
      "relationship_to_cc",
      "historical_exemplars",
      "neighbor_systems",
      "dossier_path",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^CC-SYS-"
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "name": { "type": "string", "minLength": 1 },
      "family": {
        "type": "string",
        "enum": [
          "Historical",
          "Market-capitalist",
          "Coordinated-market",
          "Socialist",
          "Diagnostic",
          "Political-economic"
        ]
      },
      "era": { "type": "string", "minLength": 1 },
      "ownership_model": { "type": "string" },
      "role_of_markets": { "type": "string" },
      "role_of_government": { "type": "string" },
      "private_property": { "type": "string" },
      "labor_treatment": { "type": "string" },
      "concentrated_power_approach": { "type": "string" },
      "accountability_source": { "type": "string" },
      "strengths": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 1
      },
      "risks": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 1
      },
      "relationship_to_cc": { "type": "string" },
      "historical_exemplars": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 1
      },
      "neighbor_systems": {
        "type": "array",
        "items": { "type": "string", "pattern": "^CC-SYS-" },
        "minItems": 1
      },
      "dossier_path": {
        "type": "string",
        "pattern": "^content/public-resources/systems/.+\\.md$"
      },
      "status": {
        "const": "developing_analytical_tool"
      }
    },
    "additionalProperties": true
  }
}
