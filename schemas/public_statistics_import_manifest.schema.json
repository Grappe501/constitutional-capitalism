{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/public_statistics_import_manifest.schema.json",
  "title": "PublicStatisticsImportManifest",
  "type": "object",
  "required": [
    "export_id",
    "generated_at",
    "source_database",
    "source_agencies",
    "validation_status",
    "boundary_attestation"
  ],
  "properties": {
    "export_id": { "type": "string", "minLength": 8 },
    "generated_at": { "type": "string" },
    "source_database": { "type": "string" },
    "source_agencies": { "type": "array", "items": { "type": "string" } },
    "dataset_versions": { "type": "array" },
    "series_count": { "type": "integer", "minimum": 0 },
    "observation_count": { "type": "integer", "minimum": 0 },
    "minimum_period": { "type": ["string", "null"] },
    "maximum_period": { "type": ["string", "null"] },
    "validation_status": {
      "type": "string",
      "enum": ["pending", "passed", "failed", "architecture_stub"]
    },
    "reddirt_commit": { "type": ["string", "null"] },
    "constitutional_capitalism_import_commit": { "type": ["string", "null"] },
    "git_commit": { "type": ["string", "null"] },
    "boundary_attestation": {
      "type": "object",
      "required": [
        "contains_campaign_data",
        "contains_personal_data",
        "contains_api_keys",
        "public_statistics_only"
      ],
      "properties": {
        "contains_campaign_data": { "type": "boolean" },
        "contains_personal_data": { "type": "boolean" },
        "contains_api_keys": { "type": "boolean" },
        "public_statistics_only": { "type": "boolean" }
      }
    }
  }
}
