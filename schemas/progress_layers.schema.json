{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/progress_layers.schema.json",
  "title": "ProgressLayers",
  "type": "object",
  "required": ["version", "layers"],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "note": { "type": "string" },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "percent", "status", "last_updated"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "percent": { "type": "number", "minimum": 0, "maximum": 100 },
          "status": { "type": "string" },
          "basis": { "type": "array" },
          "blockers": { "type": "array" },
          "next_actions": { "type": "array" },
          "last_updated": { "type": "string" }
        }
      }
    }
  }
}
