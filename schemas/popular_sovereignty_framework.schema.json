{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/popular_sovereignty_framework.schema.json",
  "title": "PopularSovereigntyFramework",
  "type": "object",
  "required": [
    "version",
    "domain_title",
    "central_declaration",
    "peoples_court_declaration",
    "governing_principle",
    "reserved_powers",
    "rights_floor",
    "supreme_court_reform",
    "removal_paths",
    "popular_sovereignty_test",
    "website_branches"
  ],
  "properties": {
    "version": { "type": "string" },
    "domain_title": { "type": "string" },
    "central_declaration": { "type": "object", "required": ["text"] },
    "peoples_court_declaration": { "type": "object", "required": ["text"] },
    "governing_principle": { "type": "object", "required": ["text"] },
    "reserved_powers": { "type": "array", "minItems": 6 },
    "rights_floor": { "type": "object", "required": ["distinction", "prohibited_ballot_uses"] },
    "supreme_court_reform": { "type": "object" },
    "removal_paths": { "type": "array", "minItems": 3 },
    "popular_sovereignty_test": { "type": "object", "required": ["questions"] },
    "website_branches": { "type": "array", "minItems": 8 }
  }
}
