{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/source_registry.schema.json",
  "title": "SourceRegistry",
  "type": "object",
  "required": ["version", "sources"],
  "properties": {
    "version": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "title", "source_type", "reliability"],
        "properties": {
          "source_id": { "type": "string" },
          "title": { "type": "string" },
          "authors": { "type": "array" },
          "year": { "type": ["integer", "string", "null"] },
          "url": { "type": ["string", "null"] },
          "source_type": { "type": "string" },
          "reliability": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
