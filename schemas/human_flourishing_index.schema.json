{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/human_flourishing_index.schema.json",
  "title": "HumanFlourishingIndex",
  "type": "object",
  "required": ["version", "title", "ultimate_question", "policy_test_question", "domains"],
  "properties": {
    "version": { "type": "string" },
    "title": { "type": "string" },
    "status": { "type": "string" },
    "ultimate_question": { "type": "string" },
    "policy_test_question": { "type": "string" },
    "domains": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["domain_id", "title", "status"],
        "properties": {
          "domain_id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
