{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/civilizational_core.schema.json",
  "title": "CivilizationalCore",
  "type": "object",
  "required": ["version", "sacred_sentence", "first_principle", "power_hierarchy", "pillars"],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "status": { "type": "string" },
    "note": { "type": "string" },
    "sacred_sentence": {
      "type": "object",
      "required": ["text", "status"],
      "properties": {
        "text": { "type": "string", "minLength": 20 },
        "decision_id": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "first_principle": {
      "type": "object",
      "required": ["text", "status"],
      "properties": {
        "text": { "type": "string", "minLength": 20 },
        "dignity_guardrail": { "type": "string" },
        "decision_id": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "organizing_principle": { "type": "object" },
    "subsidiarity": { "type": "object" },
    "power_hierarchy": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": ["level", "name"],
        "properties": {
          "level": { "type": "integer" },
          "name": { "type": "string" },
          "emphasis": { "type": ["string", "null"] }
        }
      }
    },
    "power_movement_rule": { "type": "string" },
    "pillars": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["pillar_id", "name", "focus"],
        "properties": {
          "pillar_id": { "type": "string" },
          "name": { "type": "string" },
          "focus": { "type": "string" },
          "decision_id": { "type": "string" }
        }
      }
    },
    "corporation_framing": { "type": "object" },
    "community_economic_sovereignty": { "type": "object" },
    "duty_of_improvement": { "type": "object" },
    "emotional_center": { "type": "string" },
    "civilizational_question": { "type": "string" },
    "ai_constitutional_question": { "type": "string" },
    "promise_discipline": { "type": "string" }
  }
}
