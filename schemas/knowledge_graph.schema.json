{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/knowledge_graph.schema.json",
  "title": "KnowledgeGraph",
  "type": "object",
  "required": ["version", "title", "nodes", "edges", "relationship_types"],
  "properties": {
    "version": { "type": "string" },
    "title": { "type": "string" },
    "status": { "type": "string" },
    "relationship_types": { "type": "array", "minItems": 1 },
    "nodes": { "type": "array", "minItems": 1 },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["edge_id", "from", "relation", "to", "class"],
        "properties": {
          "edge_id": { "type": "string" },
          "from": { "type": "string" },
          "relation": { "type": "string" },
          "to": { "type": "string" },
          "class": {
            "type": "string",
            "enum": ["documented", "plausible", "disputed", "untested"]
          }
        }
      }
    }
  }
}
