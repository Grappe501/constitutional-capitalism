{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/proof_burden_registry.schema.json",
  "title": "ProofBurdenRegistry",
  "type": "object",
  "required": [
    "version",
    "decision_id",
    "status",
    "standard",
    "principles",
    "operating_rule"
  ],
  "properties": {
    "version": { "type": "string" },
    "decision_id": { "type": "string" },
    "status": { "type": "string" },
    "operating_rule": { "type": "string" },
    "standard": {
      "type": "object",
      "required": ["architecture_vs_evidence", "honesty_rules"]
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "principle_id",
          "proof_burden",
          "priority_evidence_packets",
          "publishable"
        ]
      }
    }
  }
}
