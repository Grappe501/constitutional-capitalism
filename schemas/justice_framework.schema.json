{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/justice_framework.schema.json",
  "title": "JusticeFramework",
  "type": "object",
  "required": ["version", "domain_title", "foundational_principle", "stages", "justice_test", "website_branches"],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "status": { "type": "string" },
    "decision_ids": { "type": "array", "items": { "type": "string" } },
    "domain_title": { "type": "string" },
    "website_node_id": { "type": "string" },
    "note": { "type": "string" },
    "role_in_philosophy": { "type": "string" },
    "foundational_principle": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 40 },
        "doctrine_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "central_promise": { "type": "object" },
    "central_questions": { "type": "object" },
    "system_objective": { "type": "object" },
    "community_safety_doctrine": { "type": "object" },
    "public_safety_promise": { "type": "object" },
    "community_policing_foundation": { "type": "object" },
    "system_map": { "type": "array", "items": { "type": "string" } },
    "community_safety_corps": { "type": "object" },
    "recruitment_and_training": { "type": "object" },
    "relationship_policing": { "type": "object" },
    "transparency_and_review": { "type": "object" },
    "public_corrections_rule": { "type": "object" },
    "decision_pathways": { "type": "object" },
    "secure_restoration_campuses": { "type": "object" },
    "reentry_from_day_one": { "type": "object" },
    "productive_citizenship_destination": { "type": "object" },
    "restoration_councils": { "type": "object" },
    "permanent_public_safety_system": { "type": "object" },
    "core_commitments": { "type": "array" },
    "stages": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["stage_id", "number", "name", "summary"],
        "properties": {
          "stage_id": { "type": "string" },
          "number": { "type": "integer" },
          "name": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "justice_test": {
      "type": "object",
      "required": ["title", "questions"],
      "properties": {
        "title": { "type": "string" },
        "purpose": { "type": "string" },
        "questions": {
          "type": "array",
          "minItems": 10,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["question_id", "number", "text"],
            "properties": {
              "question_id": { "type": "string" },
              "number": { "type": "integer" },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "website_branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["branch_id", "title"],
        "properties": {
          "branch_id": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    },
    "research_status": { "type": "object" }
  }
}
