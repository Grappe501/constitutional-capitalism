{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/book_identity.schema.json",
  "title": "BookIdentity",
  "type": "object",
  "required": [
    "title",
    "subtitle",
    "short_title",
    "philosophy_name",
    "canonical_definition",
    "central_belief",
    "project_status",
    "publication_intent",
    "public_availability_commitment",
    "version",
    "last_updated"
  ],
  "properties": {
    "title": { "type": "string", "const": "Constitutional Capitalism" },
    "subtitle": {
      "type": "string",
      "const": "Restoring Prosperity Through Constitutional Principles"
    },
    "short_title": { "type": "string" },
    "philosophy_name": { "type": "string" },
    "canonical_definition": { "type": "string", "minLength": 40 },
    "central_belief": { "type": "string", "minLength": 20 },
    "working_author": { "type": ["string", "null"] },
    "public_byline": { "type": ["string", "null"] },
    "public_byline_note": { "type": "string" },
    "project_creator": { "type": "string" },
    "project_status": { "type": "string" },
    "publication_intent": { "type": "string" },
    "public_availability_commitment": { "type": "string" },
    "version": { "type": "string" },
    "last_updated": { "type": "string" }
  },
  "additionalProperties": true
}
