{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/chapter_evaluation_template.schema.json",
  "title": "ChapterEvaluationTemplate",
  "type": "object",
  "required": ["version", "sections"],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "status": { "type": "string" },
    "decision_id": { "type": "string" },
    "title": { "type": "string" },
    "purpose": { "type": "string" },
    "apply_when": { "type": "array", "items": { "type": "string" } },
    "sections": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["section_id", "heading", "prompt"],
        "properties": {
          "section_id": { "type": "string", "pattern": "^CC-EVAL-[A-Z_]+$" },
          "heading": { "type": "string" },
          "prompt": { "type": "string" },
          "links_to": { "type": "array", "items": { "type": "string" } },
          "horizons": { "type": "array", "items": { "type": "string" } },
          "discipline": { "type": "string" }
        }
      }
    }
  }
}
