{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/civic_wealth_framework.schema.json",
  "title": "CivicWealthFramework",
  "type": "object",
  "required": [
    "version",
    "domain_title",
    "signature_shift",
    "governing_principle",
    "core_theme",
    "veteran_prosperity_pathway",
    "civic_investment_account",
    "service_multipliers",
    "guardrails",
    "constitutional_service_forms",
    "civic_wealth_test",
    "website_branches"
  ],
  "properties": {
    "version": { "type": "string" },
    "domain_title": { "type": "string" },
    "signature_shift": { "type": "object", "required": ["from", "to"] },
    "governing_principle": { "type": "object", "required": ["text"] },
    "core_theme": { "type": "object", "required": ["text"] },
    "veteran_prosperity_pathway": {
      "type": "object",
      "required": ["steps"]
    },
    "civic_investment_account": {
      "type": "object",
      "required": ["summary", "opportunity_uses"]
    },
    "service_multipliers": {
      "type": "object",
      "required": ["summary"]
    },
    "guardrails": {
      "type": "object",
      "required": ["must_never_become"]
    },
    "constitutional_service_forms": {
      "type": "object",
      "required": ["pathways"]
    },
    "civic_wealth_test": {
      "type": "object",
      "required": ["questions"]
    },
    "website_branches": { "type": "array", "minItems": 8 }
  }
}
