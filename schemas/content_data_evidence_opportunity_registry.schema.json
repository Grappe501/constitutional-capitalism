{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/content_data_evidence_opportunity_registry.schema.json",
  "title": "Content Data Evidence Opportunity Registry",
  "type": "object",
  "required": [
    "version",
    "slice_id",
    "governing_question",
    "summary",
    "opportunities"
  ],
  "properties": {
    "version": { "type": "string" },
    "slice_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "governing_question": { "type": "string" },
    "summary": { "type": "object" },
    "top_50_content_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "content_id",
          "file",
          "section",
          "existing_statement",
          "statement_type",
          "classifications",
          "priority"
        ],
        "properties": {
          "content_id": { "type": "string" },
          "file": { "type": "string" },
          "surface_class": { "type": "string" },
          "section": { "type": "string" },
          "existing_statement": { "type": "string" },
          "statement_type": { "type": "string" },
          "classifications": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "priority": {
            "type": "string",
            "enum": ["HIGH", "MEDIUM", "LOW"]
          },
          "priority_score": { "type": "number" },
          "recommended_presentation": {
            "type": "array",
            "items": { "type": "string" }
          },
          "reuse_targets": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
