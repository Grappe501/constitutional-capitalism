{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/national_baseline_metrics.schema.json",
  "title": "NationalBaselineMetrics",
  "type": "object",
  "required": ["version", "metrics"],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "status": { "type": "string" },
    "guiding_question": { "type": "string" },
    "note": { "type": "string" },
    "linked_legacy_file": { "type": "string" },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric_id", "title", "status"],
        "properties": {
          "metric_id": { "type": "string" },
          "title": { "type": "string" },
          "current_value": {},
          "reference_year": { "type": ["string", "integer", "null"] },
          "source_ids": { "type": "array", "items": { "type": "string" } },
          "confidence_level": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
