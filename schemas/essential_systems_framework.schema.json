{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/essential_systems_framework.schema.json",
  "title": "EssentialSystemsFramework",
  "type": "object",
  "required": [
    "version",
    "domain_title",
    "constitutional_question",
    "chapter_method",
    "systems",
    "essential_systems_test",
    "website_branches"
  ],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "status": { "type": "string" },
    "decision_ids": { "type": "array", "items": { "type": "string" } },
    "domain_title": { "type": "string" },
    "research_domain_title": { "type": "string" },
    "website_node_id": { "type": "string" },
    "note": { "type": "string" },
    "framing_rule": { "type": "string" },
    "constitutional_question": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 40 },
        "doctrine_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "role_in_philosophy": { "type": "string" },
    "chapter_method": { "type": "object" },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["system_id", "title", "purpose"],
        "properties": {
          "system_id": { "type": "string" },
          "title": { "type": "string" },
          "purpose": { "type": "string" },
          "principle": { "type": "object" },
          "design_questions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "foundational_idea": { "type": "string" },
          "health_maintenance_investments": {
            "type": "array",
            "items": { "type": "string" }
          },
          "framing_caution": { "type": "string" },
          "method_note": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "community_health_index": { "type": "object" },
    "preventive_society": { "type": "object" },
    "essential_systems_test": {
      "type": "object",
      "required": ["title", "questions"],
      "properties": {
        "title": { "type": "string" },
        "purpose": { "type": "string" },
        "questions": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "required": ["question_id", "number", "text"]
          }
        }
      }
    },
    "website_branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["branch_id", "title"]
      }
    },
    "related_research_domains": {
      "type": "array",
      "items": { "type": "string" }
    },
    "research_status": { "type": "object" }
  }
}
