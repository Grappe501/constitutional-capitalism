{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/community_food_security_framework.schema.json",
  "title": "CommunityFoodSecurityFramework",
  "type": "object",
  "required": [
    "version",
    "domain_title",
    "central_principle",
    "governing_doctrine",
    "community_food_security_test",
    "website_branches"
  ],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "status": { "type": "string" },
    "decision_ids": { "type": "array", "items": { "type": "string" } },
    "domain_title": { "type": "string" },
    "research_domain_title": { "type": "string" },
    "website_node_id": { "type": "string" },
    "note": { "type": "string" },
    "role_in_philosophy": { "type": "string" },
    "rejected_principle": { "type": "object" },
    "central_principle": { "type": "object" },
    "local_first_export_second": { "type": "object" },
    "governing_doctrine": { "type": "object" },
    "food_as_critical_infrastructure": { "type": "object" },
    "system_posture": { "type": "object" },
    "regional_food_network": { "type": "object" },
    "state_food_exchange": { "type": "object" },
    "keep_value_local": { "type": "object" },
    "fresh_food_networks": { "type": "object" },
    "reduce_food_waste": { "type": "object" },
    "community_food_reserves": { "type": "object" },
    "regenerative_agriculture_link": { "type": "object" },
    "food_education": { "type": "object" },
    "community_food_dashboard": { "type": "object" },
    "community_food_security_test": {
      "type": "object",
      "required": ["title", "questions"],
      "properties": {
        "title": { "type": "string" },
        "purpose": { "type": "string" },
        "questions": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "required": ["question_id", "number", "text"],
            "properties": {
              "question_id": { "type": "string" },
              "number": { "type": "integer" },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "website_branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["branch_id", "title"],
        "properties": {
          "branch_id": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    },
    "research_status": { "type": "object" }
  }
}
