{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/constitutional_capitalism_test.schema.json",
  "title": "ConstitutionalCapitalismTest",
  "type": "object",
  "required": ["version", "title", "questions"],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "status": { "type": "string" },
    "decision_id": { "type": "string" },
    "title": { "type": "string" },
    "purpose": { "type": "string" },
    "applies_to": { "type": "array", "items": { "type": "string" } },
    "questions": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["question_id", "number", "text", "axis"],
        "properties": {
          "question_id": { "type": "string", "pattern": "^CC-TEST-\\d{2}$" },
          "number": { "type": "integer", "minimum": 1, "maximum": 10 },
          "text": { "type": "string", "minLength": 10 },
          "axis": { "type": "string" },
          "preferred_direction": { "type": "string" },
          "links_to": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
