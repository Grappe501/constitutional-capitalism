{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/human_capital_framework.schema.json",
  "title": "HumanCapitalFramework",
  "type": "object",
  "required": [
    "version",
    "domain_title",
    "first_principle",
    "human_capital_infrastructure",
    "arkansas_academy_model",
    "human_capital_test",
    "website_branches"
  ],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "status": { "type": "string" },
    "decision_ids": { "type": "array", "items": { "type": "string" } },
    "domain_title": { "type": "string" },
    "research_domain_title": { "type": "string" },
    "website_node_id": { "type": "string" },
    "note": { "type": "string" },
    "role_in_philosophy": { "type": "string" },
    "human_capital_infrastructure": { "type": "object" },
    "first_principle": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 40 },
        "doctrine_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "equal_dignity_rule": { "type": "object" },
    "pilot_posture": { "type": "object" },
    "arkansas_academy_model": {
      "type": "object",
      "required": ["status", "mission"],
      "properties": {
        "status": { "type": "string" },
        "name_candidates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "naming_rule": { "type": "string" },
        "mission": { "type": "string" },
        "mission_note": { "type": "string" },
        "living_learning_campus": { "type": "object" },
        "regional_specialization": { "type": "object" },
        "paid_apprenticeships": { "type": "object" },
        "entrepreneurship": { "type": "object" },
        "civic_leadership": { "type": "object" },
        "community_partnerships": { "type": "object" },
        "success_metrics": { "type": "object" },
        "doctrine_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "human_capital_test": {
      "type": "object",
      "required": ["title", "questions"],
      "properties": {
        "title": { "type": "string" },
        "purpose": { "type": "string" },
        "questions": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "required": ["question_id", "number", "text"]
          }
        }
      }
    },
    "website_branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["branch_id", "title"]
      }
    },
    "related_research": {
      "type": "array",
      "items": { "type": "string" }
    },
    "research_status": { "type": "object" }
  }
}
