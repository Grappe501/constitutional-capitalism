{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/constitutional_articles.schema.json",
  "title": "ConstitutionalArticles",
  "type": "object",
  "required": ["version", "articles"],
  "properties": {
    "version": { "type": "string" },
    "articles": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": ["article_id", "roman", "title", "status"],
        "properties": {
          "article_id": { "type": "string" },
          "roman": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string" },
          "summary": { "type": "string" },
          "related_chapter_ids": { "type": "array" },
          "maturity_percent": { "type": "number" }
        }
      }
    }
  }
}
