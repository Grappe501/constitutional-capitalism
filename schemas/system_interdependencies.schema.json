{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/system_interdependencies.schema.json",
  "title": "SystemInterdependencies",
  "type": "object",
  "required": ["version", "relationship_classes", "chains"],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "status": { "type": "string" },
    "decision_id": { "type": "string" },
    "note": { "type": "string" },
    "relationship_classes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["class", "meaning"],
        "properties": {
          "class": { "type": "string" },
          "meaning": { "type": "string" }
        }
      }
    },
    "chains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chain_id", "title", "nodes", "overall_class", "links"],
        "properties": {
          "chain_id": { "type": "string" },
          "title": { "type": "string" },
          "nodes": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
          "overall_class": {
            "type": "string",
            "enum": ["documented", "plausible", "disputed", "untested"]
          },
          "links": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["from", "to", "class"],
              "properties": {
                "from": { "type": "string" },
                "to": { "type": "string" },
                "class": {
                  "type": "string",
                  "enum": ["documented", "plausible", "disputed", "untested"]
                },
                "note": { "type": "string" }
              }
            }
          },
          "related_doctrine_ids": { "type": "array", "items": { "type": "string" } },
          "double_count_warning": { "type": "string" }
        }
      }
    }
  }
}
