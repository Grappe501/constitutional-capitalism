{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/transition_scenarios.schema.json",
  "title": "TransitionScenarios",
  "type": "object",
  "required": ["version", "scenarios", "disclaimer"],
  "properties": {
    "version": { "type": "string" },
    "disclaimer": { "type": "string", "minLength": 20 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "horizon", "label"],
        "properties": {
          "id": { "type": "string" },
          "horizon": { "type": "string" },
          "label": { "type": "string" },
          "related_chapters": { "type": "array" },
          "prediction_ids": { "type": "array" }
        }
      }
    }
  }
}
