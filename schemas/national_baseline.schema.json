{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/national_baseline.schema.json",
  "title": "NationalBaseline",
  "type": "object",
  "required": ["version", "domains", "guiding_question"],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "status": { "type": "string" },
    "decision_id": { "type": "string" },
    "guiding_question": { "type": "string", "minLength": 20 },
    "note": { "type": "string" },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["domain_id", "name", "indicators"],
        "properties": {
          "domain_id": { "type": "string", "pattern": "^CC-NB-[A-Z]+$" },
          "name": { "type": "string" },
          "indicators": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["indicator_id", "name", "status"],
              "properties": {
                "indicator_id": { "type": "string", "pattern": "^CC-IND-[A-Z0-9]+$" },
                "name": { "type": "string" },
                "status": { "type": "string" },
                "source_ids": { "type": "array", "items": { "type": "string" } },
                "latest_value": {},
                "as_of": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
