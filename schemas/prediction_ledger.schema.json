{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/prediction_ledger.schema.json",
  "title": "PredictionLedger",
  "type": "object",
  "required": ["version", "predictions"],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "note": { "type": "string" },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "prediction_id",
          "text",
          "layer",
          "confidence",
          "modeling_status",
          "publication_readiness"
        ],
        "properties": {
          "prediction_id": { "type": "string", "pattern": "^CC-PRED-\\d{3}$" },
          "text": { "type": "string", "minLength": 20 },
          "layer": { "const": "prediction" },
          "confidence": { "type": "string" },
          "modeling_status": { "type": "string" },
          "related_scenarios": { "type": "array", "items": { "type": "string" } },
          "related_chapters": { "type": "array", "items": { "type": "string" } },
          "publication_readiness": { "type": "string" }
        }
      }
    }
  }
}
