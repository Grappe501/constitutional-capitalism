{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/policy_proposals.schema.json",
  "title": "PolicyProposals",
  "type": "object",
  "required": ["version", "proposals"],
  "properties": {
    "version": { "type": "string" },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "proposal_id",
          "title",
          "description",
          "problem_addressed",
          "research_status",
          "maturity_percentage"
        ],
        "properties": {
          "proposal_id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "problem_addressed": { "type": "string" },
          "principle_served": { "type": "string" },
          "beneficiaries": { "type": "array" },
          "likely_opposition": { "type": "array" },
          "economic_risks": { "type": "array" },
          "constitutional_questions": { "type": "array" },
          "legal_questions": { "type": "array" },
          "implementation_level": { "type": "string" },
          "fiscal_questions": { "type": "array" },
          "research_status": { "type": "string" },
          "book_chapters": { "type": "array" },
          "current_recommendation": { "type": "string" },
          "maturity_percentage": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
