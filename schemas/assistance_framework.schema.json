{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/assistance_framework.schema.json",
  "title": "AssistanceFramework",
  "type": "object",
  "required": [
    "version",
    "domain_title",
    "organizing_principle",
    "security_vs_dependency",
    "pathways",
    "assistance_test",
    "website_branches"
  ],
  "properties": {
    "version": { "type": "string" },
    "domain_title": { "type": "string" },
    "organizing_principle": { "type": "object", "required": ["text"] },
    "security_vs_dependency": {
      "type": "object",
      "required": ["security", "dependency", "goal"]
    },
    "pathways": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["pathway_id", "title", "summary"]
      }
    },
    "assistance_test": {
      "type": "object",
      "required": ["questions"],
      "properties": {
        "questions": { "type": "array", "minItems": 6 }
      }
    },
    "website_branches": { "type": "array", "minItems": 1 }
  }
}
