{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/constitutional_citizenship_framework.schema.json",
  "title": "ConstitutionalCitizenshipFramework",
  "type": "object",
  "required": [
    "version",
    "domain_title",
    "foundational_doctrine",
    "developmental_civic_pathway",
    "prepared_civic_participation_exploration",
    "constitutional_citizenship_test",
    "website_branches"
  ],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "status": { "type": "string" },
    "decision_ids": { "type": "array", "items": { "type": "string" } },
    "domain_title": { "type": "string" },
    "research_domain_title": { "type": "string" },
    "website_node_id": { "type": "string" },
    "principle_id": { "type": "string" },
    "note": { "type": "string" },
    "role_in_philosophy": { "type": "string" },
    "central_question_shift": { "type": "object" },
    "foundational_doctrine": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 40 },
        "doctrine_ids": { "type": "array", "items": { "type": "string" } },
        "principle_id": { "type": "string" }
      }
    },
    "guiding_statement": { "type": "object" },
    "participatory_civic_education": { "type": "object" },
    "developmental_civic_pathway": {
      "type": "object",
      "required": ["stages"],
      "properties": {
        "status": { "type": "string" },
        "note": { "type": "string" },
        "stages": { "type": "array", "minItems": 4 },
        "doctrine_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "youth_leadership_councils": { "type": "object" },
    "prepared_civic_participation_exploration": {
      "type": "object",
      "required": ["hard_rule", "governing_question", "pilot_posture"],
      "properties": {
        "title": { "type": "string" },
        "status": { "type": "string" },
        "hard_rule": { "type": "string" },
        "governing_question": { "type": "string" },
        "illustrative_model": { "type": "object" },
        "pilot_posture": { "type": "string" },
        "research_questions": { "type": "array", "items": { "type": "string" } },
        "doctrine_ids": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "civic_graduation": { "type": "object" },
    "schools_as_community_laboratories": { "type": "object" },
    "civic_service": { "type": "object" },
    "civic_scorecards": { "type": "object" },
    "connections": { "type": "object" },
    "constitutional_citizenship_test": {
      "type": "object",
      "required": ["title", "purpose", "questions"],
      "properties": {
        "title": { "type": "string" },
        "purpose": { "type": "string" },
        "questions": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "required": ["question_id", "number", "text"],
            "properties": {
              "question_id": { "type": "string" },
              "number": { "type": "integer" },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "website_branches": { "type": "array", "minItems": 1 },
    "research_status": { "type": "object" }
  }
}
