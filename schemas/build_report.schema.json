{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/build_report.schema.json",
  "title": "BuildReport",
  "type": "object",
  "required": ["mission_id", "status", "updated_at"],
  "properties": {
    "mission_id": { "type": "string" },
    "status": { "type": "string" },
    "updated_at": { "type": "string" },
    "summary": { "type": "string" },
    "repository_root": { "type": "string" },
    "branch": { "type": "string" },
    "starting_commit": { "type": ["string", "null"] },
    "ending_commit": { "type": ["string", "null"] }
  }
}
