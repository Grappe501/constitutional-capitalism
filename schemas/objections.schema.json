{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "objection",
      "why_reasonable",
      "provisional_response",
      "evidence_needed",
      "unresolved_weaknesses",
      "related_principles",
      "related_chapters",
      "response_maturity_percent",
      "status",
      "category"
    ],
    "properties": {
      "id": {
        "pattern": "^CC-OBJ-\\d{3}$"
      },
      "response_maturity_percent": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "status": {
        "const": "open"
      }
    },
    "additionalProperties": true
  }
}
