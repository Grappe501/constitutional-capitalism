{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/constitutional_defense_framework.schema.json",
  "title": "ConstitutionalDefenseFramework",
  "type": "object",
  "required": [
    "version",
    "domain_title",
    "governing_principle",
    "larger_philosophy",
    "chain_of_loyalty",
    "federal_defense_responsibilities",
    "deterrence",
    "national_resilience",
    "constitutional_limits",
    "constitutional_defense_test",
    "website_branches"
  ],
  "properties": {
    "version": { "type": "string" },
    "domain_title": { "type": "string" },
    "governing_principle": { "type": "object", "required": ["text"] },
    "larger_philosophy": { "type": "object", "required": ["text"] },
    "chain_of_loyalty": { "type": "object", "required": ["order", "rule"] },
    "federal_defense_responsibilities": {
      "type": "object",
      "required": ["summary", "functions"]
    },
    "deterrence": {
      "type": "object",
      "required": ["principle"]
    },
    "national_resilience": {
      "type": "object",
      "required": ["summary", "dimensions"]
    },
    "constitutional_limits": {
      "type": "object",
      "required": ["military_must_never"]
    },
    "constitutional_defense_test": {
      "type": "object",
      "required": ["questions"]
    },
    "website_branches": { "type": "array", "minItems": 8 }
  }
}
