{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/family_framework.schema.json",
  "title": "FamilyFramework",
  "type": "object",
  "required": [
    "version",
    "domain_title",
    "organizing_principle",
    "shared_responsibility_rule",
    "foundational_doctrine",
    "care_ladder",
    "family_test",
    "website_branches"
  ],
  "properties": {
    "version": { "type": "string" },
    "domain_title": { "type": "string" },
    "organizing_principle": { "type": "object", "required": ["text"] },
    "shared_responsibility_rule": { "type": "object", "required": ["text", "rejected_phrasing"] },
    "foundational_doctrine": { "type": "object", "required": ["text"] },
    "care_ladder": { "type": "object", "required": ["order"] },
    "family_test": {
      "type": "object",
      "required": ["questions"],
      "properties": {
        "questions": { "type": "array", "minItems": 6 }
      }
    },
    "website_branches": { "type": "array", "minItems": 1 }
  }
}
