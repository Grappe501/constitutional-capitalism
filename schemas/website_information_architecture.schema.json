{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/website_information_architecture.schema.json",
  "title": "WebsiteInformationArchitecture",
  "type": "object",
  "required": ["version", "domain_tree", "life_path_tree", "primary_medium"],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "status": { "type": "string" },
    "decision_id": { "type": "string" },
    "primary_medium": { "type": "string" },
    "project_name": { "type": "string" },
    "book_role": { "type": "object" },
    "domain_tree": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node_id", "title", "status"],
        "properties": {
          "node_id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string" },
          "decision_id": { "type": "string" },
          "central_promise": { "type": "string" },
          "branches": { "type": "array", "items": { "type": "string" } },
          "framework_file": { "type": "string" }
        }
      }
    },
    "life_path_tree": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node_id", "title"],
        "properties": {
          "node_id": { "type": "string" },
          "title": { "type": "string" },
          "prompt": { "type": ["string", "null"] }
        }
      }
    },
    "arteries": { "type": "array", "items": { "type": "string" } },
    "essential_infrastructure_principle": { "type": "object" }
  }
}
