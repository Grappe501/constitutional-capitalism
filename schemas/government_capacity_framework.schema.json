{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/government_capacity_framework.schema.json",
  "title": "GovernmentCapacityFramework",
  "type": "object",
  "required": [
    "version",
    "domain_title",
    "foundational_principle",
    "technology_doctrine",
    "government_capacity_test",
    "website_branches"
  ],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "status": { "type": "string" },
    "decision_ids": { "type": "array", "items": { "type": "string" } },
    "domain_title": { "type": "string" },
    "research_domain_title": { "type": "string" },
    "website_node_id": { "type": "string" },
    "note": { "type": "string" },
    "role_in_philosophy": { "type": "string" },
    "foundational_principle": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 40 },
        "doctrine_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "operational_rule": { "type": "object" },
    "technology_doctrine": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "doctrine_ids": { "type": "array", "items": { "type": "string" } },
        "guardrail": { "type": "string" }
      }
    },
    "arkansas_objective": { "type": "object" },
    "career_distinction": { "type": "object" },
    "civic_leadership_pipeline": { "type": "array", "items": { "type": "string" } },
    "appointment_evaluation_criteria": { "type": "array", "items": { "type": "string" } },
    "appointment_rule": { "type": "string" },
    "technology_should_eliminate": { "type": "array", "items": { "type": "string" } },
    "human_work_elevated": { "type": "array", "items": { "type": "string" } },
    "visible_board_page_requirements": { "type": "array", "items": { "type": "string" } },
    "citizen_visibility_question": { "type": "string" },
    "public_authority_inventory": { "type": "object" },
    "sunset_and_renewal": { "type": "object" },
    "open_appointments": { "type": "object" },
    "civic_service_credential": { "type": "object" },
    "public_worker_standards": { "type": "array", "items": { "type": "string" } },
    "citizen_facing_account": { "type": "object" },
    "agency_accountability_dashboard": { "type": "object" },
    "government_capacity_test": {
      "type": "object",
      "required": ["title", "questions"],
      "properties": {
        "title": { "type": "string" },
        "purpose": { "type": "string" },
        "questions": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "required": ["question_id", "number", "text"]
          }
        }
      }
    },
    "website_branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["branch_id", "title"]
      }
    },
    "research_status": { "type": "object" }
  }
}
