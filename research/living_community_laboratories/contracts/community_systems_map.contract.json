{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommunitySystemsMap",
  "type": "object",
  "required": [
    "map_id",
    "community_id",
    "relationships"
  ],
  "properties": {
    "map_id": {
      "type": "string"
    },
    "community_id": {
      "type": "string"
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "direction",
          "strength",
          "confidence",
          "time_delay",
          "evidence"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "strength": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "time_delay": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
