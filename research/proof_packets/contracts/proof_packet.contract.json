{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitutional-capitalism.local/schemas/proof_packet.contract.json",
  "title": "Constitutional Capitalism Proof Packet Contract",
  "description": "JSON contract for every Proof Packet under methodology version 1.0. Architecture is frozen; this contract governs research execution only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "title",
    "principle",
    "doctrine",
    "claim_ids",
    "research_question",
    "hypothesis",
    "supporting_sources",
    "contrary_sources",
    "confidence",
    "verdict",
    "review_status",
    "methodology_version",
    "created",
    "updated"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^PP-[A-Z0-9]+-[0-9]{2}$",
      "description": "Canonical packet identifier, e.g. PP-FF-01."
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "principle": {
      "type": "string",
      "pattern": "^CC-PRIN-[0-9]+$"
    },
    "doctrine": {
      "type": "string",
      "minLength": 1,
      "description": "Primary decision or doctrine anchor, e.g. CC-DEC-089."
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^CC-CLAIM-[0-9]+$"
      }
    },
    "hypothesis_id": {
      "type": "string",
      "pattern": "^HYP-[0-9]+$"
    },
    "research_question": {
      "type": "string",
      "minLength": 20
    },
    "hypothesis": {
      "type": "string",
      "minLength": 20,
      "description": "Architectural hypothesis text exactly as adopted — do not rewrite doctrine."
    },
    "supporting_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Registered source IDs preferred (CC-SRC-*). Unregistered IDs must be justified in the research ledger."
    },
    "contrary_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "May be empty only if contrary_search_log documents exhaustive negative results."
    },
    "contrary_search_log": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "object",
      "required": ["overall", "scale"],
      "additionalProperties": false,
      "properties": {
        "overall": {
          "type": "string",
          "enum": ["Very Low", "Low", "Moderate", "High", "Very High"]
        },
        "scale": {
          "type": "string",
          "const": "evidence_quality_not_certainty"
        },
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["Very Low", "Low", "Moderate", "High", "Very High", "Not Assessed"]
          }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "Supports",
        "Qualifies",
        "Contradicts",
        "Not Enough Evidence",
        "Withdrawn",
        "Superseded"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "Planned",
        "Researching",
        "Draft",
        "Internal Review",
        "Methodology Review",
        "Domain Review",
        "Complete",
        "Archived",
        "Superseded"
      ]
    },
    "methodology_version": {
      "type": "string",
      "const": "1.0"
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "completion_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "reviewer": {
      "type": ["string", "null"]
    },
    "packet_markdown": {
      "type": "string",
      "description": "Relative path to the packet markdown file."
    },
    "notes": {
      "type": "string"
    }
  }
}
