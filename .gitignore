# Dependencies
node_modules/

# Build outputs
dist/
.astro/
.vite/

# Local H:-only caches and temps (keep directory structure via .gitkeep where needed)
.local/tmp/*
.local/temp/*
.local/cache/*
.local/npm-cache/*
.local/pnpm-store/*
.local/pnpm-home/*
.local/netlify/*
.local/astro/*
.local/vite/*
.local/logs/*
.local/downloads/*
.local/backups/*
!.local/**/.gitkeep

# Netlify local state — never commit credentials or site state
.netlify/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets*.json

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
.idea/
.vscode/*
!.vscode/extensions.json

# Logs and reports that are machine-local (keep generated project reports)
*.log
npm-debug.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/

# Package manager
.pnpm-debug.log

# Generated transient
data/generated/*.tmp
reports/*.tmp

__pycache__/
*.pyc
