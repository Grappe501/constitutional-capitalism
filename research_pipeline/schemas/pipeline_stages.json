      "formats": [
        "APA",
        "Chicago",
        "Government",
        "Court",
        "Dataset",
        "Web",
        "Book"
      ]
    },
    {
      "id": 7,
      "name": "Duplicate Detection",
      "store": "dedup/"
    },
    {
      "id": 8,
      "name": "Contradiction Detection",
      "output": "Research Conflict"
    },
    {
      "id": 9,
      "name": "Human Review Queue",
      "statuses": [
        "Needs Review",
        "Accepted",
        "Rejected",
        "Needs More Research"
      ]
    },
    {
      "id": 10,
      "name": "Canonical Corpus",
